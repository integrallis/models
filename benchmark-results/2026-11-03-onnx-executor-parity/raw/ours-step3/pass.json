{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {onnxDynamicNodes=1311, backend=pure-java, onnxNodes=2535, graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnxOpset=17, onnxOperators=56, voices=af_heart,bf_isabella,am_puck,bm_fable} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"af_heart","voiceIndex":0,"corpus":"harvard-200","pass":1,"noiseSeed":"model default","java":"25.0.3","machine":"Mac OS X 26.6.2 x86_64 12 cpus","sentences":50,"totalAudioSeconds":131.67499999999998,"totalRunSeconds":12.019084020000001,"realTimeMultiple":10.955493761495477,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.7,"runSeconds":0.487552596,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.487508676,"realTimeFactor":0.18057503555555554,"finite":true,"samples":64800},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.7,"runSeconds":0.546349474,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.546288858,"realTimeFactor":0.20235165703703703,"finite":true,"samples":64800},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.5,"runSeconds":0.360833808,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.360780278,"realTimeFactor":0.14433352319999998,"finite":true,"samples":60000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.9,"runSeconds":0.283044717,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.282924673,"realTimeFactor":0.09760162655172414,"finite":true,"samples":69600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.8,"runSeconds":0.334713677,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.334524697,"realTimeFactor":0.11954059892857143,"finite":true,"samples":67200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.575,"runSeconds":0.272994672,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.272945775,"realTimeFactor":0.10601734834951455,"finite":true,"samples":61800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.196746591,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196680281,"realTimeFactor":0.07286910777777778,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.85,"runSeconds":0.279433844,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.279379383,"realTimeFactor":0.09804696280701754,"finite":true,"samples":68400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.55,"runSeconds":0.189586378,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189437766,"realTimeFactor":0.07434759921568627,"finite":true,"samples":61200},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.05,"runSeconds":0.19228942,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192227757,"realTimeFactor":0.06304571147540984,"finite":true,"samples":73200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.4,"runSeconds":0.155148537,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155117841,"realTimeFactor":0.06464522375000001,"finite":true,"samples":57600},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.625,"runSeconds":0.189615557,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189580769,"realTimeFactor":0.0722344979047619,"finite":true,"samples":63000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.1,"runSeconds":0.237341762,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237296023,"realTimeFactor":0.07656185870967742,"finite":true,"samples":74400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.575,"runSeconds":0.168684047,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168647898,"realTimeFactor":0.06550836776699029,"finite":true,"samples":61800},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.425,"runSeconds":0.178346295,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178198928,"realTimeFactor":0.07354486391752578,"finite":true,"samples":58200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.251469154,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251426555,"realTimeFactor":0.09489402037735849,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.575,"runSeconds":0.189025731,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188992173,"realTimeFactor":0.0734080508737864,"finite":true,"samples":61800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.55,"runSeconds":0.235137422,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234969449,"realTimeFactor":0.0922107537254902,"finite":true,"samples":61200},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.625,"runSeconds":0.251275413,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251057452,"realTimeFactor":0.09572396685714286,"finite":true,"samples":63000},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.65,"runSeconds":0.232068066,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232031297,"realTimeFactor":0.08757285509433962,"finite":true,"samples":63600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.525,"runSeconds":0.167863277,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167812928,"realTimeFactor":0.06648050574257426,"finite":true,"samples":60600},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.925,"runSeconds":0.207047125,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207000424,"realTimeFactor":0.07078534188034188,"finite":true,"samples":70200},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.025,"runSeconds":0.223689421,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223650621,"realTimeFactor":0.07394691603305785,"finite":true,"samples":72600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.85,"runSeconds":0.197560482,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197524084,"realTimeFactor":0.06931946736842105,"finite":true,"samples":68400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.7,"runSeconds":0.199324591,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199289655,"realTimeFactor":0.07382392259259259,"finite":true,"samples":64800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.3,"runSeconds":0.200042989,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200010443,"realTimeFactor":0.08697521260869566,"finite":true,"samples":55200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.625,"runSeconds":0.219709949,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219608409,"realTimeFactor":0.08369902819047619,"finite":true,"samples":63000},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.825,"runSeconds":0.218016537,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217978565,"realTimeFactor":0.07717399539823008,"finite":true,"samples":67800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.05,"runSeconds":0.269840701,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.269785306,"realTimeFactor":0.08847236098360657,"finite":true,"samples":73200},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.425,"runSeconds":0.24010259,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240028302,"realTimeFactor":0.09901137731958763,"finite":true,"samples":58200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.35,"runSeconds":0.243730599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243690151,"realTimeFactor":0.10371514851063829,"finite":true,"samples":56400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.625,"runSeconds":0.202513537,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202468169,"realTimeFactor":0.0771480140952381,"finite":true,"samples":63000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.75,"runSeconds":0.219210271,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219175268,"realTimeFactor":0.07971282581818183,"finite":true,"samples":66000},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.425,"runSeconds":0.221189894,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221157215,"realTimeFactor":0.09121232742268041,"finite":true,"samples":58200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.25,"runSeconds":0.232321318,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232266028,"realTimeFactor":0.1032539191111111,"finite":true,"samples":54000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.85,"runSeconds":0.260362801,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.260317318,"realTimeFactor":0.09135536877192982,"finite":true,"samples":68400},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.625,"runSeconds":0.192415364,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192362309,"realTimeFactor":0.07330109104761905,"finite":true,"samples":63000},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.7,"runSeconds":0.200811384,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200772807,"realTimeFactor":0.07437458666666666,"finite":true,"samples":64800},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.525,"runSeconds":0.217502225,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217437906,"realTimeFactor":0.08613949504950495,"finite":true,"samples":60600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.075,"runSeconds":0.17806602,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178009528,"realTimeFactor":0.08581494939759035,"finite":true,"samples":49800},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.75,"runSeconds":0.269389244,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.269310592,"realTimeFactor":0.0979597250909091,"finite":true,"samples":66000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.208175648,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208108405,"realTimeFactor":0.07710209185185184,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.5,"runSeconds":0.309686534,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.309651377,"realTimeFactor":0.1238746136,"finite":true,"samples":60000},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.625,"runSeconds":0.27433118,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.274266996,"realTimeFactor":0.10450711619047619,"finite":true,"samples":63000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.55,"runSeconds":0.229649215,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229598479,"realTimeFactor":0.09005851568627452,"finite":true,"samples":61200},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.375,"runSeconds":0.215854599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215770238,"realTimeFactor":0.09088614694736842,"finite":true,"samples":57000},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.725,"runSeconds":0.24057374,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240535609,"realTimeFactor":0.08828394128440367,"finite":true,"samples":65400},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.425,"runSeconds":0.328148797,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.32810603,"realTimeFactor":0.13531909154639177,"finite":true,"samples":58200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.575,"runSeconds":0.197756669,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197711036,"realTimeFactor":0.07679870640776698,"finite":true,"samples":61800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.525,"runSeconds":0.202540158,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202493417,"realTimeFactor":0.08021392396039605,"finite":true,"samples":60600}]}