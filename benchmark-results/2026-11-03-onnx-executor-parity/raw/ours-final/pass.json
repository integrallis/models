{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {onnxOpset=17, onnxOperators=56, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxDynamicNodes=1311, backend=pure-java, onnxNodes=2535, graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"af_heart","voiceIndex":0,"corpus":"harvard-200","pass":1,"noiseSeed":"model default","java":"25.0.3","machine":"Mac OS X 26.6.2 x86_64 12 cpus","sentences":50,"totalAudioSeconds":131.67499999999998,"totalRunSeconds":9.047924258,"realTimeMultiple":14.553061701812489,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.7,"runSeconds":0.408106223,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.408023111,"realTimeFactor":0.15115045296296295,"finite":true,"samples":64800},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.7,"runSeconds":0.30855751,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.308365247,"realTimeFactor":0.11428055925925924,"finite":true,"samples":64800},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.5,"runSeconds":0.25379351,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253614505,"realTimeFactor":0.101517404,"finite":true,"samples":60000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.9,"runSeconds":0.336754058,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.336697465,"realTimeFactor":0.11612208896551725,"finite":true,"samples":69600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.8,"runSeconds":0.176228424,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176176308,"realTimeFactor":0.06293872285714286,"finite":true,"samples":67200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.575,"runSeconds":0.202031449,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201874349,"realTimeFactor":0.07845881514563106,"finite":true,"samples":61800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.198455462,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198420315,"realTimeFactor":0.07350202296296296,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.85,"runSeconds":0.198435838,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198395701,"realTimeFactor":0.0696266098245614,"finite":true,"samples":68400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.55,"runSeconds":0.248445683,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248295812,"realTimeFactor":0.09742967960784314,"finite":true,"samples":61200},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.05,"runSeconds":0.25536941,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.255318042,"realTimeFactor":0.08372767540983608,"finite":true,"samples":73200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.4,"runSeconds":0.143067926,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143036387,"realTimeFactor":0.05961163583333334,"finite":true,"samples":57600},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.625,"runSeconds":0.152270775,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152239002,"realTimeFactor":0.058007914285714286,"finite":true,"samples":63000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.1,"runSeconds":0.21349962,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213461544,"realTimeFactor":0.06887084516129031,"finite":true,"samples":74400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.575,"runSeconds":0.153511635,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153457398,"realTimeFactor":0.05961616893203883,"finite":true,"samples":61800},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.425,"runSeconds":0.142275727,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142244825,"realTimeFactor":0.05867040288659794,"finite":true,"samples":58200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.219703256,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219652507,"realTimeFactor":0.08290688905660377,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.575,"runSeconds":0.150653277,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150616489,"realTimeFactor":0.05850612699029126,"finite":true,"samples":61800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.55,"runSeconds":0.148099142,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148055493,"realTimeFactor":0.05807809490196079,"finite":true,"samples":61200},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.625,"runSeconds":0.154443455,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154408305,"realTimeFactor":0.058835601904761906,"finite":true,"samples":63000},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.65,"runSeconds":0.193721609,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193686311,"realTimeFactor":0.07310249396226415,"finite":true,"samples":63600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.525,"runSeconds":0.152222767,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152184622,"realTimeFactor":0.06028624435643565,"finite":true,"samples":60600},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.925,"runSeconds":0.167469539,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167433072,"realTimeFactor":0.05725454324786325,"finite":true,"samples":70200},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.025,"runSeconds":0.170712089,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17066078,"realTimeFactor":0.05643374842975207,"finite":true,"samples":72600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.85,"runSeconds":0.185975093,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18589766,"realTimeFactor":0.06525441859649123,"finite":true,"samples":68400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.7,"runSeconds":0.200099827,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200020441,"realTimeFactor":0.07411104703703704,"finite":true,"samples":64800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.3,"runSeconds":0.143029253,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142991931,"realTimeFactor":0.06218663173913044,"finite":true,"samples":55200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.625,"runSeconds":0.156172559,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156140166,"realTimeFactor":0.059494308190476186,"finite":true,"samples":63000},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.825,"runSeconds":0.182887949,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182850333,"realTimeFactor":0.06473909699115044,"finite":true,"samples":67800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.05,"runSeconds":0.177539835,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1774667,"realTimeFactor":0.05820978196721312,"finite":true,"samples":73200},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.425,"runSeconds":0.163585938,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163548679,"realTimeFactor":0.0674581187628866,"finite":true,"samples":58200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.35,"runSeconds":0.153153412,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153108838,"realTimeFactor":0.06517166468085106,"finite":true,"samples":56400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.625,"runSeconds":0.167027499,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166993612,"realTimeFactor":0.06362952342857142,"finite":true,"samples":63000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.75,"runSeconds":0.157176984,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157141379,"realTimeFactor":0.0571552669090909,"finite":true,"samples":66000},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.425,"runSeconds":0.150984217,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150946937,"realTimeFactor":0.06226153278350516,"finite":true,"samples":58200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.25,"runSeconds":0.136494534,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136464764,"realTimeFactor":0.060664237333333336,"finite":true,"samples":54000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.85,"runSeconds":0.170736979,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170697823,"realTimeFactor":0.05990771192982456,"finite":true,"samples":68400},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.625,"runSeconds":0.161498639,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161459993,"realTimeFactor":0.06152329104761905,"finite":true,"samples":63000},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.7,"runSeconds":0.173894951,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173841576,"realTimeFactor":0.0644055374074074,"finite":true,"samples":64800},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.525,"runSeconds":0.163131472,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16309542,"realTimeFactor":0.06460652356435644,"finite":true,"samples":60600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.075,"runSeconds":0.117100597,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.117069594,"realTimeFactor":0.056434022650602406,"finite":true,"samples":49800},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.75,"runSeconds":0.15567002,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155635182,"realTimeFactor":0.056607279999999996,"finite":true,"samples":66000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.170005315,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169964954,"realTimeFactor":0.06296493148148147,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.5,"runSeconds":0.147468466,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147425434,"realTimeFactor":0.058987386399999994,"finite":true,"samples":60000},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.625,"runSeconds":0.152814198,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152779546,"realTimeFactor":0.058214932571428575,"finite":true,"samples":63000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.55,"runSeconds":0.152875944,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152841811,"realTimeFactor":0.0599513505882353,"finite":true,"samples":61200},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.375,"runSeconds":0.164775365,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164732896,"realTimeFactor":0.06937910105263158,"finite":true,"samples":57000},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.725,"runSeconds":0.15718104,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15714681,"realTimeFactor":0.05768111559633027,"finite":true,"samples":65400},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.425,"runSeconds":0.13891447,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138883412,"realTimeFactor":0.057284317525773204,"finite":true,"samples":58200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.575,"runSeconds":0.147077556,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147040967,"realTimeFactor":0.05711749747572815,"finite":true,"samples":61800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.525,"runSeconds":0.152823762,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152792152,"realTimeFactor":0.060524262178217825,"finite":true,"samples":60600}]}