{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {voices=af_heart,bf_isabella,am_puck,bm_fable, onnxDynamicNodes=1311, backend=pure-java, onnxNodes=2535, graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnxOpset=17, onnxOperators=56} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"af_heart","voiceIndex":0,"corpus":"harvard-200","pass":1,"noiseSeed":"model default","java":"25.0.3","machine":"Mac OS X 26.6.2 x86_64 12 cpus","sentences":50,"totalAudioSeconds":131.67499999999998,"totalRunSeconds":14.149182765000003,"realTimeMultiple":9.306191190470495,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.7,"runSeconds":0.516609212,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.516277613,"realTimeFactor":0.19133674518518518,"finite":true,"samples":64800},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.7,"runSeconds":0.352142083,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.351982489,"realTimeFactor":0.1304229937037037,"finite":true,"samples":64800},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.5,"runSeconds":0.327256468,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.327221933,"realTimeFactor":0.1309025872,"finite":true,"samples":60000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.9,"runSeconds":0.377163944,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.376926701,"realTimeFactor":0.13005653241379309,"finite":true,"samples":69600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.8,"runSeconds":0.357007398,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.356807541,"realTimeFactor":0.12750264214285714,"finite":true,"samples":67200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.575,"runSeconds":0.327624974,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.327401258,"realTimeFactor":0.1272329996116505,"finite":true,"samples":61800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.298202255,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2981513,"realTimeFactor":0.11044527962962963,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.85,"runSeconds":0.268484782,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.268440651,"realTimeFactor":0.09420518666666666,"finite":true,"samples":68400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.55,"runSeconds":0.242571683,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242538443,"realTimeFactor":0.09512615019607844,"finite":true,"samples":61200},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.05,"runSeconds":0.354868849,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.354831589,"realTimeFactor":0.11635044229508197,"finite":true,"samples":73200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.4,"runSeconds":0.225012327,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224977153,"realTimeFactor":0.09375513625000001,"finite":true,"samples":57600},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.625,"runSeconds":0.233497823,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233464053,"realTimeFactor":0.08895155161904762,"finite":true,"samples":63000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.1,"runSeconds":0.302278405,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.302242888,"realTimeFactor":0.0975091629032258,"finite":true,"samples":74400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.575,"runSeconds":0.226212748,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226179785,"realTimeFactor":0.0878496108737864,"finite":true,"samples":61800},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.425,"runSeconds":0.2178797,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217848554,"realTimeFactor":0.08984729896907218,"finite":true,"samples":58200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.246141007,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246106299,"realTimeFactor":0.09288339886792453,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.575,"runSeconds":0.227466536,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22742777,"realTimeFactor":0.08833651883495144,"finite":true,"samples":61800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.55,"runSeconds":0.22234473,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222311474,"realTimeFactor":0.08719401176470588,"finite":true,"samples":61200},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.625,"runSeconds":0.255609278,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.255572007,"realTimeFactor":0.09737496304761904,"finite":true,"samples":63000},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.65,"runSeconds":0.245367767,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24533271,"realTimeFactor":0.09259161018867924,"finite":true,"samples":63600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.525,"runSeconds":0.256380112,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.256340064,"realTimeFactor":0.10153667801980198,"finite":true,"samples":60600},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.925,"runSeconds":0.304640392,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.304594054,"realTimeFactor":0.10415056136752136,"finite":true,"samples":70200},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.025,"runSeconds":0.265802322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265762052,"realTimeFactor":0.0878685361983471,"finite":true,"samples":72600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.85,"runSeconds":0.260667441,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.26062003,"realTimeFactor":0.09146226,"finite":true,"samples":68400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.7,"runSeconds":0.251272255,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251233017,"realTimeFactor":0.09306379814814814,"finite":true,"samples":64800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.3,"runSeconds":0.208842068,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208811743,"realTimeFactor":0.09080089913043479,"finite":true,"samples":55200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.625,"runSeconds":0.253505507,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253466063,"realTimeFactor":0.09657352647619048,"finite":true,"samples":63000},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.825,"runSeconds":0.258540878,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.258467304,"realTimeFactor":0.09151889486725662,"finite":true,"samples":67800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.05,"runSeconds":0.289920375,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.289868395,"realTimeFactor":0.0950558606557377,"finite":true,"samples":73200},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.425,"runSeconds":0.243846271,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243806529,"realTimeFactor":0.10055516329896907,"finite":true,"samples":58200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.35,"runSeconds":0.27212797,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.272094062,"realTimeFactor":0.11579913617021276,"finite":true,"samples":56400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.625,"runSeconds":0.250817675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250784422,"realTimeFactor":0.09554959047619048,"finite":true,"samples":63000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.75,"runSeconds":0.304727883,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.304685713,"realTimeFactor":0.11081013927272726,"finite":true,"samples":66000},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.425,"runSeconds":0.311126489,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.311087506,"realTimeFactor":0.12829958309278353,"finite":true,"samples":58200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.25,"runSeconds":0.249624001,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249593919,"realTimeFactor":0.11094400044444445,"finite":true,"samples":54000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.85,"runSeconds":0.309408989,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.309356074,"realTimeFactor":0.10856455754385966,"finite":true,"samples":68400},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.625,"runSeconds":0.287134394,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.287086686,"realTimeFactor":0.10938453104761905,"finite":true,"samples":63000},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.7,"runSeconds":0.277597261,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.277555336,"realTimeFactor":0.10281380037037036,"finite":true,"samples":64800},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.525,"runSeconds":0.270212601,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.270173747,"realTimeFactor":0.10701489148514852,"finite":true,"samples":60600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.075,"runSeconds":0.199920281,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1998852,"realTimeFactor":0.09634712337349396,"finite":true,"samples":49800},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.75,"runSeconds":0.260226794,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.260192217,"realTimeFactor":0.09462792509090909,"finite":true,"samples":66000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.332283307,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.332246077,"realTimeFactor":0.12306789148148148,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.5,"runSeconds":0.273239624,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.273205859,"realTimeFactor":0.10929584960000001,"finite":true,"samples":60000},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.625,"runSeconds":0.297553554,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.297508789,"realTimeFactor":0.11335373485714285,"finite":true,"samples":63000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.55,"runSeconds":0.301606853,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.301572141,"realTimeFactor":0.11827719725490198,"finite":true,"samples":61200},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.375,"runSeconds":0.21555803,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215529141,"realTimeFactor":0.09076127578947368,"finite":true,"samples":57000},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.725,"runSeconds":0.244478704,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244436076,"realTimeFactor":0.08971695559633026,"finite":true,"samples":65400},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.425,"runSeconds":0.273336745,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.273303268,"realTimeFactor":0.11271618350515464,"finite":true,"samples":58200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.575,"runSeconds":0.376440362,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.376396181,"realTimeFactor":0.14619043184466018,"finite":true,"samples":61800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.525,"runSeconds":0.424601658,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.424559909,"realTimeFactor":0.16815907247524753,"finite":true,"samples":60600}]}