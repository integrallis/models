+fn horizontal_sum_f32_sse2(values: __m128) -> f32 {
+    let folded = _mm_add_ps(values, _mm_movehl_ps(values, values));
+    let total = _mm_add_ss(folded, _mm_shuffle_ps(folded, folded, 0b0000_0001));
