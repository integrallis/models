+/// Byte selectors that broadcast one of eight i16 scales across all sixteen lanes (ggml's
+/// `get_scale_shuffle_k4`, MIT, ggml-org/ggml), as a const table.
+static QK_SCALE_SHUFFLE: [u8; 256] = {
+    let mut table = [0_u8; 256];
+    let mut group = 0;
+    while group < 8 {
+        let mut lane = 0;
+        while lane < 16 {
+            table[group * 32 + lane * 2] = (group * 2) as u8;
+            table[group * 32 + lane * 2 + 1] = (group * 2 + 1) as u8;
+            lane += 1;
+        }
+        group += 1;
+    }
+    table
+};
+
+#[cfg(target_arch = "x86_64")]
+#[inline]
+#[target_feature(enable = "avx2")]
+/// Duplicates the eight packed i16 scales into both 128-bit halves for `qk_broadcast_scale`.
+fn qk_scale_broadcast_source(mins_and_scales: __m256i) -> __m256i {
+    let low = _mm256_extracti128_si256(mins_and_scales, 0);
+    _mm256_set_m128i(low, low)
+}
