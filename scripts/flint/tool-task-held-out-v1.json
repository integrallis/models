{
  "schemaVersion": 1,
  "kind": "flint-tool-task-diagnostic-held-out",
  "purpose": "Frozen before first inference; diagnostic follow-up to the legacy fourteen-case suite, not a broad tool-use qualification. Expected calls are used only for scoring.",
  "cases": [
    {
      "case": {
        "id": "exact-spoken-text",
        "label": "exact-spoken-text",
        "tools": [
          {
            "name": "speak",
            "description": "Say something out loud through the device speakers.",
            "parameters": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        ],
        "query": "Say exactly \"MiXeD: 007!\". Do not change the text.",
        "expectedCalls": [
          {
            "name": "speak",
            "arguments": {
              "text": "MiXeD: 007!"
            }
          }
        ]
      }
    },
    {
      "case": {
        "id": "full-door-name",
        "label": "full-door-name",
        "tools": [
          {
            "name": "lock_door",
            "description": "Lock a door.",
            "parameters": {
              "type": "object",
              "properties": {
                "door": {
                  "type": "string",
                  "description": "Which door."
                }
              },
              "required": [
                "door"
              ]
            }
          }
        ],
        "query": "Lock the side entrance door.",
        "expectedCalls": [
          {
            "name": "lock_door",
            "arguments": {
              "door": "side entrance door"
            }
          }
        ]
      }
    },
    {
      "case": {
        "id": "ordered-robot",
        "label": "ordered-robot",
        "tools": [
          {
            "name": "move",
            "description": "Drive the robot in a direction.",
            "parameters": {
              "type": "object",
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "forward",
                    "backward",
                    "left",
                    "right"
                  ]
                },
                "distance_m": {
                  "type": "number",
                  "description": "Distance in meters."
                }
              },
              "required": [
                "direction",
                "distance_m"
              ]
            }
          },
          {
            "name": "rotate",
            "description": "Rotate the robot in place.",
            "parameters": {
              "type": "object",
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "degrees": {
                  "type": "number"
                }
              },
              "required": [
                "direction",
                "degrees"
              ]
            }
          },
          {
            "name": "gripper",
            "description": "Open or close the gripper.",
            "parameters": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "open",
                    "close"
                  ]
                }
              },
              "required": [
                "action"
              ]
            }
          }
        ],
        "query": "Move backward 1.5 meters, rotate right 45 degrees, then open the gripper.",
        "expectedCalls": [
          {
            "name": "move",
            "arguments": {
              "direction": "backward",
              "distance_m": 1.5
            }
          },
          {
            "name": "rotate",
            "arguments": {
              "direction": "right",
              "degrees": 45
            }
          },
          {
            "name": "gripper",
            "arguments": {
              "action": "open"
            }
          }
        ]
      }
    },
    {
      "case": {
        "id": "ordered-album",
        "label": "ordered-album",
        "tools": [
          {
            "name": "create_album",
            "description": "Create a new photo album.",
            "parameters": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          {
            "name": "move_photos",
            "description": "Move photos into an album.",
            "parameters": {
              "type": "object",
              "properties": {
                "album": {
                  "type": "string"
                },
                "filter": {
                  "type": "string",
                  "description": "Which photos, e.g. 'last weekend', 'screenshots'."
                }
              },
              "required": [
                "album",
                "filter"
              ]
            }
          },
          {
            "name": "delete_photos",
            "description": "Delete photos.",
            "parameters": {
              "type": "object",
              "properties": {
                "filter": {
                  "type": "string"
                }
              },
              "required": [
                "filter"
              ]
            }
          }
        ],
        "query": "Create an album named Trip Notes and move screenshots into it.",
        "expectedCalls": [
          {
            "name": "create_album",
            "arguments": {
              "name": "Trip Notes"
            }
          },
          {
            "name": "move_photos",
            "arguments": {
              "album": "Trip Notes",
              "filter": "screenshots"
            }
          }
        ]
      }
    },
    {
      "case": {
        "id": "explicit-flight-date",
        "label": "explicit-flight-date",
        "tools": [
          {
            "name": "search_flights",
            "description": "Search for flights.",
            "parameters": {
              "type": "object",
              "properties": {
                "from_city": {
                  "type": "string"
                },
                "to_city": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "direct_only": {
                  "type": "boolean",
                  "description": "Only non-stop flights."
                },
                "passengers": {
                  "type": "integer"
                }
              },
              "required": [
                "from_city",
                "to_city"
              ]
            }
          }
        ],
        "query": "Find non-stop flights from Oslo to Lisbon on January 9, 2030 for three passengers.",
        "expectedCalls": [
          {
            "name": "search_flights",
            "arguments": {
              "from_city": "Oslo",
              "to_city": "Lisbon",
              "date": "2030-01-09",
              "direct_only": true,
              "passengers": 3
            }
          }
        ]
      }
    },
    {
      "case": {
        "id": "missing-flight-year",
        "label": "missing-flight-year",
        "tools": [
          {
            "name": "search_flights",
            "description": "Search for flights.",
            "parameters": {
              "type": "object",
              "properties": {
                "from_city": {
                  "type": "string"
                },
                "to_city": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "direct_only": {
                  "type": "boolean",
                  "description": "Only non-stop flights."
                },
                "passengers": {
                  "type": "integer"
                }
              },
              "required": [
                "from_city",
                "to_city"
              ]
            }
          }
        ],
        "query": "Find flights from Oslo to Lisbon on January 9. Ask me which year before searching.",
        "expectedCalls": []
      },
      "manualReviewRequired": "Visible answer must ask for the missing year; no search may run."
    },
    {
      "case": {
        "id": "unicode-items",
        "label": "unicode-items",
        "tools": [
          {
            "name": "add_to_list",
            "description": "Add one item to the shopping list.",
            "parameters": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                }
              },
              "required": [
                "item"
              ]
            }
          }
        ],
        "query": "Add 2 café and 3 crème to the shopping list. Preserve these item names exactly.",
        "expectedCalls": [
          {
            "name": "add_to_list",
            "arguments": {
              "item": "café",
              "quantity": 2
            }
          },
          {
            "name": "add_to_list",
            "arguments": {
              "item": "crème",
              "quantity": 3
            }
          }
        ]
      }
    },
    {
      "case": {
        "id": "array-items",
        "label": "array-items",
        "tools": [
          {
            "name": "add_items",
            "description": "Add items to the shopping list.",
            "parameters": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "items"
              ]
            }
          }
        ],
        "query": "Add rice, tea, and pears to the shopping list.",
        "expectedCalls": [
          {
            "name": "add_items",
            "arguments": {
              "items": [
                "rice",
                "tea",
                "pears"
              ]
            }
          }
        ]
      }
    },
    {
      "case": {
        "id": "lights-without-invented-brightness",
        "label": "lights-without-invented-brightness",
        "tools": [
          {
            "name": "set_lights",
            "description": "Turn lights on or off or dim them.",
            "parameters": {
              "type": "object",
              "properties": {
                "room": {
                  "type": "string",
                  "description": "Which room."
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "on",
                    "off"
                  ]
                },
                "brightness": {
                  "type": "integer",
                  "description": "Percent 1-100."
                }
              },
              "required": [
                "room",
                "state"
              ]
            }
          }
        ],
        "query": "Turn the study lights off.",
        "expectedCalls": [
          {
            "name": "set_lights",
            "arguments": {
              "room": "study",
              "state": "off"
            }
          }
        ]
      }
    },
