{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnxOpset=17, onnxOperators=56, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxDynamicNodes=1311, backend=pure-java, onnxNodes=2535} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"am_puck","voiceIndex":2,"corpus":"harvard-200","pass":1,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":502.60000000000014,"totalRunSeconds":29.00209913099999,"realTimeMultiple":17.329780086944712,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.625,"runSeconds":0.33569477,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.335577399,"realTimeFactor":0.12788372190476188,"finite":true,"samples":63000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.675,"runSeconds":0.216716859,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216587608,"realTimeFactor":0.08101564822429907,"finite":true,"samples":64200},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.4,"runSeconds":0.205701383,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205590072,"realTimeFactor":0.08570890958333333,"finite":true,"samples":57600},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.675,"runSeconds":0.149000702,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148980562,"realTimeFactor":0.0557011970093458,"finite":true,"samples":64200},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.6,"runSeconds":0.149183103,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149149583,"realTimeFactor":0.05737811653846154,"finite":true,"samples":62400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.45,"runSeconds":0.200114624,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200015393,"realTimeFactor":0.08167943836734692,"finite":true,"samples":58800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.164894409,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164871049,"realTimeFactor":0.061072003333333326,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.725,"runSeconds":0.157701397,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157672966,"realTimeFactor":0.05787207229357798,"finite":true,"samples":65400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.475,"runSeconds":0.146854963,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146836363,"realTimeFactor":0.059335338585858585,"finite":true,"samples":59400},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":2.85,"runSeconds":0.154402968,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154383018,"realTimeFactor":0.05417648,"finite":true,"samples":68400},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.225,"runSeconds":0.124974923,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.124956743,"realTimeFactor":0.05616850471910112,"finite":true,"samples":53400},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.5,"runSeconds":0.150016901,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149999081,"realTimeFactor":0.060006760400000005,"finite":true,"samples":60000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.025,"runSeconds":0.174964277,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174942696,"realTimeFactor":0.05783943041322314,"finite":true,"samples":72600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.4,"runSeconds":0.137074839,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137048299,"realTimeFactor":0.057114516250000004,"finite":true,"samples":57600},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.35,"runSeconds":0.133550028,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133531598,"realTimeFactor":0.05682979914893616,"finite":true,"samples":56400},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.152054859,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152035518,"realTimeFactor":0.057379192075471694,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.4,"runSeconds":0.134345774,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134329014,"realTimeFactor":0.055977405833333334,"finite":true,"samples":57600},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.45,"runSeconds":0.138166608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138149088,"realTimeFactor":0.056394533877551015,"finite":true,"samples":58800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.525,"runSeconds":0.141996591,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1419775,"realTimeFactor":0.05623627366336634,"finite":true,"samples":60600},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.6,"runSeconds":0.151991978,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151970207,"realTimeFactor":0.05845845307692307,"finite":true,"samples":62400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.45,"runSeconds":0.140036464,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140009644,"realTimeFactor":0.05715774040816326,"finite":true,"samples":58800},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.725,"runSeconds":0.153109227,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153089667,"realTimeFactor":0.05618687229357797,"finite":true,"samples":65400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":2.8,"runSeconds":0.156244075,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156222565,"realTimeFactor":0.055801455357142864,"finite":true,"samples":67200},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.725,"runSeconds":0.152111019,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152090899,"realTimeFactor":0.05582055743119265,"finite":true,"samples":65400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.575,"runSeconds":0.142654587,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142634017,"realTimeFactor":0.05539983961165048,"finite":true,"samples":61800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.25,"runSeconds":0.126362815,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.126345075,"realTimeFactor":0.05616125111111111,"finite":true,"samples":54000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.525,"runSeconds":0.141685738,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141666958,"realTimeFactor":0.05611316356435644,"finite":true,"samples":60600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.625,"runSeconds":0.155496858,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155475347,"realTimeFactor":0.05923689828571428,"finite":true,"samples":63000},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":2.725,"runSeconds":0.154132327,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154104486,"realTimeFactor":0.056562321834862386,"finite":true,"samples":65400},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.175,"runSeconds":0.124122606,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.124107026,"realTimeFactor":0.05706786482758621,"finite":true,"samples":52200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.225,"runSeconds":0.125673489,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125656429,"realTimeFactor":0.05648246696629213,"finite":true,"samples":53400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.5,"runSeconds":0.139909223,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139890373,"realTimeFactor":0.0559636892,"finite":true,"samples":60000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.6,"runSeconds":0.143627555,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143607955,"realTimeFactor":0.0552413673076923,"finite":true,"samples":62400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.3,"runSeconds":0.128831227,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128812337,"realTimeFactor":0.05601357695652174,"finite":true,"samples":55200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.125,"runSeconds":0.120769617,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.120754067,"realTimeFactor":0.056832760941176466,"finite":true,"samples":51000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.775,"runSeconds":0.160575342,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160552982,"realTimeFactor":0.05786498810810811,"finite":true,"samples":66600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.425,"runSeconds":0.136970157,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136943147,"realTimeFactor":0.056482538969072175,"finite":true,"samples":58200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.675,"runSeconds":0.146745362,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146725142,"realTimeFactor":0.05485807925233645,"finite":true,"samples":64200},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.425,"runSeconds":0.136252881,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136234421,"realTimeFactor":0.05618675505154639,"finite":true,"samples":58200},{"index":39,"text":"What joy there is in living.","audioSeconds":1.925,"runSeconds":0.124660791,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.124645451,"realTimeFactor":0.06475885246753246,"finite":true,"samples":46200},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.625,"runSeconds":0.145460671,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145441351,"realTimeFactor":0.05541358895238096,"finite":true,"samples":63000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.14074641,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14072634,"realTimeFactor":0.052128299999999995,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.475,"runSeconds":0.138715452,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138696602,"realTimeFactor":0.05604664727272727,"finite":true,"samples":59400},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.55,"runSeconds":0.141256474,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141235324,"realTimeFactor":0.05539469568627451,"finite":true,"samples":61200},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.475,"runSeconds":0.144832775,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144811115,"realTimeFactor":0.05851829292929293,"finite":true,"samples":59400},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.3,"runSeconds":0.133761409,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133734729,"realTimeFactor":0.058157134347826094,"finite":true,"samples":55200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.7,"runSeconds":0.150607045,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150587085,"realTimeFactor":0.055780387037037034,"finite":true,"samples":64800},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.3,"runSeconds":0.130465382,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130443781,"realTimeFactor":0.056724079130434785,"finite":true,"samples":55200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.45,"runSeconds":0.174500723,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174482923,"realTimeFactor":0.07122478489795918,"finite":true,"samples":58800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.45,"runSeconds":0.130869675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130850634,"realTimeFactor":0.05341619387755101,"finite":true,"samples":58800},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.3,"runSeconds":0.128611205,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128593075,"realTimeFactor":0.05591791521739131,"finite":true,"samples":55200},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.525,"runSeconds":0.139818092,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139797932,"realTimeFactor":0.055373501782178224,"finite":true,"samples":60600},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.25,"runSeconds":0.125056814,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125039334,"realTimeFactor":0.055580806222222216,"finite":true,"samples":54000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.525,"runSeconds":0.14759861,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14757688,"realTimeFactor":0.05845489504950495,"finite":true,"samples":60600},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.65,"runSeconds":0.148453987,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148426187,"realTimeFactor":0.056020372452830196,"finite":true,"samples":63600},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.45,"runSeconds":0.136953797,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136933807,"realTimeFactor":0.055899508979591825,"finite":true,"samples":58800},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.55,"runSeconds":0.142554896,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142535486,"realTimeFactor":0.05590388078431372,"finite":true,"samples":61200},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.3,"runSeconds":0.130759974,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130742544,"realTimeFactor":0.056852162608695654,"finite":true,"samples":55200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.5,"runSeconds":0.140084414,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140064824,"realTimeFactor":0.05603376559999999,"finite":true,"samples":60000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.725,"runSeconds":0.149829749,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149810058,"realTimeFactor":0.05498339412844037,"finite":true,"samples":65400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.55,"runSeconds":0.152214669,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152194629,"realTimeFactor":0.05969202705882353,"finite":true,"samples":61200},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.675,"runSeconds":0.151398052,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151373252,"realTimeFactor":0.05659740261682244,"finite":true,"samples":64200},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.65,"runSeconds":0.149819089,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149790488,"realTimeFactor":0.056535505283018865,"finite":true,"samples":63600},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.55,"runSeconds":0.144000119,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143979429,"realTimeFactor":0.05647063490196079,"finite":true,"samples":61200},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.375,"runSeconds":0.13147665,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131458519,"realTimeFactor":0.05535858947368421,"finite":true,"samples":57000},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.75,"runSeconds":0.153599972,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153578722,"realTimeFactor":0.055854535272727275,"finite":true,"samples":66000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.675,"runSeconds":0.149556027,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149535746,"realTimeFactor":0.05590879514018692,"finite":true,"samples":64200},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.8,"runSeconds":0.156278035,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156256725,"realTimeFactor":0.055813583928571435,"finite":true,"samples":67200},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.425,"runSeconds":0.135873217,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135854627,"realTimeFactor":0.05603019257731959,"finite":true,"samples":58200},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":2.875,"runSeconds":0.164174803,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164148713,"realTimeFactor":0.057104279304347826,"finite":true,"samples":69000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.65,"runSeconds":0.150567485,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150537795,"realTimeFactor":0.05681791886792453,"finite":true,"samples":63600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.3,"runSeconds":0.130191359,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130173509,"realTimeFactor":0.05660493869565218,"finite":true,"samples":55200},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.625,"runSeconds":0.155444238,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155423108,"realTimeFactor":0.05921685257142858,"finite":true,"samples":63000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.425,"runSeconds":0.135827837,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135807947,"realTimeFactor":0.05601147917525774,"finite":true,"samples":58200},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.375,"runSeconds":0.132366688,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.132347148,"realTimeFactor":0.055733342315789476,"finite":true,"samples":57000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.2,"runSeconds":0.119290665,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.119273735,"realTimeFactor":0.05422302954545454,"finite":true,"samples":52800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.575,"runSeconds":0.152672733,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152650953,"realTimeFactor":0.05929038174757281,"finite":true,"samples":61800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":2.85,"runSeconds":0.16024561,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160216319,"realTimeFactor":0.0562265298245614,"finite":true,"samples":68400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.75,"runSeconds":0.151647225,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151627054,"realTimeFactor":0.05514444545454545,"finite":true,"samples":66000},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.625,"runSeconds":0.148581638,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148560268,"realTimeFactor":0.05660252876190476,"finite":true,"samples":63000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.625,"runSeconds":0.144419222,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144397202,"realTimeFactor":0.055016846476190484,"finite":true,"samples":63000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.525,"runSeconds":0.139643831,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139623231,"realTimeFactor":0.05530448752475248,"finite":true,"samples":60600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.3,"runSeconds":0.137121839,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137102089,"realTimeFactor":0.05961819086956522,"finite":true,"samples":55200},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.575,"runSeconds":0.145136268,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145109638,"realTimeFactor":0.056363599223300975,"finite":true,"samples":61800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.25,"runSeconds":0.127553556,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127522336,"realTimeFactor":0.05669046933333334,"finite":true,"samples":54000},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.55,"runSeconds":0.141376446,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141354606,"realTimeFactor":0.055441743529411766,"finite":true,"samples":61200},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.125,"runSeconds":0.119810689,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.119791079,"realTimeFactor":0.056381500705882354,"finite":true,"samples":51000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.4,"runSeconds":0.134439066,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134418316,"realTimeFactor":0.0560162775,"finite":true,"samples":57600},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.35,"runSeconds":0.129814536,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129793936,"realTimeFactor":0.05524022808510638,"finite":true,"samples":56400},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.55,"runSeconds":0.141519567,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141497337,"realTimeFactor":0.05549786941176472,"finite":true,"samples":61200},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.325,"runSeconds":0.12912989,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.12911054,"realTimeFactor":0.055539737634408594,"finite":true,"samples":55800},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.4,"runSeconds":0.171009943,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170988682,"realTimeFactor":0.07125414291666667,"finite":true,"samples":57600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSe