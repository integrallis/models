":0.058391190927835054,"finite":true,"samples":58200},{"index":145,"text":"Pure bred poodles have curls.","audioSeconds":2.2,"runSeconds":0.1245417,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.124511109,"realTimeFactor":0.05660986363636363,"finite":true,"samples":52800},{"index":146,"text":"The tree top waved in a graceful way.","audioSeconds":2.6,"runSeconds":0.152907785,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152886935,"realTimeFactor":0.05881068653846153,"finite":true,"samples":62400},{"index":147,"text":"The spot on the blotter was made by green ink.","audioSeconds":2.925,"runSeconds":0.162946213,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162915113,"realTimeFactor":0.05570810700854702,"finite":true,"samples":70200},{"index":148,"text":"Mud was spattered on the front of his white shirt.","audioSeconds":2.875,"runSeconds":0.170863061,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170825131,"realTimeFactor":0.05943062991304348,"finite":true,"samples":69000},{"index":149,"text":"The cigar burned a hole in the desk top.","audioSeconds":2.625,"runSeconds":0.14764858,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14761536,"realTimeFactor":0.056247078095238094,"finite":true,"samples":63000},{"index":150,"text":"The empty flask stood on the tin tray.","audioSeconds":2.6,"runSeconds":0.149765919,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149742289,"realTimeFactor":0.05760227653846153,"finite":true,"samples":62400},{"index":151,"text":"A speedy man can beat this track mark.","audioSeconds":2.65,"runSeconds":0.146011486,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145990546,"realTimeFactor":0.05509867396226415,"finite":true,"samples":63600},{"index":152,"text":"He broke a new shoelace that day.","audioSeconds":2.25,"runSeconds":0.13376649,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133740369,"realTimeFactor":0.059451773333333326,"finite":true,"samples":54000},{"index":153,"text":"The coffee stand is too high for the couch.","audioSeconds":2.75,"runSeconds":0.152134639,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152100479,"realTimeFactor":0.0553216869090909,"finite":true,"samples":66000},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":2.6,"runSeconds":0.148718989,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148697099,"realTimeFactor":0.05719961115384615,"finite":true,"samples":62400},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.075,"runSeconds":0.115376561,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.11535648,"realTimeFactor":0.05560316192771084,"finite":true,"samples":49800},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":2.575,"runSeconds":0.143727727,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143706447,"realTimeFactor":0.05581659300970873,"finite":true,"samples":61800},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":2.55,"runSeconds":0.145767494,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145739214,"realTimeFactor":0.0571637231372549,"finite":true,"samples":61200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.375,"runSeconds":0.134545086,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134511926,"realTimeFactor":0.05665056252631579,"finite":true,"samples":57000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":2.875,"runSeconds":0.163454627,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163431727,"realTimeFactor":0.05685378330434782,"finite":true,"samples":69000},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":2.7,"runSeconds":0.149783219,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149755998,"realTimeFactor":0.05547526629629629,"finite":true,"samples":64800},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.4,"runSeconds":0.133081864,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133061684,"realTimeFactor":0.05545077666666667,"finite":true,"samples":57600},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.35,"runSeconds":0.138718193,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138691992,"realTimeFactor":0.059029018297872334,"finite":true,"samples":56400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.525,"runSeconds":0.141033593,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140998833,"realTimeFactor":0.05585488831683169,"finite":true,"samples":60600},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.425,"runSeconds":0.146128417,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146109167,"realTimeFactor":0.060259141030927846,"finite":true,"samples":58200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.65,"runSeconds":0.146685842,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146663112,"realTimeFactor":0.055353147924528306,"finite":true,"samples":63600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.625,"runSeconds":0.150787598,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150765578,"realTimeFactor":0.05744289447619048,"finite":true,"samples":63000},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.65,"runSeconds":0.151132921,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15110413,"realTimeFactor":0.05703129094339623,"finite":true,"samples":63600},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.325,"runSeconds":0.137819945,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137789515,"realTimeFactor":0.05927739569892473,"finite":true,"samples":55800},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.675,"runSeconds":0.148613778,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148590338,"realTimeFactor":0.05555655252336449,"finite":true,"samples":64200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.25,"runSeconds":0.126828599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.126809159,"realTimeFactor":0.05636826622222221,"finite":true,"samples":54000},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.5,"runSeconds":0.145680684,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145653813,"realTimeFactor":0.0582722736,"finite":true,"samples":60000},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.55,"runSeconds":0.143390404,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143358184,"realTimeFactor":0.05623153098039216,"finite":true,"samples":61200},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.775,"runSeconds":0.160751104,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160728964,"realTimeFactor":0.05792832576576577,"finite":true,"samples":66600},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.55,"runSeconds":0.140633679,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140610489,"realTimeFactor":0.05515046235294119,"finite":true,"samples":61200},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.375,"runSeconds":0.142707987,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142688107,"realTimeFactor":0.060087573473684215,"finite":true,"samples":57000},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.45,"runSeconds":0.14078385,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14075704,"realTimeFactor":0.05746279591836734,"finite":true,"samples":58800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.525,"runSeconds":0.144258761,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144225651,"realTimeFactor":0.05713218257425743,"finite":true,"samples":60600},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.725,"runSeconds":0.152474382,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152442372,"realTimeFactor":0.05595390165137614,"finite":true,"samples":65400},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.375,"runSeconds":0.133593068,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133570868,"realTimeFactor":0.05624971284210527,"finite":true,"samples":57000},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.35,"runSeconds":0.129611684,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129590944,"realTimeFactor":0.05515390808510638,"finite":true,"samples":56400},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.3,"runSeconds":0.135273893,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135248753,"realTimeFactor":0.05881473608695653,"finite":true,"samples":55200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":2.575,"runSeconds":0.144228021,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144193661,"realTimeFactor":0.056010881941747574,"finite":true,"samples":61800},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":2.95,"runSeconds":0.162389789,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162366449,"realTimeFactor":0.05504738610169491,"finite":true,"samples":70800},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.475,"runSeconds":0.142203553,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142183183,"realTimeFactor":0.057455981010101013,"finite":true,"samples":59400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.35,"runSeconds":0.130772615,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130752665,"realTimeFactor":0.05564792127659575,"finite":true,"samples":56400},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.275,"runSeconds":0.126531418,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.126511508,"realTimeFactor":0.05561820571428572,"finite":true,"samples":54600},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.325,"runSeconds":0.13942001,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139394179,"realTimeFactor":0.059965595698924734,"finite":true,"samples":55800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":2.975,"runSeconds":0.168125028,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168089498,"realTimeFactor":0.056512614453781515,"finite":true,"samples":71400},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.4,"runSeconds":0.141546729,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141526118,"realTimeFactor":0.05897780375000001,"finite":true,"samples":57600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.525,"runSeconds":0.142011192,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141988572,"realTimeFactor":0.056242056237623766,"finite":true,"samples":60600},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.775,"runSeconds":0.162309919,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162281979,"realTimeFactor":0.0584900609009009,"finite":true,"samples":66600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.075,"runSeconds":0.121135471,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.121104571,"realTimeFactor":0.058378540240963846,"finite":true,"samples":49800},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.625,"runSeconds":0.149950992,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149928702,"realTimeFactor":0.05712418742857143,"finite":true,"samples":63000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.675,"runSeconds":0.147564311,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147540931,"realTimeFactor":0.05516422841121496,"finite":true,"samples":64200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.3,"runSeconds":0.134159404,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134139913,"realTimeFactor":0.058330175652173924,"finite":true,"samples":55200},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.75,"runSeconds":0.15793709,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15790925,"realTimeFactor":0.05743166909090909,"finite":true,"samples":66000},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":2.625,"runSeconds":0.148212736,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148178196,"realTimeFactor":0.05646199466666667,"finite":true,"samples":63000},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.1,"runSeconds":0.120632036,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.120612626,"realTimeFactor":0.05744382666666666,"finite":true,"samples":50400},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":2.575,"runSeconds":0.14288888,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14286644,"realTimeFactor":0.05549082718446601,"finite":true,"samples":61800}]}