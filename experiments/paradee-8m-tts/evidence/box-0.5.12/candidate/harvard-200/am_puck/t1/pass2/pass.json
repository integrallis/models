{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {backend=pure-java, onnxNodes=2535, graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnxOpset=17, onnxOperators=56, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxDynamicNodes=1311} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"am_puck","voiceIndex":2,"corpus":"harvard-200","pass":2,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":502.60000000000014,"totalRunSeconds":29.204600794000015,"realTimeMultiple":17.209617195084466,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.625,"runSeconds":0.362331431,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.362303721,"realTimeFactor":0.13803102133333334,"finite":true,"samples":63000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.675,"runSeconds":0.210148589,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210037458,"realTimeFactor":0.07856022018691589,"finite":true,"samples":64200},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.4,"runSeconds":0.20682457,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206707899,"realTimeFactor":0.08617690416666668,"finite":true,"samples":57600},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.675,"runSeconds":0.247615277,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247594267,"realTimeFactor":0.09256645869158879,"finite":true,"samples":64200},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.6,"runSeconds":0.169770955,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168543135,"realTimeFactor":0.06529652115384615,"finite":true,"samples":62400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.45,"runSeconds":0.147305299,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147286779,"realTimeFactor":0.06012461183673469,"finite":true,"samples":58800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.151636447,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151616537,"realTimeFactor":0.056161647037037035,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.725,"runSeconds":0.159736208,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159714538,"realTimeFactor":0.0586187919266055,"finite":true,"samples":65400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.475,"runSeconds":0.14053828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14051022,"realTimeFactor":0.05678314343434343,"finite":true,"samples":59400},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":2.85,"runSeconds":0.162725834,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162704044,"realTimeFactor":0.05709678385964913,"finite":true,"samples":68400},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.225,"runSeconds":0.125436898,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125420647,"realTimeFactor":0.05637613393258426,"finite":true,"samples":53400},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.5,"runSeconds":0.150638449,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150619979,"realTimeFactor":0.060255379600000006,"finite":true,"samples":60000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.025,"runSeconds":0.174055944,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174034964,"realTimeFactor":0.057539155041322315,"finite":true,"samples":72600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.4,"runSeconds":0.135872449,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135844609,"realTimeFactor":0.056613520416666674,"finite":true,"samples":57600},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.35,"runSeconds":0.135460985,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135442415,"realTimeFactor":0.057642972340425536,"finite":true,"samples":56400},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.145684835,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145665655,"realTimeFactor":0.05497540943396227,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.4,"runSeconds":0.131782744,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131764084,"realTimeFactor":0.05490947666666667,"finite":true,"samples":57600},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.45,"runSeconds":0.144142701,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144124731,"realTimeFactor":0.05883375551020408,"finite":true,"samples":58800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.525,"runSeconds":0.145332692,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145309902,"realTimeFactor":0.05755750178217822,"finite":true,"samples":60600},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.6,"runSeconds":0.146331081,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14630113,"realTimeFactor":0.056281185,"finite":true,"samples":62400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.45,"runSeconds":0.136553285,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136531935,"realTimeFactor":0.05573603469387754,"finite":true,"samples":58800},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.725,"runSeconds":0.157141595,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157120785,"realTimeFactor":0.05766664036697247,"finite":true,"samples":65400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":2.8,"runSeconds":0.154855826,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154835586,"realTimeFactor":0.05530565214285715,"finite":true,"samples":67200},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.725,"runSeconds":0.150192125,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150172655,"realTimeFactor":0.05511637614678899,"finite":true,"samples":65400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.575,"runSeconds":0.140141987,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140121427,"realTimeFactor":0.05442407262135922,"finite":true,"samples":61800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.25,"runSeconds":0.132943633,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.132924023,"realTimeFactor":0.05908605911111112,"finite":true,"samples":54000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.525,"runSeconds":0.142131734,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142105004,"realTimeFactor":0.056289795643564365,"finite":true,"samples":60600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.625,"runSeconds":0.141777261,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141757571,"realTimeFactor":0.05401038514285714,"finite":true,"samples":63000},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":2.725,"runSeconds":0.15076093,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15074033,"realTimeFactor":0.0553251119266055,"finite":true,"samples":65400},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.175,"runSeconds":0.128921879,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128905728,"realTimeFactor":0.05927442712643678,"finite":true,"samples":52200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.225,"runSeconds":0.125817341,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125799761,"realTimeFactor":0.0565471195505618,"finite":true,"samples":53400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.5,"runSeconds":0.139127527,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139107617,"realTimeFactor":0.0556510108,"finite":true,"samples":60000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.6,"runSeconds":0.14290023,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14287986,"realTimeFactor":0.05496162692307692,"finite":true,"samples":62400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.3,"runSeconds":0.157059084,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157039554,"realTimeFactor":0.06828655826086956,"finite":true,"samples":55200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.125,"runSeconds":0.12343754,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.12341784,"realTimeFactor":0.05808825411764706,"finite":true,"samples":51000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.775,"runSeconds":0.155181028,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155152678,"realTimeFactor":0.055921091171171174,"finite":true,"samples":66600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.425,"runSeconds":0.134591118,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134572478,"realTimeFactor":0.055501491958762895,"finite":true,"samples":58200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.675,"runSeconds":0.145530154,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145509754,"realTimeFactor":0.05440379588785047,"finite":true,"samples":64200},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.425,"runSeconds":0.138590813,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138571503,"realTimeFactor":0.05715085072164949,"finite":true,"samples":58200},{"index":39,"text":"What joy there is in living.","audioSeconds":1.925,"runSeconds":0.106822935,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.106806415,"realTimeFactor":0.055492433766233765,"finite":true,"samples":46200},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.625,"runSeconds":0.144093411,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144072921,"realTimeFactor":0.054892728,"finite":true,"samples":63000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.141831781,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141811261,"realTimeFactor":0.052530289259259254,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.475,"runSeconds":0.183779728,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183760198,"realTimeFactor":0.07425443555555555,"finite":true,"samples":59400},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.55,"runSeconds":0.143858009,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143833519,"realTimeFactor":0.056414905490196086,"finite":true,"samples":61200},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.475,"runSeconds":0.138150689,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138123639,"realTimeFactor":0.0558184602020202,"finite":true,"samples":59400},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.3,"runSeconds":0.129459373,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129441803,"realTimeFactor":0.05628668391304348,"finite":true,"samples":55200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.7,"runSeconds":0.149340797,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149320397,"realTimeFactor":0.055311406296296294,"finite":true,"samples":64800},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.3,"runSeconds":0.167372415,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167350325,"realTimeFactor":0.07277061521739131,"finite":true,"samples":55200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.45,"runSeconds":0.135604917,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135585757,"realTimeFactor":0.055348945714285704,"finite":true,"samples":58800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.45,"runSeconds":0.128309993,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128292122,"realTimeFactor":0.05237142571428571,"finite":true,"samples":58800},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.3,"runSeconds":0.127093622,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127076122,"realTimeFactor":0.05525809652173913,"finite":true,"samples":55200},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.525,"runSeconds":0.138673544,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138652163,"realTimeFactor":0.05492021544554456,"finite":true,"samples":60600},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.25,"runSeconds":0.13941683,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13939649,"realTimeFactor":0.06196303555555555,"finite":true,"samples":54000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.525,"runSeconds":0.142532877,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142504297,"realTimeFactor":0.056448664158415846,"finite":true,"samples":60600},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.65,"runSeconds":0.145689445,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145669855,"realTimeFactor":0.05497714905660377,"finite":true,"samples":63600},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.45,"runSeconds":0.135027061,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135007241,"realTimeFactor":0.05511308612244898,"finite":true,"samples":58800},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.55,"runSeconds":0.186161419,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186142829,"realTimeFactor":0.07300447803921568,"finite":true,"samples":61200},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.3,"runSeconds":0.128857618,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128840248,"realTimeFactor":0.05602505130434783,"finite":true,"samples":55200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.5,"runSeconds":0.138603873,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138583552,"realTimeFactor":0.055441549199999995,"finite":true,"samples":60000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.725,"runSeconds":0.148687811,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148666601,"realTimeFactor":0.0545643343119266,"finite":true,"samples":65400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.55,"runSeconds":0.150103914,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150085444,"realTimeFactor":0.058864280000000005,"finite":true,"samples":61200},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.675,"runSeconds":0.150187375,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150163194,"realTimeFactor":0.056144813084112156,"finite":true,"samples":64200},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.65,"runSeconds":0.149110705,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149083155,"realTimeFactor":0.05626819056603774,"finite":true,"samples":63600},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.55,"runSeconds":0.143012472,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142991992,"realTimeFactor":0.05608332235294118,"finite":true,"samples":61200},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.375,"runSeconds":0.130783735,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130766675,"realTimeFactor":0.05506683578947369,"finite":true,"samples":57000},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.75,"runSeconds":0.200368544,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200347084,"realTimeFactor":0.07286128872727272,"finite":true,"samples":66000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.675,"runSeconds":0.147796384,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147775814,"realTimeFactor":0.0552509846728972,"finite":true,"samples":64200},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.8,"runSeconds":0.153887187,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153866137,"realTimeFactor":0.05495970964285715,"finite":true,"samples":67200},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.425,"runSeconds":0.13480591,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13478692,"realTimeFactor":0.055590065979381445,"finite":true,"samples":58200},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":2.875,"runSeconds":0.189053844,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189029944,"realTimeFactor":0.06575785878260869,"finite":true,"samples":69000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.65,"runSeconds":0.153942637,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153913927,"realTimeFactor":0.05809156113207547,"finite":true,"samples":63600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.3,"runSeconds":0.137518424,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137499894,"realTimeFactor":0.059790619130434784,"finite":true,"samples":55200},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.625,"runSeconds":0.144467255,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144448284,"realTimeFactor":0.055035144761904756,"finite":true,"samples":63000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.425,"runSeconds":0.135055132,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135036942,"realTimeFactor":0.055692837938144335,"finite":true,"samples":58200},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.375,"runSeconds":0.140098811,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140081141,"realTimeFactor":0.05898897305263157,"finite":true,"samples":57000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.2,"runSeconds":0.118281609,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.118264009,"realTimeFactor":0.05376436772727272,"finite":true,"samples":52800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.575,"runSeconds":0.142329509,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142307019,"realTimeFactor":0.055273595728155336,"finite":true,"samples":61800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":2.85,"runSeconds":0.156108229,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156086429,"realTimeFactor":0.05477481719298245,"finite":true,"samples":68400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.75,"runSeconds":0.210564353,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210539303,"realTimeFactor":0.07656885563636363,"finite":true,"samples":66000},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.625,"runSeconds":0.148060729,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148032379,"realTimeFactor":0.05640408723809524,"finite":true,"samples":63000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.625,"runSeconds":0.147334063,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147312723,"realTimeFactor":0.05612726209523809,"finite":true,"samples":63000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.525,"runSeconds":0.139143352,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139122561,"realTimeFactor":0.05510627801980198,"finite":true,"samples":60600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.3,"runSeconds":0.135876043,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135858322,"realTimeFactor":0.059076540434782616,"finite":true,"samples":55200},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.575,"runSeconds":0.141375041,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14135304,"realTimeFactor":0.05490292854368932,"finite":true,"samples":61800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.25,"runSeconds":0.124695006,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.124675576,"realTimeFactor":0.05542000266666666,"finite":true,"samples":54000},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.55,"runSeconds":0.140281731,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140259751,"realTimeFactor":0.055012443529411766,"finite":true,"samples":61200},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.125,"runSeconds":0.12627826,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.126193619,"realTimeFactor":0.059425063529411765,"finite":true,"samples":51000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.4,"runSeconds":0.13435971,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13432703,"realTimeFactor":0.0559832125,"finite":true,"samples":57600},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.35,"runSeconds":0.129687279,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129666729,"realTimeFactor":0.05518607617021276,"finite":true,"samples":56400},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.55,"runSeconds":0.147524214,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147501674,"realTimeFactor":0.05785263294117647,"finite":true,"samples":61200},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.325,"runSeconds":0.128553629,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128533719,"realTimeFactor":0.05529188344086021,"finite":true,"samples":55800},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.4,"runSeconds":0.131996329,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131975739,"realTimeFactor":0.05499847041666667,"finite":true,"samples":57600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":2.575,"runSeco