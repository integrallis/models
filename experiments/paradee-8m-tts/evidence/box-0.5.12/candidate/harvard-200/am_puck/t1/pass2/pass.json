tAudioSeconds":0.132847417,"realTimeFactor":0.055944402947368424,"finite":true,"samples":57000},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.35,"runSeconds":0.128564219,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128544069,"realTimeFactor":0.05470817829787234,"finite":true,"samples":56400},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.3,"runSeconds":0.126719723,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.126700173,"realTimeFactor":0.05509553173913044,"finite":true,"samples":55200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":2.575,"runSeconds":0.17916542,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17914451,"realTimeFactor":0.06957880388349513,"finite":true,"samples":61800},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":2.95,"runSeconds":0.169875319,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169846998,"realTimeFactor":0.05758485389830508,"finite":true,"samples":70800},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.475,"runSeconds":0.140724995,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140691025,"realTimeFactor":0.05685858383838383,"finite":true,"samples":59400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.35,"runSeconds":0.131750747,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131729846,"realTimeFactor":0.056064147659574466,"finite":true,"samples":56400},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.275,"runSeconds":0.125587563,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125568113,"realTimeFactor":0.0552033243956044,"finite":true,"samples":54600},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.325,"runSeconds":0.128750181,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1287297,"realTimeFactor":0.055376421935483866,"finite":true,"samples":55800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":2.975,"runSeconds":0.167144825,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167118165,"realTimeFactor":0.05618313445378151,"finite":true,"samples":71400},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.4,"runSeconds":0.133474502,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133453482,"realTimeFactor":0.055614375833333334,"finite":true,"samples":57600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.525,"runSeconds":0.142207607,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142186337,"realTimeFactor":0.05631984435643565,"finite":true,"samples":60600},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.775,"runSeconds":0.152009563,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151986913,"realTimeFactor":0.0547782209009009,"finite":true,"samples":66600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.075,"runSeconds":0.147526954,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147510104,"realTimeFactor":0.07109732722891565,"finite":true,"samples":49800},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.625,"runSeconds":0.146723646,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146694506,"realTimeFactor":0.05589472228571429,"finite":true,"samples":63000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.675,"runSeconds":0.149012376,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148978405,"realTimeFactor":0.05570556112149533,"finite":true,"samples":64200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.3,"runSeconds":0.127112535,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127092985,"realTimeFactor":0.055266319565217395,"finite":true,"samples":55200},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.75,"runSeconds":0.150925622,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150903122,"realTimeFactor":0.05488204436363637,"finite":true,"samples":66000},