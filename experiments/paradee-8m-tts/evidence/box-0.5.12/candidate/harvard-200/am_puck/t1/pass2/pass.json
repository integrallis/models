add the figures.","audioSeconds":2.35,"runSeconds":0.130739608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130719058,"realTimeFactor":0.05563387574468085,"finite":true,"samples":56400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.525,"runSeconds":0.137174194,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137151924,"realTimeFactor":0.054326413465346536,"finite":true,"samples":60600},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.425,"runSeconds":0.136459748,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136437497,"realTimeFactor":0.056272061030927835,"finite":true,"samples":58200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.65,"runSeconds":0.196217468,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196197868,"realTimeFactor":0.07404432754716982,"finite":true,"samples":63600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.625,"runSeconds":0.146538096,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146510576,"realTimeFactor":0.05582403657142857,"finite":true,"samples":63000},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.65,"runSeconds":0.147659496,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147626715,"realTimeFactor":0.05572056452830189,"finite":true,"samples":63600},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.325,"runSeconds":0.128814802,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128794171,"realTimeFactor":0.05540421591397849,"finite":true,"samples":55800},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.675,"runSeconds":0.14586717,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14584515,"realTimeFactor":0.054529783177570096,"finite":true,"samples":64200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.25,"runSeconds":0.16761915,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167600029,"realTimeFactor":0.07449739999999999,"finite":