{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {onnxOpset=17, onnxOperators=56, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxDynamicNodes=1311, backend=pure-java, onnxNodes=2535, graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"am_puck","voiceIndex":2,"corpus":"harvard-200","pass":3,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":502.60000000000014,"totalRunSeconds":29.07250700199999,"realTimeMultiple":17.287810781692293,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.625,"runSeconds":0.35703179,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.356902059,"realTimeFactor":0.1360121104761905,"finite":true,"samples":63000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.675,"runSeconds":0.214020081,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2139112,"realTimeFactor":0.08000750691588786,"finite":true,"samples":64200},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.4,"runSeconds":0.193984566,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193968216,"realTimeFactor":0.0808269025,"finite":true,"samples":57600},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.675,"runSeconds":0.1534048,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15338565,"realTimeFactor":0.057347588785046734,"finite":true,"samples":64200},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.6,"runSeconds":0.204916781,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204883841,"realTimeFactor":0.07881414653846153,"finite":true,"samples":62400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.45,"runSeconds":0.143411723,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143390493,"realTimeFactor":0.05853539714285713,"finite":true,"samples":58800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.162287199,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162258138,"realTimeFactor":0.06010636999999999,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.725,"runSeconds":0.152333782,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152313731,"realTimeFactor":0.055902305321100916,"finite":true,"samples":65400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.475,"runSeconds":0.142383424,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142364064,"realTimeFactor":0.05752865616161616,"finite":true,"samples":59400},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":2.85,"runSeconds":0.16700409,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16698098,"realTimeFactor":0.05859792631578947,"finite":true,"samples":68400},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.225,"runSeconds":0.127774437,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127748787,"realTimeFactor":0.05742671325842696,"finite":true,"samples":53400},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.5,"runSeconds":0.149094003,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149074543,"realTimeFactor":0.0596376012,"finite":true,"samples":60000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.025,"runSeconds":0.170590311,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1705547,"realTimeFactor":0.05639349123966942,"finite":true,"samples":72600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.4,"runSeconds":0.142623497,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142602227,"realTimeFactor":0.05942645708333333,"finite":true,"samples":57600},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.35,"runSeconds":0.134514466,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134487935,"realTimeFactor":0.05724019829787234,"finite":true,"samples":56400},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.151473503,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151453563,"realTimeFactor":0.057159812452830194,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.4,"runSeconds":0.133141453,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133123713,"realTimeFactor":0.055475605416666664,"finite":true,"samples":57600},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.45,"runSeconds":0.143578175,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143558445,"realTimeFactor":0.058603336734693874,"finite":true,"samples":58800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.525,"runSeconds":0.14765735,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14763565,"realTimeFactor":0.058478158415841586,"finite":true,"samples":60600},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.6,"runSeconds":0.147467929,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147439539,"realTimeFactor":0.05671843423076923,"finite":true,"samples":62400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.45,"runSeconds":0.139987393,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139967683,"realTimeFactor":0.05713771142857142,"finite":true,"samples":58800},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.725,"runSeconds":0.152809176,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152789045,"realTimeFactor":0.05607676183486238,"finite":true,"samples":65400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":2.8,"runSeconds":0.155511629,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155491179,"realTimeFactor":0.055539867500000006,"finite":true,"samples":67200},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.725,"runSeconds":0.156255106,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156232515,"realTimeFactor":0.057341323302752295,"finite":true,"samples":65400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.575,"runSeconds":0.143841867,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143817387,"realTimeFactor":0.05586091922330097,"finite":true,"samples":61800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.25,"runSeconds":0.126202393,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.126184062,"realTimeFactor":0.056089952444444445,"finite":true,"samples":54000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.525,"runSeconds":0.145516272,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145497301,"realTimeFactor":0.05763020673267327,"finite":true,"samples":60600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.625,"runSeconds":0.142039521,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142018321,"realTimeFactor":0.05411029371428572,"finite":true,"samples":63000},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":2.725,"runSeconds":0.152994617,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152974507,"realTimeFactor":0.05614481357798165,"finite":true,"samples":65400},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.175,"runSeconds":0.129721274,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129701674,"realTimeFactor":0.05964196505747127,"finite":true,"samples":52200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.225,"runSeconds":0.130381879,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130361799,"realTimeFactor":0.05859859730337079,"finite":true,"samples":53400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.5,"runSeconds":0.141362015,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141333955,"realTimeFactor":0.056544806,"finite":true,"samples":60000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.6,"runSeconds":0.144824825,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144805195,"realTimeFactor":0.055701855769230764,"finite":true,"samples":62400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.3,"runSeconds":0.129022808,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129004798,"realTimeFactor":0.05609687304347826,"finite":true,"samples":55200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.125,"runSeconds":0.150332924,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150314844,"realTimeFactor":0.0707449054117647,"finite":true,"samples":51000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.775,"runSeconds":0.155130846,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155110546,"realTimeFactor":0.05590300756756757,"finite":true,"samples":66600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.425,"runSeconds":0.135241151,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135221481,"realTimeFactor":0.055769546804123715,"finite":true,"samples":58200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.675,"runSeconds":0.146909764,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146889284,"realTimeFactor":0.054919537943925234,"finite":true,"samples":64200},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.425,"runSeconds":0.146192028,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146172598,"realTimeFactor":0.06028537237113402,"finite":true,"samples":58200},{"index":39,"text":"What joy there is in living.","audioSeconds":1.925,"runSeconds":0.110757998,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.110739968,"realTimeFactor":0.05753662233766233,"finite":true,"samples":46200},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.625,"runSeconds":0.148043494,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148013144,"realTimeFactor":0.05639752152380952,"finite":true,"samples":63000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.143885727,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143865237,"realTimeFactor":0.05329100999999999,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.475,"runSeconds":0.138382019,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138362749,"realTimeFactor":0.055911926868686866,"finite":true,"samples":59400},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.55,"runSeconds":0.144529974,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144509384,"realTimeFactor":0.056678421176470595,"finite":true,"samples":61200},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.475,"runSeconds":0.136267031,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136246981,"realTimeFactor":0.05505738626262627,"finite":true,"samples":59400},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.3,"runSeconds":0.129407681,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129390551,"realTimeFactor":0.056264209130434784,"finite":true,"samples":55200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.7,"runSeconds":0.149420696,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149400946,"realTimeFactor":0.055340998518518515,"finite":true,"samples":64800},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.3,"runSeconds":0.136503023,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136480573,"realTimeFactor":0.059349140434782614,"finite":true,"samples":55200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.45,"runSeconds":0.140976472,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140948072,"realTimeFactor":0.05754141714285713,"finite":true,"samples":58800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.45,"runSeconds":0.130204938,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130186328,"realTimeFactor":0.05314487265306122,"finite":true,"samples":58800},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.3,"runSeconds":0.127680655,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127662735,"realTimeFactor":0.05551332826086957,"finite":true,"samples":55200},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.525,"runSeconds":0.143345723,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143324362,"realTimeFactor":0.05677058336633664,"finite":true,"samples":60600},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.25,"runSeconds":0.125961761,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125944471,"realTimeFactor":0.05598300488888889,"finite":true,"samples":54000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.525,"runSeconds":0.140300196,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140281025,"realTimeFactor":0.055564434059405934,"finite":true,"samples":60600},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.65,"runSeconds":0.146025546,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146004835,"realTimeFactor":0.05510397962264151,"finite":true,"samples":63600},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.45,"runSeconds":0.147278507,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147258377,"realTimeFactor":0.060113676326530606,"finite":true,"samples":58800},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.55,"runSeconds":0.144583144,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144555613,"realTimeFactor":0.05669927215686275,"finite":true,"samples":61200},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.3,"runSeconds":0.12925616,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.12923857,"realTimeFactor":0.05619833043478262,"finite":true,"samples":55200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.5,"runSeconds":0.147271308,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147252217,"realTimeFactor":0.05890852319999999,"finite":true,"samples":60000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.725,"runSeconds":0.149298674,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149256634,"realTimeFactor":0.054788504220183484,"finite":true,"samples":65400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.55,"runSeconds":0.141544897,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141524887,"realTimeFactor":0.05550780274509804,"finite":true,"samples":61200},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.675,"runSeconds":0.15446703,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1544419,"realTimeFactor":0.05774468411214954,"finite":true,"samples":64200},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.65,"runSeconds":0.147691491,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147662591,"realTimeFactor":0.055732638113207555,"finite":true,"samples":63600},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.55,"runSeconds":0.146851873,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146831263,"realTimeFactor":0.05758896980392157,"finite":true,"samples":61200},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.375,"runSeconds":0.131470059,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131451399,"realTimeFactor":0.055355814315789474,"finite":true,"samples":57000},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.75,"runSeconds":0.1510516,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15102969,"realTimeFactor":0.05492785454545455,"finite":true,"samples":66000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.675,"runSeconds":0.153593952,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153570122,"realTimeFactor":0.05741829981308412,"finite":true,"samples":64200},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.8,"runSeconds":0.158878848,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158855808,"realTimeFactor":0.056742445714285716,"finite":true,"samples":67200},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.425,"runSeconds":0.137485631,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137457871,"realTimeFactor":0.05669510556701031,"finite":true,"samples":58200},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":2.875,"runSeconds":0.159481624,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159456873,"realTimeFactor":0.0554718692173913,"finite":true,"samples":69000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.65,"runSeconds":0.147238557,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147218647,"realTimeFactor":0.05556171962264151,"finite":true,"samples":63600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.3,"runSeconds":0.130373889,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130355819,"realTimeFactor":0.056684299565217394,"finite":true,"samples":55200},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.625,"runSeconds":0.145602202,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145582162,"realTimeFactor":0.05546750552380952,"finite":true,"samples":63000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.425,"runSeconds":0.135983488,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135964548,"realTimeFactor":0.05607566515463919,"finite":true,"samples":58200},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.375,"runSeconds":0.131963123,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131943693,"realTimeFactor":0.055563420210526314,"finite":true,"samples":57000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.2,"runSeconds":0.14178402,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14176682,"realTimeFactor":0.06444728181818182,"finite":true,"samples":52800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.575,"runSeconds":0.147023375,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147001045,"realTimeFactor":0.05709645631067961,"finite":true,"samples":61800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":2.85,"runSeconds":0.159495208,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159463927,"realTimeFactor":0.05596323087719298,"finite":true,"samples":68400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.75,"runSeconds":0.150936766,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150916356,"realTimeFactor":0.05488609672727273,"finite":true,"samples":66000},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.625,"runSeconds":0.155646318,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155625398,"realTimeFactor":0.05929383542857143,"finite":true,"samples":63000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.625,"runSeconds":0.143041977,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143019246,"realTimeFactor":0.05449218171428571,"finite":true,"samples":63000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.525,"runSeconds":0.139448344,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139427514,"realTimeFactor":0.05522706693069307,"finite":true,"samples":60600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.3,"runSeconds":0.128362147,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128343117,"realTimeFactor":0.055809629130434794,"finite":true,"samples":55200},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.575,"runSeconds":0.154313316,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154292046,"realTimeFactor":0.0599275013592233,"finite":true,"samples":61800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.25,"runSeconds":0.128497208,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128471768,"realTimeFactor":0.05710987022222222,"finite":true,"samples":54000},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.55,"runSeconds":0.145387297,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145352797,"realTimeFactor":0.05701462627450981,"finite":true,"samples":61200},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.125,"runSeconds":0.120419386,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.120400536,"realTimeFactor":0.05666794635294118,"finite":true,"samples":51000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.4,"runSeconds":0.131490164,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131469434,"realTimeFactor":0.054787568333333335,"finite":true,"samples":57600},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.35,"runSeconds":0.167088399,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167066859,"realTimeFactor":0.07110144638297872,"finite":true,"samples":56400},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.55,"runSeconds":0.140815647,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140792457,"realTimeFactor":0.05522182235294117,"finite":true,"samples":61200},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.325,"runSeconds":0.12881152,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.12879034,"realTimeFactor":0.05540280430107527,"finite":true,"samples":55800},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.4,"runSeconds":0.133092239,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133071938,"realTimeFactor":0.055455099583333334,"finite":true,"samples":57600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":2.575,"runSeconds":0.141978627,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141955867,"realTimeFactor":0.0551373308737864,"finite":true,"samples":61800},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":2.725,"runSeconds":0.156473336,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156446555,"realTimeFactor":0.05742140770642201,"finite":true,"samples":65400},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":2.45,"runSeconds":0.139081031,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139044971,"realTimeFactor":0.05676776775510203,"finite":true,"samples":58800},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":2.55,"runSeconds":0.142757634,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142732743,"realTimeFactor":0.055983385882352944,"finite":true,"samples":61200},{"index":96,"text":"The term ended in late June that year.","audioSeconds":2.55,"runSeconds":0.142173989,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142152969,"realTimeFactor":0.05575450549019608,"finite":true,"samples":61200},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":2.55,"runSeconds":0.144246967,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144225537,"realTimeFactor":0.05656743803921569,"finite":true,"samples":61200},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.075,"runSeconds":0.115891126,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.115870536,"realTimeFactor":0.055851145060240956,"finite":true,"samples":49800},{"index":99,"text":"The bill was paid every third week.","audioSeconds":2.375,"runSeconds":0.131701026,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131680376,"realTimeFactor":0.055453063578947366,"finite":true,"samples":57000},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":2.475,"runSeconds":0.135833772,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135811372,"realTimeFactor":0.054882332121212116,"finite":true,"samples":59400},{"index":101,"text":"Cats and dogs eac