ples":54000},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":2.85,"runSeconds":0.21678357,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216754669,"realTimeFactor":0.0760644105263158,"finite":true,"samples":68400},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":2.6,"runSeconds":0.14563965,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145605899,"realTimeFactor":0.05601525,"finite":true,"samples":62400},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.325,"runSeconds":0.132723355,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.132703125,"realTimeFactor":0.05708531397849462,"finite":true,"samples":55800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":2.45,"runSeconds":0.136893112,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136870412,"realTimeFactor":0.05587473959183673,"finite":true,"samples":58800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":2.475,"runSeconds":0.150516113,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150496502,"realTimeFactor":0.060814591111111115,"finite":true,"samples":59400},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":2.35,"runSeconds":0.130179973,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130159183,"realTimeFactor":0.05539573319148936,"finite":true,"samples":56400},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":2.55,"runSeconds":0.141072049,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141049149,"realTimeFactor":0.055322372156862754,"finite":true,"samples":61200},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.025,"runSeconds":0.166680476,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166655545,"realTimeFactor":0.05510098380165289,"finite":true,"samples":72600},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.275,"runSeconds":0.162388548,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162368827,"realTimeFactor":0.07137958153846154,"finite":true,"samples":54600},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":2.425,"runSeconds":0.138460556,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138434036,"realTimeFactor":0.05709713649484537,"finite":true,"samples":58200},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.125,"runSeconds":0.123959628,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.123928778,"realTimeFactor":0.058333942588235294,"finite":true,"samples":51000},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":2.6,"runSeconds":0.151014958,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150992107,"realTimeFactor":0.05808267615384615,"finite":true,"samples":62400},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":2.575,"runSeconds":0.140842707,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140820327,"realTimeFactor":0.05469619689320388,"finite":true,"samples":61800},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":2.675,"runSeconds":0.199181114,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199159954,"realTimeFactor":0.07446022953271028,"finite":true,"samples":64200},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":2.45,"runSeconds":0.136141086,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136120076,"realTimeFactor":0.055567790204081625,"finite":true,"samples":58800},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":2.6,"runSeconds":0.142190609,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142166649,"realTimeFactor":0.054688695769230765,"finite":true,"samples":62400},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":2.625,"runSeconds":0.144910943,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144889113,"realTimeFactor":0.05520416876190476,"finite":true,"samples":63000},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":2.