nds":0.0,"timeToFirstAudioSeconds":0.191144662,"realTimeFactor":0.06951696836363636,"finite":true,"samples":66000},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":2.6,"runSeconds":0.147013152,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146979002,"realTimeFactor":0.05654352,"finite":true,"samples":62400},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.075,"runSeconds":0.116983936,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.116964436,"realTimeFactor":0.056377800481927705,"finite":true,"samples":49800},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":2.575,"runSeconds":0.143055807,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143032397,"realTimeFactor":0.0555556532038835,"finite":true,"samples":61800},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":2.55,"runSeconds":0.148839858,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148818197,"realTimeFactor":0.05836857176470588,"finite":true,"samples":61200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.375,"runSeconds":0.131639976,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131618436,"realTimeFactor":0.05542735831578947,"finite":true,"samples":57000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":2.875,"runSeconds":0.156456536,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156433155,"realTimeFactor":0.054419664695652174,"finite":true,"samples":69000},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":2.7,"runSeconds":0.164671898,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164650827,"realTimeFactor":0.06098959185185185,"finite":true,"samples":64800},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.4,"runSeconds":0.135977014,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135952014,"realTimeFactor":0.056657089166666674,"finite":true,"samples":57600},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.35,"runSeconds":0.133207369,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133175179,"realTimeFactor":0.05668398680851063,"finite":true,"samples":56400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.525,"runSeconds":0.138390765,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138366375,"realTimeFactor":0.05480822376237624,"finite":true,"samples":60600},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.425,"runSeconds":0.136831162,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136810031,"realTimeFactor":0.05642522144329898,"finite":true,"samples":58200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.65,"runSeconds":0.147115913,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147093733,"realTimeFactor":0.055515438867924524,"finite":true,"samples":63600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.625,"runSeconds":0.143660032,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143636602,"realTimeFactor":0.05472763123809524,"finite":true,"samples":63000},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.65,"runSeconds":0.146671449,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146650349,"realTimeFactor":0.05534771660377359,"finite":true,"samples":63600},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.325,"runSeconds":0.129305435,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129285955,"realTimeFactor":0.05561524086021505,"finite":true,"samples":55800},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.675,"runSeconds":0.194528123,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194504953,"realTimeFactor":0.07272079364485981,"finite":true,"samples":64200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.25,"runSeconds":0.128321956,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128295886,"realTimeFactor":0.057031980444444436,"finite":true,"samples":54000},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.5,"runSeconds":0.139893409,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139860659,"realTimeFactor":0.0559573636,"finite":true,"samples":60000},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.55,"runSeconds":0.141351992,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141330152,"realTimeFactor":0.0554321537254902,"finite":true,"samples":61200},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.775,"runSeconds":0.152144027,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152121127,"realTimeFactor":0.05482667639639639,"finite":true,"samples":66600},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.55,"runSeconds":0.140608925,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140587055,"realTimeFactor":0.055140754901960784,"finite":true,"samples":61200},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.375,"runSeconds":0.131300012,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131276442,"realTimeFactor":0.05528421557894737,"finite":true,"samples":57000},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.45,"runSeconds":0.135741082,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135719142,"realTimeFactor":0.05540452326530612,"finite":true,"samples":58800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.525,"runSeconds":0.139338254,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139316914,"realTimeFactor":0.05518346693069307,"finite":true,"samples":60600},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.725,"runSeconds":0.15811757,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158090679,"realTimeFactor":0.058024796330275234,"finite":true,"samples":65400},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.375,"runSeconds":0.13551705,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1354833,"realTimeFactor":0.05705981052631579,"finite":true,"samples":57000},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.35,"runSeconds":0.129622378,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129602158,"realTimeFactor":0.05515845872340426,"finite":true,"samples":56400},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.3,"runSeconds":0.127401258,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127379448,"realTimeFactor":0.055391851304347824,"finite":true,"samples":55200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":2.575,"runSeconds":0.145185655,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145164315,"realTimeFactor":0.0563827786407767,"finite":true,"samples":61800},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":2.95,"runSeconds":0.161363039,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161339449,"realTimeFactor":0.05469933525423729,"finite":true,"samples":70800},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.475,"runSeconds":0.136534199,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136511919,"realTimeFactor":0.055165332929292925,"finite":true,"samples":59400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.35,"runSeconds":0.129856529,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129835239,"realTimeFactor":0.055258097446808506,"finite":true,"samples":56400},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.275,"runSeconds":0.133865665,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133840475,"realTimeFactor":0.05884205054945055,"finite":true,"samples":54600},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.325,"runSeconds":0.131300333,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131268872,"realTimeFactor":0.056473261505376335,"finite":true,"samples":55800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":2.975,"runSeconds":0.165278973,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165244113,"realTimeFactor":0.055555957310924366,"finite":true,"samples":71400},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.4,"runSeconds":0.141130858,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141100528,"realTimeFactor":0.05880452416666667,"finite":true,"samples":57600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.525,"runSeconds":0.141549407,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141526587,"realTimeFactor":0.056059171089108906,"finite":true,"samples":60600},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.775,"runSeconds":0.151840809,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151817908,"realTimeFactor":0.05471740864864865,"finite":true,"samples":66600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.075,"runSeconds":0.124370626,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.124352406,"realTimeFactor":0.059937651084337344,"finite":true,"samples":49800},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.625,"runSeconds":0.147139227,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147102217,"realTimeFactor":0.05605303885714286,"finite":true,"samples":63000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.675,"runSeconds":0.150322234,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150286774,"realTimeFactor":0.05619522766355141,"finite":true,"samples":64200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.3,"runSeconds":0.127566864,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127547194,"realTimeFactor":0.05546385391304348,"finite":true,"samples":55200},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.75,"runSeconds":0.151500095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151476745,"realTimeFactor":0.05509094363636364,"finite":true,"samples":66000},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":2.625,"runSeconds":0.148317817,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148295757,"realTimeFactor":0.05650202552380952,"finite":true,"samples":63000},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.1,"runSeconds":0.118199482,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.118180222,"realTimeFactor":0.05628546761904762,"finite":true,"samples":50400},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":2.575,"runSeconds":0.142189713,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142168693,"realTimeFactor":0.05521930601941747,"finite":true,"samples":61800}]}