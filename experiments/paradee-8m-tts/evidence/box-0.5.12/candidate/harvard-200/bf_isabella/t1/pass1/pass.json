{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {onnxNodes=2535, graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnxOpset=17, onnxOperators=56, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxDynamicNodes=1311, backend=pure-java} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bf_isabella","voiceIndex":1,"corpus":"harvard-200","pass":1,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":594.5500000000001,"totalRunSeconds":32.799858948,"realTimeMultiple":18.126602341265656,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.175,"runSeconds":0.290231748,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.290084936,"realTimeFactor":0.09141157417322836,"finite":true,"samples":76200},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.025,"runSeconds":0.224517827,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224387056,"realTimeFactor":0.07422076925619835,"finite":true,"samples":72600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.85,"runSeconds":0.186126934,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186107884,"realTimeFactor":0.06530769614035087,"finite":true,"samples":68400},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.25,"runSeconds":0.224388607,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224367257,"realTimeFactor":0.0690426483076923,"finite":true,"samples":78000},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.225,"runSeconds":0.179949531,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17990728,"realTimeFactor":0.05579830418604651,"finite":true,"samples":77400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.95,"runSeconds":0.149809739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149788839,"realTimeFactor":0.05078296237288135,"finite":true,"samples":70800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.15,"runSeconds":0.166165911,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166142631,"realTimeFactor":0.05275108285714286,"finite":true,"samples":75600},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.05,"runSeconds":0.159202441,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159180601,"realTimeFactor":0.05219752163934427,"finite":true,"samples":73200},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.95,"runSeconds":0.158124651,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158100891,"realTimeFactor":0.05360157661016949,"finite":true,"samples":70800},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.4,"runSeconds":0.168058067,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168024557,"realTimeFactor":0.04942884323529412,"finite":true,"samples":81600},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.7,"runSeconds":0.140996553,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140977033,"realTimeFactor":0.05222094555555555,"finite":true,"samples":64800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.025,"runSeconds":0.148995132,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148973522,"realTimeFactor":0.049254589090909094,"finite":true,"samples":72600},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.4,"runSeconds":0.179260745,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179228414,"realTimeFactor":0.052723748529411765,"finite":true,"samples":81600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.925,"runSeconds":0.145211299,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145190499,"realTimeFactor":0.04964488854700855,"finite":true,"samples":70200},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.825,"runSeconds":0.14981353,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14979155,"realTimeFactor":0.05303133805309734,"finite":true,"samples":67800},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.05,"runSeconds":0.15101796,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15099486,"realTimeFactor":0.049514085245901646,"finite":true,"samples":73200},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.95,"runSeconds":0.158221102,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158197012,"realTimeFactor":0.05363427186440678,"finite":true,"samples":70800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.95,"runSeconds":0.147299318,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147268247,"realTimeFactor":0.04993197220338983,"finite":true,"samples":70800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.825,"runSeconds":0.148341387,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148321446,"realTimeFactor":0.05251022548672566,"finite":true,"samples":67800},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.025,"runSeconds":0.149509916,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149487466,"realTimeFactor":0.04942476561983471,"finite":true,"samples":72600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.85,"runSeconds":0.15456149,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15453731,"realTimeFactor":0.05423210175438596,"finite":true,"samples":68400},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.225,"runSeconds":0.163465838,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163434228,"realTimeFactor":0.0506870815503876,"finite":true,"samples":77400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.125,"runSeconds":0.160841585,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160819625,"realTimeFactor":0.0514693072,"finite":true,"samples":75000},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.2,"runSeconds":0.156194475,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156170515,"realTimeFactor":0.048810773437499996,"finite":true,"samples":76800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.875,"runSeconds":0.154281798,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154256658,"realTimeFactor":0.05366323408695652,"finite":true,"samples":69000},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.675,"runSeconds":0.135056942,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135029601,"realTimeFactor":0.05048857644859814,"finite":true,"samples":64200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.85,"runSeconds":0.149489856,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149458216,"realTimeFactor":0.05245258105263158,"finite":true,"samples":68400},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.1,"runSeconds":0.152781275,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152759515,"realTimeFactor":0.04928428225806451,"finite":true,"samples":74400},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.275,"runSeconds":0.173357694,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173330254,"realTimeFactor":0.052933647022900765,"finite":true,"samples":78600},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.775,"runSeconds":0.139162437,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139137497,"realTimeFactor":0.05014862594594595,"finite":true,"samples":66600},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.75,"runSeconds":0.142258414,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142236294,"realTimeFactor":0.05173033236363636,"finite":true,"samples":66000},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.0,"runSeconds":0.148347616,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148326446,"realTimeFactor":0.04944920533333333,"finite":true,"samples":72000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.1,"runSeconds":0.196144241,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196117211,"realTimeFactor":0.06327233580645161,"finite":true,"samples":74400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.825,"runSeconds":0.156894401,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156865991,"realTimeFactor":0.055537841061946897,"finite":true,"samples":67800},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.6,"runSeconds":0.147724002,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147703662,"realTimeFactor":0.05681692384615384,"finite":true,"samples":62400},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.15,"runSeconds":0.163839481,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163816161,"realTimeFactor":0.052012533650793655,"finite":true,"samples":75600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.925,"runSeconds":0.172261115,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172235904,"realTimeFactor":0.05889268888888889,"finite":true,"samples":70200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.125,"runSeconds":0.170828291,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170797031,"realTimeFactor":0.05466505312,"finite":true,"samples":75000},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.9,"runSeconds":0.167073799,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167052118,"realTimeFactor":0.057611654827586206,"finite":true,"samples":69600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.4,"runSeconds":0.128679706,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128661146,"realTimeFactor":0.05361654416666667,"finite":true,"samples":57600},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.075,"runSeconds":0.16604598,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16602386,"realTimeFactor":0.05399869268292683,"finite":true,"samples":73800},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.1,"runSeconds":0.168996876,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168970175,"realTimeFactor":0.05451512129032258,"finite":true,"samples":74400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.925,"runSeconds":0.161930834,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161899994,"realTimeFactor":0.05536096888888889,"finite":true,"samples":70200},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.95,"runSeconds":0.16937612,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169354469,"realTimeFactor":0.05741563389830508,"finite":true,"samples":70800},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.025,"runSeconds":0.162413899,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162392078,"realTimeFactor":0.05369054512396695,"finite":true,"samples":72600},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.8,"runSeconds":0.152641134,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152619274,"realTimeFactor":0.05451469071428572,"finite":true,"samples":67200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.05,"runSeconds":0.17762403,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17759874,"realTimeFactor":0.0582373868852459,"finite":true,"samples":73200},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.825,"runSeconds":0.154973434,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154940034,"realTimeFactor":0.05485785274336283,"finite":true,"samples":67800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.825,"runSeconds":0.165591236,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165569706,"realTimeFactor":0.05861636672566371,"finite":true,"samples":67800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.875,"runSeconds":0.14991823,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1498955,"realTimeFactor":0.05214547130434783,"finite":true,"samples":69000},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.75,"runSeconds":0.14867432,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148651739,"realTimeFactor":0.05406338909090909,"finite":true,"samples":66000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.975,"runSeconds":0.171313756,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171287786,"realTimeFactor":0.05758445579831933,"finite":true,"samples":71400},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.9,"runSeconds":0.158239763,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158209963,"realTimeFactor":0.054565435517241384,"finite":true,"samples":69600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.975,"runSeconds":0.170055755,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170032525,"realTimeFactor":0.05716159831932773,"finite":true,"samples":71400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.125,"runSeconds":0.170073675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170050995,"realTimeFactor":0.054423576,"finite":true,"samples":75000},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.925,"runSeconds":0.158058391,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158036221,"realTimeFactor":0.054037056752136756,"finite":true,"samples":70200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.0,"runSeconds":0.17067834,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17065227,"realTimeFactor":0.056892780000000004,"finite":true,"samples":72000},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.725,"runSeconds":0.149745359,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149703648,"realTimeFactor":0.054952425321100916,"finite":true,"samples":65400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.0,"runSeconds":0.165070412,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165049061,"realTimeFactor":0.055023470666666664,"finite":true,"samples":72000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.175,"runSeconds":0.170695381,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170670551,"realTimeFactor":0.053762324724409456,"finite":true,"samples":76200},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.975,"runSeconds":0.161626282,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161603922,"realTimeFactor":0.05432816201680672,"finite":true,"samples":71400},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.1,"runSeconds":0.167493143,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167468562,"realTimeFactor":0.05403004612903226,"finite":true,"samples":74400},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.95,"runSeconds":0.170287737,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170262167,"realTimeFactor":0.057724656610169484,"finite":true,"samples":70800},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.1,"runSeconds":0.17062451,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17059068,"realTimeFactor":0.05504016451612903,"finite":true,"samples":74400},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.8,"runSeconds":0.152893686,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152871776,"realTimeFactor":0.05460488785714286,"finite":true,"samples":67200},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.25,"runSeconds":0.175780855,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175758115,"realTimeFactor":0.054086416923076926,"finite":true,"samples":78000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.075,"runSeconds":0.167426042,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167402552,"realTimeFactor":0.054447493333333326,"finite":true,"samples":73800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.25,"runSeconds":0.177932694,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177910053,"realTimeFactor":0.05474852123076923,"finite":true,"samples":78000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.0,"runSeconds":0.161676072,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161653542,"realTimeFactor":0.053892024000000004,"finite":true,"samples":72000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.184701432,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184674802,"realTimeFactor":0.05727176186046511,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.0,"runSeconds":0.165160063,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165131903,"realTimeFactor":0.05505335433333333,"finite":true,"samples":72000},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.85,"runSeconds":0.15444395,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154423159,"realTimeFactor":0.054190859649122805,"finite":true,"samples":68400},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.15,"runSeconds":0.167394502,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167369622,"realTimeFactor":0.05314111174603175,"finite":true,"samples":75600},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.075,"runSeconds":0.166904108,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166879728,"realTimeFactor":0.05427775869918699,"finite":true,"samples":73800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.975,"runSeconds":0.16024591,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16022292,"realTimeFactor":0.053864171428571424,"finite":true,"samples":71400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.7,"runSeconds":0.139671442,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139650472,"realTimeFactor":0.0517301637037037,"finite":true,"samples":64800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.95,"runSeconds":0.160105688,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160082708,"realTimeFactor":0.05427311457627118,"finite":true,"samples":70800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.3,"runSeconds":0.227703175,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227676065,"realTimeFactor":0.06900096212121212,"finite":true,"samples":79200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.1,"runSeconds":0.170372888,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170339777,"realTimeFactor":0.05495899612903225,"finite":true,"samples":74400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.15,"runSeconds":0.169086166,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169061186,"realTimeFactor":0.05367814793650794,"finite":true,"samples":75600},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.0,"runSeconds":0.161390568,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161367718,"realTimeFactor":0.053796856000000004,"finite":true,"samples":72000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.9,"runSeconds":0.157580675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157553685,"realTimeFactor":0.05433816379310345,"finite":true,"samples":69600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.65,"runSeconds":0.149281083,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149259413,"realTimeFactor":0.0563324841509434,"finite":true,"samples":63600},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.05,"runSeconds":0.163499417,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163475366,"realTimeFactor":0.0536063662295082,"finite":true,"samples":73200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.8,"runSeconds":0.15013344,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15010913,"realTimeFactor":0.05361908571428572,"finite":true,"samples":67200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.9,"runSeconds":0.157359513,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157337113,"realTimeFactor":0.054261901034482765,"finite":true,"samples":69600},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.725,"runSeconds":0.168191167,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168161397,"realTimeFactor":0.06172152917431192,"finite":true,"samples":65400},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.7,"runSeconds":0.150813626,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150779416,"realTimeFactor":0.055856898518518515,"finite":true,"samples":64800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.825,"runSeconds":0.152988486,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152965395,"realTimeFactor":0.05415521628318584,"finite":true,"samples":67800},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.975,"runSeconds":0.160154838,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160130118,"realTimeFactor":0.053833558991596635,"finite":true,"samples":71400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.8,"runSeconds":0.163099563,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163077123,"realTimeFactor":0.05824984392857143,"finite":true,"samples":67200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.7,"runSeconds":0.14768651,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147663789,"realTimeFactor":0.0546987074074074,"finite":true,"samples":64800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.05,"runSeconds":0.163186614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163162234,"realTimeFactor":0.05350380786885246,"finite":true,"samples":73200},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":3.2,"runSeconds":0.171085542,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171059922,"realTimeFactor":0.053464231875,"finite":true,"samples":76800},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":3.0,"runSeconds":0.172196692,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172165192,"realTimeFactor":0.05739889733333334,"finite":true,"samples":72000},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":2.95,"runSeconds":0.162286296,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162250436,"realTimeFactor":0.05501230372881356,"finite":true,"samples":70800},{"index":96,"text":"The term ended in late June that year.","audioSeconds":3.125,"runSeconds":0.167502581,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167477651,"realTimeFactor":0.053600825920000005,"finite":true,"samples":75000},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":3.075,"runSeconds":0.173030889,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173003819,"realTimeFactor":0.05627020780487804,"finite":true,"samples":73800},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.55,"runSeconds":0.135920877,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135898297,"realTimeFactor":0.053302304705882354,"finite":true,"samples":61200},{"index":99,"text":"The bill was paid every third week.","audioSeconds":2.95,"runSeconds":0.157947739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157923498,"realTimeFactor":0.053541606440677965,"finite":true,"samples":70800},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":3.0,"runSeconds":0.180188031,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18015301,"realTimeFactor":0.060062677,"finite":true,"samples":72000},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":2.8,"runSeconds":0.154152206,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154116145,"realTimeFactor":0.0550543592857143,"finite":true,"samples":67200},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.75,"runSeconds":0.149503276,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149480875,"realTimeFactor":0.05436482763636363,"finite":true,"samples":66000},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.1,"runSeconds":0.17424494,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174220659,"realTimeFactor":0.05620804516129032,"finite":true,"samples":74400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.925,"runSeconds":0.159863775,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159839755,"realTimeFactor":0.05465428205128206,"finite":true,"samples":70200},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.05,"runSeconds":0.162859171,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162834301,"realTimeFactor":0.053396449508196726,"finite":true,"samples":73200},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.175,"runSeconds":0.184797621,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184765791,"realTimeFactor":0.058203975118110235,"finite":true,"samples":76200},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.168710802,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168674641,"realTimeFactor":0.055772165950413226,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.75,"runSeconds":0.151100049,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151075499,"realTimeFactor":0.05494547236363636,"finite":true,"samples":66000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.85,"runSeconds":0.158449573,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158426872,"realTimeFactor":0.055596341403508776,"finite":true,"samples":68400},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.325,"runSeconds":0.179713427,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179687207,"realTimeFactor":0.05404915097744361,"finite":true,"samples":79800},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":3.05,"runSeconds":0.165249492,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165224242,"realTimeFactor":0.05418016131147541,"finite":true,"samples":73200},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.7,"runSeconds":0.14770671,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14768339,"realTimeFactor":0.05470618888888888,"finite":true,"samples":64800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":3.075,"runSeconds":0.174398301,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174366691,"realTimeFactor":0.05671489463414634,"finite":true,"samples":73800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":2.925,"runSeconds":0.159999036,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159962776,"realTimeFactor":0.054700525128205134,"finite":true,"samples":70200},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":2.925,"runSeconds":0.157811457,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157787897,"realTimeFactor":0.05395263487179487,"finite":true,"samples":70200},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":3.0,"runSeconds":0.161680221,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161655621,"realTimeFactor":0.053893407000000004,"finite":true,"samples":72000},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.425,"runSeconds":0.188490453,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188462213,"realTimeFactor":0.055033708905109495,"finite":true,"samples":82200},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.7,"runSeconds":0.145821363,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145798663,"realTimeFactor":0.054007912222222225,"finite":true,"samples":64800},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":2.825,"runSeconds":0.153818272,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153795532,"realTimeFactor":0.05444894584070796,"finite":true,"samples":67800},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.7,"runSeconds":0.144995237,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144972816,"realTimeFactor":0.05370193962962962,"finite":true,"samples":64800},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":2.85,"runSeconds":0.155335576,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155312886,"realTimeFactor":0.05450371087719298,"finite":true,"samples":68400},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":3.075,"runSeconds":0.171788478,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171757748,"realTimeFactor":0.055866171707317065,"finite":true,"samples":73800},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":3.0,"runSeconds":0.164229212,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164193902,"realTimeFactor":0.05474307066666667,"finite":true,"samples":72000},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":3.1,"runSeconds":0.166918026,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166892786,"realTimeFactor":0.05384452451612903,"finite":true,"samples":74400},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":3.05,"runSeconds":0.163755079,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163729169,"realTimeFactor":0.05369018983606558,"finite":true,"samples":73200},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":3.025,"runSeconds":0.220277768,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220253208,"realTimeFactor":0.07281909685950413,"finite":true,"samples":72600},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":2.875,"runSeconds":0.159973676,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159949116,"realTimeFactor":0.05564301773913044,"finite":true,"samples":69000},{"index":128,"text":"Feel the heat of the weak dying flame.","audioSeconds":3.025,"runSeconds":0.162715609,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162688789,"realTimeFactor":0.05379028396694215,"finite":true,"samples":72600},{"index":129,"text":"The tiny girl took off her hat.","audioSeconds":2.6,"runSeconds":0.14087513,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14085304,"realTimeFactor":0.0541827423076923,"finite":true,"samples":62400},{"index":130,"text":"A cramp is no small danger on a swim.","audioSeconds":3.2,"runSeconds":0.17201609,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17198958,"realTimeFactor":0.053755028125,"finite":true,"samples":76800},{"index":131,"text":"He said the same phrase thirty times.","audioSeconds":3.075,"runSeconds":0.180388093,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180357403,"realTimeFactor":0.05866279447154471,"finite":true,"samples":73800},{"index":132,"text":"Pluck the bright rose without leaves.","audioSeconds":2.9,"runSeconds":0.159893475,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159856665,"realTimeFactor":0.05513568103448276,"finite":true,"samples":69600},{"index":133,"text":"Two plus seven is less than ten.","audioSeconds":2.875,"runSeconds":0.154327127,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154301477,"realTimeFactor":0.05367900069565218,"finite":true,"samples":69000},{"index":134,"text":"The glow deepened in the eyes of the sweet girl.","audioSeconds":3.25,"runSeconds":0.175818893,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175793303,"realTimeFactor":0.05409812092307693,"finite":true,"samples":78000},{"index":135,"text":"Bring your problems to the wise chief.","audioSeconds":2.8,"runSeconds":0.195126241,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19510324,"realTimeFactor":0.06968794321428572,"finite":true,"samples":67200},{"index":136,"text":"Write a fond note to the friend you cherish.","audioSeconds":3.075,"runSeconds":0.167279129,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167253619,"realTimeFactor":0.05439971674796747,"finite":true,"samples":73800},{"index":137,"text":"Clothes and lodging are free to new men.","audioSeconds":3.0,"runSeconds":0.162079025,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162054694,"realTimeFactor":0.054026341666666665,"finite":true,"samples":72000},{"index":138,"text":"We frown when events take a bad turn.","audioSeconds":3.025,"runSeconds":0.16389575,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16387088,"realTimeFactor":0.0541804132231405,"finite":true,"samples":72600},{"index":139,"text":"Port is a strong wine with a smoky taste.","audioSeconds":3.225,"runSeconds":0.172672366,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172645166,"realTimeFactor":0.05354181891472868,"finite":true,"samples":77400},{"index":140,"text":"The young kid jumped the rusty gate.","audioSeconds":2.675,"runSeconds":0.152890034,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152859984,"realTimeFactor":0.05715515289719627,"finite":true,"samples":64200},{"index":141,"text":"Guess the results from the first scores.","audioSeconds":2.925,"runSeconds":0.159962376,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159925985,"realTimeFactor":0.05468799179487179,"finite":true,"samples":70200},{"index":142,"text":"A salt pickle tastes fine with ham.","audioSeconds":2.9,"runSeconds":0.156751808,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156728728,"realTimeFactor":0.054052347586206896,"finite":true,"samples":69600},{"index":143,"text":"The just claim got the right verdict.","audioSeconds":2.825,"runSeconds":0.162101745,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162078965,"realTimeFactor":0.057381148672566364,"finite":true,"samples":67800},{"index":144,"text":"These thistles bend in a high wind.","audioSeconds":2.925,"runSeconds":0.157441434,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157417584,"realTimeFactor":0.053826131282051284,"finite":true,"samples":70200},{"index":145,"text":"Pure bred poodles have curls.","audioSeconds":2.625,"runSeconds":0.141885409,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141862679,"realTimeFactor":0.05405158438095238,"finite":true,"samples":63000},{"index":146,"text":"The tree top waved in a graceful way.","audioSeconds":3.0,"runSeconds":0.160651452,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160627672,"realTimeFactor":0.053550484,"finite":true,"samples":72000},{"index":147,"text":"The spot on the blotter was made by green ink.","audioSeconds":3.3,"runSeconds":0.188706065,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188671774,"realTimeFactor":0.05718365606060607,"finite":true,"samples":79200},{"index":148,"text":"Mud was spattered on the front of his white shirt.","audioSeconds":3.375,"runSeconds":0.187338143,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187311712,"realTimeFactor":0.05550759792592593,"finite":true,"samples":81000},{"index":149,"text":"The cigar burned a hole in the desk top.","audioSeconds":2.975,"runSeconds":0.160548321,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16052435,"realTimeFactor":0.053965822184873946,"finite":true,"samples":71400},{"index":150,"text":"The empty flask stood on the tin tray.","audioSeconds":3.025,"runSeconds":0.173336962,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173313041,"realTimeFactor":0.05730147504132232,"finite":true,"samples":72600},{"index":151,"text":"A speedy man can beat this track mark.","audioSeconds":3.075,"runSeconds":0.165512104,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165488294,"realTimeFactor":0.053825074471544714,"finite":true,"samples":73800},{"index":152,"text":"He broke a new shoelace that day.","audioSeconds":2.675,"runSeconds":0.145136087,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145113707,"realTimeFactor":0.05425648112149533,"finite":true,"samples":64200},{"index":153,"text":"The coffee stand is too high for the couch.","audioSeconds":3.075,"runSeconds":0.164484375,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164460515,"realTimeFactor":0.05349085365853658,"finite":true,"samples":73800},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":3.1,"runSeconds":0.172736196,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172704746,"realTimeFactor":0.0557213535483871,"finite":true,"samples":74400},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.6,"runSeconds":0.143478533,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143447692,"realTimeFactor":0.05518405115384615,"finite":true,"samples":62400},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":3.0,"runSeconds":0.163486076,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163462626,"realTimeFactor":0.05449535866666667,"finite":true,"samples":72000},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":3.05,"runSeconds":0.164113021,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164088461,"realTimeFactor":0.05380754786885246,"finite":true,"samples":73200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.825,"runSeconds":0.154348338,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154323527,"realTimeFactor":0.054636579823008846,"finite":true,"samples":67800},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.375,"runSeconds":0.179792977,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179766867,"realTimeFactor":0.05327199318518518,"finite":true,"samples":81000},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":3.05,"runSeconds":0.164566366,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164541586,"realTimeFactor":0.05395618557377049,"finite":true,"samples":73200},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.85,"runSeconds":0.167247919,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167217759,"realTimeFactor":0.05868348035087719,"finite":true,"samples":68400},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.725,"runSeconds":0.151948557,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151914237,"realTimeFactor":0.055760938348623855,"finite":true,"samples":65400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.925,"runSeconds":0.156483615,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156459335,"realTimeFactor":0.0534986717948718,"finite":true,"samples":70200},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.0,"runSeconds":0.168873173,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168848953,"realTimeFactor":0.056291057666666665,"finite":true,"samples":72000},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.25,"runSeconds":0.173937977,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173911047,"realTimeFactor":0.05351937753846154,"finite":true,"samples":78000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.05,"runSeconds":0.162774821,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16275065,"realTimeFactor":0.0533687937704918,"finite":true,"samples":73200},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.075,"runSeconds":0.165935608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165911618,"realTimeFactor":0.0539627993495935,"finite":true,"samples":73800},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.9,"runSeconds":0.163565637,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163533916,"realTimeFactor":0.056401943793103454,"finite":true,"samples":69600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.05,"runSeconds":0.166645614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166609364,"realTimeFactor":0.0546379062295082,"finite":true,"samples":73200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.775,"runSeconds":0.14881267,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148790179,"realTimeFactor":0.05362618738738739,"finite":true,"samples":66600},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.05,"runSeconds":0.169445538,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169407318,"realTimeFactor":0.05555591409836066,"finite":true,"samples":73200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.1,"runSeconds":0.166464002,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166437782,"realTimeFactor":0.05369806516129032,"finite":true,"samples":74400},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.325,"runSeconds":0.17899937,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17897347,"realTimeFactor":0.053834396992481194,"finite":true,"samples":79800},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.875,"runSeconds":0.153824882,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153791112,"realTimeFactor":0.053504306782608695,"finite":true,"samples":69000},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.925,"runSeconds":0.163435306,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163404666,"realTimeFactor":0.055875318290598296,"finite":true,"samples":70200},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.825,"runSeconds":0.155184525,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155149454,"realTimeFactor":0.054932575221238934,"finite":true,"samples":67800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.95,"runSeconds":0.159080469,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159055788,"realTimeFactor":0.05392558271186441,"finite":true,"samples":70800},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.125,"runSeconds":0.16615956,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16613501,"realTimeFactor":0.0531710592,"finite":true,"samples":75000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.975,"runSeconds":0.162406488,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162382408,"realTimeFactor":0.05459041613445378,"finite":true,"samples":71400},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.875,"runSeconds":0.152884405,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152861185,"realTimeFactor":0.05317718434782609,"finite":true,"samples":69000},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.75,"runSeconds":0.147153926,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147120226,"realTimeFactor":0.05351051854545454,"finite":true,"samples":66000},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.05,"runSeconds":0.162295677,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162271127,"realTimeFactor":0.053211697377049186,"finite":true,"samples":73200},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.35,"runSeconds":0.196378252,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196344852,"realTimeFactor":0.05862037373134328,"finite":true,"samples":80400},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.9,"runSeconds":0.158661776,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158624395,"realTimeFactor":0.05471095724137932,"finite":true,"samples":69600},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.775,"runSeconds":0.150336633,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150313473,"realTimeFactor":0.05417536324324324,"finite":true,"samples":66600},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.75,"runSeconds":0.146733442,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146710982,"realTimeFactor":0.05335761527272727,"finite":true,"samples":66000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.85,"runSeconds":0.187763548,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187741187,"realTimeFactor":0.06588194666666666,"finite":true,"samples":68400},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.25,"runSeconds":0.178885401,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178859431,"realTimeFactor":0.05504166184615385,"finite":true,"samples":78000},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.025,"runSeconds":0.162268977,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162244417,"realTimeFactor":0.05364263702479339,"finite":true,"samples":72600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":3.0,"runSeconds":0.163188524,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163164254,"realTimeFactor":0.054396174666666665,"finite":true,"samples":72000},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":3.125,"runSeconds":0.182162029,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182132308,"realTimeFactor":0.05829184928,"finite":true,"samples":75000},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.625,"runSeconds":0.149570347,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149525366,"realTimeFactor":0.05697917980952381,"finite":true,"samples":63000},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":3.0,"runSeconds":0.161849313,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161813942,"realTimeFactor":0.053949771,"finite":true,"samples":72000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.9,"runSeconds":0.1568987,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15687284,"realTimeFactor":0.054103000000000005,"finite":true,"samples":69600},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.9,"runSeconds":0.155965292,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155939972,"realTimeFactor":0.0537811351724138,"finite":true,"samples":69600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":3.025,"runSeconds":0.165644876,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165619095,"realTimeFactor":0.05475863669421488,"finite":true,"samples":72600},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":3.125,"runSeconds":0.167905776,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167880626,"realTimeFactor":0.05372984832,"finite":true,"samples":75000},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.65,"runSeconds":0.14302778,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14300628,"realTimeFactor":0.05397274716981132,"finite":true,"samples":63600},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":3.075,"runSeconds":0.179402325,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179373215,"realTimeFactor":0.05834221951219512,"finite":true,"samples":73800}]}