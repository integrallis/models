{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {onnx-kernels=rust-ffm, graph=onnx_paradee_int8.onnx, onnxNodes=2535, backend=pure-java, onnxDynamicNodes=1311, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxOperators=56, onnxOpset=17, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bf_isabella","voiceIndex":1,"corpus":"harvard-200","pass":3,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":594.5500000000001,"totalRunSeconds":33.719682807000034,"realTimeMultiple":17.632135017491166,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.175,"runSeconds":0.314256056,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.314107354,"realTimeFactor":0.09897828535433072,"finite":true,"samples":76200},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.025,"runSeconds":0.22722781,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227095929,"realTimeFactor":0.07511663140495868,"finite":true,"samples":72600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.85,"runSeconds":0.190591163,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190571073,"realTimeFactor":0.06687409228070175,"finite":true,"samples":68400},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.25,"runSeconds":0.242487623,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242465162,"realTimeFactor":0.07461157630769231,"finite":true,"samples":78000},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.225,"runSeconds":0.194424426,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194384236,"realTimeFactor":0.06028664372093023,"finite":true,"samples":77400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.95,"runSeconds":0.16612751,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16610718,"realTimeFactor":0.05631441016949153,"finite":true,"samples":70800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.15,"runSeconds":0.181283793,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181260812,"realTimeFactor":0.05755041047619048,"finite":true,"samples":75600},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.05,"runSeconds":0.17066477,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1706435,"realTimeFactor":0.05595566229508197,"finite":true,"samples":73200},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.95,"runSeconds":0.172072262,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172048012,"realTimeFactor":0.05832958033898305,"finite":true,"samples":70800},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.4,"runSeconds":0.187312945,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187280045,"realTimeFactor":0.05509204264705883,"finite":true,"samples":81600},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.7,"runSeconds":0.15563045,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15561124,"realTimeFactor":0.057640907407407405,"finite":true,"samples":64800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.025,"runSeconds":0.165188422,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165166732,"realTimeFactor":0.054607742809917356,"finite":true,"samples":72600},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.4,"runSeconds":0.196985209,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196955919,"realTimeFactor":0.057936826176470585,"finite":true,"samples":81600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.925,"runSeconds":0.16150104,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16147967,"realTimeFactor":0.055214030769230774,"finite":true,"samples":70200},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.825,"runSeconds":0.158883928,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158861978,"realTimeFactor":0.056242098407079645,"finite":true,"samples":67800},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.05,"runSeconds":0.167933787,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167912166,"realTimeFactor":0.05506025803278689,"finite":true,"samples":73200},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.95,"runSeconds":0.160504832,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160484072,"realTimeFactor":0.054408417627118635,"finite":true,"samples":70800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.95,"runSeconds":0.165579406,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165557345,"realTimeFactor":0.056128612203389834,"finite":true,"samples":70800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.825,"runSeconds":0.16721716,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16719316,"realTimeFactor":0.059191915044247784,"finite":true,"samples":67800},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.025,"runSeconds":0.168564472,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168522641,"realTimeFactor":0.05572379239669421,"finite":true,"samples":72600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.85,"runSeconds":0.158357643,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158337343,"realTimeFactor":0.05556408526315789,"finite":true,"samples":68400},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.225,"runSeconds":0.21684201,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21681921,"realTimeFactor":0.06723783255813953,"finite":true,"samples":77400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.125,"runSeconds":0.173199722,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173177862,"realTimeFactor":0.05542391104,"finite":true,"samples":75000},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.2,"runSeconds":0.174245042,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174211541,"realTimeFactor":0.05445157562499999,"finite":true,"samples":76800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.875,"runSeconds":0.17069719,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17067346,"realTimeFactor":0.059372935652173914,"finite":true,"samples":69000},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.675,"runSeconds":0.154949564,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154921754,"realTimeFactor":0.057925070654205615,"finite":true,"samples":64200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.85,"runSeconds":0.159252101,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159231921,"realTimeFactor":0.0558779301754386,"finite":true,"samples":68400},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.1,"runSeconds":0.16594001,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165914639,"realTimeFactor":0.05352903548387097,"finite":true,"samples":74400},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.275,"runSeconds":0.18212773,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182103039,"realTimeFactor":0.05561152061068702,"finite":true,"samples":78600},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.775,"runSeconds":0.153126788,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153107918,"realTimeFactor":0.05518082450450451,"finite":true,"samples":66600},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.75,"runSeconds":0.151412613,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151391923,"realTimeFactor":0.055059132000000004,"finite":true,"samples":66000},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.0,"runSeconds":0.222043095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222019255,"realTimeFactor":0.074014365,"finite":true,"samples":72000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.1,"runSeconds":0.176561622,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176530781,"realTimeFactor":0.05695536193548387,"finite":true,"samples":74400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.825,"runSeconds":0.156160534,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156139254,"realTimeFactor":0.05527806513274335,"finite":true,"samples":67800},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.6,"runSeconds":0.143574215,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143553015,"realTimeFactor":0.05522085192307692,"finite":true,"samples":62400},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.15,"runSeconds":0.178158465,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178135655,"realTimeFactor":0.05655824285714286,"finite":true,"samples":75600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.925,"runSeconds":0.159474763,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159453393,"realTimeFactor":0.0545212864957265,"finite":true,"samples":70200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.125,"runSeconds":0.169001286,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168979066,"realTimeFactor":0.05408041152,"finite":true,"samples":75000},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.9,"runSeconds":0.191627052,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191604962,"realTimeFactor":0.06607829379310345,"finite":true,"samples":69600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.4,"runSeconds":0.13375006,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13372324,"realTimeFactor":0.05572919166666667,"finite":true,"samples":57600},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.075,"runSeconds":0.172111063,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172088183,"realTimeFactor":0.05597107739837398,"finite":true,"samples":73800},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.1,"runSeconds":0.163212076,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163189385,"realTimeFactor":0.05264905677419355,"finite":true,"samples":74400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.925,"runSeconds":0.16485331,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16483133,"realTimeFactor":0.056360105982905986,"finite":true,"samples":70200},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.95,"runSeconds":0.161948615,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161924954,"realTimeFactor":0.05489783559322033,"finite":true,"samples":70800},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.025,"runSeconds":0.164802739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164780209,"realTimeFactor":0.054480244297520665,"finite":true,"samples":72600},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.8,"runSeconds":0.154405769,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154383969,"realTimeFactor":0.0551449175,"finite":true,"samples":67200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.05,"runSeconds":0.179443756,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179418356,"realTimeFactor":0.05883401836065574,"finite":true,"samples":73200},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.825,"runSeconds":0.156333996,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156303945,"realTimeFactor":0.05533946761061947,"finite":true,"samples":67800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.825,"runSeconds":0.156455877,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156434637,"realTimeFactor":0.05538261132743362,"finite":true,"samples":67800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.875,"runSeconds":0.15221413,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1521914,"realTimeFactor":0.05294404521739131,"finite":true,"samples":69000},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.75,"runSeconds":0.153230989,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153209958,"realTimeFactor":0.05572035963636364,"finite":true,"samples":66000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.975,"runSeconds":0.163531568,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163510848,"realTimeFactor":0.05496859428571428,"finite":true,"samples":71400},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.9,"runSeconds":0.158517555,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158495194,"realTimeFactor":0.054661225862068966,"finite":true,"samples":69600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.975,"runSeconds":0.162685151,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162662581,"realTimeFactor":0.0546840843697479,"finite":true,"samples":71400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.125,"runSeconds":0.181081941,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18105737,"realTimeFactor":0.05794622112,"finite":true,"samples":75000},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.925,"runSeconds":0.163651929,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163622919,"realTimeFactor":0.05594937743589744,"finite":true,"samples":70200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.0,"runSeconds":0.163883361,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163861351,"realTimeFactor":0.054627787000000004,"finite":true,"samples":72000},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.725,"runSeconds":0.148812341,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14879227,"realTimeFactor":0.054610033394495404,"finite":true,"samples":65400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.0,"runSeconds":0.170813441,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170780711,"realTimeFactor":0.05693781366666667,"finite":true,"samples":72000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.175,"runSeconds":0.172614767,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172592597,"realTimeFactor":0.054366855748031497,"finite":true,"samples":76200},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.975,"runSeconds":0.163976132,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163954912,"realTimeFactor":0.05511802756302521,"finite":true,"samples":71400},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.1,"runSeconds":0.221551412,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221526582,"realTimeFactor":0.07146819741935484,"finite":true,"samples":74400},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.95,"runSeconds":0.169171847,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169142126,"realTimeFactor":0.057346388813559315,"finite":true,"samples":70800},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.1,"runSeconds":0.173171602,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173147022,"realTimeFactor":0.05586180709677419,"finite":true,"samples":74400},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.8,"runSeconds":0.159859257,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159838547,"realTimeFactor":0.05709259178571429,"finite":true,"samples":67200},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.25,"runSeconds":0.176949044,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176925704,"realTimeFactor":0.05444585969230769,"finite":true,"samples":78000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.075,"runSeconds":0.169031596,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169009156,"realTimeFactor":0.054969624715447155,"finite":true,"samples":73800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.25,"runSeconds":0.199734042,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199709072,"realTimeFactor":0.06145662830769231,"finite":true,"samples":78000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.0,"runSeconds":0.168672563,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168648733,"realTimeFactor":0.05622418766666667,"finite":true,"samples":72000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.184665982,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184631892,"realTimeFactor":0.057260769612403103,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.0,"runSeconds":0.166619665,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166597925,"realTimeFactor":0.055539888333333336,"finite":true,"samples":72000},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.85,"runSeconds":0.155790791,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15576945,"realTimeFactor":0.054663435438596496,"finite":true,"samples":68400},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.15,"runSeconds":0.17293337,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17290938,"realTimeFactor":0.05489948253968254,"finite":true,"samples":75600},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.075,"runSeconds":0.167749994,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167727864,"realTimeFactor":0.05455284357723578,"finite":true,"samples":73800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.975,"runSeconds":0.161780113,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161757713,"realTimeFactor":0.05437986991596638,"finite":true,"samples":71400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.7,"runSeconds":0.141448487,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141427756,"realTimeFactor":0.05238832851851852,"finite":true,"samples":64800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.95,"runSeconds":0.162525159,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162501449,"realTimeFactor":0.05509327423728813,"finite":true,"samples":70800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.3,"runSeconds":0.188683966,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188650496,"realTimeFactor":0.0571769593939394,"finite":true,"samples":79200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.1,"runSeconds":0.171732219,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171708959,"realTimeFactor":0.055397489999999994,"finite":true,"samples":74400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.15,"runSeconds":0.171953351,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171928961,"realTimeFactor":0.0545883653968254,"finite":true,"samples":75600},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.0,"runSeconds":0.163129624,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163105864,"realTimeFactor":0.054376541333333334,"finite":true,"samples":72000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.9,"runSeconds":0.210453265,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210429835,"realTimeFactor":0.07257009137931035,"finite":true,"samples":69600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.65,"runSeconds":0.146856474,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146835214,"realTimeFactor":0.05541753735849056,"finite":true,"samples":63600},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.05,"runSeconds":0.167365141,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167340811,"realTimeFactor":0.054873816721311475,"finite":true,"samples":73200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.8,"runSeconds":0.151793017,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151768857,"realTimeFactor":0.05421179178571429,"finite":true,"samples":67200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.9,"runSeconds":0.159537894,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159514764,"realTimeFactor":0.05501306689655173,"finite":true,"samples":69600},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.725,"runSeconds":0.155366187,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155338277,"realTimeFactor":0.05701511449541284,"finite":true,"samples":65400},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.7,"runSeconds":0.150886799,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150851629,"realTimeFactor":0.05588399962962962,"finite":true,"samples":64800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.825,"runSeconds":0.154696682,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154673111,"realTimeFactor":0.054759887433628314,"finite":true,"samples":67800},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.975,"runSeconds":0.163307035,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163282385,"realTimeFactor":0.05489312100840336,"finite":true,"samples":71400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.8,"runSeconds":0.16053192,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1605093,"realTimeFactor":0.057332828571428573,"finite":true,"samples":67200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.7,"runSeconds":0.150401992,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150379282,"realTimeFactor":0.05570444148148148,"finite":true,"samples":64800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.05,"runSeconds":0.165812806,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165786736,"realTimeFactor":0.054364854426229514,"finite":true,"samples":73200},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":3.2,"runSeconds":0.174736284,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174710163,"realTimeFactor":0.054605088749999996,"finite":true,"samples":76800},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":3.0,"runSeconds":0.171961709,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171932429,"realTimeFactor":0.05732056966666666,"finite":true,"samples":72000},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":2.95,"runSeconds":0.164874328,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164838437,"realTimeFactor":0.0558896027118644,"finite":true,"samples":70800},{"index":96,"text":"The term ended in late June that year.","audioSeconds":3.125,"runSeconds":0.170638978,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170612278,"realTimeFactor":0.05460447296,"finite":true,"samples":75000},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":3.075,"runSeconds":0.167806873,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167778803,"realTimeFactor":0.05457134081300812,"finite":true,"samples":73800},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.55,"runSeconds":0.144090559,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144069608,"realTimeFactor":0.05650610156862746,"finite":true,"samples":61200},{"index":99,"text":"The bill was paid every third week.","audioSeconds":2.95,"runSeconds":0.161464498,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161440608,"realTimeFactor":0.05473372813559322,"finite":true,"samples":70800},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":3.0,"runSeconds":0.162279846,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162254896,"realTimeFactor":0.054093282,"finite":true,"samples":72000},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":2.8,"runSeconds":0.164170892,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164141182,"realTimeFactor":0.05863246142857144,"finite":true,"samples":67200},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.75,"runSeconds":0.154564829,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154530109,"realTimeFactor":0.05620539236363636,"finite":true,"samples":66000},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.1,"runSeconds":0.170301155,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170275215,"realTimeFactor":0.054935856451612905,"finite":true,"samples":74400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.925,"runSeconds":0.16853887,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16851461,"realTimeFactor":0.0576201264957265,"finite":true,"samples":70200},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.05,"runSeconds":0.165864886,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165839526,"realTimeFactor":0.05438192983606557,"finite":true,"samples":73200},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.175,"runSeconds":0.171601397,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171574957,"realTimeFactor":0.05404768409448819,"finite":true,"samples":76200},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.177398767,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177369256,"realTimeFactor":0.058644220495867774,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.75,"runSeconds":0.152630572,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152595932,"realTimeFactor":0.05550202618181818,"finite":true,"samples":66000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.85,"runSeconds":0.156291844,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156267774,"realTimeFactor":0.05483924350877193,"finite":true,"samples":68400},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.325,"runSeconds":0.188095229,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188070869,"realTimeFactor":0.05656999368421053,"finite":true,"samples":79800},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":3.05,"runSeconds":0.166569883,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166545993,"realTimeFactor":0.05461307639344263,"finite":true,"samples":73200},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.7,"runSeconds":0.149183312,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149151042,"realTimeFactor":0.05525307851851852,"finite":true,"samples":64800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":3.075,"runSeconds":0.177631069,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177601319,"realTimeFactor":0.057766201300813,"finite":true,"samples":73800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":2.925,"runSeconds":0.162458987,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162421937,"realTimeFactor":0.05554153401709402,"finite":true,"samples":70200},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":2.925,"runSeconds":0.160038617,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160015736,"realTimeFactor":0.054714057094017096,"finite":true,"samples":70200},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":3.0,"runSeconds":0.16975751,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16973137,"realTimeFactor":0.05658583666666667,"finite":true,"samples":72000},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.425,"runSeconds":0.187568674,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187541304,"realTimeFactor":0.05476457635036496,"finite":true,"samples":82200},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.7,"runSeconds":0.147071764,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147049084,"realTimeFactor":0.0544710237037037,"finite":true,"samples":64800},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":2.825,"runSeconds":0.166454952,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166426552,"realTimeFactor":0.05892210690265486,"finite":true,"samples":67800},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.7,"runSeconds":0.150003859,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149970119,"realTimeFactor":0.05555698481481481,"finite":true,"samples":64800},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":2.85,"runSeconds":0.159086668,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159062798,"realTimeFactor":0.05581988350877192,"finite":true,"samples":68400},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":3.075,"runSeconds":0.173454682,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173430912,"realTimeFactor":0.056408026666666666,"finite":true,"samples":73800},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":3.0,"runSeconds":0.164654556,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164630536,"realTimeFactor":0.054884852000000005,"finite":true,"samples":72000},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":3.1,"runSeconds":0.169222006,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169197186,"realTimeFactor":0.05458774387096774,"finite":true,"samples":74400},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":3.05,"runSeconds":0.181033028,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181003068,"realTimeFactor":0.05935509114754099,"finite":true,"samples":73200},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":3.025,"runSeconds":0.171440805,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171404704,"realTimeFactor":0.05667464628099174,"finite":true,"samples":72600},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":2.875,"runSeconds":0.160430139,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160403889,"realTimeFactor":0.05580178747826087,"finite":true,"samples":69000},{"index":128,"text":"Feel the heat of the weak dying flame.","audioSeconds":3.025,"runSeconds":0.172945638,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172920388,"realTimeFactor":0.0571721117355372,"finite":true,"samples":72600},{"index":129,"text":"The tiny girl took off her hat.","audioSeconds":2.6,"runSeconds":0.14425849,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14423562,"realTimeFactor":0.055484034615384606,"finite":true,"samples":62400},{"index":130,"text":"A cramp is no small danger on a swim.","audioSeconds":3.2,"runSeconds":0.174418121,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174391051,"realTimeFactor":0.0545056628125,"finite":true,"samples":76800},{"index":131,"text":"He said the same phrase thirty times.","audioSeconds":3.075,"runSeconds":0.192758,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192726309,"realTimeFactor":0.06268552845528455,"finite":true,"samples":73800},{"index":132,"text":"Pluck the bright rose without leaves.","audioSeconds":2.9,"runSeconds":0.162017573,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161982523,"realTimeFactor":0.055868128620689655,"finite":true,"samples":69600},{"index":133,"text":"Two plus seven is less than ten.","audioSeconds":2.875,"runSeconds":0.161891472,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161868172,"realTimeFactor":0.056310077217391306,"finite":true,"samples":69000},{"index":134,"text":"The glow deepened in the eyes of the sweet girl.","audioSeconds":3.25,"runSeconds":0.186125803,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186101142,"realTimeFactor":0.05726947784615385,"finite":true,"samples":78000},{"index":135,"text":"Bring your problems to the wise chief.","audioSeconds":2.8,"runSeconds":0.154097124,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154072914,"realTimeFactor":0.05503468714285715,"finite":true,"samples":67200},{"index":136,"text":"Write a fond note to the friend you cherish.","audioSecon