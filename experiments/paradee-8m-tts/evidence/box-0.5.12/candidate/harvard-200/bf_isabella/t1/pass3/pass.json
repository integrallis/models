,"text":"Pure bred poodles have curls.","audioSeconds":2.625,"runSeconds":0.143988427,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143965627,"realTimeFactor":0.054852734095238095,"finite":true,"samples":63000},{"index":146,"text":"The tree top waved in a graceful way.","audioSeconds":3.0,"runSeconds":0.169115464,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169086414,"realTimeFactor":0.05637182133333333,"finite":true,"samples":72000},{"index":147,"text":"The spot on the blotter was made by green ink.","audioSeconds":3.3,"runSeconds":0.18478118,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18474321,"realTimeFactor":0.05599429696969697,"finite":true,"samples":79200},{"index":148,"text":"Mud was spattered on the front of his white shirt.","audioSeconds":3.375,"runSeconds":0.18588746,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18586085,"realTimeFactor":0.05507776592592593,"finite":true,"samples":81000},{"index":149,"text":"The cigar burned a hole in the desk top.","audioSeconds":2.975,"runSeconds":0.162231655,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162206135,"realTimeFactor":0.0545316487394958,"finite":true,"samples":71400},{"index":150,"text":"The empty flask stood on the tin tray.","audioSeconds":3.025,"runSeconds":0.169651399,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169626959,"realTimeFactor":0.056083107107438024,"finite":true,"samples":72600},{"index":151,"text":"A speedy man can beat this track mark.","audioSeconds":3.075,"runSeconds":0.167545061,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167519521,"realTimeFactor":0.054486198699186986,"finite":true,"samples":73800},{"index":152,"text":"He broke a new shoelace that day.","audioSeconds":2.675,"runSeconds":0.147076184,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147053473,"realTimeFactor":0.05498175102803739,"finite":true,"samples":64200},{"index":153,"text":"The coffee stand is too high for the couch.","audioSeconds":3.075,"runSeconds":0.167047647,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167023057,"realTimeFactor":0.05432443804878048,"finite":true,"samples":73800},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":3.1,"runSeconds":0.179492445,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179462534,"realTimeFactor":0.057900788709677416,"finite":true,"samples":74400},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.6,"runSeconds":0.146238326,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146203436,"realTimeFactor":0.05624551,"finite":true,"samples":62400},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":3.0,"runSeconds":0.165777116,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165753556,"realTimeFactor":0.05525903866666667,"finite":true,"samples":72000},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":3.05,"runSeconds":0.166136329,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166111798,"realTimeFactor":0.05447092754098361,"finite":true,"samples":73200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.825,"runSeconds":0.175129967,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175106927,"realTimeFactor":0.06199290867256637,"finite":true,"samples":67800},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.375,"runSeconds":0.181083118,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181057498,"realTimeFactor":0.053654257185185183,"finite":true,"samples":81000},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":3.05,"runSeconds":0.167227399,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167203119,"realTimeFactor":0.05482865540983607,"finite":true,"samples":73200},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.85,"runSeconds":0.155535217,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155511867,"realTimeFactor":0.054573760350877194,"finite":true,"samples":68400},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.725,"runSeconds":0.163830949,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163803189,"realTimeFactor":0.060121449174311926,"finite":true,"samples":65400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.925,"runSeconds":0.161286667,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161251327,"realTimeFactor":0.05514074085470086,"finite":true,"samples":70200},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.0,"runSeconds":0.164814077,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164790937,"realTimeFactor":0.05493802566666667,"finite":true,"samples":72000},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.25,"runSeconds":0.184231566,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184206915,"realTimeFactor":0.056686635692307696,"finite":true,"samples":78000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.05,"runSeconds":0.164710737,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164675077,"realTimeFactor":0.054003520327868856,"finite":true,"samples":73200},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.075,"runSeconds":0.168800852,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168776382,"realTimeFactor":0.05489458601626016,"finite":true,"samples":73800},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.9,"runSeconds":0.156897119,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156873178,"realTimeFactor":0.05410245482758621,"finite":true,"samples":69600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.05,"runSeconds":0.176121195,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176092505,"realTimeFactor":0.05774465409836066,"finite":true,"samples":73200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.775,"runSeconds":0.154538969,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154503448,"realTimeFactor":0.05568971855855856,"finite":true,"samples":66600},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.05,"runSeconds":0.165526633,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165502673,"realTimeFactor":0.05427102721311476,"finite":true,"samples":73200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.1,"runSeconds":0.168466139,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168441069,"realTimeFactor":0.054343915806451606,"finite":true,"samples":74400},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.325,"runSeconds":0.186345444,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186317904,"realTimeFactor":0.056043742556390976,"finite":true,"samples":79800},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.875,"runSeconds":0.157800147,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157777877,"realTimeFactor":0.054887007652173914,"finite":true,"samples":69000},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.925,"runSeconds":0.159089298,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159065138,"realTimeFactor":0.05438950358974359,"finite":true,"samples":70200},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.825,"runSeconds":0.168870662,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168841552,"realTimeFactor":0.05977722548672566,"finite":true,"samples":67800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.95,"runSeconds":0.163365675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163330045,"realTimeFactor":0.05537819491525423,"finite":true,"samples":70800},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.125,"runSeconds":0.171194273,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171168872,"realTimeFactor":0.05478216736,"finite":true,"samples":75000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.975,"runSeconds":0.171915299,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171892229,"realTimeFactor":0.05778665512605042,"finite":true,"samples":71400},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.875,"runSeconds":0.155257935,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155234294,"realTimeFactor":0.054002760000000004,"finite":true,"samples":69000},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.75,"runSeconds":0.150815527,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150791606,"realTimeFactor":0.05484200981818182,"finite":true,"samples":66000},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.05,"runSeconds":0.188860426,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188831315,"realTimeFactor":0.06192145114754099,"finite":true,"samples":73200},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.35,"runSeconds":0.184600209,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184563378,"realTimeFactor":0.055104539999999994,"finite":true,"samples":80400},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.9,"runSeconds":0.15814743,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158124509,"realTimeFactor":0.05453359655172414,"finite":true,"samples":69600},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.775,"runSeconds":0.154700611,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154678431,"realTimeFactor":0.055747967927927924,"finite":true,"samples":66600},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.75,"runSeconds":0.151184491,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151162221,"realTimeFactor":0.05497617854545455,"finite":true,"samples":66000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.85,"runSeconds":0.155500999,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155477759,"realTimeFactor":0.054561754035087714,"finite":true,"samples":68400},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.25,"runSeconds":0.211939032,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211908302,"realTimeFactor":0.06521200984615384,"finite":true,"samples":78000},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.025,"runSeconds":0.169654633,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169617342,"realTimeFactor":0.05608417619834711,"finite":true,"samples":72600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":3.0,"runSeconds":0.166543146,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166517195,"realTimeFactor":0.055514382,"finite":true,"samples":72000},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":3.125,"runSeconds":0.178895463,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178868203,"realTimeFactor":0.05724654816,"finite":true,"samples":75000},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.625,"runSeconds":0.145334601,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14531157,"realTimeFactor":0.055365562285714286,"finite":true,"samples":63000},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":3.0,"runSeconds":0.16251372,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16248951,"realTimeFactor":0.05417124,"finite":true,"samples":72000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.9,"runSeconds":0.176472803,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176444772,"realTimeFactor":0.06085269068965518,"finite":true,"samples":69600},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.9,"runSeconds":0.160080769,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160044839,"realTimeFactor":0.0552002651724138,"finite":true,"samples":69600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":3.025,"runSeconds":0.168983537,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168958337,"realTimeFactor":0.055862326280991734,"finite":true,"samples":72600},{"index":197,"text":"Bring your best compass to the third class.","audioSecon