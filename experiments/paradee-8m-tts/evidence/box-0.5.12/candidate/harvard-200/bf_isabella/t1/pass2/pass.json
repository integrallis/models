00},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":2.825,"runSeconds":0.156198327,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156174276,"realTimeFactor":0.05529144318584071,"finite":true,"samples":67800},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.7,"runSeconds":0.146951166,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146929376,"realTimeFactor":0.054426357777777774,"finite":true,"samples":64800},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":2.85,"runSeconds":0.159735747,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159710577,"realTimeFactor":0.05604763052631579,"finite":true,"samples":68400},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":3.075,"runSeconds":0.166583268,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166559247,"realTimeFactor":0.05417342048780488,"finite":true,"samples":73800},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":3.0,"runSeconds":0.164153297,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164127806,"realTimeFactor":0.05471776566666667,"finite":true,"samples":72000},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":3.1,"runSeconds":0.168292953,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168264163,"realTimeFactor":0.054288049354838705,"finite":true,"samples":74400},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":3.05,"runSeconds":0.18055374,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180524389,"realTimeFactor":0.059197947540983606,"finite":true,"samples":73200},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":3.025,"runSeconds":0.169927947,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169890797,"realTimeFactor":0.0561745279338843,"finite":true,"samples":72600},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":2.875,"runSeconds":0.159152522,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.