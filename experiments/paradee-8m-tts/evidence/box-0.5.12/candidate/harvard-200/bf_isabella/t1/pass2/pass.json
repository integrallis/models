{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {onnxDynamicNodes=1311, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxOperators=56, onnxOpset=17, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnx-kernels=rust-ffm, graph=onnx_paradee_int8.onnx, onnxNodes=2535, backend=pure-java} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bf_isabella","voiceIndex":1,"corpus":"harvard-200","pass":2,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":594.5500000000001,"totalRunSeconds":33.682960871000006,"realTimeMultiple":17.651357975239325,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.175,"runSeconds":0.304267797,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.304120345,"realTimeFactor":0.09583237700787402,"finite":true,"samples":76200},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.025,"runSeconds":0.232870884,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232746183,"realTimeFactor":0.07698211041322314,"finite":true,"samples":72600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.85,"runSeconds":0.188049662,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188030412,"realTimeFactor":0.06598233754385965,"finite":true,"samples":68400},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.25,"runSeconds":0.226148274,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226124984,"realTimeFactor":0.0695840843076923,"finite":true,"samples":78000},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.225,"runSeconds":0.17634425,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17630493,"realTimeFactor":0.05468038759689923,"finite":true,"samples":77400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.95,"runSeconds":0.150692266,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150670655,"realTimeFactor":0.0510821240677966,"finite":true,"samples":70800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.15,"runSeconds":0.163667869,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163645909,"realTimeFactor":0.05195805365079365,"finite":true,"samples":75600},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.05,"runSeconds":0.182826717,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182803646,"realTimeFactor":0.05994318590163935,"finite":true,"samples":73200},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.95,"runSeconds":0.166978668,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166953728,"realTimeFactor":0.05660293830508474,"finite":true,"samples":70800},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.4,"runSeconds":0.196561727,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196517626,"realTimeFactor":0.05781227264705882,"finite":true,"samples":81600},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.7,"runSeconds":0.150394153,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150373523,"realTimeFactor":0.05570153814814815,"finite":true,"samples":64800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.025,"runSeconds":0.163983912,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163961782,"realTimeFactor":0.05420955768595042,"finite":true,"samples":72600},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.4,"runSeconds":0.198576054,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198545854,"realTimeFactor":0.05840472176470588,"finite":true,"samples":81600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.925,"runSeconds":0.160565622,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160543142,"realTimeFactor":0.05489422974358974,"finite":true,"samples":70200},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.825,"runSeconds":0.166882527,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166862397,"realTimeFactor":0.05907346088495575,"finite":true,"samples":67800},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.05,"runSeconds":0.167688264,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167666134,"realTimeFactor":0.054979758688524595,"finite":true,"samples":73200},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.95,"runSeconds":0.176524882,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176498432,"realTimeFactor":0.05983894305084745,"finite":true,"samples":70800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.95,"runSeconds":0.165238843,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165196963,"realTimeFactor":0.05601316711864406,"finite":true,"samples":70800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.825,"runSeconds":0.162425519,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162405448,"realTimeFactor":0.05749575893805309,"finite":true,"samples":67800},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.025,"runSeconds":0.166347982,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166325362,"realTimeFactor":0.05499106842975207,"finite":true,"samples":72600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.85,"runSeconds":0.157348304,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157327623,"realTimeFactor":0.05520993122807017,"finite":true,"samples":68400},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.225,"runSeconds":0.18893676,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18890257,"realTimeFactor":0.05858504186046512,"finite":true,"samples":77400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.125,"runSeconds":0.174994898,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174972938,"realTimeFactor":0.05599836736,"finite":true,"samples":75000},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.2,"runSeconds":0.184788743,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184764183,"realTimeFactor":0.057746482187499996,"finite":true,"samples":76800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.875,"runSeconds":0.1569305,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15690867,"realTimeFactor":0.054584521739130434,"finite":true,"samples":69000},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.675,"runSeconds":0.159809345,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159788305,"realTimeFactor":0.05974181121495327,"finite":true,"samples":64200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.85,"runSeconds":0.161126477,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161102767,"realTimeFactor":0.05653560596491228,"finite":true,"samples":68400},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.1,"runSeconds":0.169110197,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169073887,"realTimeFactor":0.0545516764516129,"finite":true,"samples":74400},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.275,"runSeconds":0.181851478,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181824948,"realTimeFactor":0.05552716885496184,"finite":true,"samples":78600},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.775,"runSeconds":0.151514053,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151490003,"realTimeFactor":0.054599658738738746,"finite":true,"samples":66600},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.75,"runSeconds":0.149802018,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149782598,"realTimeFactor":0.054473461090909094,"finite":true,"samples":66000},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.0,"runSeconds":0.164073033,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164052313,"realTimeFactor":0.054691011000000005,"finite":true,"samples":72000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.1,"runSeconds":0.230015039,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229989579,"realTimeFactor":0.07419839967741935,"finite":true,"samples":74400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.825,"runSeconds":0.157372304,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157341204,"realTimeFactor":0.05570701026548672,"finite":true,"samples":67800},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.6,"runSeconds":0.143540224,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143520844,"realTimeFactor":0.05520777846153846,"finite":true,"samples":62400},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.15,"runSeconds":0.171293926,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171269916,"realTimeFactor":0.05437902412698413,"finite":true,"samples":75600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.925,"runSeconds":0.173224022,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173202982,"realTimeFactor":0.05922188786324787,"finite":true,"samples":70200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.125,"runSeconds":0.1694866,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16946258,"realTimeFactor":0.054235712,"finite":true,"samples":75000},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.9,"runSeconds":0.159416382,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159395432,"realTimeFactor":0.05497116620689655,"finite":true,"samples":69600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.4,"runSeconds":0.130056446,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130038456,"realTimeFactor":0.054190185833333335,"finite":true,"samples":57600},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.075,"runSeconds":0.225975853,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225950473,"realTimeFactor":0.07348808227642276,"finite":true,"samples":73800},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.1,"runSeconds":0.170034175,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170000305,"realTimeFactor":0.05484973387096774,"finite":true,"samples":74400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.925,"runSeconds":0.161759692,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161737342,"realTimeFactor":0.05530245880341881,"finite":true,"samples":70200},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.95,"runSeconds":0.159767465,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159744805,"realTimeFactor":0.054158462711864405,"finite":true,"samples":70800},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.025,"runSeconds":0.167896806,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167874746,"realTimeFactor":0.05550307636363637,"finite":true,"samples":72600},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.8,"runSeconds":0.153423419,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153402469,"realTimeFactor":0.05479407821428572,"finite":true,"samples":67200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.05,"runSeconds":0.166841697,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166819537,"realTimeFactor":0.05470219573770493,"finite":true,"samples":73200},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.825,"runSeconds":0.17403226,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17400516,"realTimeFactor":0.06160433982300884,"finite":true,"samples":67800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.825,"runSeconds":0.161113757,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161082857,"realTimeFactor":0.05703141840707964,"finite":true,"samples":67800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.875,"runSeconds":0.154982943,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154960573,"realTimeFactor":0.05390711060869566,"finite":true,"samples":69000},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.75,"runSeconds":0.150493034,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150472174,"realTimeFactor":0.05472473963636364,"finite":true,"samples":66000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.975,"runSeconds":0.161721102,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161698282,"realTimeFactor":0.05436003428571429,"finite":true,"samples":71400},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.9,"runSeconds":0.158355582,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158332752,"realTimeFactor":0.054605373103448276,"finite":true,"samples":69600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.975,"runSeconds":0.162669311,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16264763,"realTimeFactor":0.05467876,"finite":true,"samples":71400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.125,"runSeconds":0.170889822,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170864762,"realTimeFactor":0.05468474304,"finite":true,"samples":75000},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.925,"runSeconds":0.159451783,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159430783,"realTimeFactor":0.05451343008547009,"finite":true,"samples":70200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.0,"runSeconds":0.180694908,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180669547,"realTimeFactor":0.060231636,"finite":true,"samples":72000},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.725,"runSeconds":0.152476712,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152445841,"realTimeFactor":0.0559547566972477,"finite":true,"samples":65400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.0,"runSeconds":0.166795447,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166773556,"realTimeFactor":0.05559848233333334,"finite":true,"samples":72000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.175,"runSeconds":0.171584668,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171562808,"realTimeFactor":0.05404241511811024,"finite":true,"samples":76200},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.975,"runSeconds":0.199647693,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199626403,"realTimeFactor":0.06710846823529411,"finite":true,"samples":71400},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.1,"runSeconds":0.169968555,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169942534,"realTimeFactor":0.05482856612903225,"finite":true,"samples":74400},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.95,"runSeconds":0.162434599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162412979,"realTimeFactor":0.05506257593220339,"finite":true,"samples":70800},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.1,"runSeconds":0.169700532,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169678282,"realTimeFactor":0.05474210709677419,"finite":true,"samples":74400},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.8,"runSeconds":0.16723395,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16721053,"realTimeFactor":0.059726410714285715,"finite":true,"samples":67200},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.25,"runSeconds":0.17520623,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175173309,"realTimeFactor":0.05390960923076923,"finite":true,"samples":78000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.075,"runSeconds":0.168115138,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168094158,"realTimeFactor":0.05467158959349593,"finite":true,"samples":73800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.25,"runSeconds":0.191353051,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191329231,"realTimeFactor":0.058877861846153845,"finite":true,"samples":78000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.0,"runSeconds":0.163798451,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16377606,"realTimeFactor":0.05459948366666667,"finite":true,"samples":72000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.17863359,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17861074,"realTimeFactor":0.05539026046511628,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.0,"runSeconds":0.176134698,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176110478,"realTimeFactor":0.058711566,"finite":true,"samples":72000},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.85,"runSeconds":0.161099517,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161068917,"realTimeFactor":0.05652614631578947,"finite":true,"samples":68400},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.15,"runSeconds":0.18089718,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1808739,"realTimeFactor":0.05742767619047619,"finite":true,"samples":75600},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.075,"runSeconds":0.166271892,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166249482,"realTimeFactor":0.05407216,"finite":true,"samples":73800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.975,"runSeconds":0.161837193,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161815503,"realTimeFactor":0.05439905647058823,"finite":true,"samples":71400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.7,"runSeconds":0.149655086,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149632546,"realTimeFactor":0.05542780962962962,"finite":true,"samples":64800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.95,"runSeconds":0.164363216,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164332725,"realTimeFactor":0.05571634440677966,"finite":true,"samples":70800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.3,"runSeconds":0.190574474,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190550124,"realTimeFactor":0.05774984060606061,"finite":true,"samples":79200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.1,"runSeconds":0.169231707,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169207137,"realTimeFactor":0.054590873225806455,"finite":true,"samples":74400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.15,"runSeconds":0.186451198,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186422548,"realTimeFactor":0.05919085650793651,"finite":true,"samples":75600},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.0,"runSeconds":0.166606414,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166572544,"realTimeFactor":0.055535471333333336,"finite":true,"samples":72000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.9,"runSeconds":0.164815349,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164790759,"realTimeFactor":0.056832878965517246,"finite":true,"samples":69600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.65,"runSeconds":0.147231735,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147209475,"realTimeFactor":0.05555914528301887,"finite":true,"samples":63600},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.05,"runSeconds":0.165548446,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165523896,"realTimeFactor":0.054278179016393445,"finite":true,"samples":73200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.8,"runSeconds":0.160541742,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160513402,"realTimeFactor":0.05733633642857143,"finite":true,"samples":67200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.9,"runSeconds":0.16378807,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16375186,"realTimeFactor":0.05647864482758621,"finite":true,"samples":69600},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.725,"runSeconds":0.147991982,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147969502,"realTimeFactor":0.05430898422018348,"finite":true,"samples":65400},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.7,"runSeconds":0.15010749,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15008441,"realTimeFactor":0.05559536666666667,"finite":true,"samples":64800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.825,"runSeconds":0.154008925,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153984895,"realTimeFactor":0.05451643362831858,"finite":true,"samples":67800},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.975,"runSeconds":0.162866342,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162842212,"realTimeFactor":0.054744988907563026,"finite":true,"samples":71400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.8,"runSeconds":0.167821325,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167794185,"realTimeFactor":0.0599361875,"finite":true,"samples":67200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.7,"runSeconds":0.152869905,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152836304,"realTimeFactor":0.05661848333333333,"finite":true,"samples":64800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.05,"runSeconds":0.166820687,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166796297,"realTimeFactor":0.054695307213114754,"finite":true,"samples":73200},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":3.2,"runSeconds":0.173885252,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173859692,"realTimeFactor":0.05433914124999999,"finite":true,"samples":76800},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":3.0,"runSeconds":0.166135884,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166112274,"realTimeFactor":0.055378628000000006,"finite":true,"samples":72000},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":2.95,"runSeconds":0.160500994,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160477514,"realTimeFactor":0.05440711661016949,"finite":true,"samples":70800},{"index":96,"text":"The term ended in late June that year.","audioSeconds":3.125,"runSeconds":0.169399863,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169375332,"realTimeFactor":0.05420795616,"finite":true,"samples":75000},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":3.075,"runSeconds":0.222734899,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222705419,"realTimeFactor":0.07243411349593495,"finite":true,"samples":73800},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.55,"runSeconds":0.142709139,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142674419,"realTimeFactor":0.055964368235294125,"finite":true,"samples":61200},{"index":99,"text":"The bill was paid every third week.","audioSeconds":2.95,"runSeconds":0.161483474,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161458923,"realTimeFactor":0.054740160677966096,"finite":true,"samples":70800},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":3.0,"runSeconds":0.161824176,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161799606,"realTimeFactor":0.053941392,"finite":true,"samples":72000},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":2.8,"runSeconds":0.156230087,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156205987,"realTimeFactor":0.05579645964285714,"finite":true,"samples":67200},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.75,"runSeconds":0.151328204,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151306004,"realTimeFactor":0.05502843781818181,"finite":true,"samples":66000},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.1,"runSeconds":0.168956099,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168930328,"realTimeFactor":0.054501967419354834,"finite":true,"samples":74400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.925,"runSeconds":0.182706509,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182677579,"realTimeFactor":0.06246376376068376,"finite":true,"samples":70200},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.05,"runSeconds":0.168687756,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168648306,"realTimeFactor":0.05530746098360656,"finite":true,"samples":73200},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.175,"runSeconds":0.175876679,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175851759,"realTimeFactor":0.055394229606299215,"finite":true,"samples":76200},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.172872123,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172846933,"realTimeFactor":0.05714780925619835,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.75,"runSeconds":0.149954863,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149931202,"realTimeFactor":0.054529041090909086,"finite":true,"samples":66000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.85,"runSeconds":0.154728414,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154705764,"realTimeFactor":0.05429067157894737,"finite":true,"samples":68400},{"index":110,"text":"The bark of the pine tree was shiny and