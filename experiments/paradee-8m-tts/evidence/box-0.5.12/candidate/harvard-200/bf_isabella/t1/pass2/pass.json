600260162601,"finite":true,"samples":73800},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":3.1,"runSeconds":0.16680914,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166785259,"realTimeFactor":0.05380939999999999,"finite":true,"samples":74400},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.6,"runSeconds":0.153686155,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153654134,"realTimeFactor":0.05911005961538461,"finite":true,"samples":62400},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":3.0,"runSeconds":0.169651794,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169622624,"realTimeFactor":0.056550598,"finite":true,"samples":72000},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":3.05,"runSeconds":0.169661855,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169626435,"realTimeFactor":0.05562683770491804,"finite":true,"samples":73200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.825,"runSeconds":0.155865455,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155842214,"realTimeFactor":0.05517361238938053,"finite":true,"samples":67800},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.375,"runSeconds":0.180171527,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180140707,"realTimeFactor":0.05338415614814815,"finite":true,"samples":81000},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":3.05,"runSeconds":0.168590406,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168565965,"realTimeFactor":0.05527554295081968,"finite":true,"samples":73200},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.85,"runSeconds":0.155519531,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155496481,"realTimeFactor":0.05456825649122807,"finite":true,"samples":68400},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.725,"runSeconds":0.149329757,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149306327,"realTimeFactor":0.054799910825688074,"finite":true,"samples":65400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.925,"runSeconds":0.157252566,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157229396,"realTimeFactor":0.05376156102564103,"finite":true,"samples":70200},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.0,"runSeconds":0.181573729,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181545889,"realTimeFactor":0.06052457633333333,"finite":true,"samples":72000},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.25,"runSeconds":0.178747334,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178710344,"realTimeFactor":0.05499917969230769,"finite":true,"samples":78000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.05,"runSeconds":0.167409095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167383455,"realTimeFactor":0.05488822786885247,"finite":true,"samples":73200},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.075,"runSeconds":0.168270352,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168245182,"realTimeFactor":0.05472206569105691,"finite":true,"samples":73800},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.9,"runSeconds":0.168325643,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168303413,"realTimeFactor":0.05804332517241379,"finite":true,"samples":69600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.05,"runSeconds":0.166353546,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166330086,"realTimeFactor":0.0545421462295082,"finite":true,"samples":73200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.775,"runSeconds":0.150691739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150665409,"realTimeFactor":0.054303329369369366,"finite":true,"samples":66600},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.05,"runSeconds":0.164509889,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164485359,"realTimeFactor":0.053937668524590164,"finite":true,"samples":73200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.1,"runSeconds":0.241984608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241955538,"realTimeFactor":0.07805955096774193,"finite":true,"samples":74400},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.325,"runSeconds":0.183602207,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183561337,"realTimeFactor":0.055218708872180444,"finite":true,"samples":79800},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.875,"runSeconds":0.15655152,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15652626,"realTimeFactor":0.054452702608695655,"finite":true,"samples":69000},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.925,"runSeconds":0.158278056,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158243975,"realTimeFactor":0.0541121558974359,"finite":true,"samples":70200},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.825,"runSeconds":0.162773164,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162750804,"realTimeFactor":0.05761881911504425,"finite":true,"samples":67800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.95,"runSeconds":0.16117487,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16115046,"realTimeFactor":0.054635549152542366,"finite":true,"samples":70800},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.125,"runSeconds":0.169577714,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169553704,"realTimeFactor":0.05426486848,"finite":true,"samples":75000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.975,"runSeconds":0.160885608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160861608,"realTimeFactor":0.05407919596638656,"finite":true,"samples":71400},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.875,"runSeconds":0.165164615,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165126735,"realTimeFactor":0.05744856173913043,"finite":true,"samples":69000},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.75,"runSeconds":0.152619596,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152584836,"realTimeFactor":0.05549803490909091,"finite":true,"samples":66000},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.05,"runSeconds":0.164994704,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164970804,"realTimeFactor":0.054096624262295084,"finite":true,"samples":73200},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.35,"runSeconds":0.186855575,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186831315,"realTimeFactor":0.05577778358208955,"finite":true,"samples":80400},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.9,"runSeconds":0.157162586,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157139345,"realTimeFactor":0.05419399517241379,"finite":true,"samples":69600},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.775,"runSeconds":0.151460246,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151437875,"realTimeFactor":0.054580268828828826,"finite":true,"samples":66600},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.75,"runSeconds":0.148389129,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148367038,"realTimeFactor":0.05395968327272727,"finite":true,"samples":66000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.85,"runSeconds":0.161953737,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161925977,"realTimeFactor":0.05682587263157894,"finite":true,"samples":68400},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.25,"runSeconds":0.182278605,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182241225,"realTimeFactor":0.05608572461538462,"finite":true,"samples":78000},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.025,"runSeconds":0.16448294,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164458709,"realTimeFactor":0.05437452561983471,"finite":true,"samples":72600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":3.0,"runSeconds":0.17600123,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17597925,"realTimeFactor":0.05866707666666667,"finite":true,"samples":72000},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":3.125,"runSeconds":0.170581613,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170554563,"realTimeFactor":0.054586116159999996,"finite":true,"samples":75000},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.625,"runSeconds":0.143590417,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143568107,"realTimeFactor":0.054701111238095235,"finite":true,"samples":63000},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":3.0,"runSeconds":0.172419179,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172387449,"realTimeFactor":0.057473059666666666,"finite":true,"samples":72000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.9,"runSeconds":0.163946565,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163902184,"realTimeFactor":0.056533298275862065,"finite":true,"samples":69600},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.9,"runSeconds":0.16571583,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16569421,"realTimeFactor":0.05714338965517242,"finite":true,"samples":69600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":3.025,"runSeconds":0.167093943,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167068222,"realTimeFactor":0.055237667107438014,"finite":true,"samples":72600},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":3.125,"runSeconds":0.169337042,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169309782,"realTimeFactor":0.054187853439999996,"finite":true,"samples":75000},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.65,"runSeconds":0.151469616,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151441026,"realTimeFactor":0.05715834566037736,"finite":true,"samples":63600},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":3.075,"runSeconds":0.167730438,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167694678,"realTimeFactor":0.054546483902439026,"finite":true,"samples":73800}]}