{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {onnxDynamicNodes=1311, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxOperators=56, onnxOpset=17, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnx-kernels=rust-ffm, graph=onnx_paradee_int8.onnx, onnxNodes=2535, backend=pure-java} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"af_heart","voiceIndex":0,"corpus":"harvard-200","pass":3,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":524.9500000000002,"totalRunSeconds":29.876027923000013,"realTimeMultiple":17.570943545539674,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.7,"runSeconds":0.256073746,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.255938835,"realTimeFactor":0.09484212814814814,"finite":true,"samples":64800},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.7,"runSeconds":0.211045132,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210935401,"realTimeFactor":0.0781648637037037,"finite":true,"samples":64800},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.5,"runSeconds":0.214750614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214733644,"realTimeFactor":0.08590024560000001,"finite":true,"samples":60000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.9,"runSeconds":0.163721938,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163703017,"realTimeFactor":0.05645584068965518,"finite":true,"samples":69600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.8,"runSeconds":0.220826036,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220789686,"realTimeFactor":0.07886644142857144,"finite":true,"samples":67200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.575,"runSeconds":0.147401819,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147374758,"realTimeFactor":0.057243424854368924,"finite":true,"samples":61800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.154993993,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154974353,"realTimeFactor":0.057405182592592585,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.85,"runSeconds":0.158296732,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158276252,"realTimeFactor":0.05554271298245614,"finite":true,"samples":68400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.55,"runSeconds":0.152775855,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152756995,"realTimeFactor":0.0599121,"finite":true,"samples":61200},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.05,"runSeconds":0.171244222,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171220232,"realTimeFactor":0.056145646557377055,"finite":true,"samples":73200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.4,"runSeconds":0.136503926,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136478085,"realTimeFactor":0.056876635833333335,"finite":true,"samples":57600},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.625,"runSeconds":0.146923074,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146904434,"realTimeFactor":0.05597069485714285,"finite":true,"samples":63000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.1,"runSeconds":0.17211613,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17209326,"realTimeFactor":0.055521332258064514,"finite":true,"samples":74400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.575,"runSeconds":0.142043393,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142023263,"realTimeFactor":0.05516248271844659,"finite":true,"samples":61800},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.425,"runSeconds":0.144926617,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144906377,"realTimeFactor":0.05976355340206186,"finite":true,"samples":58200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.148718659,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148677639,"realTimeFactor":0.05612024867924528,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.575,"runSeconds":0.140634551,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140614751,"realTimeFactor":0.05461535961165048,"finite":true,"samples":61800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.55,"runSeconds":0.147848792,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147828482,"realTimeFactor":0.057979918431372554,"finite":true,"samples":61200},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.625,"runSeconds":0.145550313,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145530982,"realTimeFactor":0.05544773828571428,"finite":true,"samples":63000},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.65,"runSeconds":0.147417498,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147397488,"realTimeFactor":0.05562924452830189,"finite":true,"samples":63600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.525,"runSeconds":0.148428897,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148406987,"realTimeFactor":0.05878372158415842,"finite":true,"samples":60600},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.925,"runSeconds":0.163407306,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163376575,"realTimeFactor":0.055865745641025644,"finite":true,"samples":70200},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.025,"runSeconds":0.176974921,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176950551,"realTimeFactor":0.05850410611570248,"finite":true,"samples":72600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.85,"runSeconds":0.157814838,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157793497,"realTimeFactor":0.05537362736842105,"finite":true,"samples":68400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.7,"runSeconds":0.157871708,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157850717,"realTimeFactor":0.05847100296296296,"finite":true,"samples":64800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.3,"runSeconds":0.126209098,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.126189108,"realTimeFactor":0.05487352086956522,"finite":true,"samples":55200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.625,"runSeconds":0.14640646,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14637797,"realTimeFactor":0.05577388952380952,"finite":true,"samples":63000},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.825,"runSeconds":0.154085446,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154064975,"realTimeFactor":0.054543520707964595,"finite":true,"samples":67800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.05,"runSeconds":0.165414763,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165393293,"realTimeFactor":0.054234348524590165,"finite":true,"samples":73200},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.425,"runSeconds":0.134494798,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134477368,"realTimeFactor":0.055461772371134026,"finite":true,"samples":58200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.35,"runSeconds":0.139940845,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139922045,"realTimeFactor":0.059549295744680854,"finite":true,"samples":56400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.625,"runSeconds":0.14754315,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14752024,"realTimeFactor":0.05620691428571429,"finite":true,"samples":63000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.75,"runSeconds":0.153354189,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153326249,"realTimeFactor":0.05576515963636364,"finite":true,"samples":66000},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.425,"runSeconds":0.134735351,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134718251,"realTimeFactor":0.05556096948453609,"finite":true,"samples":58200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.25,"runSeconds":0.125455281,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125438471,"realTimeFactor":0.055757902666666664,"finite":true,"samples":54000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.85,"runSeconds":0.200415581,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200395461,"realTimeFactor":0.07032125649122807,"finite":true,"samples":68400},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.625,"runSeconds":0.143611797,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143591906,"realTimeFactor":0.054709256000000005,"finite":true,"samples":63000},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.7,"runSeconds":0.146886864,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146866584,"realTimeFactor":0.05440254222222222,"finite":true,"samples":64800},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.525,"runSeconds":0.139473451,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139453981,"realTimeFactor":0.0552370102970297,"finite":true,"samples":60600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.075,"runSeconds":0.11354948,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.11353336,"realTimeFactor":0.054722640963855415,"finite":true,"samples":49800},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.75,"runSeconds":0.162347367,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162324316,"realTimeFactor":0.05903540618181818,"finite":true,"samples":66000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.147050976,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147021615,"realTimeFactor":0.05446332444444444,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.5,"runSeconds":0.139640262,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139618832,"realTimeFactor":0.055856104799999994,"finite":true,"samples":60000},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.625,"runSeconds":0.143576446,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143555626,"realTimeFactor":0.054695788952380954,"finite":true,"samples":63000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.55,"runSeconds":0.139196819,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139178409,"realTimeFactor":0.05458698784313726,"finite":true,"samples":61200},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.375,"runSeconds":0.137925907,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137907327,"realTimeFactor":0.05807406610526315,"finite":true,"samples":57000},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.725,"runSeconds":0.151300952,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151280942,"realTimeFactor":0.055523285137614675,"finite":true,"samples":65400},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.425,"runSeconds":0.133913864,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133889803,"realTimeFactor":0.05522221195876289,"finite":true,"samples":58200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.575,"runSeconds":0.140918373,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140898883,"realTimeFactor":0.05472558174757282,"finite":true,"samples":61800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.525,"runSeconds":0.131305082,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131286061,"realTimeFactor":0.052002012673267324,"finite":true,"samples":60600},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.375,"runSeconds":0.152712854,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152694584,"realTimeFactor":0.06430014905263158,"finite":true,"samples":57000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.625,"runSeconds":0.14873042,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14870937,"realTimeFactor":0.05665920761904762,"finite":true,"samples":63000},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.5,"runSeconds":0.137604695,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137578585,"realTimeFactor":0.055041878,"finite":true,"samples":60000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.725,"runSeconds":0.14991766,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14989656,"realTimeFactor":0.05501565504587156,"finite":true,"samples":65400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.85,"runSeconds":0.1545966,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1545753,"realTimeFactor":0.05424442105263158,"finite":true,"samples":68400},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.6,"runSeconds":0.144749296,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144728025,"realTimeFactor":0.05567280615384615,"finite":true,"samples":62400},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.65,"runSeconds":0.145018948,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144999308,"realTimeFactor":0.054724131320754724,"finite":true,"samples":63600},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.35,"runSeconds":0.129567637,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129549386,"realTimeFactor":0.05513516468085107,"finite":true,"samples":56400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.6,"runSeconds":0.14290081,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14288122,"realTimeFactor":0.05496184999999999,"finite":true,"samples":62400},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.85,"runSeconds":0.203996462,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203973052,"realTimeFactor":0.07157770596491228,"finite":true,"samples":68400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.575,"runSeconds":0.145384162,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145356562,"realTimeFactor":0.05645986873786408,"finite":true,"samples":61800},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.775,"runSeconds":0.152714144,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152693063,"realTimeFactor":0.055032123963963966,"finite":true,"samples":66600},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.725,"runSeconds":0.148600219,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148570439,"realTimeFactor":0.054532190458715595,"finite":true,"samples":65400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.625,"runSeconds":0.151221112,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151199311,"realTimeFactor":0.057608042666666665,"finite":true,"samples":63000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.45,"runSeconds":0.13353513,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13351546,"realTimeFactor":0.05450413469387755,"finite":true,"samples":58800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.85,"runSeconds":0.155668829,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155646978,"realTimeFactor":0.05462064175438597,"finite":true,"samples":68400},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.75,"runSeconds":0.171467674,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171444823,"realTimeFactor":0.06235188145454545,"finite":true,"samples":66000},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.875,"runSeconds":0.163033093,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163002482,"realTimeFactor":0.05670716278260869,"finite":true,"samples":69000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.625,"runSeconds":0.146105277,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146086117,"realTimeFactor":0.055659153142857146,"finite":true,"samples":63000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.0,"runSeconds":0.171700766,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171677976,"realTimeFactor":0.05723358866666667,"finite":true,"samples":72000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.775,"runSeconds":0.152906795,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152885225,"realTimeFactor":0.05510154774774775,"finite":true,"samples":66600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.375,"runSeconds":0.132038827,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.132019327,"realTimeFactor":0.055595295578947365,"finite":true,"samples":57000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.725,"runSeconds":0.148504338,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148482918,"realTimeFactor":0.054497004770642204,"finite":true,"samples":65400},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.575,"runSeconds":0.151460673,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151438533,"realTimeFactor":0.05881967883495145,"finite":true,"samples":61800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.5,"runSeconds":0.139785453,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139757273,"realTimeFactor":0.0559141812,"finite":true,"samples":60000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.375,"runSeconds":0.125859945,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125840495,"realTimeFactor":0.05299366105263158,"finite":true,"samples":57000},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.6,"runSeconds":0.150470615,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150449425,"realTimeFactor":0.05787331346153846,"finite":true,"samples":62400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.05,"runSeconds":0.166719874,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166696094,"realTimeFactor":0.0546622537704918,"finite":true,"samples":73200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.85,"runSeconds":0.155861911,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155838481,"realTimeFactor":0.0546883898245614,"finite":true,"samples":68400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.75,"runSeconds":0.149367865,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149346305,"realTimeFactor":0.05431558727272727,"finite":true,"samples":66000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.65,"runSeconds":0.152849115,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152822565,"realTimeFactor":0.05767891132075472,"finite":true,"samples":63600},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.625,"runSeconds":0.145605443,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145577383,"realTimeFactor":0.05546874019047619,"finite":true,"samples":63000},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.325,"runSeconds":0.129700868,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129681498,"realTimeFactor":0.055785319569892466,"finite":true,"samples":55800},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.7,"runSeconds":0.147354018,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147332008,"realTimeFactor":0.05457556222222222,"finite":true,"samples":64800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.425,"runSeconds":0.136755267,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136734057,"realTimeFactor":0.05639392453608248,"finite":true,"samples":58200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.575,"runSeconds":0.140760722,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140738922,"realTimeFactor":0.05466435805825243,"finite":true,"samples":61800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.2,"runSeconds":0.12171493,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.12169473,"realTimeFactor":0.055324968181818174,"finite":true,"samples":52800},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.575,"runSeconds":0.14766257,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1476357,"realTimeFactor":0.05734468737864077,"finite":true,"samples":61800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.4,"runSeconds":0.134239927,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134207166,"realTimeFactor":0.05593330291666667,"finite":true,"samples":57600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.725,"runSeconds":0.148617459,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148589989,"realTimeFactor":0.054538517064220186,"finite":true,"samples":65400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.425,"runSeconds":0.1359496,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13592827,"realTimeFactor":0.05606169072164949,"finite":true,"samples":58200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.45,"runSeconds":0.13583734,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135815349,"realTimeFactor":0.05544381224489796,"finite":true,"samples":58800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":2.675,"runSe