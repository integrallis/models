0.148668775,"realTimeFactor":0.054070002181818184,"finite":true,"samples":66000},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":2.7,"runSeconds":0.168939783,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168916923,"realTimeFactor":0.06257029,"finite":true,"samples":64800},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.25,"runSeconds":0.122175523,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.122155002,"realTimeFactor":0.05430023244444444,"finite":true,"samples":54000},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":2.7,"runSeconds":0.14925954,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14923647,"realTimeFactor":0.055281311111111106,"finite":true,"samples":64800},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":2.65,"runSeconds":0.144969153,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144947063,"realTimeFactor":0.05470534075471698,"finite":true,"samples":63600},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.5,"runSeconds":0.137513577,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137490747,"realTimeFactor":0.0550054308,"finite":true,"samples":60000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.075,"runSeconds":0.222787845,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222756775,"realTimeFactor":0.07245133170731707,"finite":true,"samples":73800},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":2.725,"runSeconds":0.153362546,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153328065,"realTimeFactor":0.05627983339449541,"finite":true,"samples":65400},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.45,"runSeconds":0.135642521,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13561849,"realTimeFactor":0.05536429428571428,"finite":true,"samples":58800},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.55,"runSeconds":0.139395703,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139373483,"realTimeFactor":0.05466498156862746,"finite":true,"samples":61200},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.625,"runSeconds":0.141386321,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141363431,"realTimeFactor":0.05386145561904762,"finite":true,"samples":63000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.55,"runSeconds":0.14702031,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14699948,"realTimeFactor":0.057655023529411764,"finite":true,"samples":61200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.875,"runSeconds":0.155534575,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155511115,"realTimeFactor":0.05409898260869565,"finite":true,"samples":69000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.85,"runSeconds":0.153109994,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153086144,"realTimeFactor":0.0537228049122807,"finite":true,"samples":68400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.75,"runSeconds":0.166920986,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166897965,"realTimeFactor":0.06069854036363636,"finite":true,"samples":66000},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.5,"runSeconds":0.139709686,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139682716,"realTimeFactor":0.0558838744,"finite":true,"samples":60000},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.725,"runSeconds":0.151918673,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151884163,"realTimeFactor":0.05574997174311926,"finite":true,"samples":65400},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.425,"runSeconds":0.133565722,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133544072,"realTimeFactor":0.05507864824742268,"finite":true,"samples":58200},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.6,"runSeconds":0.141406471,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141382831,"realTimeFactor":0.05438710423076923,"finite":true,"samples":62400},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.7,"runSeconds":0.153702309,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153678599,"realTimeFactor":0.05692678111111111,"finite":true,"samples":64800},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.925,"runSeconds":0.159784593,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159759973,"realTimeFactor":0.05462721128205129,"finite":true,"samples":70200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.525,"runSeconds":0.138022021,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137998791,"realTimeFactor":0.05466218653465346,"finite":true,"samples":60600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.525,"runSeconds":0.138508896,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138485806,"realTimeFactor":0.05485500831683168,"finite":true,"samples":60600},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.475,"runSeconds":0.177167075,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177143584,"realTimeFactor":0.07158265656565657,"finite":true,"samples":59400},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.6,"runSeconds":0.146030031,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146000351,"realTimeFactor":0.05616539653846154,"finite":true,"samples":62400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.8,"runSeconds":0.15491088,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15487696,"realTimeFactor":0.05532531428571429,"finite":true,"samples":67200},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.575,"runSeconds":0.142704233,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142681602,"realTimeFactor":0.05541911961165049,"finite":true,"samples":61800},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.5,"runSeconds":0.135932073,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135908883,"realTimeFactor":0.05437282919999999,"finite":true,"samples":60000},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.425,"runSeconds":0.138468766,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138448236,"realTimeFactor":0.057100522061855674,"finite":true,"samples":58200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":2.6,"runSeconds":0.142154228,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142132758,"realTimeFactor":0.05467470307692307,"finite":true,"samples":62400},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.2,"runSeconds":0.170717048,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170691828,"realTimeFactor":0.0533490775,"finite":true,"samples":76800},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.55,"runSeconds":0.13897215,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1389502,"realTimeFactor":0.054498882352941175,"finite":true,"samples":61200},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.425,"runSeconds":0.145613828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145576988,"realTimeFactor":0.0600469393814433,"finite":true,"samples":58200},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.425,"runSeconds":0.134740922,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134708012,"realTimeFactor":0.05556326680412372,"finite":true,"samples":58200},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.475,"runSeconds":0.135834342,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135812452,"realTimeFactor":0.05488256242424242,"finite":true,"samples":59400},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":2.95,"runSeconds":0.163177983,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163154002,"realTimeFactor":0.055314570508474575,"finite":true,"samples":70800},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.7,"runSeconds":0.152942582,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152920552,"realTimeFactor":0.05664540074074073,"finite":true,"samples":64800},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.7,"runSeconds":0.149178189,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149156819,"realTimeFactor":0.0552511811111111,"finite":true,"samples":64800},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.9,"runSeconds":0.157798245,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157774295,"realTimeFactor":0.05441318793103449,"finite":true,"samples":69600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.175,"runSeconds":0.135940393,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135915573,"realTimeFactor":0.06250133011494254,"finite":true,"samples":52200},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.65,"runSeconds":0.148233001,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14819926,"realTimeFactor":0.055936981509433964,"finite":true,"samples":63600},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.55,"runSeconds":0.141546082,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141524172,"realTimeFactor":0.05550826745098039,"finite":true,"samples":61200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.525,"runSeconds":0.141741884,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141720974,"realTimeFactor":0.056135399603960405,"finite":true,"samples":60600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.775,"runSeconds":0.152478378,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152454298,"realTimeFactor":0.054947163243243245,"finite":true,"samples":66600},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":2.7,"runSeconds":0.147752327,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147728517,"realTimeFactor":0.054723084074074065,"finite":true,"samples":64800},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.35,"runSeconds":0.137367466,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137339846,"realTimeFactor":0.05845424085106383,"finite":true,"samples":56400},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":2.775,"runSeconds":0.152313647,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152277027,"realTimeFactor":0.05488780072072072,"finite":true,"samples":66600}]}