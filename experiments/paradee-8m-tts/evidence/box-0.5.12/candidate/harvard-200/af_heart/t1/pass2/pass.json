realTimeFactor":0.055315456727272734,"finite":true,"samples":66000},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":2.7,"runSeconds":0.150158428,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150130618,"realTimeFactor":0.05561423259259259,"finite":true,"samples":64800},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.25,"runSeconds":0.125287121,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125266841,"realTimeFactor":0.055683164888888886,"finite":true,"samples":54000},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":2.7,"runSeconds":0.157739254,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157711664,"realTimeFactor":0.05842194592592592,"finite":true,"samples":64800},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":2.65,"runSeconds":0.15043862,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15040526,"realTimeFactor":0.05676929056603774,"finite":true,"samples":63600},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.5,"runSeconds":0.139919709,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139897139,"realTimeFactor":0.055967883600000004,"finite":true,"samples":60000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.075,"runSeconds":0.171221522,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171196152,"realTimeFactor":0.05568179577235772,"finite":true,"samples":73800},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":2.725,"runSeconds":0.152849522,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152826602,"realTimeFactor":0.05609156770642201,"finite":true,"samples":65400},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.45,"runSeconds":0.137978553,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137956112,"realTimeFactor":0.056317776734693875,"finite":true,"samples":58800},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.55,"runSeconds":0.142132719,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142110749,"realTimeFactor":0.05573832117647059,"finite":true,"samples":61200},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.625,"runSeconds":0.151104706,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151077546,"realTimeFactor":0.05756369752380953,"finite":true,"samples":63000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.55,"runSeconds":0.146701179,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146668798,"realTimeFactor":0.05752987411764706,"finite":true,"samples":61200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.875,"runSeconds":0.160099765,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160076105,"realTimeFactor":0.0556868747826087,"finite":true,"samples":69000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.85,"runSeconds":0.167170886,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167148666,"realTimeFactor":0.05865645122807017,"finite":true,"samples":68400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.75,"runSeconds":0.153568758,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153546548,"realTimeFactor":0.055843184727272725,"finite":true,"samples":66000},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.5,"runSeconds":0.139075362,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139053282,"realTimeFactor":0.0556301448,"finite":true,"samples":60000},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.725,"runSeconds":0.151807683,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151785552,"realTimeFactor":0.05570924146788991,"finite":true,"samples":65400},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.425,"runSeconds":0.143924974,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143899484,"realTimeFactor":0.05935050474226805,"finite":true,"samples":58200},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.6,"runSeconds":0.147744388,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147708668,"realTimeFactor":0.05682476461538462,"finite":true,"samples":62400},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.7,"runSeconds":0.151281148,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151258558,"realTimeFactor":0.056030054814814816,"finite":true,"samples":64800},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.925,"runSeconds":0.174517161,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174493881,"realTimeFactor":0.05966398666666667,"finite":true,"samples":70200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.525,"runSeconds":0.141753025,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141732355,"realTimeFactor":0.05613981188118812,"finite":true,"samples":60600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.525,"runSeconds":0.149994687,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149974327,"realTimeFactor":0.059403836435643564,"finite":true,"samples":60600},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.475,"runSeconds":0.144393338,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144366338,"realTimeFactor":0.058340742626262626,"finite":true,"samples":59400},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.6,"runSeconds":0.149071749,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149037318,"realTimeFactor":0.05733528807692308,"finite":true,"samples":62400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.8,"runSeconds":0.158205439,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158182849,"realTimeFactor":0.056501942500000006,"finite":true,"samples":67200},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.575,"runSeconds":0.144867322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144845292,"realTimeFactor":0.05625915417475728,"finite":true,"samples":61800},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.5,"runSeconds":0.139680357,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139657627,"realTimeFactor":0.0558721428,"finite":true,"samples":60000},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.425,"runSeconds":0.142671823,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142650933,"realTimeFactor":0.058833741443298976,"finite":true,"samples":58200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":2.6,"runSeconds":0.14916867,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149131269,"realTimeFactor":0.05737256538461538,"finite":true,"samples":62400},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.2,"runSeconds":0.177585437,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177548227,"realTimeFactor":0.0554954490625,"finite":true,"samples":76800},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.55,"runSeconds":0.142757274,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142734274,"realTimeFactor":0.055983244705882354,"finite":true,"samples":61200},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.425,"runSeconds":0.137194076,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137172646,"realTimeFactor":0.05657487670103093,"finite":true,"samples":58200},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.425,"runSeconds":0.139729457,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139708437,"realTimeFactor":0.05762039463917526,"finite":true,"samples":58200},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.475,"runSeconds":0.138685039,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138663629,"realTimeFactor":0.056034359191919195,"finite":true,"samples":59400},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":2.95,"runSeconds":0.167103296,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167080446,"realTimeFactor":0.05664518508474577,"finite":true,"samples":70800},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.7,"runSeconds":0.149725255,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149699335,"realTimeFactor":0.055453798148148145,"finite":true,"samples":64800},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.7,"runSeconds":0.204436501,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204414741,"realTimeFactor":0.07571722259259259,"finite":true,"samples":64800},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.9,"runSeconds":0.165888555,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165860065,"realTimeFactor":0.05720295,"finite":true,"samples":69600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.175,"runSeconds":0.128326529,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128296268,"realTimeFactor":0.05900070298850575,"finite":true,"samples":52200},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.65,"runSeconds":0.148474603,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148451493,"realTimeFactor":0.0560281520754717,"finite":true,"samples":63600},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.55,"runSeconds":0.145208085,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145183835,"realTimeFactor":0.05694434705882353,"finite":true,"samples":61200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.525,"runSeconds":0.150840374,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150818404,"realTimeFactor":0.05973876198019802,"finite":true,"samples":60600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.775,"runSeconds":0.156446073,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156422973,"realTimeFactor":0.05637696324324324,"finite":true,"samples":66600},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":2.7,"runSeconds":0.151636972,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151613361,"realTimeFactor":0.056161841481481484,"finite":true,"samples":64800},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.35,"runSeconds":0.131201594,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131181343,"realTimeFactor":0.0558304655319149,"finite":true,"samples":56400},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":2.775,"runSeconds":0.15263402,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1526105,"realTimeFactor":0.05500325045045046,"finite":true,"samples":66600}]}