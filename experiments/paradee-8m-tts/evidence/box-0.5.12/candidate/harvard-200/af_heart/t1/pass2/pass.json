{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {onnxOperators=56, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxDynamicNodes=1311, backend=pure-java, onnxNodes=2535, graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnxOpset=17} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"af_heart","voiceIndex":0,"corpus":"harvard-200","pass":2,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":524.9500000000002,"totalRunSeconds":29.660647929,"realTimeMultiple":17.698534477621532,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.7,"runSeconds":0.260077149,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.259955768,"realTimeFactor":0.09632486999999999,"finite":true,"samples":64800},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.7,"runSeconds":0.218931889,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218821508,"realTimeFactor":0.08108588481481481,"finite":true,"samples":64800},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.5,"runSeconds":0.208275607,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208258626,"realTimeFactor":0.0833102428,"finite":true,"samples":60000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.9,"runSeconds":0.165196691,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165177041,"realTimeFactor":0.05696437620689655,"finite":true,"samples":69600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.8,"runSeconds":0.208940352,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208905872,"realTimeFactor":0.07462155428571429,"finite":true,"samples":67200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.575,"runSeconds":0.139637148,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139610538,"realTimeFactor":0.05422801864077669,"finite":true,"samples":61800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.14440599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144386789,"realTimeFactor":0.0534837,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.85,"runSeconds":0.149679315,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149659575,"realTimeFactor":0.05251905789473684,"finite":true,"samples":68400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.55,"runSeconds":0.146498268,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146477637,"realTimeFactor":0.05745030117647059,"finite":true,"samples":61200},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.05,"runSeconds":0.172380804,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172350114,"realTimeFactor":0.05651829639344263,"finite":true,"samples":73200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.4,"runSeconds":0.144802233,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144783933,"realTimeFactor":0.060334263750000006,"finite":true,"samples":57600},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.625,"runSeconds":0.148634437,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148614067,"realTimeFactor":0.05662264266666667,"finite":true,"samples":63000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.1,"runSeconds":0.192061826,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192034915,"realTimeFactor":0.06195542774193548,"finite":true,"samples":74400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.575,"runSeconds":0.147258815,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147231675,"realTimeFactor":0.05718788932038834,"finite":true,"samples":61800},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.425,"runSeconds":0.145639011,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14562037,"realTimeFactor":0.06005732412371135,"finite":true,"samples":58200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.149437823,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149416593,"realTimeFactor":0.05639163132075472,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.575,"runSeconds":0.152087166,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152068026,"realTimeFactor":0.059062977087378635,"finite":true,"samples":61800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.55,"runSeconds":0.149686806,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149664816,"realTimeFactor":0.05870070823529412,"finite":true,"samples":61200},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.625,"runSeconds":0.150919796,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150891496,"realTimeFactor":0.05749325561904762,"finite":true,"samples":63000},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.65,"runSeconds":0.153296827,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153277507,"realTimeFactor":0.05784785924528302,"finite":true,"samples":63600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.525,"runSeconds":0.143420191,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14340116,"realTimeFactor":0.05680007564356436,"finite":true,"samples":60600},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.925,"runSeconds":0.165818956,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165798446,"realTimeFactor":0.05669024136752137,"finite":true,"samples":70200},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.025,"runSeconds":0.170121574,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170099623,"realTimeFactor":0.05623853685950413,"finite":true,"samples":72600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.85,"runSeconds":0.167362739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167339369,"realTimeFactor":0.05872376807017544,"finite":true,"samples":68400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.7,"runSeconds":0.151888645,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151863075,"realTimeFactor":0.0562550537037037,"finite":true,"samples":64800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.3,"runSeconds":0.131656008,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131638458,"realTimeFactor":0.057241742608695655,"finite":true,"samples":55200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.625,"runSeconds":0.148608306,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148589626,"realTimeFactor":0.056612688,"finite":true,"samples":63000},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.825,"runSeconds":0.145256177,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145234807,"realTimeFactor":0.05141811575221238,"finite":true,"samples":67800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.05,"runSeconds":0.155641557,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155619587,"realTimeFactor":0.051030018688524595,"finite":true,"samples":73200},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.425,"runSeconds":0.1260763,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.12605826,"realTimeFactor":0.05199022680412372,"finite":true,"samples":58200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.35,"runSeconds":0.122180576,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.122161826,"realTimeFactor":0.0519917344680851,"finite":true,"samples":56400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.625,"runSeconds":0.146941192,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146918792,"realTimeFactor":0.05597759695238095,"finite":true,"samples":63000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.75,"runSeconds":0.142703914,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142675894,"realTimeFactor":0.051892332363636356,"finite":true,"samples":66000},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.425,"runSeconds":0.126028549,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.126009519,"realTimeFactor":0.05197053567010309,"finite":true,"samples":58200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.25,"runSeconds":0.117493605,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.117476304,"realTimeFactor":0.05221938,"finite":true,"samples":54000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.85,"runSeconds":0.150591024,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150569134,"realTimeFactor":0.05283895578947368,"finite":true,"samples":68400},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.625,"runSeconds":0.13295768,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13293712,"realTimeFactor":0.05065054476190476,"finite":true,"samples":63000},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.7,"runSeconds":0.136808633,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136789153,"realTimeFactor":0.050669864074074075,"finite":true,"samples":64800},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.525,"runSeconds":0.140665937,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140644426,"realTimeFactor":0.05570928198019802,"finite":true,"samples":60600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.075,"runSeconds":0.10767674,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.107652449,"realTimeFactor":0.05189240481927711,"finite":true,"samples":49800},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.75,"runSeconds":0.139409006,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139388066,"realTimeFactor":0.050694184,"finite":true,"samples":66000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.1422145,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1421952,"realTimeFactor":0.05267203703703703,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.5,"runSeconds":0.128995185,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128975945,"realTimeFactor":0.05159807400000001,"finite":true,"samples":60000},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.625,"runSeconds":0.133816008,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133796747,"realTimeFactor":0.05097752685714285,"finite":true,"samples":63000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.55,"runSeconds":0.128838114,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128817853,"realTimeFactor":0.0505247505882353,"finite":true,"samples":61200},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.375,"runSeconds":0.143065358,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143044968,"realTimeFactor":0.060238045473684214,"finite":true,"samples":57000},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.725,"runSeconds":0.142773395,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142734415,"realTimeFactor":0.05239390642201835,"finite":true,"samples":65400},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.425,"runSeconds":0.126556953,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.126529113,"realTimeFactor":0.05218843422680413,"finite":true,"samples":58200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.575,"runSeconds":0.140031011,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140010781,"realTimeFactor":0.05438097514563107,"finite":true,"samples":61800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.525,"runSeconds":0.127182089,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127162139,"realTimeFactor":0.05036914415841584,"finite":true,"samples":60600},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.375,"runSeconds":0.122441599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.122423168,"realTimeFactor":0.05155435747368421,"finite":true,"samples":57000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.625,"runSeconds":0.141652795,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141634705,"realTimeFactor":0.05396296952380952,"finite":true,"samples":63000},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.5,"runSeconds":0.132675747,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.132654957,"realTimeFactor":0.053070298800000006,"finite":true,"samples":60000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.725,"runSeconds":0.142932346,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142904296,"realTimeFactor":0.05245223706422018,"finite":true,"samples":65400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.85,"runSeconds":0.145003315,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144982304,"realTimeFactor":0.050878356140350876,"finite":true,"samples":68400},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.6,"runSeconds":0.142343431,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142321901,"realTimeFactor":0.05474747346153846,"finite":true,"samples":62400},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.65,"runSeconds":0.135858725,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135838215,"realTimeFactor":0.05126744339622642,"finite":true,"samples":63600},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.35,"runSeconds":0.122575349,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.122557399,"realTimeFactor":0.0521597229787234,"finite":true,"samples":56400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.6,"runSeconds":0.133488955,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133469245,"realTimeFactor":0.05134190576923076,"finite":true,"samples":62400},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.85,"runSeconds":0.174858585,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174834825,"realTimeFactor":0.06135388947368421,"finite":true,"samples":68400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.575,"runSeconds":0.136683283,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136655832,"realTimeFactor":0.05308088660194174,"finite":true,"samples":61800},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.775,"runSeconds":0.144332229,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144311389,"realTimeFactor":0.05201161405405406,"finite":true,"samples":66600},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.725,"runSeconds":0.140324724,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140304524,"realTimeFactor":0.05149531155963303,"finite":true,"samples":65400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.625,"runSeconds":0.140220823,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140201623,"realTimeFactor":0.053417456380952376,"finite":true,"samples":63000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.45,"runSeconds":0.127750795,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127730535,"realTimeFactor":0.05214318163265306,"finite":true,"samples":58800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.85,"runSeconds":0.146510848,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146490088,"realTimeFactor":0.0514073150877193,"finite":true,"samples":68400},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.75,"runSeconds":0.158430782,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158408271,"realTimeFactor":0.057611193454545455,"finite":true,"samples":66000},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.875,"runSeconds":0.15245394,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152423999,"realTimeFactor":0.05302745739130435,"finite":true,"samples":69000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.625,"runSeconds":0.136044506,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136024886,"realTimeFactor":0.05182647847619048,"finite":true,"samples":63000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.0,"runSeconds":0.162158054,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162136454,"realTimeFactor":0.05405268466666666,"finite":true,"samples":72000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.775,"runSeconds":0.142744195,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142712435,"realTimeFactor":0.05143934954954955,"finite":true,"samples":66600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.375,"runSeconds":0.123853771,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.123834801,"realTimeFactor":0.052148956210526315,"finite":true,"samples":57000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.725,"runSeconds":0.155211354,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155184953,"realTimeFactor":0.056958295045871556,"finite":true,"samples":65400},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.575,"runSeconds":0.138256816,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138223745,"realTimeFactor":0.05369196737864077,"finite":true,"samples":61800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.5,"runSeconds":0.130466888,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130445838,"realTimeFactor":0.052186755200000004,"finite":true,"samples":60000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.375,"runSeconds":0.128201578,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128183608,"realTimeFactor":0.05397961178947369,"finite":true,"samples":57000},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.6,"runSeconds":0.135178499,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135157309,"realTimeFactor":0.05199173038461539,"finite":true,"samples":62400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.05,"runSeconds":0.155313535,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155289454,"realTimeFactor":0.05092247049180328,"finite":true,"samples":73200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.85,"runSeconds":0.146018443,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145996473,"realTimeFactor":0.05123454140350877,"finite":true,"samples":68400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.75,"runSeconds":0.146594828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146572568,"realTimeFactor":0.053307210181818186,"finite":true,"samples":66000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.65,"runSeconds":0.137009185,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136980225,"realTimeFactor":0.05170157924528302,"finite":true,"samples":63600},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.625,"runSeconds":0.134810096,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134789436,"realTimeFactor":0.051356227047619045,"finite":true,"samples":63000},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.325,"runSeconds":0.125645645,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.125628055,"realTimeFactor":0.0540411376344086,"finite":true,"samples":55800},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.7,"runSeconds":0.136706862,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136684102,"realTimeFactor":0.05063217111111111,"finite":true,"samples":64800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.425,"runSeconds":0.134878676,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134858016,"realTimeFactor":0.055620072577319594,"finite":true,"samples":58200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.575,"runSeconds":0.14322147,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143199569,"realTimeFactor":0.05561998834951456,"finite":true,"samples":61800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.2,"runSeconds":0.128517871,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.128496801,"realTimeFactor":0.05841721409090909,"finite":true,"samples":52800},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.575,"runSeconds":0.14567385,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14564615,"realTimeFactor":0.056572368932038826,"finite":true,"samples":61800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.4,"runSeconds":0.136588631,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136556311,"realTimeFactor":0.05691192958333333,"finite":true,"samples":57600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.725,"runSeconds":0.151509921,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151486851,"realTimeFactor":0.055599971009174305,"finite":true,"samples":65400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.425,"runSeconds":0.135867725,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135846385,"realTimeFactor":0.05602792783505155,"finite":true,"samples":58200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.45,"runSeconds":0.17084022,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1708195,"realTimeFactor":0.06973070204081631,"finite":true,"samples":58800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":2.675,"runSeconds":0.148876268,"g2pSe