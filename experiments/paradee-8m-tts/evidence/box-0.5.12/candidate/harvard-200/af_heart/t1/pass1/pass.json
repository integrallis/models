imeFactor":0.056606969152542375,"finite":true,"samples":70800},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.7,"runSeconds":0.148337207,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148313927,"realTimeFactor":0.05493970629629629,"finite":true,"samples":64800},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.7,"runSeconds":0.155065705,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155043084,"realTimeFactor":0.05743174259259259,"finite":true,"samples":64800},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.9,"runSeconds":0.160029218,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160005178,"realTimeFactor":0.055182488965517244,"finite":true,"samples":69600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.175,"runSeconds":0.123704433,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.123684063,"realTimeFactor":0.05687560137931035,"finite":true,"samples":52200},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.65,"runSeconds":0.145946086,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145922796,"realTimeFactor":0.055073994716981135,"finite":true,"samples":63600},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.55,"runSeconds":0.149078493,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149051233,"realTimeFactor":0.05846215411764707,"finite":true,"samples":61200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.525,"runSeconds":0.140262236,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140227636,"realTimeFactor":0.05554940039603961,"finite":true,"samples":60600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.775,"runSeconds":0.154281778,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154258188,"realTimeFactor":0.055597037117117123,"finite":true,"samples":66600},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":2.7,"runSecon