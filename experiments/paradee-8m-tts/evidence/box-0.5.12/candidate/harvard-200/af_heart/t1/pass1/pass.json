{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {onnxOpset=17, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnx-kernels=rust-ffm, graph=onnx_paradee_int8.onnx, onnxNodes=2535, backend=pure-java, onnxDynamicNodes=1311, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxOperators=56} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"af_heart","voiceIndex":0,"corpus":"harvard-200","pass":1,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":524.9500000000002,"totalRunSeconds":30.187068403000005,"realTimeMultiple":17.38989666011524,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.7,"runSeconds":0.2574958,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.257364689,"realTimeFactor":0.09536881481481481,"finite":true,"samples":64800},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.7,"runSeconds":0.211537132,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21140887,"realTimeFactor":0.07834708592592592,"finite":true,"samples":64800},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.5,"runSeconds":0.20201069,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20199209,"realTimeFactor":0.080804276,"finite":true,"samples":60000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.9,"runSeconds":0.178549236,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178530126,"realTimeFactor":0.06156870206896552,"finite":true,"samples":69600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.8,"runSeconds":0.221182795,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221147635,"realTimeFactor":0.07899385535714286,"finite":true,"samples":67200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.575,"runSeconds":0.149335083,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149305113,"realTimeFactor":0.05799420699029126,"finite":true,"samples":61800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.157633585,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157613185,"realTimeFactor":0.058382809259259254,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.85,"runSeconds":0.159904335,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159883124,"realTimeFactor":0.05610678421052632,"finite":true,"samples":68400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.55,"runSeconds":0.153735311,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153714861,"realTimeFactor":0.06028835725490197,"finite":true,"samples":61200},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.05,"runSeconds":0.172166061,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172141801,"realTimeFactor":0.05644788885245902,"finite":true,"samples":73200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.4,"runSeconds":0.137536161,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137510921,"realTimeFactor":0.05730673375,"finite":true,"samples":57600},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.625,"runSeconds":0.150323432,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150303911,"realTimeFactor":0.057266069333333336,"finite":true,"samples":63000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.1,"runSeconds":0.173469443,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173436852,"realTimeFactor":0.05595788483870968,"finite":true,"samples":74400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.575,"runSeconds":0.142919888,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142890007,"realTimeFactor":0.055502869126213585,"finite":true,"samples":61800},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.425,"runSeconds":0.152674162,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152653722,"realTimeFactor":0.06295841731958764,"finite":true,"samples":58200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.152045197,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152020957,"realTimeFactor":0.05737554603773585,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.575,"runSeconds":0.144954125,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144925935,"realTimeFactor":0.056292864077669896,"finite":true,"samples":61800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.55,"runSeconds":0.141940599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141921999,"realTimeFactor":0.05566298,"finite":true,"samples":61200},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.625,"runSeconds":0.147112654,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147092533,"realTimeFactor":0.056042915809523815,"finite":true,"samples":63000},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.65,"runSeconds":0.159780153,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159758203,"realTimeFactor":0.06029439735849057,"finite":true,"samples":63600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.525,"runSeconds":0.140961321,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.140941811,"realTimeFactor":0.05582626574257426,"finite":true,"samples":60600},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.925,"runSeconds":0.163289164,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163267384,"realTimeFactor":0.05582535521367521,"finite":true,"samples":70200},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.025,"runSeconds":0.166336531,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166315721,"realTimeFactor":0.054987282975206615,"finite":true,"samples":72600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.85,"runSeconds":0.179715346,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179691896,"realTimeFactor":0.06305801614035088,"finite":true,"samples":68400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.7,"runSeconds":0.154124184,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154095664,"realTimeFactor":0.057083031111111106,"finite":true,"samples":64800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.3,"runSeconds":0.127463614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.127446264,"realTimeFactor":0.05541896260869566,"finite":true,"samples":55200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.625,"runSeconds":0.144547261,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144528881,"realTimeFactor":0.05506562323809524,"finite":true,"samples":63000},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.825,"runSeconds":0.160358949,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160337629,"realTimeFactor":0.05676422973451327,"finite":true,"samples":67800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.05,"runSeconds":0.167606812,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167573031,"realTimeFactor":0.0549530531147541,"finite":true,"samples":73200},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.425,"runSeconds":0.136014848,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135997728,"realTimeFactor":0.05608859711340206,"finite":true,"samples":58200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.35,"runSeconds":0.131836052,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131817921,"realTimeFactor":0.05610044765957447,"finite":true,"samples":56400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.625,"runSeconds":0.153154476,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153131256,"realTimeFactor":0.05834456228571429,"finite":true,"samples":63000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.75,"runSeconds":0.150248961,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150220831,"realTimeFactor":0.05463598581818181,"finite":true,"samples":66000},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.425,"runSeconds":0.135636045,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135619265,"realTimeFactor":0.05593238969072166,"finite":true,"samples":58200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.25,"runSeconds":0.130753033,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.130735142,"realTimeFactor":0.058112459111111105,"finite":true,"samples":54000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.85,"runSeconds":0.15829262,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15826963,"realTimeFactor":0.05554127017543859,"finite":true,"samples":68400},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.625,"runSeconds":0.144181278,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144161788,"realTimeFactor":0.054926201142857144,"finite":true,"samples":63000},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.7,"runSeconds":0.148476155,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148454695,"realTimeFactor":0.05499116851851851,"finite":true,"samples":64800},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.525,"runSeconds":0.147923901,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147901001,"realTimeFactor":0.05858372316831683,"finite":true,"samples":60600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.075,"runSeconds":0.117505468,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.117479718,"realTimeFactor":0.056629141204819274,"finite":true,"samples":49800},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.75,"runSeconds":0.151750884,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151730804,"realTimeFactor":0.05518213963636364,"finite":true,"samples":66000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.143757645,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143737515,"realTimeFactor":0.053243572222222216,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.5,"runSeconds":0.143943367,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143924577,"realTimeFactor":0.0575773468,"finite":true,"samples":60000},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.625,"runSeconds":0.145235648,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145216648,"realTimeFactor":0.0553278659047619,"finite":true,"samples":63000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.55,"runSeconds":0.139979462,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.139960772,"realTimeFactor":0.05489390666666667,"finite":true,"samples":61200},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.375,"runSeconds":0.133354275,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.133334565,"realTimeFactor":0.05614916842105263,"finite":true,"samples":57000},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.725,"runSeconds":0.184277275,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184254265,"realTimeFactor":0.06762468807339449,"finite":true,"samples":65400},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.425,"runSeconds":0.138142216,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138112006,"realTimeFactor":0.05696586226804125,"finite":true,"samples":58200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.575,"runSeconds":0.143852055,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143832605,"realTimeFactor":0.055864875728155336,"finite":true,"samples":61800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.525,"runSeconds":0.132884461,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.132865691,"realTimeFactor":0.0526275093069307,"finite":true,"samples":60600},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.375,"runSeconds":0.131872282,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131853922,"realTimeFactor":0.055525171368421056,"finite":true,"samples":57000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.625,"runSeconds":0.152288178,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152267168,"realTimeFactor":0.058014544,"finite":true,"samples":63000},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.5,"runSeconds":0.137448811,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13742838,"realTimeFactor":0.0549795244,"finite":true,"samples":60000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.725,"runSeconds":0.149829268,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149810318,"realTimeFactor":0.05498321761467889,"finite":true,"samples":65400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.85,"runSeconds":0.156185912,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156165822,"realTimeFactor":0.05480207438596491,"finite":true,"samples":68400},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.6,"runSeconds":0.1523606,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15233733,"realTimeFactor":0.05860023076923077,"finite":true,"samples":62400},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.65,"runSeconds":0.148253484,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148224473,"realTimeFactor":0.055944710943396224,"finite":true,"samples":63600},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.35,"runSeconds":0.131129815,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131112445,"realTimeFactor":0.05579992127659575,"finite":true,"samples":56400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.6,"runSeconds":0.144065738,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144046217,"realTimeFactor":0.05540989923076923,"finite":true,"samples":62400},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.85,"runSeconds":0.158094429,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158072969,"realTimeFactor":0.055471729473684214,"finite":true,"samples":68400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.575,"runSeconds":0.143098029,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143079929,"realTimeFactor":0.05557205009708737,"finite":true,"samples":61800},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.775,"runSeconds":0.151873735,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151850565,"realTimeFactor":0.05472927387387388,"finite":true,"samples":66600},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.725,"runSeconds":0.161842092,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161819432,"realTimeFactor":0.05939159339449541,"finite":true,"samples":65400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.625,"runSeconds":0.151133349,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151110329,"realTimeFactor":0.05757460914285714,"finite":true,"samples":63000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.45,"runSeconds":0.135589064,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135560244,"realTimeFactor":0.055342475102040815,"finite":true,"samples":58800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.85,"runSeconds":0.157589345,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157567694,"realTimeFactor":0.055294507017543855,"finite":true,"samples":68400},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.75,"runSeconds":0.152594971,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152574251,"realTimeFactor":0.05548908036363636,"finite":true,"samples":66000},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.875,"runSeconds":0.163642858,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163620147,"realTimeFactor":0.05691925495652174,"finite":true,"samples":69000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.625,"runSeconds":0.144712483,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144691713,"realTimeFactor":0.05512856495238096,"finite":true,"samples":63000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.0,"runSeconds":0.164892438,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164869988,"realTimeFactor":0.054964146,"finite":true,"samples":72000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.775,"runSeconds":0.164917468,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164896598,"realTimeFactor":0.05942971819819821,"finite":true,"samples":66600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.375,"runSeconds":0.136520532,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136500162,"realTimeFactor":0.0574823292631579,"finite":true,"samples":57000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.725,"runSeconds":0.152864374,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152836744,"realTimeFactor":0.05609701798165137,"finite":true,"samples":65400},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.575,"runSeconds":0.142798787,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142779016,"realTimeFactor":0.05545583961165049,"finite":true,"samples":61800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.5,"runSeconds":0.13858398,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13856261,"realTimeFactor":0.055433592,"finite":true,"samples":60000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.375,"runSeconds":0.131341128,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.131322008,"realTimeFactor":0.05530152757894737,"finite":true,"samples":57000},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.6,"runSeconds":0.145046946,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145026406,"realTimeFactor":0.055787286923076926,"finite":true,"samples":62400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.05,"runSeconds":0.166598262,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166562252,"realTimeFactor":0.05462238098360656,"finite":true,"samples":73200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.85,"runSeconds":0.15699175,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15696912,"realTimeFactor":0.05508482456140351,"finite":true,"samples":68400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.75,"runSeconds":0.156764947,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156741087,"realTimeFactor":0.05700543527272727,"finite":true,"samples":66000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.65,"runSeconds":0.147703549,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147673099,"realTimeFactor":0.05573718830188679,"finite":true,"samples":63600},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.625,"runSeconds":0.144963795,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.144941285,"realTimeFactor":0.05522430285714286,"finite":true,"samples":63000},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.325,"runSeconds":0.136439311,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136419981,"realTimeFactor":0.058683574623655914,"finite":true,"samples":55800},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.7,"runSeconds":0.148786419,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148765809,"realTimeFactor":0.05510608111111111,"finite":true,"samples":64800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.425,"runSeconds":0.134242833,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134222543,"realTimeFactor":0.05535786927835052,"finite":true,"samples":58200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.575,"runSeconds":0.142342173,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142320812,"realTimeFactor":0.05527851378640776,"finite":true,"samples":61800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.2,"runSeconds":0.129470881,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.129445011,"realTimeFactor":0.058850400454545454,"finite":true,"samples":52800},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.575,"runSeconds":0.143335971,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143302691,"realTimeFactor":0.05566445475728155,"finite":true,"samples":61800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.4,"runSeconds":0.13278993,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13277005,"realTimeFactor":0.0553291375,"finite":true,"samples":57600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.725,"runSeconds":0.152919866,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152897586,"realTimeFactor":0.056117382018348615,"finite":true,"samples":65400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.425,"runSeconds":0.135102741,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135082411,"realTimeFactor":0.05571247051546392,"finite":true,"samples":58200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.45,"runSeconds":0.136353612,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.136332252,"realTimeFactor":0.055654535510204085,"finite":true,"samples":58800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":2.675,"runSeconds":0.157284924,"g2pSeconds":0.0,"t