actor":0.05461749527272727,"finite":true,"samples":66000},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":2.7,"runSeconds":0.16150125,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16147977,"realTimeFactor":0.05981527777777778,"finite":true,"samples":64800},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.25,"runSeconds":0.123619792,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.123599321,"realTimeFactor":0.05494212977777778,"finite":true,"samples":54000},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":2.7,"runSeconds":0.150089672,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150066972,"realTimeFactor":0.055588767407407404,"finite":true,"samples":64800},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":2.65,"runSeconds":0.147341167,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.147316827,"realTimeFactor":0.05560044037735849,"finite":true,"samples":63600},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.5,"runSeconds":0.150457095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150429495,"realTimeFactor":0.060182838,"finite":true,"samples":60000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.075,"runSeconds":0.16948165,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16944222,"realTimeFactor":0.0551159837398374,"finite":true,"samples":73800},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":2.725,"runSeconds":0.151596155,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151573594,"realTimeFactor":0.05563161651376147,"finite":true,"samples":65400},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.45,"runSeconds":0.143228523,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143207822,"realTimeFactor":0.05846062163265305,"finite":true,"samples":58800},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.55,"runSeconds":0.141032193,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.141009513,"realTimeFactor":0.05530674235294118,"finite":true,"samples":61200},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.625,"runSeconds":0.143347023,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.143322223,"realTimeFactor":0.05460838971428571,"finite":true,"samples":63000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.55,"runSeconds":0.152290241,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15226312,"realTimeFactor":0.0597216631372549,"finite":true,"samples":61200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.875,"runSeconds":0.159935777,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159899716,"realTimeFactor":0.05562983547826087,"finite":true,"samples":69000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.85,"runSeconds":0.161092707,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161070996,"realTimeFactor":0.05652375684210526,"finite":true,"samples":68400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.75,"runSeconds":0.151914048,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.151890657,"realTimeFactor":0.055241472,"finite":true,"samples":66000},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.5,"runSeconds":0.138064027,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.138042587,"realTimeFactor":0.055225610800000005,"finite":true,"samples":60000},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.725,"runSeconds":0.158863567,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158834187,"realTimeFactor":0.058298556697247705,"finite":true,"samples":65400},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.425,"runSeconds":0.137040448,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137005888,"realTimeFactor":0.056511524948453615,"finite":true,"samples":58200},{"index":171,"text":"The child almost hurt the small 