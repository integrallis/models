dex":180,"text":"Acid burns holes in wool cloth.","audioSeconds":3.05,"runSeconds":0.170276567,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170243287,"realTimeFactor":0.05582838262295082,"finite":true,"samples":73200},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.925,"runSeconds":0.161024376,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160999095,"realTimeFactor":0.05505106871794872,"finite":true,"samples":70200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.275,"runSeconds":0.182818016,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182791216,"realTimeFactor":0.05582229496183206,"finite":true,"samples":78600},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.55,"runSeconds":0.191146839,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191088859,"realTimeFactor":0.053844180000000005,"finite":true,"samples":85200},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.975,"runSeconds":0.161576341,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16155169,"realTimeFactor":0.05431137512605042,"finite":true,"samples":71400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.95,"runSeconds":0.161012346,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160986496,"realTimeFactor":0.05458045627118644,"finite":true,"samples":70800},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.875,"runSeconds":0.168666673,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168638802,"realTimeFactor":0.05866666886956522,"finite":true,"samples":69000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.95,"runSeconds":0.164524687,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164489137,"realTimeFactor":0.05577108033898305,"finite":true,"samples":70800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.425,"runSeconds":0.190716916,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190690405,"realTimeFactor":0.05568377109489051,"finite":true,"samples":82200},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.25,"runSeconds":0.176241739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176215559,"realTimeFactor":0.054228227384615385,"finite":true,"samples":78000},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":3.175,"runSeconds":0.192491731,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192467611,"realTimeFactor":0.06062731685039371,"finite":true,"samples":76200},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":3.375,"runSeconds":0.183705774,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183679474,"realTimeFactor":0.05443134044444444,"finite":true,"samples":81000},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.7,"runSeconds":0.149306664,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149284584,"realTimeFactor":0.05529876444444444,"finite":true,"samples":64800},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":3.15,"runSeconds":0.170129925,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170102455,"realTimeFactor":0.054009499999999995,"finite":true,"samples":75600},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":3.05,"runSeconds":0.177652361,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177620991,"realTimeFactor":0.05824667573770492,"finite":true,"samples":73200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":3.05,"runSeconds":0.167554503,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167517953,"realTimeFactor":0.05493590262295082,"finite":true,"samples":73200},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":3.2,"runSeconds":0.175838096,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175811646,"realTimeFactor":0.054949405,"finite":true,"samples":76800},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":3.3,"runSeconds":0.180150