{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {backend=pure-java, onnxNodes=2535, graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnxOpset=17, onnxOperators=56, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxDynamicNodes=1311} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bm_fable","voiceIndex":3,"corpus":"harvard-200","pass":3,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":624.8499999999993,"totalRunSeconds":35.445381797999964,"realTimeMultiple":17.628530666165855,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.375,"runSeconds":0.286521005,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.286363944,"realTimeFactor":0.0848951125925926,"finite":true,"samples":81000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.15,"runSeconds":0.338107709,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.337976758,"realTimeFactor":0.10733578063492064,"finite":true,"samples":75600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":3.0,"runSeconds":0.202082751,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202063471,"realTimeFactor":0.067360917,"finite":true,"samples":72000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.4,"runSeconds":0.247084827,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247061427,"realTimeFactor":0.07267200794117648,"finite":true,"samples":81600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.3,"runSeconds":0.19853128,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19849192,"realTimeFactor":0.06016099393939394,"finite":true,"samples":79200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":3.1,"runSeconds":0.175633758,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175609018,"realTimeFactor":0.056656050967741935,"finite":true,"samples":74400},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.3,"runSeconds":0.190173806,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190150536,"realTimeFactor":0.057628426060606065,"finite":true,"samples":79200},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.275,"runSeconds":0.204461292,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204435562,"realTimeFactor":0.06243092885496183,"finite":true,"samples":78600},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":3.0,"runSeconds":0.172652192,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172628192,"realTimeFactor":0.05755073066666667,"finite":true,"samples":72000},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.675,"runSeconds":0.2110453,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21101123,"realTimeFactor":0.0574272925170068,"finite":true,"samples":88200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.825,"runSeconds":0.159821249,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159800419,"realTimeFactor":0.05657389345132743,"finite":true,"samples":67800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.175,"runSeconds":0.174092654,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174069774,"realTimeFactor":0.05483233196850394,"finite":true,"samples":76200},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.475,"runSeconds":0.203728235,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203704275,"realTimeFactor":0.05862683021582734,"finite":true,"samples":83400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":3.1,"runSeconds":0.1724682,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172437,"realTimeFactor":0.05563490322580645,"finite":true,"samples":74400},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.925,"runSeconds":0.168902739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168881219,"realTimeFactor":0.057744526153846155,"finite":true,"samples":70200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.1,"runSeconds":0.172987434,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172964054,"realTimeFactor":0.055802398064516125,"finite":true,"samples":74400},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":3.1,"runSeconds":0.169159681,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169136481,"realTimeFactor":0.054567639032258065,"finite":true,"samples":74400},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":3.15,"runSeconds":0.183360467,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183335816,"realTimeFactor":0.05820967206349206,"finite":true,"samples":75600},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.975,"runSeconds":0.161512113,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161482963,"realTimeFactor":0.05428978588235294,"finite":true,"samples":71400},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.225,"runSeconds":0.186810396,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186787026,"realTimeFactor":0.057925704186046506,"finite":true,"samples":77400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":3.0,"runSeconds":0.166629369,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166608048,"realTimeFactor":0.055543123,"finite":true,"samples":72000},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.45,"runSeconds":0.203826817,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203801406,"realTimeFactor":0.059080236811594196,"finite":true,"samples":82800},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.4,"runSeconds":0.199543969,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199510489,"realTimeFactor":0.058689402647058825,"finite":true,"samples":81600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.325,"runSeconds":0.182335327,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182312037,"realTimeFactor":0.05483769233082706,"finite":true,"samples":79800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":3.075,"runSeconds":0.176328624,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176303494,"realTimeFactor":0.057342641951219506,"finite":true,"samples":73800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.875,"runSeconds":0.161004429,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160974389,"realTimeFactor":0.056001540521739133,"finite":true,"samples":69000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":3.025,"runSeconds":0.173907743,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173886433,"realTimeFactor":0.057490162975206614,"finite":true,"samples":72600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.325,"runSeconds":0.177140851,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17711598,"realTimeFactor":0.05327544390977443,"finite":true,"samples":79800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.5,"runSeconds":0.208040834,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208013163,"realTimeFactor":0.059440238285714285,"finite":true,"samples":84000},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.95,"runSeconds":0.165497499,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165471929,"realTimeFactor":0.05610084711864406,"finite":true,"samples":70800},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.9,"runSeconds":0.168029651,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168008421,"realTimeFactor":0.057941258965517245,"finite":true,"samples":69600},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.15,"runSeconds":0.172857204,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172834803,"realTimeFactor":0.05487530285714286,"finite":true,"samples":75600},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.3,"runSeconds":0.189243857,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189218477,"realTimeFactor":0.05734662333333333,"finite":true,"samples":79200},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.925,"runSeconds":0.162977046,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162945756,"realTimeFactor":0.0557186482051282,"finite":true,"samples":70200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.7,"runSeconds":0.153505173,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153485513,"realTimeFactor":0.05685376777777777,"finite":true,"samples":64800},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.45,"runSeconds":0.189224297,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189199357,"realTimeFactor":0.05484762231884058,"finite":true,"samples":82800},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":3.15,"runSeconds":0.179588173,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179563743,"realTimeFactor":0.05701211841269841,"finite":true,"samples":75600},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.225,"runSeconds":0.176895129,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176864059,"realTimeFactor":0.054851202790697676,"finite":true,"samples":77400},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":3.0,"runSeconds":0.173354508,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173332388,"realTimeFactor":0.057784836,"finite":true,"samples":72000},{"index":39,"text":"What joy there is in living.","audioSeconds":2.5,"runSeconds":0.135273173,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.135254562,"realTimeFactor":0.0541092692,"finite":true,"samples":60000},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.15,"runSeconds":0.182389808,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182360867,"realTimeFactor":0.057901526349206346,"finite":true,"samples":75600},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.225,"runSeconds":0.171818784,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171786414,"realTimeFactor":0.053277142325581395,"finite":true,"samples":77400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":3.075,"runSeconds":0.170123679,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170101089,"realTimeFactor":0.05532477365853658,"finite":true,"samples":73800},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":3.125,"runSeconds":0.168581735,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168556885,"realTimeFactor":0.053946155200000005,"finite":true,"samples":75000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.125,"runSeconds":0.176429175,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176406244,"realTimeFactor":0.056457336,"finite":true,"samples":75000},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.975,"runSeconds":0.186489503,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186457973,"realTimeFactor":0.06268554722689075,"finite":true,"samples":71400},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.275,"runSeconds":0.179820294,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179796334,"realTimeFactor":0.05490696,"finite":true,"samples":78600},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.95,"runSeconds":0.166244215,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166218225,"realTimeFactor":0.05635397118644068,"finite":true,"samples":70800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":3.0,"runSeconds":0.164079867,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164057796,"realTimeFactor":0.054693289,"finite":true,"samples":72000},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.975,"runSeconds":0.157415027,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157392637,"realTimeFactor":0.05291261411764706,"finite":true,"samples":71400},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.9,"runSeconds":0.159818248,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159797118,"realTimeFactor":0.05510974068965517,"finite":true,"samples":69600},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":3.175,"runSeconds":0.179398581,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179374271,"realTimeFactor":0.056503490078740164,"finite":true,"samples":76200},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":3.025,"runSeconds":0.166400456,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166371036,"realTimeFactor":0.05500841520661157,"finite":true,"samples":72600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":3.1,"runSeconds":0.169591835,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169570434,"realTimeFactor":0.054707043548387096,"finite":true,"samples":74400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.325,"runSeconds":0.181081886,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181056086,"realTimeFactor":0.05446071759398496,"finite":true,"samples":79800},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":3.05,"runSeconds":0.22240296,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22238081,"realTimeFactor":0.07291900327868853,"finite":true,"samples":73200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.2,"runSeconds":0.165807162,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165782391,"realTimeFactor":0.051814738125,"finite":true,"samples":76800},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.925,"runSeconds":0.161608734,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161587434,"realTimeFactor":0.055250849230769235,"finite":true,"samples":70200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.15,"runSeconds":0.171754314,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171731054,"realTimeFactor":0.05452517904761905,"finite":true,"samples":75600},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.275,"runSeconds":0.188927295,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188901485,"realTimeFactor":0.057687723664122136,"finite":true,"samples":78600},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":3.125,"runSeconds":0.172567391,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172543141,"realTimeFactor":0.055221565119999996,"finite":true,"samples":75000},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.25,"runSeconds":0.179031758,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178999817,"realTimeFactor":0.055086694769230775,"finite":true,"samples":78000},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":3.1,"runSeconds":0.169756636,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169732986,"realTimeFactor":0.05476020516129032,"finite":true,"samples":74400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.25,"runSeconds":0.178805046,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178780875,"realTimeFactor":0.05501693723076923,"finite":true,"samples":78000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.95,"runSeconds":0.175853499,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175831369,"realTimeFactor":0.05961135559322033,"finite":true,"samples":70800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.525,"runSeconds":0.191288296,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191261136,"realTimeFactor":0.054266183262411345,"finite":true,"samples":84600},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.325,"runSeconds":0.182114305,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182089565,"realTimeFactor":0.05477121954887218,"finite":true,"samples":79800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.375,"runSeconds":0.186900418,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186876227,"realTimeFactor":0.05537790162962963,"finite":true,"samples":81000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.25,"runSeconds":0.240962275,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240936014,"realTimeFactor":0.07414223846153846,"finite":true,"samples":78000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.184074875,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184043225,"realTimeFactor":0.05707748062015504,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.15,"runSeconds":0.174306759,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174283009,"realTimeFactor":0.05533547904761905,"finite":true,"samples":75600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":3.0,"runSeconds":0.165052009,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165029679,"realTimeFactor":0.05501733633333333,"finite":true,"samples":72000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.25,"runSeconds":0.239265106,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239240106,"realTimeFactor":0.07362003261538462,"finite":true,"samples":78000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.225,"runSeconds":0.176733941,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176710301,"realTimeFactor":0.05480122201550388,"finite":true,"samples":77400},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":3.1,"runSeconds":0.170525716,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170504256,"realTimeFactor":0.05500829548387096,"finite":true,"samples":74400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.575,"runSeconds":0.137989303,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.137969142,"realTimeFactor":0.05358807883495145,"finite":true,"samples":61800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":3.1,"runSeconds":0.186505396,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186478066,"realTimeFactor":0.06016303096774193,"finite":true,"samples":74400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.475,"runSeconds":0.194929,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194799488,"realTimeFactor":0.0560946762589928,"finite":true,"samples":83400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.3,"runSeconds":0.18237863,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18235329,"realTimeFactor":0.05526625151515152,"finite":true,"samples":79200},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.25,"runSeconds":0.187195642,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187170752,"realTimeFactor":0.057598659076923076,"finite":true,"samples":78000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.2,"runSeconds":0.17435833,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17433369,"realTimeFactor":0.054486978125,"finite":true,"samples":76800},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":3.025,"runSeconds":0.167599531,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167575051,"realTimeFactor":0.05540480363636364,"finite":true,"samples":72600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.725,"runSeconds":0.161534939,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161510088,"realTimeFactor":0.0592788766972477,"finite":true,"samples":65400},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.3,"runSeconds":0.181100519,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181063309,"realTimeFactor":0.05487894515151515,"finite":true,"samples":79200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.925,"runSeconds":0.158803585,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158780474,"realTimeFactor":0.054291823931623934,"finite":true,"samples":70200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":3.075,"runSeconds":0.171299013,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171275453,"realTimeFactor":0.055706996097560975,"finite":true,"samples":73800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.875,"runSeconds":0.155741738,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155718698,"realTimeFactor":0.05417103930434782,"finite":true,"samples":69000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.725,"runSeconds":0.149481373,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149459433,"realTimeFactor":0.05485554972477064,"finite":true,"samples":65400},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.9,"runSeconds":0.174970085,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174940835,"realTimeFactor":0.06033451206896552,"finite":true,"samples":69600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":3.1,"runSeconds":0.175348729,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175312558,"realTimeFactor":0.05656410612903226,"finite":true,"samples":74400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.9,"runSeconds":0.159073626,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159046886,"realTimeFactor":0.054852974482758624,"finite":true,"samples":69600},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.9,"runSeconds":0.166758934,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166736374,"realTimeFactor":0.05750308068965517,"finite":true,"samples":69600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.125,"runSeconds":0.170256394,"g2pSeconds":0.0,"timeToFi