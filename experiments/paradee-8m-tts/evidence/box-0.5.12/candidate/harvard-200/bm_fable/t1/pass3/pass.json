},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":3.025,"runSeconds":0.16748959,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16745399,"realTimeFactor":0.05536845950413223,"finite":true,"samples":72600},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.85,"runSeconds":0.155630367,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155606107,"realTimeFactor":0.054607146315789466,"finite":true,"samples":68400},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":3.0,"runSeconds":0.171703977,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171676827,"realTimeFactor":0.057234659,"finite":true,"samples":72000},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":3.25,"runSeconds":0.175263878,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175238858,"realTimeFactor":0.05392734707692308,"finite":true,"samples":78000},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":3.2,"runSeconds":0.173747155,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173720985,"realTimeFactor":0.05429598593749999,"finite":true,"samples":76800},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":3.325,"runSeconds":0.193352886,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193307316,"realTimeFactor":0.058151243909774435,"finite":true,"samples":79800},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":3.2,"runSeconds":0.174689363,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174662272,"realTimeFactor":0.05459042593749999,"finite":true,"samples":76800},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":3.2,"runSeconds":0.175011435,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174981855,"realTimeFactor":0.054691073437499994,"finite":true,"samples":76800},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":3.025,"runSeconds":0.173041109,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173016299,"r