{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.12 {backend=pure-java, onnxNodes=2535, graph=onnx_paradee_int8.onnx, onnx-kernels=rust-ffm, phonemizer=misaki-java fba1236; unresolved words: cmudict tier + letter-to-phoneme model, onnxOpset=17, onnxOperators=56, voices=af_heart,bf_isabella,am_puck,bm_fable, onnxDynamicNodes=1311} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bm_fable","voiceIndex":3,"corpus":"harvard-200","pass":2,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 7.0.0-1013-aws amd64 8 cpus","sentences":200,"totalAudioSeconds":624.8499999999993,"totalRunSeconds":34.87361195000002,"realTimeMultiple":17.917559009828892,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.375,"runSeconds":0.305424436,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.305278794,"realTimeFactor":0.0904961291851852,"finite":true,"samples":81000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.15,"runSeconds":0.245428883,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245291342,"realTimeFactor":0.07791393111111111,"finite":true,"samples":75600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":3.0,"runSeconds":0.265100375,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265056804,"realTimeFactor":0.08836679166666667,"finite":true,"samples":72000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.4,"runSeconds":0.186001868,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.185925157,"realTimeFactor":0.05470643176470588,"finite":true,"samples":81600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.3,"runSeconds":0.229754978,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229714987,"realTimeFactor":0.0696227206060606,"finite":true,"samples":79200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":3.1,"runSeconds":0.174123244,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174091493,"realTimeFactor":0.056168788387096776,"finite":true,"samples":74400},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.3,"runSeconds":0.18297712,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18291627,"realTimeFactor":0.055447612121212124,"finite":true,"samples":79200},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.275,"runSeconds":0.17817786,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178154309,"realTimeFactor":0.054405453435114506,"finite":true,"samples":78600},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":3.0,"runSeconds":0.17947006,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17944623,"realTimeFactor":0.05982335333333333,"finite":true,"samples":72000},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.675,"runSeconds":0.198877269,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198843939,"realTimeFactor":0.05411626367346939,"finite":true,"samples":88200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.825,"runSeconds":0.153363393,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153342043,"realTimeFactor":0.05428792672566371,"finite":true,"samples":67800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.175,"runSeconds":0.172037106,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172013486,"realTimeFactor":0.05418491527559055,"finite":true,"samples":76200},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.475,"runSeconds":0.18974358,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189718309,"realTimeFactor":0.0546024690647482,"finite":true,"samples":83400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":3.1,"runSeconds":0.167619538,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167596588,"realTimeFactor":0.05407081870967742,"finite":true,"samples":74400},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.925,"runSeconds":0.169891517,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169866917,"realTimeFactor":0.05808256991452992,"finite":true,"samples":70200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.1,"runSeconds":0.174442806,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174410746,"realTimeFactor":0.05627187290322581,"finite":true,"samples":74400},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":3.1,"runSeconds":0.167060723,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167037422,"realTimeFactor":0.05389055580645161,"finite":true,"samples":74400},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":3.15,"runSeconds":0.171100167,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171077417,"realTimeFactor":0.05431751333333333,"finite":true,"samples":75600},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.975,"runSeconds":0.161978818,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161955358,"realTimeFactor":0.05444666151260504,"finite":true,"samples":71400},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.225,"runSeconds":0.173732881,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173708901,"realTimeFactor":0.0538706607751938,"finite":true,"samples":77400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":3.0,"runSeconds":0.163363931,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163343171,"realTimeFactor":0.05445464366666666,"finite":true,"samples":72000},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.45,"runSeconds":0.194847954,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194812894,"realTimeFactor":0.05647766782608695,"finite":true,"samples":82800},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.4,"runSeconds":0.184856527,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184832087,"realTimeFactor":0.05436956676470588,"finite":true,"samples":81600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.325,"runSeconds":0.177923147,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177898717,"realTimeFactor":0.053510720902255636,"finite":true,"samples":79800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":3.075,"runSeconds":0.164139187,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164117667,"realTimeFactor":0.05337859739837398,"finite":true,"samples":73800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.875,"runSeconds":0.156984285,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156961725,"realTimeFactor":0.05460322956521739,"finite":true,"samples":69000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":3.025,"runSeconds":0.163763644,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163741923,"realTimeFactor":0.05413674181818182,"finite":true,"samples":72600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.325,"runSeconds":0.17254995,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17252593,"realTimeFactor":0.051894721804511275,"finite":true,"samples":79800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.5,"runSeconds":0.186173818,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186149498,"realTimeFactor":0.05319251942857143,"finite":true,"samples":84000},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.95,"runSeconds":0.200675825,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200655054,"realTimeFactor":0.06802570338983051,"finite":true,"samples":70800},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.9,"runSeconds":0.159337115,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159307325,"realTimeFactor":0.05494383275862069,"finite":true,"samples":69600},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.15,"runSeconds":0.168285803,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168263753,"realTimeFactor":0.05342406444444445,"finite":true,"samples":75600},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.3,"runSeconds":0.17484859,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17482452,"realTimeFactor":0.05298442121212121,"finite":true,"samples":79200},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.925,"runSeconds":0.20595887,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20593775,"realTimeFactor":0.07041328888888888,"finite":true,"samples":70200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.7,"runSeconds":0.146515244,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.146495894,"realTimeFactor":0.054264905185185175,"finite":true,"samples":64800},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.45,"runSeconds":0.183164912,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183141152,"realTimeFactor":0.05309127884057971,"finite":true,"samples":82800},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":3.15,"runSeconds":0.166521398,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166498087,"realTimeFactor":0.05286393587301587,"finite":true,"samples":75600},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.225,"runSeconds":0.182603008,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182576218,"realTimeFactor":0.056621087751937985,"finite":true,"samples":77400},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":3.0,"runSeconds":0.170956626,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170929156,"realTimeFactor":0.056985542,"finite":true,"samples":72000},{"index":39,"text":"What joy there is in living.","audioSeconds":2.5,"runSeconds":0.132956686,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.132937716,"realTimeFactor":0.0531826744,"finite":true,"samples":60000},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.15,"runSeconds":0.163678573,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163654903,"realTimeFactor":0.05196145174603174,"finite":true,"samples":75600},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.225,"runSeconds":0.168008201,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167984851,"realTimeFactor":0.05209556620155038,"finite":true,"samples":77400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":3.075,"runSeconds":0.165990933,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165967463,"realTimeFactor":0.05398079121951219,"finite":true,"samples":73800},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":3.125,"runSeconds":0.167093443,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167070762,"realTimeFactor":0.05346990176,"finite":true,"samples":75000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.125,"runSeconds":0.16564552,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1656233,"realTimeFactor":0.053006566399999996,"finite":true,"samples":75000},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.975,"runSeconds":0.211138726,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211114415,"realTimeFactor":0.07097100033613445,"finite":true,"samples":71400},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.275,"runSeconds":0.178638163,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178605153,"realTimeFactor":0.05454600396946565,"finite":true,"samples":78600},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.95,"runSeconds":0.157897613,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.157870863,"realTimeFactor":0.05352461457627118,"finite":true,"samples":70800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":3.0,"runSeconds":0.16100347,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160981879,"realTimeFactor":0.05366782333333334,"finite":true,"samples":72000},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.975,"runSeconds":0.196145685,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196124555,"realTimeFactor":0.06593132268907563,"finite":true,"samples":71400},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.9,"runSeconds":0.15638134,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156349649,"realTimeFactor":0.0539246,"finite":true,"samples":69600},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":3.175,"runSeconds":0.168637316,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168614506,"realTimeFactor":0.053114115275590554,"finite":true,"samples":76200},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":3.025,"runSeconds":0.160151292,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160128992,"realTimeFactor":0.0529425758677686,"finite":true,"samples":72600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":3.1,"runSeconds":0.179718552,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179694302,"realTimeFactor":0.0579737264516129,"finite":true,"samples":74400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.325,"runSeconds":0.183137112,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183102902,"realTimeFactor":0.055078830676691726,"finite":true,"samples":79800},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":3.05,"runSeconds":0.159923771,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159899451,"realTimeFactor":0.05243402327868853,"finite":true,"samples":73200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.2,"runSeconds":0.169115,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16908988,"realTimeFactor":0.05284843749999999,"finite":true,"samples":76800},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.925,"runSeconds":0.165202806,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165181806,"realTimeFactor":0.0564795917948718,"finite":true,"samples":70200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.15,"runSeconds":0.171261369,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171237279,"realTimeFactor":0.05436868857142857,"finite":true,"samples":75600},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.275,"runSeconds":0.174634268,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174609728,"realTimeFactor":0.05332344061068703,"finite":true,"samples":78600},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":3.125,"runSeconds":0.207413073,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207388213,"realTimeFactor":0.06637218336,"finite":true,"samples":75000},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.25,"runSeconds":0.180354548,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180319728,"realTimeFactor":0.055493707076923075,"finite":true,"samples":78000},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":3.1,"runSeconds":0.171168198,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171143948,"realTimeFactor":0.05521554774193548,"finite":true,"samples":74400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.25,"runSeconds":0.182942291,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182919391,"realTimeFactor":0.0562899356923077,"finite":true,"samples":78000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.95,"runSeconds":0.159441676,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159417756,"realTimeFactor":0.054048025762711865,"finite":true,"samples":70800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.525,"runSeconds":0.186641192,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186614282,"realTimeFactor":0.05294785588652483,"finite":true,"samples":84600},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.325,"runSeconds":0.196395227,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196367747,"realTimeFactor":0.059066233684210524,"finite":true,"samples":79800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.375,"runSeconds":0.187751682,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187716542,"realTimeFactor":0.055630128,"finite":true,"samples":81000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.25,"runSeconds":0.175340584,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175316254,"realTimeFactor":0.05395094892307692,"finite":true,"samples":78000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.182073283,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182050263,"realTimeFactor":0.056456831937984495,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.15,"runSeconds":0.170300331,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170276481,"realTimeFactor":0.05406359714285714,"finite":true,"samples":75600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":3.0,"runSeconds":0.161630285,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161606985,"realTimeFactor":0.05387676166666667,"finite":true,"samples":72000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.25,"runSeconds":0.173252134,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173227274,"realTimeFactor":0.053308348923076926,"finite":true,"samples":78000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.225,"runSeconds":0.182657776,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182631146,"realTimeFactor":0.05663807007751938,"finite":true,"samples":77400},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":3.1,"runSeconds":0.167973268,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167944238,"realTimeFactor":0.05418492516129032,"finite":true,"samples":74400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.575,"runSeconds":0.133662361,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.13363182,"realTimeFactor":0.051907713009708735,"finite":true,"samples":61800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":3.1,"runSeconds":0.166964389,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166940139,"realTimeFactor":0.053859480322580644,"finite":true,"samples":74400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.475,"runSeconds":0.19692744,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19690021,"realTimeFactor":0.05666976690647482,"finite":true,"samples":83400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.3,"runSeconds":0.175697425,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175670195,"realTimeFactor":0.05324164393939394,"finite":true,"samples":79200},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.25,"runSeconds":0.173202044,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173176103,"realTimeFactor":0.05329293661538462,"finite":true,"samples":78000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.2,"runSeconds":0.210646959,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210617929,"realTimeFactor":0.06582717468749999,"finite":true,"samples":76800},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":3.025,"runSeconds":0.170246188,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170210188,"realTimeFactor":0.05627973157024793,"finite":true,"samples":72600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.725,"runSeconds":0.150576937,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150555547,"realTimeFactor":0.05525759155963302,"finite":true,"samples":65400},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.3,"runSeconds":0.183807576,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183783186,"realTimeFactor":0.055699265454545455,"finite":true,"samples":79200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.925,"runSeconds":0.156204557,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156180056,"realTimeFactor":0.05340326735042735,"finite":true,"samples":70200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":3.075,"runSeconds":0.165967191,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165943121,"realTimeFactor":0.05397307024390243,"finite":true,"samples":73800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.875,"runSeconds":0.152192392,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152169301,"realTimeFactor":0.05293648417391305,"finite":true,"samples":69000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.725,"runSeconds":0.155610261,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155571291,"realTimeFactor":0.05710468293577981,"finite":true,"samples":65400},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.9,"runSeconds":0.157877431,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15783284,"realTimeFactor":0.05444049344827587,"finite":true,"samples":69600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":3.1,"runSeconds":0.166785628,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166761898,"realTimeFactor":0.05380181548387096,"finite":true,"samples":74400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.9,"runSeconds":0.160903717,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160881096,"realTimeFactor":0.05548404034482759,"finite":true,"samples":69600},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.9,"runSeconds":0.156726411,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156703101,"realTimeFactor":0.05404359,"finite":true,"samples":69600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.125,"runSeconds":0.166061682,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166036161,"realTimeFactor":0.05313973824,"finite":true,"samples":75000},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":3.45,"runSeconds":0.181678137,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181652237,"realTimeFactor":0.052660329565217386,"finite":true,"samples":82800},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":3.125,"runSeconds":0.173282114,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173252714,"realTimeFactor":0.05545027648,"finite":true,"samples":75000},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":3.125,"runSeconds":0.168334281,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168296501,"realTimeFactor":0.05386696992,"finite":true,"samples":75000},{"index":96,"text":"The term ended in late June that year.","audioSeconds":3.3,"runSeconds":0.175447763,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175422483,"realTimeFactor":0.053165988787878794,"finite":true,"samples":79200},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":3.3,"runSeconds":0.175321072,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175294451,"realTimeFactor":0.05312759757575758,"finite":true,"samples":79200},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.7,"runSeconds":0.14392786,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14390578,"realTimeFactor":0.05330661481481481,"finite":true,"samples":64800},{"index":99,"text":"The bill was paid every third week.","audioSeconds":3.1,"runSeconds":0.16477242,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16474796,"realTimeFactor":0.0531523935483871,"finite":true,"samples":74400},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":3.2,"runSeconds":0.168341842,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168310532,"realTimeFactor":0.05260682562499999,"finite":true,"samples":76800},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":3.0,"runSeconds":0.159208032,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159184962,"realTimeFactor":0.053069344,"finite":true,"samples":72000},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.9,"runSeconds":0.202008034,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201979984,"realTimeFactor":0.0696579427586207,"finite":true,"samples":69600},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.225,"runSeconds":0.176093609,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176046658,"realTimeFactor":0.05460266945736434,"finite":true,"samples":77400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":3.075,"runSeconds":0.165582438,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165557647,"realTimeFactor":0.053847947317073167,"finite":true,"samples":73800},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.225,"runSeconds":0.171008675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170984884,"realTimeFactor":0.053025945736434106,"finite":true,"samples":77400},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.325,"runSeconds":0.186937033,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186911643,"realTimeFactor":0.056221664060150375,"finite":true,"samples":79800},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.162279639,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162255109,"realTimeFactor":0.053646161652892564,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.85,"runSeconds":0.153496733,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153473553,"realTimeFactor":0.05385850280701754,"finite":true,"samples":68400},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":3.0,"runSeconds":0.176572163,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176549523,"realTimeFactor":0.05885738766666667,"finite":true,"samples":72000},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audio