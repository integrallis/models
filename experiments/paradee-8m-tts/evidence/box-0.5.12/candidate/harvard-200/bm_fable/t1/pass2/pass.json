"index":154,"text":"The urge to write short stories is rare.","audioSeconds":3.3,"runSeconds":0.175609244,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175582584,"realTimeFactor":0.053214922424242424,"finite":true,"samples":79200},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.8,"runSeconds":0.150139343,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150116363,"realTimeFactor":0.05362119392857143,"finite":true,"samples":67200},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":3.15,"runSeconds":0.169157798,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169133128,"realTimeFactor":0.05370088825396826,"finite":true,"samples":75600},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":3.175,"runSeconds":0.220668996,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220639126,"realTimeFactor":0.06950204598425197,"finite":true,"samples":76200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":3.0,"runSeconds":0.164180385,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164143795,"realTimeFactor":0.054726795,"finite":true,"samples":72000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.525,"runSeconds":0.186731831,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186704871,"realTimeFactor":0.052973569078014184,"finite":true,"samples":84600},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":3.2,"runSeconds":0.171668891,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171643701,"realTimeFactor":0.05364652843749999,"finite":true,"samples":76800},{"index":161,"text":"At that high level the air is pure.","audioSeconds":3.025,"runSeconds":0.167831497,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167805767,"realTimeFactor":0.05548148661157025,"finite":true,"samples":72600},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.9,"runSeconds":0.156437429,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156413938,"realTimeFactor":0.05394394103448276,"finite":true,"samples":69600},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":3.25,"runSeconds":0.171125816,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171098446,"realTimeFactor":0.05265409723076923,"finite":true,"samples":78000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.15,"runSeconds":0.197696326,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197666806,"realTimeFactor":0.06276073841269841,"finite":true,"samples":75600},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.4,"runSeconds":0.18778716,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1877483,"realTimeFactor":0.05523151764705883,"finite":true,"samples":81600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.35,"runSeconds":0.177035727,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177008866,"realTimeFactor":0.05284648567164179,"finite":true,"samples":80400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.175,"runSeconds":0.177626412,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177600742,"realTimeFactor":0.05594532661417324,"finite":true,"samples":76200},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":3.025,"runSeconds":0.161572403,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161547932,"realTimeFactor":0.053412364628099174,"finite":true,"samples":72600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.2,"runSeconds":0.169487322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169461701,"realTimeFactor":0.052964788124999995,"finite":true,"samples":76800},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.925,"runSeconds":0.177642402,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177613262,"realTimeFactor":0.06073244512820514,"finite":true,"samples":70200},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.175,"runSeconds":0.173384355,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173346335,"realTimeFactor":0.05460924566929134,"finite":true,"samples":76200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.125,"runSeconds":0.169584492,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169558462,"realTimeFactor":0.05426703744,"finite":true,"samples":75000},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.425,"runSeconds":0.188823749,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188796329,"realTimeFactor":0.05513102160583942,"finite":true,"samples":82200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":3.025,"runSeconds":0.163286068,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163259658,"realTimeFactor":0.05397886545454546,"finite":true,"samples":72600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.975,"runSeconds":0.159297363,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159273052,"realTimeFactor":0.05354533210084034,"finite":true,"samples":71400},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":3.0,"runSeconds":0.1600635,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16003929,"realTimeFactor":0.0533545,"finite":true,"samples":72000},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":3.1,"runSeconds":0.178135646,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178104906,"realTimeFactor":0.057463111612903225,"finite":true,"samples":74400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.25,"runSeconds":0.178462159,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178423969,"realTimeFactor":0.05491143353846154,"finite":true,"samples":78000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":3.175,"runSeconds":0.168975277,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168950336,"realTimeFactor":0.05322055968503937,"finite":true,"samples":76200},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":3.05,"runSeconds":0.165267365,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165242325,"realTimeFactor":0.054186021311475416,"finite":true,"samples":73200},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.925,"runSeconds":0.156756471,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156733121,"realTimeFactor":0.05359195589743591,"finite":true,"samples":70200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.275,"runSeconds":0.173354795,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173325524,"realTimeFactor":0.052932761832061075,"finite":true,"samples":78600},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.55,"runSeconds":0.186241957,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186215086,"realTimeFactor":0.052462523098591556,"finite":true,"samples":85200},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.975,"runSeconds":0.168752075,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168722885,"realTimeFactor":0.05672338655462185,"finite":true,"samples":71400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.95,"runSeconds":0.160521824,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160485923,"realTimeFactor":0.05441417762711864,"finite":true,"samples":70800},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.875,"runSeconds":0.153890406,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153865996,"realTimeFactor":0.05352709773913044,"finite":true,"samples":69000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.95,"runSeconds":0.156786541,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156761751,"realTimeFactor":0.05314798,"finite":true,"samples":70800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.425,"runSeconds":0.227301433,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227275943,"realTimeFactor":0.06636538189781022,"finite":true,"samples":82200},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.25,"runSeconds":0.1728587,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17283348,"realTimeFactor":0.053187292307692306,"finite":true,"samples":78000},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":3.175,"runSeconds":0.171074565,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171049945,"realTimeFactor":0.05388175275590552,"finite":true,"samples":76200},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":3.375,"runSeconds":0.179585639,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179560349,"realTimeFactor":0.053210559703703704,"finite":true,"samples":81000},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.7,"runSeconds":0.158315974,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158284644,"realTimeFactor":0.05863554592592592,"finite":true,"samples":64800},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":3.15,"runSeconds":0.168974987,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168923546,"realTimeFactor":0.053642853015873015,"finite":true,"samples":75600},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":3.05,"runSeconds":0.163926953,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163901533,"realTimeFactor":0.05374654196721311,"finite":true,"samples":73200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":3.05,"runSeconds":0.171379098,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171355068,"realTimeFactor":0.05618986819672132,"finite":true,"samples":73200},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":3.2,"runSeconds":0.172878031,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172851531,"realTimeFactor":0.054024384687499996,"finite":true,"samples":76800},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":3.3,"runSeconds":0.176364042,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176339611,"realTimeFactor":0.053443649090909096,"finite":true,"samples":79200},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.8,"runSeconds":0.148774862,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.148750232,"realTimeFactor":0.053133879285714294,"finite":true,"samples":67200},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":3.175,"runSeconds":0.174145702,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174114581,"realTimeFactor":0.05484904000000001,"finite":true,"samples":76200}]}