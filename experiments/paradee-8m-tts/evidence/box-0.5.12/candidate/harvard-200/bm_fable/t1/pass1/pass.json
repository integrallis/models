Seconds":0.152547655,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.152522764,"realTimeFactor":0.05399916991150442,"finite":true,"samples":67800},{"index":146,"text":"The tree top waved in a graceful way.","audioSeconds":3.075,"runSeconds":0.165464027,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165439067,"realTimeFactor":0.05380943967479675,"finite":true,"samples":73800},{"index":147,"text":"The spot on the blotter was made by green ink.","audioSeconds":3.475,"runSeconds":0.205968828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205934608,"realTimeFactor":0.059271605179856114,"finite":true,"samples":83400},{"index":148,"text":"Mud was spattered on the front of his white shirt.","audioSeconds":3.375,"runSeconds":0.188037513,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187998322,"realTimeFactor":0.055714818666666666,"finite":true,"samples":81000},{"index":149,"text":"The cigar burned a hole in the desk top.","audioSeconds":3.175,"runSeconds":0.170514701,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170489061,"realTimeFactor":0.05370541763779527,"finite":true,"samples":76200},{"index":150,"text":"The empty flask stood on the tin tray.","audioSeconds":3.2,"runSeconds":0.177561452,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177534452,"realTimeFactor":0.05548795375,"finite":true,"samples":76800},{"index":151,"text":"A speedy man can beat this track mark.","audioSeconds":3.225,"runSeconds":0.174810608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174784058,"realTimeFactor":0.05420483968992248,"finite":true,"samples":77400},{"index":152,"text":"He broke a new shoelace that day.","audioSeconds":2.825,"runSeconds":0.153890967,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.153866736,"realTimeFactor":0.05447467858407079,"finite":true,"samples":67800},{"index":153,"text":"The coffee stand is too high for the couch.","audioSeconds":3.275,"runSeconds":0.186910953,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186875133,"realTimeFactor":0.05707204671755725,"finite":true,"samples":78600},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":3.3,"runSeconds":0.178915524,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178886013,"realTimeFactor":0.05421682545454545,"finite":true,"samples":79200},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.8,"runSeconds":0.150345046,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.150321695,"realTimeFactor":0.05369465928571429,"finite":true,"samples":67200},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":3.15,"runSeconds":0.178864703,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178840403,"realTimeFactor":0.0567824453968254,"finite":true,"samples":75600},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":3.175,"runSeconds":0.171009694,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170985104,"realTimeFactor":0.05386132094488189,"finite":true,"samples":76200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":3.0,"runSeconds":0.16239981,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16237616,"realTimeFactor":0.054133270000000004,"finite":true,"samples":72000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.525,"runSeconds":0.19586206,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19582285,"realTimeFactor":0.05556370496453901,"finite":true,"samples":84600},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":3.2,"runSeconds":0.173602437,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173576426,"realTimeFactor":0.0542507615625,"finite":true,"samples":76800},{"index":161,"text":"At that high level the air is pure.","audioSeconds":3.025,"runSeconds":0.162109957,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162085767,"realTimeFactor":0.053590068429752065,"finite":true,"samples":72600},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.9,"runSeconds":0.161092258,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161068748,"realTimeFactor":0.05554905448275862,"finite":true,"samples":69600},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":3.25,"runSeconds":0.172257315,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172230945,"realTimeFactor":0.05300225076923077,"finite":true,"samples":78000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.15,"runSeconds":0.170109817,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170085306,"realTimeFactor":0.05400311650793651,"finite":true,"samples":75600},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.4,"runSeconds":0.197200952,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197175472,"realTimeFactor":0.05800028000000001,"finite":true,"samples":81600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.35,"runSeconds":0.182864127,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182828156,"realTimeFactor":0.05458630656716417,"finite":true,"samples":80400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.175,"runSeconds":0.177212518,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177188228,"realTimeFactor":0.05581496629921261,"finite":true,"samples":76200},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":3.025,"runSeconds":0.16245316,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16242845,"realTimeFactor":0.053703523966942154,"finite":true,"samples":72600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.2,"runSeconds":0.171253626,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171228786,"realTimeFactor":0.053516758124999994,"finite":true,"samples":76800},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.925,"runSeconds":0.167486014,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167462613,"realTimeFactor":0.05726017572649573,"finite":true,"samples":70200},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.175,"runSeconds":0.170696082,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170671392,"realTimeFactor":0.053762545511811026,"finite":true,"samples":76200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.125,"runSeconds":0.16829575,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16827131,"realTimeFactor":0.053854639999999995,"finite":true,"samples":75000},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.425,"runSeconds":0.184618832,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184592952,"realTimeFactor":0.05390330861313869,"finite":true,"samples":82200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":3.025,"runSeconds":0.224979442,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224948052,"realTimeFactor":0.07437336925619835,"finite":true,"samples":72600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.975,"runSeconds":0.162601681,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162566451,"realTimeFactor":0.05465602722689075,"finite":true,"samples":71400},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":3.0,"runSeconds":0.162203158,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162179148,"realTimeFactor":0.054067719333333326,"finite":true,"samples":72000},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":3.1,"runSeconds":0.166914278,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166890298,"realTimeFactor":0.05384331548387097,"finite":true,"samples":74400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.25,"runSeconds":0.248748719,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248722469,"realTimeFactor":0.07653806738461538,"finite":true,"samples":78000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":3.175,"runSeconds":0.16943645,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1694119,"realTimeFactor":0.05336581102362205,"finite":true,"samples":76200},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":3.05,"runSeconds":0.161140489,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161117209,"realTimeFactor":0.05283294721311475,"finite":true,"samples":73200},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.925,"runSeconds":0.15673165,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15670827,"realTimeFactor":0.05358347008547009,"finite":true,"samples":70200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.275,"runSeconds":0.200916814,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200885933,"realTimeFactor":0.061348645496183206,"finite":true,"samples":78600},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.55,"runSeconds":0.195632238,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195590707,"realTimeFactor":0.055107672676056346,"finite":true,"samples":85200},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.975,"runSeconds":0.162272208,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162249378,"realTimeFactor":0.05454528,"finite":true,"samples":71400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.95,"runSeconds":0.158849979,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158824849,"realTimeFactor":0.05384745050847457,"finite":true,"samples":70800},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.875,"runSeconds":0.160669345,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160646345,"realTimeFactor":0.05588498956521739,"finite":true,"samples":69000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.95,"runSeconds":0.15899687,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15897067,"realTimeFactor":0.05389724406779661,"finite":true,"samples":70800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.425,"runSeconds":0.186868852,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186842671,"realTimeFactor":0.05456024875912409,"finite":true,"samples":82200},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.25,"runSeconds":0.213985297,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213953717,"realTimeFactor":0.06584162984615384,"finite":true,"samples":78000},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":3.175,"runSeconds":0.174657736,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174617795,"realTimeFactor":0.05501031055118111,"finite":true,"samples":76200},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":3.375,"runSeconds":0.181561906,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181531525,"realTimeFactor":0.053796120296296296,"finite":true,"samples":81000},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.7,"runSeconds":0.155421489,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.155400909,"realTimeFactor":0.057563514444444436,"finite":true,"samples":64800},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":3.15,"runSeconds":0.167652905,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167628554,"realTimeFactor":0.05322314444444445,"finite":true,"samples":75600},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":3.05,"runSeconds":0.164715519,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164689349,"realTimeFactor":0.05400508819672132,"finite":true,"samples":73200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":3.05,"runSeconds":0.178818322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178789802,"realTimeFactor":0.058628958032786886,"finite":true,"samples":73200},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":3.2,"runSeconds":0.176511881,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176473491,"realTimeFactor":0.0551599628125,"finite":true,"samples":76800},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":3.3,"runSeconds":0.178014505,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177986924,"realTimeFactor":0.053943789393939394,"finite":true,"samples":79200},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.8,"runSeconds":0.15665652,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.15663462,"realTimeFactor":0.055948757142857145,"finite":true,"samples":67200},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":3.175,"runSeconds":0.169225739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169201299,"realTimeFactor":0.053299445354330705,"finite":true,"samples":76200}]}