4243,"finite":true,"samples":79200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":3.1,"runSeconds":0.175754135,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175723805,"realTimeFactor":0.056694882258064516,"finite":true,"samples":74400},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.3,"runSeconds":0.18430885,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18428637,"realTimeFactor":0.05585116666666667,"finite":true,"samples":79200},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.275,"runSeconds":0.179379777,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179357417,"realTimeFactor":0.05477245099236641,"finite":true,"samples":78600},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":3.0,"runSeconds":0.181694437,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181668017,"realTimeFactor":0.06056481233333333,"finite":true,"samples":72000},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.675,"runSeconds":0.199886674,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199850304,"realTimeFactor":0.054390931700680274,"finite":true,"samples":88200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.825,"runSeconds":0.161574392,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161553902,"realTimeFactor":0.05719447504424779,"finite":true,"samples":67800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.175,"runSeconds":0.17168971,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17166581,"realTimeFactor":0.054075499212598424,"finite":true,"samples":76200},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.475,"runSeconds":0.205734855,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205709165,"realTimeFactor":0.059204274820143885,"finite":true,"samples":83400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":3.1,"runSeconds":0.168368351,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16834304,"realTimeFactor":0.05431237129032258,"finite":true,"samples":74400},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.925,"runSeconds":0.171497288,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171469818,"realTimeFactor":0.058631551452991454,"finite":true,"samples":70200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.1,"runSeconds":0.173511005,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173488565,"realTimeFactor":0.05597129193548387,"finite":true,"samples":74400},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":3.1,"runSeconds":0.166659186,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166636536,"realTimeFactor":0.05376102774193548,"finite":true,"samples":74400},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":3.15,"runSeconds":0.169248299,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169225929,"realTimeFactor":0.05372961873015873,"finite":true,"samples":75600},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.975,"runSeconds":0.164965552,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164943481,"realTimeFactor":0.05545060571428571,"finite":true,"samples":71400},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.225,"runSeconds":0.187294705,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187266925,"realTimeFactor":0.05807587751937984,"finite":true,"samples":77400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":3.0,"runSeconds":0.166443534,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166412244,"realTimeFactor":0.055481178,"finite":true,"samples":72000},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.45,"runSeconds":0.188182973,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188158173,"realTimeFactor":0.054545789275362314,"finite":true,"samples":82800},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.4,"runSeconds":0.184814013,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184790103,"realTimeFactor":0.05435706264705883,"finite":true,"samples":81600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.325,"runSeconds":0.184565141,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184541711,"realTimeFactor":0.05550831308270676,"finite":true,"samples":79800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":3.075,"runSeconds":0.165165133,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165143103,"realTimeFactor":0.053712238373983735,"finite":true,"samples":73800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.875,"runSeconds":0.156801881,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156781501,"realTimeFactor":0.054539784695652176,"finite":true,"samples":69000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":3.025,"runSeconds":0.1843769,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18435027,"realTimeFactor":0.060951041322314055,"finite":true,"samples":72600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.325,"runSeconds":0.179206485,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179173495,"realTimeFactor":0.05389668721804511,"finite":true,"samples":79800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.5,"runSeconds":0.189730856,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189706806,"realTimeFactor":0.054208816,"finite":true,"samples":84000},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.95,"runSeconds":0.160476993,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160456142,"realTimeFactor":0.0543989806779661,"finite":true,"samples":70800},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.9,"runSeconds":0.160726745,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160705725,"realTimeFactor":0.05542301551724138,"finite":true,"samples":69600},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.15,"runSeconds":0.171288437,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171263927,"realTimeFactor":0.05437728158730158,"finite":true,"samples":75600},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.3,"runSeconds":0.177640191,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177616221,"realTimeFactor":0.053830360909090914,"finite":true,"samples":79200},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.925,"runSeconds":0.158475645,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158454284,"realTimeFactor":0.0541797076923077,"finite":true,"samples":70200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.7,"runSeconds":0.158965939,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158942659,"realTimeFactor":0.0588762737037037,"finite":true,"samples":64800},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.45,"runSeconds":0.187783889,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187750699,"realTimeFactor":0.05443011275362319,"finite":true,"samples":82800},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":3.15,"runSeconds":0.168413822,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168390951,"realTimeFactor":0.05346470539682539,"finite":true,"samples":75600},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.225,"runSeconds":0.191098059,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191074008,"realTimeFactor":0.05925521209302325,"finite":true,"samples":77400},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":3.0,"runSeconds":0.163883812,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163861972,"realTimeFactor":0.05462793733333333,"finite":true,"samples":72000},{"index":39,"text":"What joy there is in living.","audioSeconds":2.5,"runSeconds":0.134359976,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.134339866,"realTimeFactor":0.0537439904,"finite":true,"samples":60000},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.15,"runSeconds":0.175089649,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175065929,"realTimeFactor":0.05558401555555556,"finite":true,"samples":75600},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.225,"runSeconds":0.173387314,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173355304,"realTimeFactor":0.05376350821705426,"finite":true,"samples":77400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":3.075,"runSeconds":0.172304315,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172280615,"realTimeFactor":0.05603392357723577,"finite":true,"samples":73800},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":3.125,"runSeconds":0.168418341,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168396261,"realTimeFactor":0.05389386912,"finite":true,"samples":75000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.125,"runSeconds":0.166959059,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166936089,"realTimeFactor":0.05342689888,"finite":true,"samples":75000},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.975,"runSeconds":0.164361766,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164339956,"realTimeFactor":0.055247652436974784,"finite":true,"samples":71400},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.275,"runSeconds":0.176745333,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176722213,"realTimeFactor":0.053968040610687024,"finite":true,"samples":78600},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.95,"runSeconds":0.158345744,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158320154,"realTimeFactor":0.05367652338983051,"finite":true,"samples":70800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":3.0,"runSeconds":0.162227778,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162205518,"realTimeFactor":0.054075925999999996,"finite":true,"samples":72000},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.975,"runSeconds":0.214949665,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214924015,"realTimeFactor":0.07225198823529412,"finite":true,"samples":71400},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.9,"runSeconds":0.160474853,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.160444932,"realTimeFactor":0.05533615620689655,"finite":true,"samples":69600},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":3.175,"runSeconds":0.170830733,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170797382,"realTimeFactor":0.05380495527559056,"finite":true,"samples":76200},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":3.025,"runSeconds":0.16129827,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16127673,"realTimeFactor":0.05332174214876033,"finite":true,"samples":72600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":3.1,"runSeconds":0.218209043,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218187503,"realTimeFactor":0.07039001387096774,"finite":true,"samples":74400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.325,"runSeconds":0.179243795,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179220165,"realTimeFactor":0.053907908270676694,"finite":true,"samples":79800},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":3.05,"runSeconds":0.161155978,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161131748,"realTimeFactor":0.05283802557377049,"finite":true,"samples":73200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.2,"runSeconds":0.170435039,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170411499,"realTimeFactor":0.0532609496875,"finite":true,"samples":76800},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.925,"runSeconds":0.171507198,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171483178,"realTimeFactor":0.05863493948717949,"finite":true,"samples":70200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.15,"runSeconds":0.176768074,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176736624,"realTimeFactor":0.05611684888888889,"finite":true,"samples":75600},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.275,"runSeconds":0.177000106,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176975955,"realTimeFactor":0.05404583389312977,"finite":true,"samples":78600},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":3.125,"runSeconds":0.169167187,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169143877,"realTimeFactor":0.05413349984,"finite":true,"samples":75000},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.25,"runSeconds":0.177240318,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177215628,"realTimeFactor":0.05453548246153846,"finite":true,"samples":78000},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":3.1,"runSeconds":0.169693693,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169671542,"realTimeFactor":0.054739900967741936,"finite":true,"samples":74400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.25,"runSeconds":0.176550152,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176526142,"realTimeFactor":0.05432312369230769,"finite":true,"samples":78000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.95,"runSeconds":0.159800527,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159778307,"realTimeFactor":0.05416967016949152,"finite":true,"samples":70800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.525,"runSeconds":0.20612635,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206096949,"realTimeFactor":0.05847556028368795,"finite":true,"samples":84600},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.325,"runSeconds":0.182844198,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182809257,"realTimeFactor":0.0549907362406015,"finite":true,"samples":79800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.375,"runSeconds":0.184375891,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184352251,"realTimeFactor":0.054629893629629625,"finite":true,"samples":81000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.25,"runSeconds":0.174011831,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173988271,"realTimeFactor":0.05354210184615385,"finite":true,"samples":78000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.184276601,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184251,"realTimeFactor":0.05714003131782946,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.15,"runSeconds":0.171493739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171469379,"realTimeFactor":0.05444245682539683,"finite":true,"samples":75600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":3.0,"runSeconds":0.162296059,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162273239,"realTimeFactor":0.05409868633333333,"finite":true,"samples":72000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.25,"runSeconds":0.217484839,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217458199,"realTimeFactor":0.06691841200000001,"finite":true,"samples":78000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.225,"runSeconds":0.178245708,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178212628,"realTimeFactor":0.055269986976744186,"finite":true,"samples":77400},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":3.1,"runSeconds":0.167927028,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167905058,"realTimeFactor":0.05417000903225806,"finite":true,"samples":74400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.575,"runSeconds":0.142958832,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.142938371,"realTimeFactor":0.055517993009708735,"finite":true,"samples":61800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":3.1,"runSeconds":0.16931674,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.16929119,"realTimeFactor":0.05461830322580645,"finite":true,"samples":74400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.475,"runSeconds":0.18660202,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18657446,"realTimeFactor":0.05369842302158274,"finite":true,"samples":83400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.3,"runSeconds":0.189014872,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188985101,"realTimeFactor":0.05727723393939394,"finite":true,"samples":79200},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.25,"runSeconds":0.17845055,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17841326,"realTimeFactor":0.05490786153846154,"finite":true,"samples":78000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.2,"runSeconds":0.171118206,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171093196,"realTimeFactor":0.053474439374999995,"finite":true,"samples":76800},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":3.025,"runSeconds":0.169376061,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169351601,"realTimeFactor":0.05599208628099173,"finite":true,"samples":72600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.725,"runSeconds":0.149478548,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.149456898,"realTimeFactor":0.05485451302752293,"finite":true,"samples":65400},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.3,"runSeconds":0.177027197,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177001367,"realTimeFactor":0.05364460515151515,"finite":true,"samples":79200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.925,"runSeconds":0.166768039,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166738318,"realTimeFactor":0.05701471418803419,"finite":true,"samples":70200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":3.075,"runSeconds":0.168373502,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168335871,"realTimeFactor":0.05475561040650406,"finite":true,"samples":73800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.875,"runSeconds":0.154485252,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.154461542,"realTimeFactor":0.05373400069565217,"finite":true,"samples":69000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.725,"runSeconds":0.156932493,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156911463,"realTimeFactor":0.057589905688073394,"finite":true,"samples":65400},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.9,"runSeconds":0.156225407,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.156202727,"realTimeFactor":0.05387083000000001,"finite":true,"samples":69600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":3.1,"runSeconds":0.168280551,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168255291,"realTimeFactor":0.054284048709677415,"finite":true,"samples":74400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.9,"runSeconds":0.182488115,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182458695,"realTimeFactor":0.06292693620689656,"finite":true,"samples":69600},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.9,"runSeconds":0.161725244,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161689394,"realTimeFactor":0.055767325517241374,"finite":true,"samples":69600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.125,"runSeconds":0.167813018,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167788078,"realTimeFactor":0.05370016576,"finite":true,"samples":75000},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":3.45,"runSeconds":0.190114681,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190087881,"realTimeFactor":0.055105704637681156,"finite":true,"samples":82800},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":3.125,"runSeconds":0.168546564,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168521344,"realTimeFactor":0.053934900480000006,"finite":true,"samples":75000},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":3.125,"runSeconds":0.168051269,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.168026409,"realTimeFactor":0.05377640608,"finite":true,"samples":75000},{"index":96,"text":"The term ended in late June that year.","audioSeconds":3.3,"runSeconds":0.220215932,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220175182,"realTimeFactor":0.06673210060606061,"finite":true,"samples":79200},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":3.3,"runSeconds":0.182158052,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182119462,"realTimeFactor":0.055199409696969695,"finite":true,"samples":79200},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.7,"runSeconds":0.145648195,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.145624825,"realTimeFactor":0.053943775925925926,"finite":true,"samples":64800},{"index":99,"text":"The bill was paid every third week.","audioSeconds":3.1,"runSeconds":0.16696814,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1669429,"realTimeFactor":0.05386069032258064,"finite":true,"samples":74400},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":3.2,"runSeconds":0.174630997,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174603777,"realTimeFactor":0.0545721865625,"finite":true,"samples":76800},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":3.0,"runSeconds":0.161625603,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161600093,"realTimeFactor":0.053875201000000005,"finite":true,"samples":72000},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.9,"runSeconds":0.15663731,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1566133,"realTimeFactor":0.05401286551724138,"finite":true,"samples":69600},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.225,"runSeconds":0.17507089,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17504589,"realTimeFactor":0.05428554728682171,"finite":true,"samples":77400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":3.075,"runSeconds":0.17839875,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178369429,"realTimeFactor":0.05801585365853658,"finite":true,"samples":73800},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.225,"runSeconds":0.175126451,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17508762,"realTimeFactor":0.054302775503875966,"finite":true,"samples":77400},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.325,"runSeconds":0.178827193,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178800833,"realTimeFactor":0.05378261443609022,"finite":true,"samples":79800},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.163028546,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163003975,"realTimeFactor":0.05389373421487603,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.85,"runSeconds":0.158563617,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.158540157,"realTimeFactor":0.05563635684210526,"finite":true,"samples":68400},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":3.0,"runSeconds":0.159862858,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159827358,"realTimeFactor":0.053287619333333335,"finite":true,"samples":72000},{"index":110,"text":"The bark of the pine tree was