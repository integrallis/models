0},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":3.025,"runSeconds":0.163032276,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.163008886,"realTimeFactor":0.05389496727272727,"finite":true,"samples":72600},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.85,"runSeconds":0.166949089,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166910049,"realTimeFactor":0.05857862771929824,"finite":true,"samples":68400},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":3.0,"runSeconds":0.16930865,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169270719,"realTimeFactor":0.05643621666666667,"finite":true,"samples":72000},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":3.25,"runSeconds":0.173119093,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173092183,"realTimeFactor":0.05326741323076923,"finite":true,"samples":78000},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":3.2,"runSeconds":0.187028464,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187002294,"realTimeFactor":0.058446395,"finite":true,"samples":76800},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":3.325,"runSeconds":0.17846481,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17843803,"realTimeFactor":0.05367362706766917,"finite":true,"samples":79800},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":3.2,"runSeconds":0.171432489,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171406408,"realTimeFactor":0.053572652812499996,"finite":true,"samples":76800},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":3.2,"runSeconds":0.185069667,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.185028487,"realTimeFactor":0.057834270937499994,"finite":true,"samples":76800},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":3.025,"runSeconds":0.170762443,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170737552,"realTimeFactor":0.056450394380165296,"finite":true,"samples":72600},{"index":128,"text":"Feel the heat of the weak dying flame.","audioSeconds":2.975,"runSeconds":0.170479711,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17045461,"realTimeFactor":0.05730410453781513,"finite":true,"samples":71400},{"index":129,"text":"The tiny girl took off her hat.","audioSeconds":2.625,"runSeconds":0.14400335,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.14398106,"realTimeFactor":0.054858419047619046,"finite":true,"samples":63000},{"index":130,"text":"A cramp is no small danger on a swim.","audioSeconds":3.375,"runSeconds":0.181274985,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181244834,"realTimeFactor":0.05371110666666667,"finite":true,"samples":81000},{"index":131,"text":"He said the same phrase thirty times.","audioSeconds":3.25,"runSeconds":0.18303377,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182998599,"realTimeFactor":0.056318083076923084,"finite":true,"samples":78000},{"index":132,"text":"Pluck the bright rose without leaves.","audioSeconds":3.075,"runSeconds":0.165329325,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165302995,"realTimeFactor":0.05376563414634146,"finite":true,"samples":73800},{"index":133,"text":"Two plus seven is less than ten.","audioSeconds":3.125,"runSeconds":0.177658553,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177631813,"realTimeFactor":0.05685073696,"finite":true,"samples":75000},{"index":134,"text":"The glow deepened in the eyes of the sweet girl.","audioSeconds":3.35,"runSeconds":0.182123831,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182094371,"realTimeFactor":0.054365322686567165,"finite":true,"samples":80400},{"index":135,"text":"Bring your problems to the wise chief.","audioSeconds":2.95,"runSeconds":0.159433985,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.159409214,"realTimeFactor":0.05404541864406779,"finite":true,"samples":70800},{"index":136,"text":"Write a fond note to the friend you cherish.","audioSeconds":3.15,"runSeconds":0.17921579