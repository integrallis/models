finite":true,"samples":65400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.925,"runSeconds":0.21589274,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21587204,"realTimeFactor":0.07380948376068376,"finite":true,"samples":70200},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.0,"runSeconds":0.226374958,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226341828,"realTimeFactor":0.07545831933333333,"finite":true,"samples":72000},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.25,"runSeconds":0.238321129,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238298279,"realTimeFactor":0.07332957815384615,"finite":true,"samples":78000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.05,"runSeconds":0.22663447,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22661429,"realTimeFactor":0.07430638360655738,"finite":true,"samples":73200},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.075,"runSeconds":0.236061028,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236039748,"realTimeFactor":0.07676781398373983,"finite":true,"samples":73800},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.9,"runSeconds":0.217434894,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217415404,"realTimeFactor":0.0749775496551724,"finite":true,"samples":69600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.05,"runSeconds":0.228578709,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228558219,"realTimeFactor":0.07494383901639344,"finite":true,"samples":73200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.775,"runSeconds":0.215482067,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215463787,"realTimeFactor":0.07765119531531532,"finite":true,"samples":66600},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.05,"runSeconds":0.227341999,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227321658,"realTimeFactor":0.07453836032786886,"finite":true,"samples":73200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.1,"runSeconds":0.252571493,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252539473,"realTimeFactor":0.08147467516129031,"finite":true,"samples":74400},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.325,"runSeconds":0.249016673,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248993293,"realTimeFactor":0.074892232481203,"finite":true,"samples":79800},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.875,"runSeconds":0.21529556,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2152749,"realTimeFactor":0.07488541217391305,"finite":true,"samples":69000},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.925,"runSeconds":0.218814442,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218794483,"realTimeFactor":0.07480835623931624,"finite":true,"samples":70200},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.825,"runSeconds":0.229139108,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229119269,"realTimeFactor":0.08111118867256636,"finite":true,"samples":67800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.95,"runSeconds":0.223886962,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223867603,"realTimeFactor":0.07589388542372881,"finite":true,"samples":70800},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.125,"runSeconds":0.240110977,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240088199,"realTimeFactor":0.07683551264,"finite":true,"samples":75000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.975,"runSeconds":0.253812163,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253789744,"realTimeFactor":0.08531501277310924,"finite":true,"samples":71400},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.875