9479798357142857,"finite":true,"samples":67200},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.75,"runSeconds":0.234898382,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234858371,"realTimeFactor":0.08541759345454546,"finite":true,"samples":66000},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.1,"runSeconds":0.241517233,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241495103,"realTimeFactor":0.07790878483870968,"finite":true,"samples":74400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.925,"runSeconds":0.223085343,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223065812,"realTimeFactor":0.07626849333333334,"finite":true,"samples":70200},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.05,"runSeconds":0.248445687,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248420917,"realTimeFactor":0.08145760229508198,"finite":true,"samples":73200},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.175,"runSeconds":0.250784619,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250763859,"realTimeFactor":0.07898728157480316,"finite":true,"samples":76200},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.230199787,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230170097,"realTimeFactor":0.07609910314049587,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.75,"runSeconds":0.216817274,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216794473,"realTimeFactor":0.07884264509090909,"finite":true,"samples":66000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.85,"runSeconds":0.277996492,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.277978532,"realTimeFactor":0.09754262877192982,"finite":true,"samples":68400},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.325,"runSeconds":0.252374254,"g2pSec