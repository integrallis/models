{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.11 {backend=pure-java, onnxOperators=56, onnxOpset=17, onnxNodes=2535, onnxDynamicNodes=1311, phonemizer=misaki-java fba1236, no fallback, graph=onnx_paradee_int8.onnx, voices=af_heart,bf_isabella,am_puck,bm_fable} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bf_isabella","voiceIndex":1,"corpus":"harvard-200","pass":3,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 6.8.0-138-generic amd64 8 cpus","sentences":200,"totalAudioSeconds":594.5500000000001,"totalRunSeconds":46.668978946000024,"realTimeMultiple":12.739725904180268,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.175,"runSeconds":0.388016286,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.387845544,"realTimeFactor":0.12220985385826771,"finite":true,"samples":76200},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.025,"runSeconds":0.557526111,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.557497311,"realTimeFactor":0.18430615239669423,"finite":true,"samples":72600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.85,"runSeconds":0.287710338,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.287695228,"realTimeFactor":0.10095099578947368,"finite":true,"samples":68400},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.25,"runSeconds":0.272814332,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.272791372,"realTimeFactor":0.08394287138461538,"finite":true,"samples":78000},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.225,"runSeconds":0.241776755,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241745024,"realTimeFactor":0.07496953643410853,"finite":true,"samples":77400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.95,"runSeconds":0.231919565,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231900544,"realTimeFactor":0.07861680169491525,"finite":true,"samples":70800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.15,"runSeconds":0.244733441,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244713261,"realTimeFactor":0.07769315587301587,"finite":true,"samples":75600},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.05,"runSeconds":0.248929501,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248904711,"realTimeFactor":0.08161622983606558,"finite":true,"samples":73200},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.95,"runSeconds":0.230745772,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230710282,"realTimeFactor":0.07821890576271186,"finite":true,"samples":70800},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.4,"runSeconds":0.250875979,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250854769,"realTimeFactor":0.07378705264705883,"finite":true,"samples":81600},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.7,"runSeconds":0.207084555,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207068295,"realTimeFactor":0.07669798333333333,"finite":true,"samples":64800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.025,"runSeconds":0.225254242,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225235152,"realTimeFactor":0.07446421223140495,"finite":true,"samples":72600},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.4,"runSeconds":0.251017181,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250998321,"realTimeFactor":0.07382858264705881,"finite":true,"samples":81600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.925,"runSeconds":0.22717447,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22715359,"realTimeFactor":0.07766648547008548,"finite":true,"samples":70200},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.825,"runSeconds":0.209893991,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209868591,"realTimeFactor":0.0742987578761062,"finite":true,"samples":67800},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.05,"runSeconds":0.239101381,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239076651,"realTimeFactor":0.07839389540983607,"finite":true,"samples":73200},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.95,"runSeconds":0.22689785,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226875739,"realTimeFactor":0.07691452542372881,"finite":true,"samples":70800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.95,"runSeconds":0.252105952,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252089742,"realTimeFactor":0.08545964474576272,"finite":true,"samples":70800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.825,"runSeconds":0.217437681,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217408261,"realTimeFactor":0.07696909061946902,"finite":true,"samples":67800},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.025,"runSeconds":0.229755495,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229738385,"realTimeFactor":0.07595222975206611,"finite":true,"samples":72600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.85,"runSeconds":0.22593923,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22592243,"realTimeFactor":0.07927692280701754,"finite":true,"samples":68400},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.225,"runSeconds":0.23461299,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23459462,"realTimeFactor":0.07274821395348836,"finite":true,"samples":77400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.125,"runSeconds":0.240538254,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240521194,"realTimeFactor":0.07697224128,"finite":true,"samples":75000},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.2,"runSeconds":0.251734129,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251710879,"realTimeFactor":0.07866691531249999,"finite":true,"samples":76800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.875,"runSeconds":0.223216185,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223196225,"realTimeFactor":0.07764041217391304,"finite":true,"samples":69000},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.675,"runSeconds":0.220768363,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220740993,"realTimeFactor":0.0825302291588785,"finite":true,"samples":64200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.85,"runSeconds":0.213424884,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213407154,"realTimeFactor":0.07488592421052631,"finite":true,"samples":68400},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.1,"runSeconds":0.238755719,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238737938,"realTimeFactor":0.07701797387096775,"finite":true,"samples":74400},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.275,"runSeconds":0.249319127,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249297307,"realTimeFactor":0.07612797770992366,"finite":true,"samples":78600},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.775,"runSeconds":0.238272526,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238256436,"realTimeFactor":0.08586397333333334,"finite":true,"samples":66600},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.75,"runSeconds":0.214802479,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214786808,"realTimeFactor":0.07810999236363636,"finite":true,"samples":66000},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.0,"runSeconds":0.218817895,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218800775,"realTimeFactor":0.07293929833333333,"finite":true,"samples":72000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.1,"runSeconds":0.287937115,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.287920714,"realTimeFactor":0.09288294032258065,"finite":true,"samples":74400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.825,"runSeconds":0.214150553,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214125863,"realTimeFactor":0.07580550548672566,"finite":true,"samples":67800},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.6,"runSeconds":0.192362461,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192346121,"realTimeFactor":0.07398556192307693,"finite":true,"samples":62400},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.15,"runSeconds":0.248378459,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248361389,"realTimeFactor":0.07885030444444445,"finite":true,"samples":75600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.925,"runSeconds":0.222042734,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222024664,"realTimeFactor":0.07591204581196581,"finite":true,"samples":70200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.125,"runSeconds":0.303382149,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.303363459,"realTimeFactor":0.09708228767999999,"finite":true,"samples":75000},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.9,"runSeconds":0.223621411,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223604911,"realTimeFactor":0.07711083137931034,"finite":true,"samples":69600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.4,"runSeconds":0.169413139,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169397729,"realTimeFactor":0.07058880791666666,"finite":true,"samples":57600},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.075,"runSeconds":0.233321751,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23330433,"realTimeFactor":0.07587699219512195,"finite":true,"samples":73800},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.1,"runSeconds":0.238161015,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238142065,"realTimeFactor":0.07682613387096775,"finite":true,"samples":74400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.925,"runSeconds":0.238016904,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237990383,"realTimeFactor":0.08137330051282052,"finite":true,"samples":70200},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.95,"runSeconds":0.224981663,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224956193,"realTimeFactor":0.07626497050847457,"finite":true,"samples":70800},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.025,"runSeconds":0.224409698,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224389008,"realTimeFactor":0.07418502413223141,"finite":true,"samples":72600},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.8,"runSeconds":0.198115845,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198099435,"realTimeFactor":0.07075565892857144,"finite":true,"samples":67200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.05,"runSeconds":0.249431671,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249414881,"realTimeFactor":0.08178087573770491,"finite":true,"samples":73200},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.825,"runSeconds":0.207897336,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207878306,"realTimeFactor":0.07359197734513273,"finite":true,"samples":67800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.825,"runSeconds":0.20623608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2062192,"realTimeFactor":0.0730039221238938,"finite":true,"samples":67800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.875,"runSeconds":0.211523489,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211505519,"realTimeFactor":0.07357338747826088,"finite":true,"samples":69000},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.75,"runSeconds":0.248843325,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248811885,"realTimeFactor":0.09048848181818182,"finite":true,"samples":66000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.975,"runSeconds":0.234458903,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234440853,"realTimeFactor":0.07880971529411765,"finite":true,"samples":71400},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.9,"runSeconds":0.217953399,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217925449,"realTimeFactor":0.07515634448275862,"finite":true,"samples":69600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.975,"runSeconds":0.22997986,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22996265,"realTimeFactor":0.07730415462184874,"finite":true,"samples":71400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.125,"runSeconds":0.265298637,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265280837,"realTimeFactor":0.08489556384000001,"finite":true,"samples":75000},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.925,"runSeconds":0.21807111,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21805385,"realTimeFactor":0.07455422564102565,"finite":true,"samples":70200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.0,"runSeconds":0.218156111,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218139411,"realTimeFactor":0.07271870366666668,"finite":true,"samples":72000},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.725,"runSeconds":0.237708183,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237690172,"realTimeFactor":0.08723236073394494,"finite":true,"samples":65400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.0,"runSeconds":0.252031036,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252005956,"realTimeFactor":0.08401034533333333,"finite":true,"samples":72000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.175,"runSeconds":0.275595335,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.275575915,"realTimeFactor":0.08680168031496063,"finite":true,"samples":76200},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.975,"runSeconds":0.230530076,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230512276,"realTimeFactor":0.07748910117647059,"finite":true,"samples":71400},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.1,"runSeconds":0.235665545,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235647745,"realTimeFactor":0.0760211435483871,"finite":true,"samples":74400},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.95,"runSeconds":0.242011953,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241994623,"realTimeFactor":0.08203795016949152,"finite":true,"samples":70800},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.1,"runSeconds":0.236834684,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236817734,"realTimeFactor":0.07639828516129031,"finite":true,"samples":74400},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.8,"runSeconds":0.198743192,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198725311,"realTimeFactor":0.07097971142857144,"finite":true,"samples":67200},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.25,"runSeconds":0.240209187,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240190217,"realTimeFactor":0.07391051907692307,"finite":true,"samples":78000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.075,"runSeconds":0.280248558,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.280229868,"realTimeFactor":0.09113774243902438,"finite":true,"samples":73800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.25,"runSeconds":0.246959159,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246933599,"realTimeFactor":0.07598743353846155,"finite":true,"samples":78000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.0,"runSeconds":0.218406654,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218389594,"realTimeFactor":0.072802218,"finite":true,"samples":72000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.235664946,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235647366,"realTimeFactor":0.07307440186046511,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.0,"runSeconds":0.22109799,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22107895,"realTimeFactor":0.07369933,"finite":true,"samples":72000},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.85,"runSeconds":0.226668681,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226652021,"realTimeFactor":0.07953287052631579,"finite":true,"samples":68400},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.15,"runSeconds":0.239653492,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239636412,"realTimeFactor":0.07608047365079365,"finite":true,"samples":75600},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.075,"runSeconds":0.232501775,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232482255,"realTimeFactor":0.07561033333333332,"finite":true,"samples":73800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.975,"runSeconds":0.227054885,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227036735,"realTimeFactor":0.07632096974789916,"finite":true,"samples":71400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.7,"runSeconds":0.255755312,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.255618841,"realTimeFactor":0.09472418962962963,"finite":true,"samples":64800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.95,"runSeconds":0.229057895,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229033125,"realTimeFactor":0.0776467440677966,"finite":true,"samples":70800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.3,"runSeconds":0.244145475,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244127234,"realTimeFactor":0.07398347727272728,"finite":true,"samples":79200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.1,"runSeconds":0.234190852,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234171802,"realTimeFactor":0.07554543612903225,"finite":true,"samples":74400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.15,"runSeconds":0.240264909,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240246569,"realTimeFactor":0.07627457428571428,"finite":true,"samples":75600},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.0,"runSeconds":0.218516367,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218500177,"realTimeFactor":0.072838789,"finite":true,"samples":72000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.9,"runSeconds":0.217962242,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217945472,"realTimeFactor":0.07515939379310345,"finite":true,"samples":69600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.65,"runSeconds":0.201077946,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201060936,"realTimeFactor":0.07587847018867926,"finite":true,"samples":63600},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.05,"runSeconds":0.229260027,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229240267,"realTimeFactor":0.07516722196721312,"finite":true,"samples":73200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.8,"runSeconds":0.211764874,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211736024,"realTimeFactor":0.07563031214285715,"finite":true,"samples":67200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.9,"runSeconds":0.219009323,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218989352,"realTimeFactor":0.07552045620689656,"finite":true,"samples":69600},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.725,"runSeconds":0.206198523,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206180433,"realTimeFactor":0.07566918275229358,"finite":true,"samples":65400},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.7,"runSeconds":0.205055853,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205036333,"realTimeFactor":0.07594661222222222,"finite":true,"samples":64800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.825,"runSeconds":0.252997978,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252970027,"realTimeFactor":0.08955680637168141,"finite":true,"samples":67800},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.975,"runSeconds":0.228319998,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228300448,"realTimeFactor":0.07674621781512604,"finite":true,"samples":71400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.8,"runSeconds":0.1961869,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19616856,"realTimeFactor":0.07006675,"finite":true,"samples":67200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.7,"runSeconds":0.206939911,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206921281,"realTimeFactor":0.07664441148148148,"finite":true,"samples":64800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.05,"runSeconds":0.249180662,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249160342,"realTimeFactor":0.08169857770491804,"f