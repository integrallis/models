{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.11 {onnxOpset=17, onnxNodes=2535, onnxDynamicNodes=1311, phonemizer=misaki-java fba1236, no fallback, graph=onnx_paradee_int8.onnx, voices=af_heart,bf_isabella,am_puck,bm_fable, backend=pure-java, onnxOperators=56} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bf_isabella","voiceIndex":1,"corpus":"harvard-200","pass":2,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 6.8.0-138-generic amd64 8 cpus","sentences":200,"totalAudioSeconds":594.5500000000001,"totalRunSeconds":46.65462015399997,"realTimeMultiple":12.743646782193892,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.175,"runSeconds":0.370159329,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.369967668,"realTimeFactor":0.11658561543307086,"finite":true,"samples":76200},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.025,"runSeconds":0.527750975,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.527728805,"realTimeFactor":0.17446313223140497,"finite":true,"samples":72600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.85,"runSeconds":0.238114903,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238096643,"realTimeFactor":0.08354908877192982,"finite":true,"samples":68400},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.25,"runSeconds":0.245222691,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245206071,"realTimeFactor":0.07545313569230769,"finite":true,"samples":78000},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.225,"runSeconds":0.247119395,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247084555,"realTimeFactor":0.07662616899224806,"finite":true,"samples":77400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.95,"runSeconds":0.240037737,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240022417,"realTimeFactor":0.08136872440677966,"finite":true,"samples":70800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.15,"runSeconds":0.256259128,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.256238278,"realTimeFactor":0.08135210412698413,"finite":true,"samples":75600},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.05,"runSeconds":0.246226099,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246198659,"realTimeFactor":0.08072986852459017,"finite":true,"samples":73200},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.95,"runSeconds":0.228079806,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228061186,"realTimeFactor":0.07731518847457626,"finite":true,"samples":70800},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.4,"runSeconds":0.256199058,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.256170798,"realTimeFactor":0.07535266411764706,"finite":true,"samples":81600},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.7,"runSeconds":0.211326372,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211311382,"realTimeFactor":0.07826902666666667,"finite":true,"samples":64800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.025,"runSeconds":0.230616194,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230597264,"realTimeFactor":0.07623675834710744,"finite":true,"samples":72600},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.4,"runSeconds":0.260323277,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.260289327,"realTimeFactor":0.07656566970588236,"finite":true,"samples":81600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.925,"runSeconds":0.230101061,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230082171,"realTimeFactor":0.0786670294017094,"finite":true,"samples":70200},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.825,"runSeconds":0.227671945,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227653665,"realTimeFactor":0.08059183893805309,"finite":true,"samples":67800},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.05,"runSeconds":0.252786397,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252750437,"realTimeFactor":0.08288078590163935,"finite":true,"samples":73200},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.95,"runSeconds":0.255016993,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.254997173,"realTimeFactor":0.08644643830508475,"finite":true,"samples":70800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.95,"runSeconds":0.227491235,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227475075,"realTimeFactor":0.07711567288135593,"finite":true,"samples":70800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.825,"runSeconds":0.259181722,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.259036111,"realTimeFactor":0.09174574230088495,"finite":true,"samples":67800},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.025,"runSeconds":0.255761129,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.255731978,"realTimeFactor":0.084549133553719,"finite":true,"samples":72600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.85,"runSeconds":0.217046275,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217029814,"realTimeFactor":0.07615658771929824,"finite":true,"samples":68400},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.225,"runSeconds":0.284304986,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.284285746,"realTimeFactor":0.08815658480620155,"finite":true,"samples":77400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.125,"runSeconds":0.240879678,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240862528,"realTimeFactor":0.07708149696000001,"finite":true,"samples":75000},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.2,"runSeconds":0.233369038,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233348558,"realTimeFactor":0.07292782437499999,"finite":true,"samples":76800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.875,"runSeconds":0.22628899,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22626537,"realTimeFactor":0.07870921391304347,"finite":true,"samples":69000},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.675,"runSeconds":0.208198856,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208182346,"realTimeFactor":0.07783134803738317,"finite":true,"samples":64200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.85,"runSeconds":0.216629563,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216612833,"realTimeFactor":0.07601037298245614,"finite":true,"samples":68400},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.1,"runSeconds":0.23933047,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23931041,"realTimeFactor":0.07720337741935483,"finite":true,"samples":74400},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.275,"runSeconds":0.247884869,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247868088,"realTimeFactor":0.07569003633587787,"finite":true,"samples":78600},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.775,"runSeconds":0.220791355,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220774195,"realTimeFactor":0.07956445225225225,"finite":true,"samples":66600},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.75,"runSeconds":0.219591856,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219568006,"realTimeFactor":0.079851584,"finite":true,"samples":66000},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.0,"runSeconds":0.220801045,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220783865,"realTimeFactor":0.07360034833333333,"finite":true,"samples":72000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.1,"runSeconds":0.2346788,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23465556,"realTimeFactor":0.07570283870967741,"finite":true,"samples":74400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.825,"runSeconds":0.207846467,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207830067,"realTimeFactor":0.07357397061946902,"finite":true,"samples":67800},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.6,"runSeconds":0.193413128,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193395828,"realTimeFactor":0.07438966461538461,"finite":true,"samples":62400},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.15,"runSeconds":0.245078322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245060412,"realTimeFactor":0.0778026419047619,"finite":true,"samples":75600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.925,"runSeconds":0.220757876,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220741666,"realTimeFactor":0.07547277811965812,"finite":true,"samples":70200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.125,"runSeconds":0.236562165,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236545185,"realTimeFactor":0.0756998928,"finite":true,"samples":75000},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.9,"runSeconds":0.285854354,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.285837304,"realTimeFactor":0.09857046689655172,"finite":true,"samples":69600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.4,"runSeconds":0.174137668,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174114778,"realTimeFactor":0.07255736166666667,"finite":true,"samples":57600},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.075,"runSeconds":0.237023549,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237005658,"realTimeFactor":0.07708082894308943,"finite":true,"samples":73800},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.1,"runSeconds":0.24010453,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24008638,"realTimeFactor":0.07745307419354838,"finite":true,"samples":74400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.925,"runSeconds":0.24284733,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242828899,"realTimeFactor":0.08302472820512821,"finite":true,"samples":70200},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.95,"runSeconds":0.226384467,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226366777,"realTimeFactor":0.07674049728813559,"finite":true,"samples":70800},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.025,"runSeconds":0.227741426,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227722676,"realTimeFactor":0.07528642181818182,"finite":true,"samples":72600},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.8,"runSeconds":0.20364942,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20363034,"realTimeFactor":0.07273193571428571,"finite":true,"samples":67200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.05,"runSeconds":0.247596023,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247570483,"realTimeFactor":0.08117902393442623,"finite":true,"samples":73200},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.825,"runSeconds":0.209236781,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209219261,"realTimeFactor":0.0740661171681416,"finite":true,"samples":67800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.825,"runSeconds":0.208866857,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208849367,"realTimeFactor":0.07393517061946901,"finite":true,"samples":67800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.875,"runSeconds":0.217556628,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217535728,"realTimeFactor":0.07567187060869565,"finite":true,"samples":69000},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.75,"runSeconds":0.232045838,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232022048,"realTimeFactor":0.08438030472727273,"finite":true,"samples":66000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.975,"runSeconds":0.233153986,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233136856,"realTimeFactor":0.07837108773109244,"finite":true,"samples":71400},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.9,"runSeconds":0.220417819,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220398939,"realTimeFactor":0.07600614448275862,"finite":true,"samples":69600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.975,"runSeconds":0.231481065,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231463175,"realTimeFactor":0.07780876134453782,"finite":true,"samples":71400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.125,"runSeconds":0.265310568,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265282628,"realTimeFactor":0.08489938176,"finite":true,"samples":75000},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.925,"runSeconds":0.221883521,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221868231,"realTimeFactor":0.07585761401709402,"finite":true,"samples":70200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.0,"runSeconds":0.220650702,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220632402,"realTimeFactor":0.073550234,"finite":true,"samples":72000},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.725,"runSeconds":0.212960009,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212944079,"realTimeFactor":0.07815046201834862,"finite":true,"samples":65400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.0,"runSeconds":0.240504639,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240485408,"realTimeFactor":0.080168213,"finite":true,"samples":72000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.175,"runSeconds":0.249552862,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249535101,"realTimeFactor":0.07859932661417322,"finite":true,"samples":76200},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.975,"runSeconds":0.232887068,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232869858,"realTimeFactor":0.07828136739495799,"finite":true,"samples":71400},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.1,"runSeconds":0.26223188,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.26220359,"realTimeFactor":0.08459092903225805,"finite":true,"samples":74400},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.95,"runSeconds":0.229403884,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229387294,"realTimeFactor":0.07776402847457627,"finite":true,"samples":70800},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.1,"runSeconds":0.237809432,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237791802,"realTimeFactor":0.07671272,"finite":true,"samples":74400},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.8,"runSeconds":0.204294912,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204277112,"realTimeFactor":0.07296246857142857,"finite":true,"samples":67200},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.25,"runSeconds":0.240242431,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240223621,"realTimeFactor":0.07392074800000001,"finite":true,"samples":78000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.075,"runSeconds":0.243630934,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243612014,"realTimeFactor":0.07922957203252032,"finite":true,"samples":73800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.25,"runSeconds":0.248505167,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248477667,"realTimeFactor":0.07646312830769231,"finite":true,"samples":78000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.0,"runSeconds":0.220495564,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220478684,"realTimeFactor":0.07349852133333333,"finite":true,"samples":72000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.241834053,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241814853,"realTimeFactor":0.07498730325581394,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.0,"runSeconds":0.221968316,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221951276,"realTimeFactor":0.07398943866666667,"finite":true,"samples":72000},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.85,"runSeconds":0.21243774,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21242076,"realTimeFactor":0.07453955789473685,"finite":true,"samples":68400},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.15,"runSeconds":0.244569553,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244546152,"realTimeFactor":0.07764112793650793,"finite":true,"samples":75600},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.075,"runSeconds":0.241971455,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241944315,"realTimeFactor":0.07868990406504064,"finite":true,"samples":73800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.975,"runSeconds":0.231893526,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231876635,"realTimeFactor":0.07794740369747899,"finite":true,"samples":71400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.7,"runSeconds":0.208826996,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208811956,"realTimeFactor":0.07734333185185184,"finite":true,"samples":64800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.95,"runSeconds":0.228018039,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228001219,"realTimeFactor":0.07729425050847458,"finite":true,"samples":70800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.3,"runSeconds":0.248644653,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248625473,"realTimeFactor":0.07534686454545454,"finite":true,"samples":79200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.1,"runSeconds":0.241615795,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241597595,"realTimeFactor":0.07794057903225807,"finite":true,"samples":74400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.15,"runSeconds":0.24379357,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24377568,"realTimeFactor":0.07739478412698413,"finite":true,"samples":75600},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.0,"runSeconds":0.221712177,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221694017,"realTimeFactor":0.07390405900000001,"finite":true,"samples":72000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.9,"runSeconds":0.230181718,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230153647,"realTimeFactor":0.07937300620689655,"finite":true,"samples":69600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.65,"runSeconds":0.206620334,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206590784,"realTimeFactor":0.07796993735849056,"finite":true,"samples":63600},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.05,"runSeconds":0.23226236,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232232,"realTimeFactor":0.07615159344262296,"finite":true,"samples":73200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.8,"runSeconds":0.197610371,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197590351,"realTimeFactor":0.07057513250000001,"finite":true,"samples":67200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.9,"runSeconds":0.287533776,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.287513996,"realTimeFactor":0.09914957793103449,"finite":true,"samples":69600},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.725,"runSeconds":0.20884118,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2088124,"realTimeFactor":0.07663896513761467,"finite":true,"samples":65400},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.7,"runSeconds":0.207927393,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207908943,"realTimeFactor":0.07701014555555555,"finite":true,"samples":64800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.825,"runSeconds":0.205465367,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205446917,"realTimeFactor":0.07273110336283185,"finite":true,"samples":67800},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.975,"runSeconds":0.230010888,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229991978,"realTimeFactor":0.07731458420168066,"finite":true,"samples":71400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.8,"runSeconds":0.20427702,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20424751,"realTimeFactor":0.07295607857142858,"finite":true,"samples":67200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.7,"runSeconds":0.209108343,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209088033,"realTimeFactor":0.07744753444444444,"finite":true,"samples":64800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.05,"runSeconds":0.228044465,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228025285,"realTimeFactor":0.07476867704918033,"finite":true,"samples":73200},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":3.2,"runSeconds":0.227855974,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227834034,"realTimeFactor":0.071204991875,"finite":true,"samples":76800},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":3.0,"runSeconds":0.242587237,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242567807,"realTimeFactor":0.08086241233333334,"finite":true,"samples":72000},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":2.95,"runSeconds":0.224452171,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224433551,"realTimeFactor":0.07608548169491525,"finite":true,"samples":70800},{"index":96,"text":"The term ended in late June that year.","audioSeconds":3.125,"runSeconds":0.241103518,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241082318,"realTimeFactor":0.07715312576,"finite":true,"samples":75000},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":3.075,"runSeconds":0.235914322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235894662,"realTimeFactor":0.07672010471544716,"finite":true,"samples":73800},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.55,"runSeconds":0.259121603,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.259102243,"realTimeFactor":0.10161631490196078,"finite":true,"samples":61200},{"index":99,"text":"The bill was paid every third week.","audioSeconds":2.95,"runSeconds":0.22973858,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22970158,"realTimeFactor":0.07787748474576271,"finite":true,"samples":70800},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":3.0,"runSeconds":0.218713554,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218691373,"realTimeFactor":0.072904518,"finite":true,"samples":72000},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":2.8,"runSeconds":0.196993602,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196974872,"realTimeFactor":0.07035485785714286,"finite":true,"samples":67200},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.75,"runSeconds":0.213288145,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213268465,"realTimeFactor":0.07755932545454546,"finite":true,"samples":66000},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.1,"runSeconds":0.248625203,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248604083,"realTimeFactor":0.08020167838709677,"finite":true,"samples":74400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.925,"runSeconds":0.221164431,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221138411,"realTimeFactor":0.07561177128205128,"finite":true,"samples":70200},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.05,"runSeconds":0.22818669,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22816555,"realTimeFactor":0.07481530819672132,"finite":true,"samples":73200},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.175,"runSeconds":0.2467759,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24675543,"realTimeFactor":0.07772469291338582,"finite":true,"samples":76200},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.239778172,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239743742,"realTimeFactor":0.07926551140495869,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.75,"runSeconds":0.214524026,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214504626,"realTimeFactor":0.07800873672727272,"finite":true,"samples":66000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.85,"runSeconds":0.207776518,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207757518,"realTimeFactor":0.07290404140350877,"finite":true,"samples":68400},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.325,"runSeconds":0.245426912,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245407422,"realTimeFactor":0.07381260511278195,"finite":true,"samples":79800},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":3.05,"runSeconds":0.234721937,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234701567,"realTimeFactor":0.07695801213114754,"finite":true,"samples":73200},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.7,"runSeconds":0.209897935,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209880135,"realTimeFactor":0.07773997592592592,"finite":true,"samples":64800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":3.075,"runSeconds":0.23214276,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23212223,"realTimeFactor":0.07549358048780487,"finite":true,"samples":73800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":2.925,"runSeconds":0.220960182,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220940182,"realTimeFactor":0.07554194256410257,"finite":true,"samples":70200},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":2.925,"runSeconds":0.238576297,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238545346,"realTimeFactor":0.08156454598290598,"finite":true,"samples":70200},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":3.0,"runSeconds":0.22179477,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22177334,"realTimeFactor":0.07393159,"finite":true,"samples":72000},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.425,"runSeconds":0.25912212,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.25909938,"realTimeFactor":0.07565609343065695,"finite":true,"samples":82200},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.7,"runSeconds":0.21615568,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21613514,"realTimeFactor":0.08005765925925926,"finite":true,"samples":64800},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":2.825,"runSeconds":0.210278029,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210258258,"realTimeFactor":0.07443470053097345,"finite":true,"samples":67800},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.7,"runSeconds":0.211221427,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211201087,"realTimeFactor":0.07823015814814814,"finite":true,"samples":64800},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":2.85,"runSeconds":0.222126614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222099644,"realTimeFactor":0.07793916280701754,"finite":true,"samples":68400},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":3.075,"runSeconds":0.239875178,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239841688,"realTimeFactor":0.07800818796747967,"finite":true,"samples":73800},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":3.0,"runSeconds":0.223526264,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223505814,"realTimeFactor":0.07450875466666666,"finite":true,"samples":72000},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":3.1,"runSeconds":0.23719989,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237162949,"realTimeFactor":0.07651609354838709,"finite":true,"samples":74400},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":3.05,"runSeconds":0.250877887,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250851836,"realTimeFactor":0.0822550449180328,"finite":true,"samples":73200},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":3.025,"runSeconds":0.230949227,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230926627,"realTimeFactor":0.07634685190082645,"finite":true,"samples":72600},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":2.875,"runSeconds":0.220189252,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220161011,"realTimeFactor":0.07658756591304348,"finite":true,"samples":69000},{"index":128,"text":"Feel