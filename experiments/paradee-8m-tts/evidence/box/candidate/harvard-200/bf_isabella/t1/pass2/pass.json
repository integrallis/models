49,"finite":true,"samples":73800},{"index":137,"text":"Clothes and lodging are free to new men.","audioSeconds":3.0,"runSeconds":0.220798648,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220779028,"realTimeFactor":0.07359954933333333,"finite":true,"samples":72000},{"index":138,"text":"We frown when events take a bad turn.","audioSeconds":3.025,"runSeconds":0.230508837,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230487677,"realTimeFactor":0.07620126842975207,"finite":true,"samples":72600},{"index":139,"text":"Port is a strong wine with a smoky taste.","audioSeconds":3.225,"runSeconds":0.236109787,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236090297,"realTimeFactor":0.07321233705426355,"finite":true,"samples":77400},{"index":140,"text":"The young kid jumped the rusty gate.","audioSeconds":2.675,"runSeconds":0.205205031,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205187521,"realTimeFactor":0.07671216112149534,"finite":true,"samples":64200},{"index":141,"text":"Guess the results from the first scores.","audioSeconds":2.925,"runSeconds":0.223429019,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223409749,"realTimeFactor":0.0763859894017094,"finite":true,"samples":70200},{"index":142,"text":"A salt pickle tastes fine with ham.","audioSeconds":2.9,"runSeconds":0.223847582,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223811412,"realTimeFactor":0.07718882137931034,"finite":true,"samples":69600},{"index":143,"text":"The just claim got the right verdict.","audioSeconds":2.825,"runSeconds":0.207476828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207458088,"realTimeFactor":0.07344312495575221,"finite":true,"samples":67800},{"index":144,"text":"These thistles bend in a high wind.","audioSeconds":2.925,"runSeconds":0.217395098,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217375697,"realTimeFactor":0.07432311042735043,"finite":true,"samples":70200},{"index":145,"text":"Pure bred poodles have curls.","audioSeconds":2.625,"runSeconds":0.195616434,"g2pSeconds":0.0,"timeToFirstAudioSe