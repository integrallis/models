dex":163,"text":"A filing case is now hard to buy.","audioSeconds":2.925,"runSeconds":0.226429427,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226410957,"realTimeFactor":0.07741176991452992,"finite":true,"samples":70200},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.0,"runSeconds":0.220152223,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220131993,"realTimeFactor":0.07338407433333334,"finite":true,"samples":72000},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.25,"runSeconds":0.238320101,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238299961,"realTimeFactor":0.07332926184615385,"finite":true,"samples":78000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.05,"runSeconds":0.230121014,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230099884,"realTimeFactor":0.07544951278688525,"finite":true,"samples":73200},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.075,"runSeconds":0.259994366,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.259949455,"realTimeFactor":0.08455101333333333,"finite":true,"samples":73800},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.9,"runSeconds":0.219942183,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219921723,"realTimeFactor":0.07584213206896552,"finite":true,"samples":69600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.05,"runSeconds":0.229830794,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229810954,"realTimeFactor":0.0753543586885246,"finite":true,"samples":73200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.775,"runSeconds":0.217321555,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217302995,"realTimeFactor":0.07831407387387387,"finite":true,"samples":66600},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.05,"runSeconds":0.235597575,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235576055,"realTimeFactor":0.07724510655737706,"finite":true,"samples":73200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.1,"runSeconds":0.234781089,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234760429,"realTimeFactor":0.07573583516129032,"finite":true,"samples":74400},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.325,"runSeconds":0.248332915,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248310815,"realTimeFactor":0.0746865909774436,"finite":true,"samples":79800},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.875,"runSeconds":0.24039329,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24037214,"realTimeFactor":0.08361505739130436,"finite":true,"samples":69000},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.925,"runSeconds":0.227050095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227009944,"realTimeFactor":0.07762396410256411,"finite":true,"samples":70200},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.825,"runSeconds":0.209202219,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209181519,"realTimeFactor":0.0740538828318584,"finite":true,"samples":67800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.95,"runSeconds":0.224633299,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224613209,"realTimeFactor":0.07614688101694915,"finite":true,"samples":70800},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.125,"runSeconds":0.26008603,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.26006327,"realTimeFactor":0.0832275296,"finite":true,"samples":75000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.975,"runSeconds":0.231031435,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231012015,"realTimeFactor":0.07765762521008403,"finite":true,"samples":71400},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.875,"runSeconds":0.215788386,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215769556,"realTimeFactor":0.07505682991304348,"finite":true,"samples":69000},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.75,"runSeconds":0.214880432,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214862222,"realTimeFactor":0.07813833890909092,"finite":true,"samples":66000},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.05,"runSeconds":0.296902963,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.296881793,"realTimeFactor":0.09734523377049181,"finite":true,"samples":73200},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.35,"runSeconds":0.263027842,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.262994822,"realTimeFactor":0.07851577373134329,"finite":true,"samples":80400},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.9,"runSeconds":0.219268232,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219248292,"realTimeFactor":0.0756097351724138,"finite":true,"samples":69600},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.775,"runSeconds":0.221999163,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221975803,"realTimeFactor":0.07999969837837838,"finite":true,"samples":66600},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.75,"runSeconds":0.216511674,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216488064,"realTimeFactor":0.07873151781818181,"finite":true,"samples":66000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.85,"runSeconds":0.225001514,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224980954,"realTimeFactor":0.07894789964912281,"finite":true,"samples":68400},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.25,"runSeconds":0.245105568,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245083758,"realTimeFactor":0.07541709784615384,"finite":true,"samples":78000},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.025,"runSeconds":0.227335312,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227295862,"realTimeFactor":0.07515216925619836,"finite":true,"samples":72600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":3.0,"runSeconds":0.225413589,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225394169,"realTimeFactor":0.075137863,"finite":true,"samples":72000},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":3.125,"runSeconds":0.270900882,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.270868511,"realTimeFactor":0.08668828224,"finite":true,"samples":75000},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.625,"runSeconds":0.198432858,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198414568,"realTimeFactor":0.07559346971428571,"finite":true,"samples":63000},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":3.0,"runSeconds":0.217913036,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217892936,"realTimeFactor":0.07263767866666666,"finite":true,"samples":72000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.9,"runSeconds":0.221163059,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221132689,"realTimeFactor":0.07626312379310345,"finite":true,"samples":69600},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.9,"runSeconds":0.282722657,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.282648707,"realTimeFactor":0.09749057137931035,"finite":true,"samples":69600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":3.025,"runSeconds":0.231228512,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231208772,"realTimeFactor":0.07643917752066116,"finite":true,"samples":72600},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":3.125,"runSeconds":0.240750439,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240730509,"realTimeFactor":0.07704014048,"finite":true,"samples"