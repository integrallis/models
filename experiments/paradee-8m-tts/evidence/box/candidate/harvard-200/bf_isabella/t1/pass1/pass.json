he juice of lemons makes fine punch.","audioSeconds":2.95,"runSeconds":0.22608378,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22606647,"realTimeFactor":0.07663856949152542,"finite":true,"samples":70800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.15,"runSeconds":0.250617031,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250598621,"realTimeFactor":0.07956096222222223,"finite":true,"samples":75600},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.05,"runSeconds":0.231097652,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231080242,"realTimeFactor":0.07576972196721311,"finite":true,"samples":73200},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.95,"runSeconds":0.239163054,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239143774,"realTimeFactor":0.08107222169491525,"finite":true,"samples":70800},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.4,"runSeconds":0.251172726,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251134706,"realTimeFactor":0.07387433117647059,"finite":true,"samples":81600},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.7,"runSeconds":0.208596872,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208580752,"realTimeFactor":0.07725810074074073,"finite":true,"samples":64800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.025,"runSeconds":0.227200053,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227179753,"realTimeFactor":0.07510745553719009,"finite":true,"samples":72600},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.4,"runSeconds":0.246040648,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246020338,"realTimeFactor":0.07236489647058823,"finite":true,"samples":81600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.925,"runSeconds":0.220846017,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220824467,"realTimeFactor":0.0755029117948718,"finite":true,"samples":70200},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.825,"runSeconds":0.214427458,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214403158,"realTimeFactor":0.0759035249557522,"finite":true,"samples":67800},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.05,"runSeconds":0.231263013,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231245233,"realTimeFactor":0.07582393868852459,"finite":true,"samples":73200},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.95,"runSeconds":0.221495559,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221470619,"realTimeFactor":0.07508324033898305,"finite":true,"samples":70800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.95,"runSeconds":0.230528338,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230508588,"realTimeFactor":0.0781451993220339,"finite":true,"samples":70800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.825,"runSeconds":0.20926382,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20924482,"realTimeFactor":0.0740756884955752,"finite":true,"samples":67800},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.025,"runSeconds":0.2426591,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24263366,"realTimeFactor":0.08021788429752066,"finite":true,"samples":72600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.85,"runSeconds":0.218202497,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218176927,"realTimeFactor":0.07656227964912281,"finite":true,"samples":68400},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.225,"runSeconds":0.234235188,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234215108,"realTimeFactor":0.07263106604651164,"finite":true,"samples":77400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.125,"runSeconds":0.237985083,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237966323,"realTimeFactor":0.07615522656,"finite":true,"samples":75000},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.2,"runSeconds":0.22542037,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22539986,"realTimeFactor":0.070443865625,"finite":true,"samples":76800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.875,"runSeconds":0.217959032,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217941162,"realTimeFactor":0.0758118372173913,"finite":true,"samples":69000},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.675,"runSeconds":0.211375994,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211359614,"realTimeFactor":0.0790190631775701,"finite":true,"samples":64200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.85,"runSeconds":0.214340172,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214306222,"realTimeFactor":0.07520707789473684,"finite":true,"samples":68400},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.1,"runSeconds":0.235397132,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235364722,"realTimeFactor":0.07593455870967741,"finite":true,"samples":74400},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.275,"runSeconds":0.248238464,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248219284,"realTimeFactor":0.07579800427480916,"finite":true,"samples":78600},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.775,"runSeconds":0.21538856,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215364501,"realTimeFactor":0.07761749909909911,"finite":true,"samples":66600},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.75,"runSeconds":0.238100813,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238083333,"realTimeFactor":0.08658211381818182,"finite":true,"samples":66000},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.0,"runSeconds":0.21903446,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21901665,"realTimeFactor":0.07301148666666667,"finite":true,"samples":72000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.1,"runSeconds":0.233283931,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233266281,"realTimeFactor":0.07525288096774194,"finite":true,"samples":74400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.825,"runSeconds":0.208279626,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208259536,"realTimeFactor":0.07372730123893804,"finite":true,"samples":67800},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.6,"runSeconds":0.223813677,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223796677,"realTimeFactor":0.08608218346153845,"finite":true,"samples":62400},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.15,"runSeconds":0.247265747,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247236087,"realTimeFactor":0.07849706253968254,"finite":true,"samples":75600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.925,"runSeconds":0.222334541,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222315621,"realTimeFactor":0.0760118088888889,"finite":true,"samples":70200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.125,"runSeconds":0.233169746,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233151166,"realTimeFactor":0.07461431872,"finite":true,"samples":75000},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.9,"runSeconds":0.218073828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218055558,"realTimeFactor":0.07519787172413793,"finite":true,"samples":69600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.4,"runSeconds":0.21987803,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2198623,"realTimeFactor":0.09161584583333333,"finite":true,"samples":57600},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.075,"runSeconds":0.231251944,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231232634,"realTimeFactor":0.07520388422764226,"finite":true,"samples":73800},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.1,"runSeconds":0.236656966,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236638306,"realTimeFactor":0.07634095677419354,"finite":true,"samples":74400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.925,"runSeconds":0.21860118,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2185839,"realTimeFactor":0.07473544615384616,"finite":true,"samples":70200},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.95,"runSeconds":0.221044142,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221026072,"realTimeFactor":0.07493021762711864,"finite":true,"samples":70800},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.025,"runSeconds":0.242334884,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242303194,"realTimeFactor":0.08011070545454546,"finite":true,"samples":72600},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.8,"runSeconds":0.198469943,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198452463,"realTimeFactor":0.0708821225,"finite":true,"samples":67200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.05,"runSeconds":0.234990554,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234971265,"realTimeFactor":0.07704608327868853,"finite":true,"samples":73200},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.825,"runSeconds":0.205485005,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205458645,"realTimeFactor":0.07273805486725664,"finite":true,"samples":67800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.825,"runSeconds":0.225505562,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225485802,"realTimeFactor":0.07982497769911504,"finite":true,"samples":67800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.875,"runSeconds":0.210688921,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210671661,"realTimeFactor":0.07328310295652174,"finite":true,"samples":69000},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.75,"runSeconds":0.213788597,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213767037,"realTimeFactor":0.077741308,"finite":true,"samples":66000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.975,"runSeconds":0.232175893,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232156223,"realTimeFactor":0.07804231697478992,"finite":true,"samples":71400},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.9,"runSeconds":0.272667045,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.272646375,"realTimeFactor":0.09402311896551724,"finite":true,"samples":69600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.975,"runSeconds":0.238868189,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238842069,"realTimeFactor":0.08029182823529411,"finite":true,"samples":71400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.125,"runSeconds":0.241012316,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240993576,"realTimeFactor":0.07712394112,"finite":true,"samples":75000},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.925,"runSeconds":0.23126984,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23124672,"realTimeFactor":0.07906661196581197,"finite":true,"samples":70200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.0,"runSeconds":0.216991862,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216974232,"realTimeFactor":0.07233062066666666,"finite":true,"samples":72000},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.725,"runSeconds":0.221980687,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221962427,"realTimeFactor":0.08146080256880735,"finite":true,"samples":65400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.0,"runSeconds":0.22013599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22011751,"realTimeFactor":0.07337866333333333,"finite":true,"samples":72000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.175,"runSeconds":0.243614709,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243595449,"realTimeFactor":0.07672904220472442,"finite":true,"samples":76200},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.975,"runSeconds":0.230046848,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230029018,"realTimeFactor":0.07732667159663865,"finite":true,"samples":71400},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.1,"runSeconds":0.259720444,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.259693914,"realTimeFactor":0.08378078838709677,"finite":true,"samples":74400},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.95,"runSeconds":0.227587944,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227570674,"realTimeFactor":0.07714845559322032,"finite":true,"samples":70800},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.1,"runSeconds":0.239109779,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239092119,"realTimeFactor":0.07713218677419355,"finite":true,"samples":74400},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.8,"runSeconds":0.199479019,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199460949,"realTimeFactor":0.0712425067857143,"finite":true,"samples":67200},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.25,"runSeconds":0.265493832,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265473892,"realTimeFactor":0.08169040984615385,"finite":true,"samples":78000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.075,"runSeconds":0.236421248,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236403428,"realTimeFactor":0.07688495869918699,"finite":true,"samples":73800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.25,"runSeconds":0.244266329,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244245109,"realTimeFactor":0.07515887046153846,"finite":true,"samples":78000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.0,"runSeconds":0.253432819,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253414749,"realTimeFactor":0.08447760633333333,"finite":true,"samples":72000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.242745756,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242719356,"realTimeFactor":0.07527000186046512,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.0,"runSeconds":0.22375667,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22373847,"realTimeFactor":0.07458555666666666,"finite":true,"samples":72000},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.85,"runSeconds":0.210883235,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210866725,"realTimeFactor":0.07399411754385965,"finite":true,"samples":68400},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.15,"runSeconds":0.23988961,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23987203,"realTimeFactor":0.07615543174603175,"finite":true,"samples":75600},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.075,"runSeconds":0.24311147,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24309373,"realTimeFactor":0.0790606406504065,"finite":true,"samples":73800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.975,"runSeconds":0.226189642,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226171872,"realTimeFactor":0.07603013176470588,"finite":true,"samples":71400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.7,"runSeconds":0.205549836,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205531096,"realTimeFactor":0.07612956888888889,"finite":true,"samples":64800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.95,"runSeconds":0.243153951,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243136391,"realTimeFactor":0.08242506813559322,"finite":true,"samples":70800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.3,"runSeconds":0.27233996,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.27231884,"realTimeFactor":0.08252726060606061,"finite":true,"samples":79200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.1,"runSeconds":0.24987402,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24984523,"realTimeFactor":0.08060452258064515,"finite":true,"samples":74400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.15,"runSeconds":0.244918245,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244899926,"realTimeFactor":0.07775182380952382,"finite":true,"samples":75600},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.0,"runSeconds":0.219365405,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219344765,"realTimeFactor":0.07312180166666667,"finite":true,"samples":72000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.9,"runSeconds":0.221550404,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221531764,"realTimeFactor":0.07639669103448277,"finite":true,"samples":69600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.65,"runSeconds":0.213847435,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213830565,"realTimeFactor":0.08069714528301887,"finite":true,"samples":63600},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.05,"runSeconds":0.228478609,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228459369,"realTimeFactor":0.0749110193442623,"finite":true,"samples":73200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.8,"runSeconds":0.194434908,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194417038,"realTimeFactor":0.06944103857142857,"finite":true,"samples":67200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.9,"runSeconds":0.21864865,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21863037,"realTimeFactor":0.07539608620689656,"finite":true,"samples":69600},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.725,"runSeconds":0.235179825,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235161436,"realTimeFactor":0.08630452293577982,"finite":true,"samples":65400},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.7,"runSeconds":0.211716602,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211687442,"realTimeFactor":0.07841355629629629,"finite":true,"samples":64800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.825,"runSeconds":0.20546544,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20544324,"realTimeFactor":0.07273112920353982,"finite":true,"samples":67800},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.975,"runSeconds":0.228726574,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228707424,"realTimeFactor":0.07688288201680672,"finite":true,"samples":71400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.8,"runSeconds":0.216227368,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216208368,"realTimeFactor":0.07722406000000001,"finite":true,"samples":67200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.7,"runSeconds":0.20826661,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20824823,"realTimeFactor":0.07713578148148147,"finite":true,"samples":64800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.05,"runSeconds":0.230558737,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230529077,"realTimeFactor":0.07559302852459017,"finite":true,"samples":73200},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":3.2,"runSeconds":0.22780913,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22777913,"realTimeFactor":0.071190353125,"finite":true,"samples":76800},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":3.0,"runSeconds":0.234355653,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234322634,"realTimeFactor":0.078118551,"finite":true,"samples":72000},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":2.95,"runSeconds":0.228006824,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227987364,"realTimeFactor":0.07729044881355931,"finite":true,"samples":70800},{"index":96,"text":"The term ended in late June that year.","audioSeconds":3.125,"runSeconds":0.242678389,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242659049,"realTimeFactor":0.07765708448,"finite":true,"samples":75000},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":3.075,"runSeconds":0.233849828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233830818,"realTimeFactor":0.07604872455284553,"finite":true,"samples":73800},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.55,"runSeconds":0.200073555,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200057205,"realTimeFactor":0.07846021764705882,"finite":true,"samples":61200},{"index":99,"text":"The bill was paid every third week.","audioSeconds":2.95,"runSeconds":0.225102719,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225078549,"realTimeFactor":0.07630600644067796,"finite":true,"samples":70800},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":3.0,"runSeconds":0.219822008,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219798368,"realTimeFactor":0.07327400266666667,"finite":true,"samples":72000},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":2.8,"runSeconds":0.200268379,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200249189,"realTimeFactor":0.07152442107142858,"finite":true,"samples":67200},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.75,"runSeconds":0.252646523,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252616753,"realTimeFactor":0.09187146290909091,"finite":true,"samples":66000},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.1,"runSeconds":0.238684178,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238662458,"realTimeFactor":0.07699489612903225,"finite":true,"samples":74400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.925,"runSeconds":0.221887421,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221867521,"realTimeFactor":0.07585894735042735,"finite":true,"samples":70200},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.05,"runSeconds":0.226820846,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226801356,"realTimeFactor":0.07436749049180329,"finite":true,"samples":73200},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.175,"runSeconds":0.258684553,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.258664493,"realTimeFactor":0.08147544976377953,"finite":true,"samples":76200},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.224762078,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224741218,"realTimeFactor":0.07430151338842976,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.75,"runSeconds":0.211680345,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211661945,"realTimeFactor":0.07697467090909091,"finite":true,"samples":66000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.85,"runSeconds":0.239422368,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239391848,"realTimeFactor":0.08400784842105263,"finite":true,"samples":68400},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.325,"runSeconds":0.245662122,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245641002,"realTimeFactor":0.07388334496240602,"finite":true,"samples":79800},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":3.05,"runSeconds":0.22817781,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22815885,"realTimeFactor":0.07481239672131149,"finite":true,"samples":73200},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.7,"runSeconds":0.220835879,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22081677,"realTimeFactor":0.0817910662962963,"finite":true,"samples":64800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":3.075,"runSeconds":0.230403633,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230382013,"realTimeFactor":0.07492801073170731,"finite":true,"samples":73800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":2.925,"runSeconds":0.227523476,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227503126,"realTimeFactor":0.07778580376068377,"finite":true,"samples":70200},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":2.925,"runSeconds":0.224606238,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224574538,"realTimeFactor":0.07678845743589745,"finite":true,"samples":70200},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":3.0,"runSeconds":0.219644063,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219622884,"realTimeFactor":0.07321468766666667,"finite":true,"samples":72000},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.425,"runSeconds":0.255874382,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.255852412,"realTimeFactor":0.07470784875912409,"finite":true,"samples":82200},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.7,"runSeconds":0.20628474,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20625624,"realTimeFactor":0.07640175555555555,"finite":true,"samples":64800},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":2.825,"runSeconds":0.206030821,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206011911,"realTimeFactor":0.07293126407079646,"finite":true,"samples":67800},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.7,"runSeconds":0.205009702,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204989322,"realTimeFactor":0.07592951925925925,"finite":true,"samples":64800},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":2.85,"runSeconds":0.214759903,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214740453,"realTimeFactor":0.07535435192982456,"finite":true,"samples":68400},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":3.075,"runSeconds":0.238438924,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238402554,"realTimeFactor":0.07754111349593495,"finite":true,"samples":73800},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":3.0,"runSeconds":0.220995891,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220972251,"realTimeFactor":0.073665297,"finite":true,"samples":72000},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":3.1,"runSeconds":0.236093788,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236073978,"realTimeFactor":0.0761592864516129,"finite":true,"samples":74400},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":3.05,"runSeconds":0.242283492,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242259382,"realTimeFactor":0.07943721049180327,"finite":true,"samples":73200},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":3.025,"runSeconds":0.226784411,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226762841,"realTimeFactor":0.0749700532231405,"finite":true,"samples":72600},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":2.875,"runSeconds":0.218137049,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218118459,"realTimeFactor":0.07587375617391304,"finite":true,"samples":69000},{"index":128,"text":"Feel the heat of the weak dying flame.","audioSeconds":3.025,"runSeconds":0.242192206,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242161466,"realTimeFactor":0.08006353917355372,"finite":true,"samples":72600},{"index":129,"text":"The tiny girl took off her hat.","audioSeconds":2.6,"runSeconds":0.189626595,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189600485,"realTimeFactor":0.07293330576923077,"finite":true,"samples":62400},{"index":130,"text":"A cramp is no small danger on a swim.","audioSeconds":3.2,"runSeconds":0.239488872,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239467232,"realTimeFactor":0.0748402725,"finite":true,"samples":76800},{"index":131,"text":"He said the same phrase thirty times.","audioSeconds":3.075,"runSeconds":0.230837202,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230814072,"realTimeFactor":0.07506900878048779,"finite":true,"samples":73800},{"index":132,"text":"Pluck the bright rose without leaves.","audioSeconds":2.9,"runSeconds":0.216434884,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216416104,"realTimeFactor":0.07463271862068965,"finite":true,"samples":69600},{"index":133,"text":"Two plus seven is less than ten.","audioSeconds":2.875,"runSeconds":0.217893474,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217873124,"realTimeFactor":0.0757890344347826,"finite":true,"samples":69000},{"index":134,"text":"The glow deepened in the eyes of the sweet girl.","audioSeconds":3.25,"runSeconds":0.243311482,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243280222,"realTimeFactor":0.07486507138461539,"finite":true,"samples":78000},{"index":135,"text":"Bring your problems to the wise chief.","audioSeconds":2.8,"runSeconds":0.198145426,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198126756,"realTimeFactor":0.07076622357142857,"finite":true,"samples":67200},{"index":136,"text":"Write a fond note to the friend you cherish.","audioSeconds":3.075,"runSeconds":0.232929854,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232911124,"realTimeFactor":0.07574954601626016,"finite":true,"samples":73800},{"index":137,"text":"Clothes and lodging are free to new men.","audioSeconds":3.0,"runSeconds":0.223577282,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223557903,"realTimeFactor":0.07452576066666666,"finite":true,"samples":72000},{"index":138,"text":"We frown when events take a bad turn.","audioSeconds":3.025,"runSeconds":0.225578151,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225557161,"realTimeFactor":0.07457128958677686,"finite":true,"samples":72600},{"index":139,"text":"Port is a strong wine with a smoky taste.","audioSeconds":3.225,"runSeconds":0.233627328,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233607608,"realTimeFactor":0.07244258232558139,"finite":true,"samples":77400},{"index":140,"text":"The young kid jumped the rusty gate.","audioSeconds":2.675,"runSeconds":0.203144226,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203126516,"realTimeFactor":0.07594176672897197,"finite":true,"samples":64200},{"index":141,"text":"Guess the results from the first scores.","audioSeconds":2.925,"runSeconds":0.227651165,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227621625,"realTimeFactor":0.07782945811965812,"finite":true,"samples":70200},{"index":142,"text":"A salt pickle tastes fine with ham.","audioSeconds":2.9,"runSeconds":0.220069911,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220049131,"realTimeFactor":0.07588617620689656,"finite":true,"samples":69600},{"index":143,"text":"The just claim got the right verdict.","audioSeconds":2.825,"runSeconds":0.208378501,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208355161,"realTimeFactor":0.07376230123893805,"finite":true,"samples":67800},{"index":144,"text":"These thistles bend in a high wind.","audioSeconds":2.925,"runSeconds":0.221536344,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221516694,"realTimeFactor":0.07573892102564103,"finite":true,"samples":70200},{"index":145,"text":"Pure bred poodles have curls.","audioSeconds":2.625,"runSeconds":0.194727007,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194707927,"realTimeFactor":0.07418171695238096,"finite":true,"samples":63000},{"index":146,"text":"The tree top waved in a graceful way.","audioSeconds":3.0,"runSeconds":0.213947161,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213928101,"realTimeFactor":0.07131572033333333,"finite":true,"samples":72000},{"index":147,"text":"The spot on the blotter was made by green ink.","audioSeconds":3.3,"runSeconds":0.253754628,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253722518,"realTimeFactor":0.07689534181818182,"finite":true,"samples":79200},{"index":148,"text":"Mud was spattered on the front of his white shirt.","audioSeconds":3.375,"runSeconds":0.25643929,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.25641856,"realTimeFactor":0.07598201185185184,"finite":true,"samples":81000},{"index":149,"text":"The cigar burned a hole in the desk top.","audioSeconds":2.975,"runSeconds":0.232348032,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232328912,"realTimeFactor":0.07810017882352942,"finite":true,"samples":71400},{"index":150,"text":"The empty flask stood on the tin tray.","audioSeconds":3.025,"runSeconds":0.224161628,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224142498,"realTimeFactor":0.07410301752066116,"finite":true,"samples":72600},{"index":151,"text":"A speedy man can beat this track mark.","audioSeconds":3.075,"runSeconds":0.24589999,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24588165,"realTimeFactor":0.07996747642276422,"finite":true,"samples":73800},{"index":152,"text":"He broke a new shoelace that day.","audioSeconds":2.675,"runSeconds":0.211669329,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211639749,"realTimeFactor":0.07912872112149533,"finite":true,"samples":64200},{"index":153,"text":"The coffee stand is too high for the couch.","audioSeconds":3.075,"runSeconds":0.233965285,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233944185,"realTimeFactor":0.07608627154471544,"finite":true,"samples":73800},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":3.1,"runSeconds":0.234760404,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234741114,"realTimeFactor":0.07572916258064516,"finite":true,"samples":74400},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.6,"runSeconds":0.18901147,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18899344,"realTimeFactor":0.07269671923076923,"finite":true,"samples":62400},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":3.0,"runSeconds":0.221078095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221059105,"realTimeFactor":0.07369269833333333,"finite":true,"samples":72000},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":3.05,"runSeconds":0.230014893,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229996203,"realTimeFactor":0.07541471901639345,"finite":true,"samples":73200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.825,"runSeconds":0.215134654,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215099794,"realTimeFactor":0.07615385982300885,"finite":true,"samples":67800},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.375,"runSeconds":0.253218224,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253196144,"realTimeFactor":0.07502762192592592,"finite":true,"samples":81000},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":3.05,"runSeconds":0.229936163,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229916613,"realTimeFactor":0.07538890590163935,"finite":true,"samples":73200},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.85,"runSeconds":0.215358987,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215335447,"realTimeFactor":0.07556455684210527,"finite":true,"samples":68400},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.725,"runSeconds":0.209957533,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209939503,"realTimeFactor":0.07704863596330275,"finite":true,"samples":65400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.925,"runSeconds":0.215423238,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215403778,"realTimeFactor":0.07364897025641026,"finite":true,"samples":70200},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.0,"runSeconds":0.218353816,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218332576,"realTimeFactor":0.07278460533333334,"finite":true,"samples":72000},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.25,"runSeconds":0.245240248,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245200118,"realTimeFactor":0.07545853784615385,"finite":true,"samples":78000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.05,"runSeconds":0.228019604,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227998574,"realTimeFactor":0.07476052590163934,"finite":true,"samples":73200},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.075,"runSeconds":0.234990629,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234971009,"realTimeFactor":0.07641971674796748,"finite":true,"samples":73800},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.9,"runSeconds":0.227892085,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227872105,"realTimeFactor":0.0785834775862069,"finite":true,"samples":69600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.05,"runSeconds":0.228638573,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228618273,"realTimeFactor":0.07496346655737705,"finite":true,"samples":73200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.775,"runSeconds":0.215874576,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215854957,"realTimeFactor":0.07779264000000001,"finite":true,"samples":66600},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.05,"runSeconds":0.236282714,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236251744,"realTimeFactor":0.07746974229508197,"finite":true,"samples":73200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.1,"runSeconds":0.235342523,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235316603,"realTimeFactor":0.0759169429032258,"finite":true,"samples":74400},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.325,"runSeconds":0.248469854,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248449824,"realTimeFactor":0.07472777563909774,"finite":true,"samples":79800},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.875,"runSeconds":0.21397495,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21395593,"realTimeFactor":0.07442606956521738,"finite":true,"samples":69000},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.925,"runSeconds":0.225182576,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225164046,"realTimeFactor":0.07698549606837607,"finite":true,"samples":70200},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.825,"runSeconds":0.215901471,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215869681,"realTimeFactor":0.07642529946902654,"finite":true,"samples":67800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.95,"runSeconds":0.223456816,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223436316,"realTimeFactor":0.07574807322033898,"finite":true,"samples":70800},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.125,"runSeconds":0.241023945,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241004225,"realTimeFactor":0.07712766239999999,"finite":true,"samples":75000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.975,"runSeconds":0.228478548,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228459548,"realTimeFactor":0.07679951193277311,"finite":true,"samples":71400},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.875,"runSeconds":0.213064759,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213047239,"realTimeFactor":0.07410948139130434,"finite":true,"samples":69000},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.75,"runSeconds":0.21176582,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21174778,"realTimeFactor":0.07700575272727272,"finite":true,"samples":66000},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.05,"runSeconds":0.231619956,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231589756,"realTimeFactor":0.07594096918032787,"finite":true,"samples":73200},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.35,"runSeconds":0.251945095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251922355,"realTimeFactor":0.07520749104477611,"finite":true,"samples":80400},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.9,"runSeconds":0.215889361,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215869901,"realTimeFactor":0.07444460724137932,"finite":true,"samples":69600},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.775,"runSeconds":0.220486019,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220465649,"realTimeFactor":0.07945442126126126,"finite":true,"samples":66600},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.75,"runSeconds":0.211952463,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211924293,"realTimeFactor":0.07707362290909091,"finite":true,"samples":66000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.85,"runSeconds":0.208531916,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208513686,"realTimeFactor":0.07316909333333334,"finite":true,"samples":68400},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.25,"runSeconds":0.246967766,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246948166,"realTimeFactor":0.07599008184615384,"finite":true,"samples":78000},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.025,"runSeconds":0.230077487,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230045967,"realTimeFactor":0.07605867338842975,"finite":true,"samples":72600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":3.0,"runSeconds":0.220839113,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220818463,"realTimeFactor":0.07361303766666667,"finite":true,"samples":72000},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":3.125,"runSeconds":0.240346252,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240326642,"realTimeFactor":0.07691080064,"finite":true,"samples":75000},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.625,"runSeconds":0.196221071,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196203281,"realTimeFactor":0.0747508841904762,"finite":true,"samples":63000},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":3.0,"runSeconds":0.218487339,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218467919,"realTimeFactor":0.072829113,"finite":true,"samples":72000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.9,"runSeconds":0.220242198,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220221338,"realTimeFactor":0.07594558551724138,"finite":true,"samples":69600},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.9,"runSeconds":0.214789372,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214771062,"realTimeFactor":0.07406530068965518,"finite":true,"samples":69600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":3.025,"runSeconds":0.229759452,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229739832,"realTimeFactor":0.07595353785123968,"finite":true,"samples":72600},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":3.125,"runSeconds":0.307805162,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.307779162,"realTimeFactor":0.09849765184,"finite":true,"samples":75000},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.65,"runSeconds":0.204935682,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204907052,"realTimeFactor":0.07733421962264152,"finite":true,"samples":63600},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":3.075,"runSeconds":0.230085217,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230064437,"realTimeFactor":0.07482446081300813,"finite":true,"samples":73800}]}