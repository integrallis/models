2000},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.9,"runSeconds":0.218143596,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218123137,"realTimeFactor":0.07522192965517241,"finite":true,"samples":69600},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.225,"runSeconds":0.234852205,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234831577,"realTimeFactor":0.07282238914728682,"finite":true,"samples":77400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":3.075,"runSeconds":0.23280646,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232785381,"realTimeFactor":0.07570941788617885,"finite":true,"samples":73800},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.225,"runSeconds":0.241605093,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241567296,"realTimeFactor":0.07491630790697675,"finite":true,"samples":77400},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.325,"runSeconds":0.247338556,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247304788,"realTimeFactor":0.07438753563909774,"finite":true,"samples":79800},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.223482635,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223457426,"realTimeFactor":0.0738785570247934,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.85,"runSeconds":0.222957007,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222938758,"realTimeFactor":0.07823052877192983,"finite":true,"samples":68400},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":3.0,"runSeconds":0.212982005,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212955046,"realTimeFactor":0.07099400166666667,"finite":true,"samples":72000},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.5,"runSeconds":0.259945085,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.259914607,"realTimeFactor":0.07427002428571429,"finite":true,"samples":84000},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":3.275,"runSeconds":0.257586495,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.257564056,"realTimeFactor":0.07865236488549619,"finite":true,"samples":78600},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.95,"runSeconds":0.228496007,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228465949,"realTimeFactor":0.07745627355932203,"finite":true,"samples":70800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":3.2,"runSeconds":0.225286554,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225263205,"realTimeFactor":0.07040204812499999,"finite":true,"samples":76800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":3.05,"runSeconds":0.227494308,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227474779,"realTimeFactor":0.07458829770491804,"finite":true,"samples":73200},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":3.075,"runSeconds":0.230556538,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23052975,"realTimeFactor":0.07497773593495935,"finite":true,"samples":73800},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":3.125,"runSeconds":0.244851044,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244829765,"realTimeFactor":0.07835233408,"finite":true,"samples":75000},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.6,"runSeconds":0.250463394,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250440615,"realTimeFactor":0.069573165,"finite":true,"samples":86400},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.85,"runSeconds":0.208750493,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208729425,"realTimeFactor":0.07324578701754386,"finite":true,"samples":68400},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":3.025,"runSeconds":0.222671727,"g2pSeco