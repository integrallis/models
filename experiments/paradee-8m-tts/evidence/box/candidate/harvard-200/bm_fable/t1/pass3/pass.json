{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.11 {onnxOperators=56, backend=pure-java, voices=af_heart,bf_isabella,am_puck,bm_fable, graph=onnx_paradee_int8.onnx, phonemizer=misaki-java fba1236, no fallback, onnxDynamicNodes=1311, onnxNodes=2535, onnxOpset=17} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bm_fable","voiceIndex":3,"corpus":"harvard-200","pass":3,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 6.8.0-138-generic amd64 8 cpus","sentences":200,"totalAudioSeconds":624.8499999999993,"totalRunSeconds":47.74818058700002,"realTimeMultiple":13.08636250257715,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.375,"runSeconds":0.357370399,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.357139314,"realTimeFactor":0.10588752562962964,"finite":true,"samples":81000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.15,"runSeconds":0.317914788,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.31788716,"realTimeFactor":0.10092532952380953,"finite":true,"samples":75600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":3.0,"runSeconds":0.229532344,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229515015,"realTimeFactor":0.07651078133333333,"finite":true,"samples":72000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.4,"runSeconds":0.251105446,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251087558,"realTimeFactor":0.07385454294117648,"finite":true,"samples":81600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.3,"runSeconds":0.27787453,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.277839102,"realTimeFactor":0.08420440303030303,"finite":true,"samples":79200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":3.1,"runSeconds":0.23959082,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239574891,"realTimeFactor":0.07728736129032258,"finite":true,"samples":74400},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.3,"runSeconds":0.252787416,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252769077,"realTimeFactor":0.07660224727272727,"finite":true,"samples":79200},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.275,"runSeconds":0.248085965,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248066046,"realTimeFactor":0.07575143969465649,"finite":true,"samples":78600},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":3.0,"runSeconds":0.22847409,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228442472,"realTimeFactor":0.07615803,"finite":true,"samples":72000},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.675,"runSeconds":0.280568403,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.280548084,"realTimeFactor":0.0763451436734694,"finite":true,"samples":88200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.825,"runSeconds":0.22252894,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222510551,"realTimeFactor":0.07877130619469026,"finite":true,"samples":67800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.175,"runSeconds":0.253815768,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.25378984,"realTimeFactor":0.07994197417322835,"finite":true,"samples":76200},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.475,"runSeconds":0.263353355,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.263335466,"realTimeFactor":0.0757851381294964,"finite":true,"samples":83400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":3.1,"runSeconds":0.239007669,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23899019,"realTimeFactor":0.07709924806451612,"finite":true,"samples":74400},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.925,"runSeconds":0.224933195,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224907616,"realTimeFactor":0.07690023760683762,"finite":true,"samples":70200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.1,"runSeconds":0.24232745,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242308251,"realTimeFactor":0.07817014516129032,"finite":true,"samples":74400},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":3.1,"runSeconds":0.233569694,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233551705,"realTimeFactor":0.07534506258064516,"finite":true,"samples":74400},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":3.15,"runSeconds":0.25014798,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250119522,"realTimeFactor":0.07941205714285714,"finite":true,"samples":75600},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.975,"runSeconds":0.232574077,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232557218,"realTimeFactor":0.07817616033613445,"finite":true,"samples":71400},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.225,"runSeconds":0.239637418,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239618709,"realTimeFactor":0.07430617612403101,"finite":true,"samples":77400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":3.0,"runSeconds":0.219250493,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219233564,"realTimeFactor":0.07308349766666666,"finite":true,"samples":72000},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.45,"runSeconds":0.266211582,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.266185144,"realTimeFactor":0.07716277739130434,"finite":true,"samples":82800},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.4,"runSeconds":0.245549843,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245531504,"realTimeFactor":0.07222054205882353,"finite":true,"samples":81600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.325,"runSeconds":0.253357155,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253338126,"realTimeFactor":0.07619764060150376,"finite":true,"samples":79800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":3.075,"runSeconds":0.23706637,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237047632,"realTimeFactor":0.07709475447154471,"finite":true,"samples":73800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.875,"runSeconds":0.224040907,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224015269,"realTimeFactor":0.077927272,"finite":true,"samples":69000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":3.025,"runSeconds":0.224340078,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224323599,"realTimeFactor":0.07416200925619836,"finite":true,"samples":72600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.325,"runSeconds":0.252032904,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252013715,"realTimeFactor":0.07579936962406014,"finite":true,"samples":79800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.5,"runSeconds":0.281199412,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.281177423,"realTimeFactor":0.08034268914285714,"finite":true,"samples":84000},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.95,"runSeconds":0.228279458,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228254579,"realTimeFactor":0.07738286711864406,"finite":true,"samples":70800},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.9,"runSeconds":0.223243325,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223225626,"realTimeFactor":0.07698045689655172,"finite":true,"samples":69600},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.15,"runSeconds":0.245307697,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245289449,"realTimeFactor":0.07787545936507936,"finite":true,"samples":75600},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.3,"runSeconds":0.247608806,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247590387,"realTimeFactor":0.07503297151515151,"finite":true,"samples":79200},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.925,"runSeconds":0.220341096,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220324257,"realTimeFactor":0.07533028923076923,"finite":true,"samples":70200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.7,"runSeconds":0.218167305,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218142136,"realTimeFactor":0.08080270555555555,"finite":true,"samples":64800},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.45,"runSeconds":0.260874322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.260845114,"realTimeFactor":0.07561574550724637,"finite":true,"samples":82800},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":3.15,"runSeconds":0.241513582,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241496113,"realTimeFactor":0.07667097841269842,"finite":true,"samples":75600},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.225,"runSeconds":0.27012926,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.270111121,"realTimeFactor":0.08376101085271317,"finite":true,"samples":77400},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":3.0,"runSeconds":0.21994322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219925201,"realTimeFactor":0.07331440666666666,"finite":true,"samples":72000},{"index":39,"text":"What joy there is in living.","audioSeconds":2.5,"runSeconds":0.190135108,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190120077,"realTimeFactor":0.0760540432,"finite":true,"samples":60000},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.15,"runSeconds":0.265329708,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265311338,"realTimeFactor":0.08423165333333334,"finite":true,"samples":75600},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.225,"runSeconds":0.245287043,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245259555,"realTimeFactor":0.07605799782945737,"finite":true,"samples":77400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":3.075,"runSeconds":0.234608266,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234590937,"realTimeFactor":0.07629537105691057,"finite":true,"samples":73800},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":3.125,"runSeconds":0.237535352,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237518493,"realTimeFactor":0.07601131264,"finite":true,"samples":75000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.125,"runSeconds":0.240060943,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240040285,"realTimeFactor":0.07681950176,"finite":true,"samples":75000},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.975,"runSeconds":0.229206614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229189655,"realTimeFactor":0.07704424,"finite":true,"samples":71400},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.275,"runSeconds":0.248789045,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248767976,"realTimeFactor":0.07596612061068703,"finite":true,"samples":78600},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.95,"runSeconds":0.224615261,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224597472,"realTimeFactor":0.07614076644067796,"finite":true,"samples":70800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":3.0,"runSeconds":0.281581269,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.281564,"realTimeFactor":0.09386042300000001,"finite":true,"samples":72000},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.975,"runSeconds":0.228145099,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22811992,"realTimeFactor":0.0766874282352941,"finite":true,"samples":71400},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.9,"runSeconds":0.223398017,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223357039,"realTimeFactor":0.07703379896551725,"finite":true,"samples":69600},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":3.175,"runSeconds":0.247784139,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2477656,"realTimeFactor":0.07804224850393701,"finite":true,"samples":76200},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":3.025,"runSeconds":0.226359961,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226339322,"realTimeFactor":0.07482973917355372,"finite":true,"samples":72600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":3.1,"runSeconds":0.251903642,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251884454,"realTimeFactor":0.0812592393548387,"finite":true,"samples":74400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.325,"runSeconds":0.253413498,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253390679,"realTimeFactor":0.07621458586466165,"finite":true,"samples":79800},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":3.05,"runSeconds":0.234214217,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234196528,"realTimeFactor":0.07679154655737705,"finite":true,"samples":73200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.2,"runSeconds":0.228339811,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228318593,"realTimeFactor":0.0713561909375,"finite":true,"samples":76800},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.925,"runSeconds":0.247005229,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246971391,"realTimeFactor":0.08444623213675213,"finite":true,"samples":70200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.15,"runSeconds":0.2540516,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.254032711,"realTimeFactor":0.08065130158730159,"finite":true,"samples":75600},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.275,"runSeconds":0.245419398,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245399969,"realTimeFactor":0.07493722076335878,"finite":true,"samples":78600},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":3.125,"runSeconds":0.241046227,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241027378,"realTimeFactor":0.07713479264,"finite":true,"samples":75000},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.25,"runSeconds":0.254379161,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.254361742,"realTimeFactor":0.07827051107692308,"finite":true,"samples":78000},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":3.1,"runSeconds":0.235933069,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23591365,"realTimeFactor":0.07610744161290323,"finite":true,"samples":74400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.25,"runSeconds":0.240231162,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240212793,"realTimeFactor":0.07391728061538462,"finite":true,"samples":78000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.95,"runSeconds":0.246972797,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246941599,"realTimeFactor":0.08371959220338983,"finite":true,"samples":70800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.525,"runSeconds":0.265256757,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265236119,"realTimeFactor":0.07525014382978724,"finite":true,"samples":84600},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.325,"runSeconds":0.247104235,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247083796,"realTimeFactor":0.07431706315789473,"finite":true,"samples":79800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.375,"runSeconds":0.259595349,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.25957526,"realTimeFactor":0.07691714044444443,"finite":true,"samples":81000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.25,"runSeconds":0.238165236,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238146127,"realTimeFactor":0.07328161107692308,"finite":true,"samples":78000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.235152566,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235133258,"realTimeFactor":0.07291552434108527,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.15,"runSeconds":0.266247379,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.266219561,"realTimeFactor":0.08452297746031746,"finite":true,"samples":75600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":3.0,"runSeconds":0.217138703,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217119364,"realTimeFactor":0.07237956766666666,"finite":true,"samples":72000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.25,"runSeconds":0.245902962,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245877193,"realTimeFactor":0.07566244984615385,"finite":true,"samples":78000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.225,"runSeconds":0.234742179,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234721721,"realTimeFactor":0.07278827255813954,"finite":true,"samples":77400},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":3.1,"runSeconds":0.247407047,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247386788,"realTimeFactor":0.07980872483870967,"finite":true,"samples":74400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.575,"runSeconds":0.206087002,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206063563,"realTimeFactor":0.08003378718446601,"finite":true,"samples":61800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":3.1,"runSeconds":0.237304912,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237285184,"realTimeFactor":0.07654997161290322,"finite":true,"samples":74400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.475,"runSeconds":0.258160608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.258140799,"realTimeFactor":0.07429082244604317,"finite":true,"samples":83400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.3,"runSeconds":0.245735251,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245715412,"realTimeFactor":0.07446522757575758,"finite":true,"samples":79200},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.25,"runSeconds":0.239184216,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239163647,"realTimeFactor":0.07359514338461538,"finite":true,"samples":78000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.2,"runSeconds":0.232084164,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232051766,"realTimeFactor":0.07252630125,"finite":true,"samples":76800},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":3.025,"runSeconds":0.225879554,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225859526,"realTimeFactor":0.07467092694214876,"finite":true,"samples":72600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.725,"runSeconds":0.209575209,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2095564,"realTimeFactor":0.07690833357798166,"finite":true,"samples":65400},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.3,"runSeconds":0.24770646,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247678431,"realTimeFactor":0.07506256363636364,"finite":true,"samples":79200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.925,"runSeconds":0.216185493,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216165194,"realTimeFactor":0.07390957025641026,"finite":true,"samples":70200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":3.075,"runSeconds":0.234106455,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234083387,"realTimeFactor":0.07613218048780487,"finite":true,"samples":73800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.875,"runSeconds":0.213162144,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213137046,"realTimeFactor":0.07414335443478261,"finite":true,"samples":69000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.725,"runSeconds":0.220321194,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220290945,"realTimeFactor":0.0808518143119266,"finite":true,"samples":65400},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.9,"runSeconds":0.219449318,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219424369,"realTimeFactor":0.07567217862068966,"finite":true,"samples":69600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":3.1,"runSeconds":0.239622477,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239600478,"realTimeFactor":0.07729757322580645,"finite":true,"samples":74400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.9,"runSeconds":0.236648504,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236627766,"realTimeFactor":0.08160293241379311,"finite":true,"samples":69600},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.9,"runSeconds":0.220739106,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220717727,"realTimeFactor":0.07611693310344828,"finite":true,"samples":69600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.125,"runSeconds":0.236086503,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236064314,"realTimeFactor":0.07554768096,"finite":true,"samples":75000},{"in