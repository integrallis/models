:true,"samples":76200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.125,"runSeconds":0.238420614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238395105,"realTimeFactor":0.07629459648,"finite":true,"samples":75000},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.425,"runSeconds":0.250246135,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250224077,"realTimeFactor":0.07306456496350365,"finite":true,"samples":82200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":3.025,"runSeconds":0.223105162,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223077023,"realTimeFactor":0.07375377256198347,"finite":true,"samples":72600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.975,"runSeconds":0.233114915,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233079307,"realTimeFactor":0.07835795462184873,"finite":true,"samples":71400},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":3.0,"runSeconds":0.217653067,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217631558,"realTimeFactor":0.07255102233333334,"finite":true,"samples":72000},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":3.1,"runSeconds":0.233664153,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233643264,"realTimeFactor":0.07537553322580645,"finite":true,"samples":74400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.25,"runSeconds":0.238956845,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238934866,"realTimeFactor":0.07352518307692307,"finite":true,"samples":78000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":3.175,"runSeconds":0.24607326,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246050741,"realTimeFactor":0.07750338897637796,"finite":true,"samples":76200},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":3.05,"runSeconds":0.224122802,"g2pSeconds":0.0,"timeToFirstAudio