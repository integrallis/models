nds":0.0,"timeToFirstAudioSeconds":0.245395039,"realTimeFactor":0.0743706996969697,"finite":true,"samples":79200},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.8,"runSeconds":0.195494281,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195474621,"realTimeFactor":0.06981938607142857,"finite":true,"samples":67200},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":3.15,"runSeconds":0.246498417,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246463737,"realTimeFactor":0.07825346571428572,"finite":true,"samples":75600},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":3.175,"runSeconds":0.24665841,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24663704,"realTimeFactor":0.07768768818897638,"finite":true,"samples":76200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":3.0,"runSeconds":0.219650555,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219613475,"realTimeFactor":0.07321685166666667,"finite":true,"samples":72000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.525,"runSeconds":0.262934513,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.262911713,"realTimeFactor":0.07459135120567376,"finite":true,"samples":84600},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":3.2,"runSeconds":0.227097121,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227068751,"realTimeFactor":0.0709678503125,"finite":true,"samples":76800},{"index":161,"text":"At that high level the air is pure.","audioSeconds":3.025,"runSeconds":0.222436067,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222413537,"realTimeFactor":0.0735325841322314,"finite":true,"samples":72600},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.9,"runSeconds":0.220246481,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220221521,"realTimeFactor":0.0759470624137931,"finite":true,"samples":69600},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":3.25,"runSeconds":0.232906136,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232884936,"realTimeFactor":0.07166342646153846,"finite":true,"samples":78000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.15,"runSeconds":0.243529308,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243502688,"realTimeFactor":0.07731089142857143,"finite":true,"samples":75600},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.4,"runSeconds":0.242115548,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242089907,"realTimeFactor":0.07121045529411765,"finite":true,"samples":81600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.35,"runSeconds":0.24889949,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248861359,"realTimeFactor":0.07429835522388059,"finite":true,"samples":80400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.175,"runSeconds":0.247854272,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247831842,"realTimeFactor":0.07806433763779527,"finite":true,"samples":76200},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":3.025,"runSeconds":0.224550684,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224518784,"realTimeFactor":0.07423163107438016,"finite":true,"samples":72600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.2,"runSeconds":0.223291825,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223267495,"realTimeFactor":0.0697786953125,"finite":true,"samples":76800},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.925,"runSeconds":0.230748733,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230712052,"realTimeFactor":0.07888845572649573,"finite":true,"samples":70200},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.175,"runSeconds":0.246975716,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246955296,"realTimeFactor":0.07778762708661419,"finite":true,"samples":76200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.125,"runSeconds":0.241703166,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241675756,"realTimeFactor":0.07734501312,"finite":true,"samples":75000},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.425,"runSeconds":0.251847234,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251824774,"realTimeFactor":0.0735320391240876,"finite":true,"samples":82200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":3.025,"runSeconds":0.227168736,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227131656,"realTimeFactor":0.07509710280991735,"finite":true,"samples":72600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.975,"runSeconds":0.232702209,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232674449,"realTimeFactor":0.07821922991596639,"finite":true,"samples":71400},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":3.0,"runSeconds":0.218954945,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218927915,"realTimeFactor":0.07298498166666667,"finite":true,"samples":72000},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":3.1,"runSeconds":0.232863761,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23284384,"realTimeFactor":0.07511734225806452,"finite":true,"samples":74400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.25,"runSeconds":0.241638288,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241606498,"realTimeFactor":0.07435024246153846,"finite":true,"samples":78000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":3.175,"runSeconds":0.244272118,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244246228,"realTimeFactor":0.07693610015748033,"finite":true,"samples":76200},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":3.05,"runSeconds":0.226721805,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226695855,"realTimeFactor":0.07433501803278689,"finite":true,"samples":73200},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.925,"runSeconds":0.216296155,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216273664,"realTimeFactor":0.07394740341880342,"finite":true,"samples":70200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.275,"runSeconds":0.241113154,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241086524,"realTimeFactor":0.07362233709923664,"finite":true,"samples":78600},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.55,"runSeconds":0.266855041,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.266829781,"realTimeFactor":0.07517043408450705,"finite":true,"samples":85200},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.975,"runSeconds":0.229423577,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229391397,"realTimeFactor":0.0771171687394958,"finite":true,"samples":71400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.95,"runSeconds":0.224836551,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224814901,"realTimeFactor":0.07621578,"finite":true,"samples":70800},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.875,"runSeconds":0.219456082,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21942949,"realTimeFactor":0.07633255026086956,"finite":true,"samples":69000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.95,"runSeconds":0.222091002,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222067031,"realTimeFactor":0.07528508542372882,"finite":true,"samples":70800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.425,"runSeconds":0.259212305,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.259183855,"realTimeFactor":0.07568242481751825,"finite":true,"samples":82200},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.25,"runSeconds":0.239524744,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239491024,"realTimeFactor":0.07369992123076924,"finite":true,"samples":78000},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":3.175,"runSeconds":0.252276863,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252245932,"realTimeFactor":0.07945727968503938,"finite":true,"samples":76200},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":3.375,"runSeconds":0.257272521,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.257248701,"realTimeFactor":0.0762288951111111,"finite":true,"samples":81000},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.7,"runSeconds":0.212426438,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212400608,"realTimeFactor":0.07867645851851851,"finite":true,"samples":64800},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":3.15,"runSeconds":0.239278084,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239252404,"realTimeFactor":0.07596129650793651,"finite":true,"samples":75600},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":3.05,"runSeconds":0.233010206,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232984156,"realTimeFactor":0.07639678885245901,"finite":true,"samples":73200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":3.05,"runSeconds":0.223380743,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223359243,"realTimeFactor":0.07323958786885246,"finite":true,"samples":73200},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":3.2,"runSeconds":0.229960024,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229930784,"realTimeFactor":0.0718625075,"finite":true,"samples":76800},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":3.3,"runSeconds":0.246014146,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245991866,"realTimeFactor":0.07454974121212121,"finite":true,"samples":79200},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.8,"runSeconds":0.197643438,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197618018,"realTimeFactor":0.07058694214285714,"finite":true,"samples":67200},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":3.175,"runSeconds":0.241681244,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241659624,"realTimeFactor":0.07612007685039371,"finite":true,"samples":76200}]}