FirstAudioSeconds":0.223877047,"realTimeFactor":0.07401591966942149,"finite":true,"samples":72600},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.85,"runSeconds":0.221358918,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221332348,"realTimeFactor":0.07766979578947368,"finite":true,"samples":68400},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":3.0,"runSeconds":0.218349444,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218329284,"realTimeFactor":0.072783148,"finite":true,"samples":72000},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":3.25,"runSeconds":0.240910116,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240883116,"realTimeFactor":0.07412618953846153,"finite":true,"samples":78000},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":3.2,"runSeconds":0.225630762,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225607262,"realTimeFactor":0.070509613125,"finite":true,"samples":76800},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":3.325,"runSeconds":0.245788963,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245749073,"realTimeFactor":0.07392149263157895,"finite":true,"samples":79800},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":3.2,"runSeconds":0.222399717,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222376167,"realTimeFactor":0.06949991156249999,"finite":true,"samples":76800},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":3.2,"runSeconds":0.227493515,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227465785,"realTimeFactor":0.0710917234375,"finite":true,"samples":76800},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":3.025,"runSeconds":0.225521722,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225490632,"realTimeFactor":0.07455263537190084,"finite":true,"samples":72600},{"index":128,"text":"Feel the heat of the weak dying flame.","audioSeconds