{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.11 {onnxOperators=56, onnxOpset=17, onnxNodes=2535, onnxDynamicNodes=1311, phonemizer=misaki-java fba1236, no fallback, graph=onnx_paradee_int8.onnx, voices=af_heart,bf_isabella,am_puck,bm_fable, backend=pure-java} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bm_fable","voiceIndex":3,"corpus":"harvard-200","pass":2,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 6.8.0-138-generic amd64 8 cpus","sentences":200,"totalAudioSeconds":624.8499999999993,"totalRunSeconds":47.13221869699998,"realTimeMultiple":13.257385654110355,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.375,"runSeconds":0.401733375,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.401552344,"realTimeFactor":0.11903211111111112,"finite":true,"samples":81000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.15,"runSeconds":0.341935254,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.341916484,"realTimeFactor":0.10855087428571429,"finite":true,"samples":75600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":3.0,"runSeconds":0.237133801,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237114041,"realTimeFactor":0.07904460033333334,"finite":true,"samples":72000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.4,"runSeconds":0.281445348,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.281423247,"realTimeFactor":0.08277804352941176,"finite":true,"samples":81600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.3,"runSeconds":0.252458934,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252424884,"realTimeFactor":0.07650270727272729,"finite":true,"samples":79200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":3.1,"runSeconds":0.237062782,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237047102,"realTimeFactor":0.07647186516129031,"finite":true,"samples":74400},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.3,"runSeconds":0.269048757,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.269031537,"realTimeFactor":0.08152992636363637,"finite":true,"samples":79200},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.275,"runSeconds":0.251113035,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251087125,"realTimeFactor":0.0766757358778626,"finite":true,"samples":78600},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":3.0,"runSeconds":0.218317363,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218298423,"realTimeFactor":0.07277245433333333,"finite":true,"samples":72000},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.675,"runSeconds":0.272721066,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.272699676,"realTimeFactor":0.07420981387755103,"finite":true,"samples":88200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.825,"runSeconds":0.207854497,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207837237,"realTimeFactor":0.07357681309734512,"finite":true,"samples":67800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.175,"runSeconds":0.246077899,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246052539,"realTimeFactor":0.07750485007874015,"finite":true,"samples":76200},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.475,"runSeconds":0.265514614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265495444,"realTimeFactor":0.07640708316546761,"finite":true,"samples":83400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":3.1,"runSeconds":0.236190347,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236171587,"realTimeFactor":0.07619043451612903,"finite":true,"samples":74400},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.925,"runSeconds":0.223405382,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223381862,"realTimeFactor":0.07637790837606838,"finite":true,"samples":70200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.1,"runSeconds":0.237707109,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237689369,"realTimeFactor":0.07667971258064515,"finite":true,"samples":74400},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":3.1,"runSeconds":0.235382363,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235360853,"realTimeFactor":0.07592979451612904,"finite":true,"samples":74400},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":3.15,"runSeconds":0.241194615,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241175915,"realTimeFactor":0.07656971904761906,"finite":true,"samples":75600},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.975,"runSeconds":0.23240716,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2323863,"realTimeFactor":0.0781200537815126,"finite":true,"samples":71400},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.225,"runSeconds":0.233614739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233588099,"realTimeFactor":0.07243867875968991,"finite":true,"samples":77400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":3.0,"runSeconds":0.220490543,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220468573,"realTimeFactor":0.07349684766666667,"finite":true,"samples":72000},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.45,"runSeconds":0.254874519,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.254848539,"realTimeFactor":0.07387667217391304,"finite":true,"samples":82800},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.4,"runSeconds":0.250249944,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250222374,"realTimeFactor":0.07360292470588235,"finite":true,"samples":81600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.325,"runSeconds":0.248848343,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248822323,"realTimeFactor":0.07484160691729323,"finite":true,"samples":79800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":3.075,"runSeconds":0.238971191,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238950621,"realTimeFactor":0.07771420845528455,"finite":true,"samples":73800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.875,"runSeconds":0.21583683,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21581391,"realTimeFactor":0.07507368,"finite":true,"samples":69000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":3.025,"runSeconds":0.228911507,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228883997,"realTimeFactor":0.07567322545454545,"finite":true,"samples":72600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.325,"runSeconds":0.248230111,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248211281,"realTimeFactor":0.074655672481203,"finite":true,"samples":79800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.5,"runSeconds":0.269338759,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.269307588,"realTimeFactor":0.07695393114285713,"finite":true,"samples":84000},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.95,"runSeconds":0.223444988,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223426218,"realTimeFactor":0.07574406372881357,"finite":true,"samples":70800},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.9,"runSeconds":0.22239889,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22236959,"realTimeFactor":0.0766892724137931,"finite":true,"samples":69600},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.15,"runSeconds":0.244184242,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244165942,"realTimeFactor":0.07751880698412698,"finite":true,"samples":75600},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.3,"runSeconds":0.249026459,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249003099,"realTimeFactor":0.07546256333333334,"finite":true,"samples":79200},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.925,"runSeconds":0.219816723,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219793133,"realTimeFactor":0.07515101641025641,"finite":true,"samples":70200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.7,"runSeconds":0.210215571,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21019416,"realTimeFactor":0.07785761888888888,"finite":true,"samples":64800},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.45,"runSeconds":0.25862662,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.258599769,"realTimeFactor":0.07496423768115941,"finite":true,"samples":82800},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":3.15,"runSeconds":0.242899103,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242872353,"realTimeFactor":0.07711082634920635,"finite":true,"samples":75600},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.225,"runSeconds":0.231600851,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231581841,"realTimeFactor":0.07181421736434108,"finite":true,"samples":77400},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":3.0,"runSeconds":0.220880172,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220857732,"realTimeFactor":0.073626724,"finite":true,"samples":72000},{"index":39,"text":"What joy there is in living.","audioSeconds":2.5,"runSeconds":0.189394637,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189378077,"realTimeFactor":0.0757578548,"finite":true,"samples":60000},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.15,"runSeconds":0.244265975,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244244065,"realTimeFactor":0.07754475396825397,"finite":true,"samples":75600},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.225,"runSeconds":0.236601879,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236582139,"realTimeFactor":0.07336492372093023,"finite":true,"samples":77400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":3.075,"runSeconds":0.234447074,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234423894,"realTimeFactor":0.07624295089430894,"finite":true,"samples":73800},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":3.125,"runSeconds":0.23526879,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235250679,"realTimeFactor":0.0752860128,"finite":true,"samples":75000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.125,"runSeconds":0.2392845,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23926337,"realTimeFactor":0.07657104,"finite":true,"samples":75000},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.975,"runSeconds":0.227706814,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227687134,"realTimeFactor":0.07654010554621848,"finite":true,"samples":71400},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.275,"runSeconds":0.247810334,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247788064,"realTimeFactor":0.0756672775572519,"finite":true,"samples":78600},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.95,"runSeconds":0.220817873,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220800673,"realTimeFactor":0.07485351627118643,"finite":true,"samples":70800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":3.0,"runSeconds":0.219359982,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219330992,"realTimeFactor":0.07311999400000001,"finite":true,"samples":72000},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.975,"runSeconds":0.22442884,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22440535,"realTimeFactor":0.07543826554621848,"finite":true,"samples":71400},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.9,"runSeconds":0.220392911,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220368981,"realTimeFactor":0.07599755551724138,"finite":true,"samples":69600},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":3.175,"runSeconds":0.24450617,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24448767,"realTimeFactor":0.07700981732283464,"finite":true,"samples":76200},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":3.025,"runSeconds":0.226861019,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226838579,"realTimeFactor":0.07499537818181819,"finite":true,"samples":72600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":3.1,"runSeconds":0.238426787,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238398677,"realTimeFactor":0.07691186677419355,"finite":true,"samples":74400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.325,"runSeconds":0.25213246,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.25210259,"realTimeFactor":0.07582931127819549,"finite":true,"samples":79800},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":3.05,"runSeconds":0.230976221,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230956211,"realTimeFactor":0.07572990852459018,"finite":true,"samples":73200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.2,"runSeconds":0.229268968,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229245568,"realTimeFactor":0.07164655249999999,"finite":true,"samples":76800},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.925,"runSeconds":0.218206617,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218184177,"realTimeFactor":0.07460055282051282,"finite":true,"samples":70200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.15,"runSeconds":0.246988471,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246966031,"realTimeFactor":0.07840903841269842,"finite":true,"samples":75600},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.275,"runSeconds":0.244156711,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244129201,"realTimeFactor":0.07455166748091603,"finite":true,"samples":78600},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":3.125,"runSeconds":0.243290425,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243269475,"realTimeFactor":0.077852936,"finite":true,"samples":75000},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.25,"runSeconds":0.241410891,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241391101,"realTimeFactor":0.07428027415384615,"finite":true,"samples":78000},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":3.1,"runSeconds":0.240812276,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240788956,"realTimeFactor":0.07768137935483871,"finite":true,"samples":74400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.25,"runSeconds":0.241606342,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241581412,"realTimeFactor":0.07434041292307693,"finite":true,"samples":78000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.95,"runSeconds":0.227072155,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227044525,"realTimeFactor":0.07697361186440678,"finite":true,"samples":70800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.525,"runSeconds":0.265563431,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265542441,"realTimeFactor":0.0753371435460993,"finite":true,"samples":84600},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.325,"runSeconds":0.252693897,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252666227,"realTimeFactor":0.0759981645112782,"finite":true,"samples":79800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.375,"runSeconds":0.25566249,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.25563832,"realTimeFactor":0.07575184888888889,"finite":true,"samples":81000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.25,"runSeconds":0.241299643,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241278033,"realTimeFactor":0.074246044,"finite":true,"samples":78000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.23564225,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23562243,"realTimeFactor":0.07306736434108527,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.15,"runSeconds":0.247497828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247475318,"realTimeFactor":0.07857073904761905,"finite":true,"samples":75600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":3.0,"runSeconds":0.215575651,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215556741,"realTimeFactor":0.07185855033333334,"finite":true,"samples":72000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.25,"runSeconds":0.240430527,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240409347,"realTimeFactor":0.07397862369230769,"finite":true,"samples":78000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.225,"runSeconds":0.232424558,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232405208,"realTimeFactor":0.0720696303875969,"finite":true,"samples":77400},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":3.1,"runSeconds":0.236172076,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236149415,"realTimeFactor":0.0761845406451613,"finite":true,"samples":74400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.575,"runSeconds":0.20190492,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20188527,"realTimeFactor":0.07840967766990291,"finite":true,"samples":61800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":3.1,"runSeconds":0.238543245,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238522015,"realTimeFactor":0.07694943387096774,"finite":true,"samples":74400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.475,"runSeconds":0.256313768,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.256293767,"realTimeFactor":0.07375935769784173,"finite":true,"samples":83400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.3,"runSeconds":0.247018878,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246987097,"realTimeFactor":0.07485420545454546,"finite":true,"samples":79200},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.25,"runSeconds":0.240729532,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240710951,"realTimeFactor":0.07407062523076922,"finite":true,"samples":78000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.2,"runSeconds":0.225166495,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225143505,"realTimeFactor":0.0703645296875,"finite":true,"samples":76800},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":3.025,"runSeconds":0.223936156,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223916226,"realTimeFactor":0.07402848132231406,"finite":true,"samples":72600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.725,"runSeconds":0.211955517,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211931866,"realTimeFactor":0.07778184110091743,"finite":true,"samples":65400},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.3,"runSeconds":0.244146189,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244125038,"realTimeFactor":0.07398369363636365,"finite":true,"samples":79200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.925,"runSeconds":0.218832739,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218805109,"realTimeFactor":0.07481461162393163,"finite":true,"samples":70200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":3.075,"runSeconds":0.230265406,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230242446,"realTimeFactor":0.07488305886178862,"finite":true,"samples":73800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.875,"runSeconds":0.213410689,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213381399,"realTimeFactor":0.07422980486956521,"finite":true,"samples":69000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.725,"runSeconds":0.209288608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209269888,"realTimeFactor":0.07680315889908255,"finite":true,"samples":65400},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.9,"runSeconds":0.217134018,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217107578,"realTimeFactor":0.07487379931034484,"finite":true,"samples":69600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":3.1,"runSeconds":0.234863981,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234843761,"realTimeFactor":0.07576257451612903,"finite":true,"samples":74400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.9,"runSeconds":0.220444234,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220413164,"realTimeFactor":0.07601525310344827,"finite":true,"samples":69600},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.9,"runSeconds":0.218246796,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218221426,"realTimeFactor":0.07525751586206897,"finite":true,"samples":69600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.125,"runSeconds":0.23868974,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23866281,"realTimeFactor":0.0763807168,"finite":true,"samples":75000},{"index":9