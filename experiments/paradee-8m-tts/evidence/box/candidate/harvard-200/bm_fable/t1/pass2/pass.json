,{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.9,"runSeconds":0.220636287,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220608717,"realTimeFactor":0.07608147827586206,"finite":true,"samples":69600},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.225,"runSeconds":0.234537612,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234517511,"realTimeFactor":0.07272484093023256,"finite":true,"samples":77400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":3.075,"runSeconds":0.236221165,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236186904,"realTimeFactor":0.07681989105691057,"finite":true,"samples":73800},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.225,"runSeconds":0.23156483,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23154449,"realTimeFactor":0.0718030480620155,"finite":true,"samples":77400},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.325,"runSeconds":0.246987917,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246960157,"realTimeFactor":0.07428208030075188,"finite":true,"samples":79800},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.221243244,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221222714,"realTimeFactor":0.07313826247933884,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.85,"runSeconds":0.210783735,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210758425,"realTimeFactor":0.0739592052631579,"finite":true,"samples":68400},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":3.0,"runSeconds":0.212743668,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212723148,"realTimeFactor":0.070914556,"finite":true,"samples":72000},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.5,"runSeconds":0.261738249,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.261702939,"realTimeFac