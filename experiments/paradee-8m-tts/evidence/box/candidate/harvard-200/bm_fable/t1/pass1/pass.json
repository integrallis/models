{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.11 {voices=af_heart,bf_isabella,am_puck,bm_fable, backend=pure-java, onnxOperators=56, onnxOpset=17, onnxNodes=2535, onnxDynamicNodes=1311, phonemizer=misaki-java fba1236, no fallback, graph=onnx_paradee_int8.onnx} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"bm_fable","voiceIndex":3,"corpus":"harvard-200","pass":1,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 6.8.0-138-generic amd64 8 cpus","sentences":200,"totalAudioSeconds":624.8499999999993,"totalRunSeconds":47.86348323800001,"realTimeMultiple":13.054837586578225,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":3.375,"runSeconds":0.412001939,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.411820119,"realTimeFactor":0.1220746485925926,"finite":true,"samples":81000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":3.15,"runSeconds":0.333812094,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.333791754,"realTimeFactor":0.10597209333333334,"finite":true,"samples":75600},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":3.0,"runSeconds":0.261509547,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.261488437,"realTimeFactor":0.08716984900000001,"finite":true,"samples":72000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":3.4,"runSeconds":0.250837794,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250819904,"realTimeFactor":0.07377582176470589,"finite":true,"samples":81600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":3.3,"runSeconds":0.250185118,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250153418,"realTimeFactor":0.07581367212121212,"finite":true,"samples":79200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":3.1,"runSeconds":0.243783775,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243765965,"realTimeFactor":0.07863992741935484,"finite":true,"samples":74400},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":3.3,"runSeconds":0.248065787,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248045747,"realTimeFactor":0.07517145060606062,"finite":true,"samples":79200},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":3.275,"runSeconds":0.247326317,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247307967,"realTimeFactor":0.07551948610687023,"finite":true,"samples":78600},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":3.0,"runSeconds":0.249178632,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249151202,"realTimeFactor":0.083059544,"finite":true,"samples":72000},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.675,"runSeconds":0.2709049,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.27088277,"realTimeFactor":0.07371561904761906,"finite":true,"samples":88200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.825,"runSeconds":0.209858706,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209841166,"realTimeFactor":0.07428626761061946,"finite":true,"samples":67800},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":3.175,"runSeconds":0.243108339,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243090079,"realTimeFactor":0.07656955559055119,"finite":true,"samples":76200},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.475,"runSeconds":0.260398082,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.260379902,"realTimeFactor":0.0749346998561151,"finite":true,"samples":83400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":3.1,"runSeconds":0.246312095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246294945,"realTimeFactor":0.07945551451612903,"finite":true,"samples":74400},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.925,"runSeconds":0.218460274,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218443474,"realTimeFactor":0.07468727316239317,"finite":true,"samples":70200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":3.1,"runSeconds":0.241428124,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241408094,"realTimeFactor":0.07788004,"finite":true,"samples":74400},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":3.1,"runSeconds":0.236373857,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236349877,"realTimeFactor":0.07624963129032257,"finite":true,"samples":74400},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":3.15,"runSeconds":0.24554094,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24552074,"realTimeFactor":0.07794950476190476,"finite":true,"samples":75600},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.975,"runSeconds":0.233947434,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233926504,"realTimeFactor":0.07863779294117647,"finite":true,"samples":71400},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":3.225,"runSeconds":0.238265268,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238244448,"realTimeFactor":0.07388070325581395,"finite":true,"samples":77400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":3.0,"runSeconds":0.221048743,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221028173,"realTimeFactor":0.07368291433333334,"finite":true,"samples":72000},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":3.45,"runSeconds":0.25761632,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.25759509,"realTimeFactor":0.07467139710144928,"finite":true,"samples":82800},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.4,"runSeconds":0.247049675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247027355,"realTimeFactor":0.07266166911764706,"finite":true,"samples":81600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":3.325,"runSeconds":0.251184217,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251161417,"realTimeFactor":0.07554412541353382,"finite":true,"samples":79800},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":3.075,"runSeconds":0.239883626,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239864056,"realTimeFactor":0.07801093528455284,"finite":true,"samples":73800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.875,"runSeconds":0.218139256,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218120186,"realTimeFactor":0.07587452382608696,"finite":true,"samples":69000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":3.025,"runSeconds":0.22622821,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22620667,"realTimeFactor":0.07478618512396695,"finite":true,"samples":72600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":3.325,"runSeconds":0.249394861,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249374521,"realTimeFactor":0.0750059732330827,"finite":true,"samples":79800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.5,"runSeconds":0.265974932,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265952862,"realTimeFactor":0.07599283771428571,"finite":true,"samples":84000},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.95,"runSeconds":0.222691052,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222671592,"realTimeFactor":0.07548849220338982,"finite":true,"samples":70800},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.9,"runSeconds":0.220689491,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220669631,"realTimeFactor":0.07609982448275862,"finite":true,"samples":69600},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":3.15,"runSeconds":0.244289463,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244269013,"realTimeFactor":0.07755221047619049,"finite":true,"samples":75600},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":3.3,"runSeconds":0.247605607,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247584717,"realTimeFactor":0.07503200212121212,"finite":true,"samples":79200},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.925,"runSeconds":0.220709386,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220688636,"realTimeFactor":0.07545620034188034,"finite":true,"samples":70200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.7,"runSeconds":0.206914788,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206898378,"realTimeFactor":0.07663510666666666,"finite":true,"samples":64800},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":3.45,"runSeconds":0.259681106,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.259658916,"realTimeFactor":0.07526988579710145,"finite":true,"samples":82800},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":3.15,"runSeconds":0.242362208,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242340978,"realTimeFactor":0.07694038349206349,"finite":true,"samples":75600},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":3.225,"runSeconds":0.234050306,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234029646,"realTimeFactor":0.07257373829457364,"finite":true,"samples":77400},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":3.0,"runSeconds":0.220062029,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220041609,"realTimeFactor":0.07335400966666666,"finite":true,"samples":72000},{"index":39,"text":"What joy there is in living.","audioSeconds":2.5,"runSeconds":0.189338483,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189323663,"realTimeFactor":0.0757353932,"finite":true,"samples":60000},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":3.15,"runSeconds":0.243998661,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243978671,"realTimeFactor":0.07745989238095238,"finite":true,"samples":75600},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":3.225,"runSeconds":0.240738614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240717904,"realTimeFactor":0.074647632248062,"finite":true,"samples":77400},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":3.075,"runSeconds":0.235054792,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235035602,"realTimeFactor":0.07644058276422765,"finite":true,"samples":73800},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":3.125,"runSeconds":0.238403685,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238383255,"realTimeFactor":0.0762891792,"finite":true,"samples":75000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":3.125,"runSeconds":0.239078645,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239058125,"realTimeFactor":0.0765051664,"finite":true,"samples":75000},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.975,"runSeconds":0.229553062,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229533462,"realTimeFactor":0.0771606931092437,"finite":true,"samples":71400},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":3.275,"runSeconds":0.246990383,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246969683,"realTimeFactor":0.07541691083969466,"finite":true,"samples":78600},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.95,"runSeconds":0.223320009,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223298739,"realTimeFactor":0.0757016979661017,"finite":true,"samples":70800},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":3.0,"runSeconds":0.218221666,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218200396,"realTimeFactor":0.07274055533333333,"finite":true,"samples":72000},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.975,"runSeconds":0.224867581,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224845401,"realTimeFactor":0.07558574151260504,"finite":true,"samples":71400},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.9,"runSeconds":0.220774812,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220752722,"realTimeFactor":0.07612924551724137,"finite":true,"samples":69600},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":3.175,"runSeconds":0.247536329,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247514859,"realTimeFactor":0.07796419811023622,"finite":true,"samples":76200},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":3.025,"runSeconds":0.226935027,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226914206,"realTimeFactor":0.07501984363636365,"finite":true,"samples":72600},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":3.1,"runSeconds":0.237770362,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237750192,"realTimeFactor":0.07670011677419356,"finite":true,"samples":74400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":3.325,"runSeconds":0.258322939,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.258301789,"realTimeFactor":0.0776911094736842,"finite":true,"samples":79800},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":3.05,"runSeconds":0.230209301,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230189631,"realTimeFactor":0.0754784593442623,"finite":true,"samples":73200},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":3.2,"runSeconds":0.227184451,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227160881,"realTimeFactor":0.07099514093749999,"finite":true,"samples":76800},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.925,"runSeconds":0.221569166,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221549046,"realTimeFactor":0.07575014222222223,"finite":true,"samples":70200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":3.15,"runSeconds":0.247194696,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247174096,"realTimeFactor":0.07847450666666667,"finite":true,"samples":75600},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":3.275,"runSeconds":0.246726137,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246705737,"realTimeFactor":0.07533622503816795,"finite":true,"samples":78600},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":3.125,"runSeconds":0.241325944,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241305744,"realTimeFactor":0.07722430208,"finite":true,"samples":75000},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":3.25,"runSeconds":0.241480143,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241459313,"realTimeFactor":0.07430158246153847,"finite":true,"samples":78000},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":3.1,"runSeconds":0.239063824,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239043844,"realTimeFactor":0.07711736258064517,"finite":true,"samples":74400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":3.25,"runSeconds":0.24349719,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24347555,"realTimeFactor":0.0749222123076923,"finite":true,"samples":78000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.95,"runSeconds":0.225050868,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225027778,"realTimeFactor":0.07628842983050847,"finite":true,"samples":70800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":3.525,"runSeconds":0.266772785,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.266749715,"realTimeFactor":0.07568022269503547,"finite":true,"samples":84600},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":3.325,"runSeconds":0.251393437,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251372287,"realTimeFactor":0.0756070487218045,"finite":true,"samples":79800},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":3.375,"runSeconds":0.286115603,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.286094643,"realTimeFactor":0.08477499348148149,"finite":true,"samples":81000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":3.25,"runSeconds":0.246317976,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246294836,"realTimeFactor":0.07579014646153846,"finite":true,"samples":78000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.225,"runSeconds":0.249832758,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249806848,"realTimeFactor":0.07746752186046511,"finite":true,"samples":77400},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":3.15,"runSeconds":0.254458245,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.254437975,"realTimeFactor":0.08078039523809524,"finite":true,"samples":75600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":3.0,"runSeconds":0.227728399,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227707839,"realTimeFactor":0.07590946633333333,"finite":true,"samples":72000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":3.25,"runSeconds":0.252882105,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252860645,"realTimeFactor":0.07780987846153847,"finite":true,"samples":78000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":3.225,"runSeconds":0.244915349,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244893559,"realTimeFactor":0.07594274387596898,"finite":true,"samples":77400},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":3.1,"runSeconds":0.253746849,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253724939,"realTimeFactor":0.08185382225806451,"finite":true,"samples":74400},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.575,"runSeconds":0.207435348,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207420238,"realTimeFactor":0.08055741669902912,"finite":true,"samples":61800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":3.1,"runSeconds":0.246259785,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.246239405,"realTimeFactor":0.07943864032258065,"finite":true,"samples":74400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.475,"runSeconds":0.274706785,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.274684825,"realTimeFactor":0.07905231223021583,"finite":true,"samples":83400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":3.3,"runSeconds":0.26259421,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.26257342,"realTimeFactor":0.07957400303030303,"finite":true,"samples":79200},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":3.25,"runSeconds":0.249596342,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249572812,"realTimeFactor":0.07679887446153846,"finite":true,"samples":78000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":3.2,"runSeconds":0.237573724,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237548384,"realTimeFactor":0.07424178875,"finite":true,"samples":76800},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":3.025,"runSeconds":0.235551763,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.235528133,"realTimeFactor":0.07786835140495868,"finite":true,"samples":72600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.725,"runSeconds":0.216871831,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216854051,"realTimeFactor":0.07958599302752292,"finite":true,"samples":65400},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":3.3,"runSeconds":0.256900012,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.256873572,"realTimeFactor":0.07784848848484849,"finite":true,"samples":79200},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.925,"runSeconds":0.22627386,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22624741,"realTimeFactor":0.07735858461538461,"finite":true,"samples":70200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":3.075,"runSeconds":0.238152188,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238126998,"realTimeFactor":0.07744786601626015,"finite":true,"samples":73800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.875,"runSeconds":0.227721651,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227696141,"realTimeFactor":0.0792075307826087,"finite":true,"samples":69000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.725,"runSeconds":0.212740552,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212722092,"realTimeFactor":0.07806992733944954,"finite":true,"samples":65400},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.9,"runSeconds":0.22190286,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2218775,"realTimeFactor":0.0765182275862069,"finite":true,"samples":69600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":3.1,"runSeconds":0.241793106,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241767386,"realTimeFactor":0.07799777612903226,"finite":true,"samples":74400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.9,"runSeconds":0.224057492,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224031532,"realTimeFactor":0.07726120413793104,"finite":true,"samples":69600},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.9,"runSeconds":0.221850254,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221825024,"realTimeFactor":0.0765000875862069,"finite":true,"samples":69600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":3.125,"runSeconds":0.24208095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24205462,"realTimeFactor":0.077465904,"finite":true,"samples":75000},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":3.45,"runSeconds":0.262564056,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.262536506,"realTimeFactor":0.07610552347826087,"finite":true,"samples":82800},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":3.125,"runSeconds":0.241838021,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241811851,"realTimeFactor":0.07738816672,"finite":true,"samples":75000},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":3.125,"runSeconds":0.239498182,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239473662,"realTimeFactor":0.07663941824,"finite":true,"samples":75000},{"index":96,"text":"The term ended in late June that year.","audioSeconds":3.3,"runSeconds":0.250086461,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250059571,"realTimeFactor":0.07578377606060606,"finite":true,"samples":79200},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":3.3,"runSeconds":0.24976369,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2497375,"realTimeFactor":0.07568596666666667,"finite":true,"samples":79200},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.7,"runSeconds":0.206272526,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206254776,"realTimeFactor":0.07639723185185185,"finite":true,"samples":64800},{"index":99,"text":"The bill was paid every third week.","audioSeconds":3.1,"runSeconds":0.234965632,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234939762,"realTimeFactor":0.07579536516129032,"finite":true,"samples":74400},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":3.2,"runSeconds":0.225012976,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224984706,"realTimeFactor":0.070316555,"finite":true,"samples":76800},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":3.0,"runSeconds":0.21939918,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21937349,"realTimeFactor":0.07313306,"finite":true,"samples":72000},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.9,"runSeconds":0.220495242,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220454372,"realTimeFactor":0.07603284206896552,"finite":true,"samples":69600},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":3.225,"runSeconds":0.237413596,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.237386806,"realTimeFactor":0.07361661891472868,"finite":true,"samples":77400},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":3.075,"runSeconds":0.236739349,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236713499,"realTimeFactor":0.07698840617886178,"finite":true,"samples":73800},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":3.225,"runSeconds":0.234789327,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234762507,"realTimeFactor":0.07280289209302325,"finite":true,"samples":77400},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":3.325,"runSeconds":0.250233181,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250198971,"realTimeFactor":0.07525809954887218,"finite":true,"samples":79800},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":3.025,"runSeconds":0.2265501,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22652371,"realTimeFactor":0.07489259504132231,"finite":true,"samples":72600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.85,"runSeconds":0.213453433,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213428933,"realTimeFactor":0.07489594140350878,"finite":true,"samples":68400},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":3.0,"runSeconds":0.216920107,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216893157,"realTimeFactor":0.07230670233333333,"finite":true,"samples":72000},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.5,"runSeconds":0.264289828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.264262208,"realTimeFactor":0.07551137942857143,"finite":true,"samples":84000},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":3.275,"runSeconds":0.246023062,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245996282,"realTimeFactor":0.07512154564885495,"finite":true,"samples":78600},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.95,"runSeconds":0.227282919,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227256359,"realTimeFactor":0.07704505728813558,"finite":true,"samples":70800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":3.2,"runSeconds":0.226728169,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226700099,"realTimeFactor":0.0708525528125,"finite":true,"samples":76800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":3.05,"runSeconds":0.231887734,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231862874,"realTimeFactor":0.07602876524590164,"finite":true,"samples":73200},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":3.075,"runSeconds":0.251807111,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251780931,"realTimeFactor":0.0818884913821138,"finite":true,"samples":73800},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":3.125,"runSeconds":0.250543843,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250504033,"realTimeFactor":0.08017402976,"finite":true,"samples":75000},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.6,"runSeconds":0.262707566,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.262679906,"realTimeFactor":0.07297432388888889,"finite":true,"samples":86400},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.85,"runSeconds":0.216339763,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216315123,"realTimeFactor":0.07590868877192981,"finite":true,"samples":68400},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":3.025,"runSeconds":0.229021205,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228995335,"realTimeFactor":0.07570948925619835,"finite":true,"samples":72600},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.85,"runSeconds":0.213560902,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213535492,"realTimeFactor":0.0749336498245614,"finite":true,"samples":68400},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":3.0,"runSeconds":0.222279313,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222253603,"realTimeFactor":0.07409310433333334,"finite":true,"samples":72000},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":3.25,"runSeconds":0.241417591,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.241389921,"realTimeFactor":0.07428233569230769,"finite":true,"samples":78000},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":3.2,"runSeconds":0.228416859,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228388279,"realTimeFactor":0.07138026843749999,"finite":true,"samples":76800},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":3.325,"runSeconds":0.248528427,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248502467,"realTimeFactor":0.07474539157894736,"finite":true,"samples":79800},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":3.2,"runSeconds":0.234806709,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234779469,"realTimeFactor":0.0733770965625,"finite":true,"samples":76800},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":3.2,"runSeconds":0.233376678,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233342788,"realTimeFactor":0.072930211875,"finite":true,"samples":76800},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":3.025,"runSeconds":0.23577323,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23574679,"realTimeFactor":0.07794156363636363,"finite":true,"samples":72600},{"index":128,"text":"Feel the heat of the weak dying flame.","audioSeconds":2.975,"runSeconds":0.231066236,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231040116,"realTimeFactor":0.07766932302521008,"finite":true,"samples":71400},{"index":129,"text":"The tiny girl took off her hat.","audioSeconds":2.625,"runSeconds":0.196628446,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196610626,"realTimeFactor":0.07490607466666667,"finite":true,"samples":63000},{"index":130,"text":"A cramp is no small danger on a swim.","audioSeconds":3.375,"runSeconds":0.257102844,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.257076214,"realTimeFactor":0.07617862044444444,"finite":true,"samples":81000},{"index":131,"text":"He said the same phrase thirty times.","audioSeconds":3.25,"runSeconds":0.239728218,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239701458,"realTimeFactor":0.07376252861538461,"finite":true,"samples":78000},{"index":132,"text":"Pluck the bright rose without leaves.","audioSeconds":3.075,"runSeconds":0.231758191,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231733321,"realTimeFactor":0.07536851739837398,"finite":true,"samples":73800},{"index":133,"text":"Two plus seven is less than ten.","audioSeconds":3.125,"runSeconds":0.238120279,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238095399,"realTimeFactor":0.07619848928,"finite":true,"samples":75000},{"index":134,"text":"The glow deepened in the eyes of the sweet girl.","audioSeconds":3.35,"runSeconds":0.252340525,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.252314045,"realTimeFactor":0.07532552985074627,"finite":true,"samples":80400},{"index":135,"text":"Bring your problems to the wise chief.","audioSeconds":2.95,"runSeconds":0.226089729,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226063939,"realTimeFactor":0.07664058610169491,"finite":true,"samples":70800},{"index":136,"text":"Write a fond note to the friend you cherish.","audioSeconds":3.15,"runSeconds":0.251186843,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251159523,"realTimeFactor":0.07974185492063492,"finite":true,"samples":75600},{"index":137,"text":"Clothes and lodging are free to new men.","audioSeconds":3.2,"runSeconds":0.229646305,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229617815,"realTimeFactor":0.0717644703125,"finite":true,"samples":76800},{"index":138,"text":"We frown when events take a bad turn.","audioSeconds":3.175,"runSeconds":0.261224529,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.261197009,"realTimeFactor":0.08227544220472441,"finite":true,"samples":76200},{"index":139,"text":"Port is a strong wine with a smoky taste.","audioSeconds":3.45,"runSeconds":0.258944135,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.258908495,"realTimeFactor":0.07505627101449276,"finite":true,"samples":82800},{"index":140,"text":"The young kid jumped the rusty gate.","audioSeconds":2.625,"runSeconds":0.201119048,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201094408,"realTimeFactor":0.07661678019047619,"finite":true,"samples":63000},{"index":141,"text":"Guess the results from the first scores.","audioSeconds":3.05,"runSeconds":0.229850966,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229831536,"realTimeFactor":0.07536097245901639,"finite":true,"samples":73200},{"index":142,"text":"A salt pickle tastes fine with ham.","audioSeconds":3.125,"runSeconds":0.255769607,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.255741527,"realTimeFactor":0.08184627424,"finite":true,"samples":75000},{"index":143,"text":"The just claim got the right verdict.","audioSeconds":2.875,"runSeconds":0.222842804,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222818854,"realTimeFactor":0.07751054052173913,"finite":true,"samples":69000},{"index":144,"text":"These thistles bend in a high wind.","audioSeconds":2.975,"runSeconds":0.233210494,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233183964,"realTimeFactor":0.07839008201680672,"finite":true,"samples":71400},{"index":145,"text":"Pure bred poodles have curls.","audioSeconds":2.825,"runSeconds":0.206671908,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206647448,"realTimeFactor":0.073