uld laugh although they were sad.","audioSeconds":2.8,"runSeconds":0.199893318,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199869588,"realTimeFactor":0.07139047071428571,"finite":true,"samples":67200},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":3.175,"runSeconds":0.245632344,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245606634,"realTimeFactor":0.07736451779527559,"finite":true,"samples":76200}]}