7738,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.254560498,"realTimeFactor":0.0771477993939394,"finite":true,"samples":79200},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.8,"runSeconds":0.200630742,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200606462,"realTimeFactor":0.07165383642857143,"finite":true,"samples":67200},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":3.15,"runSeconds":0.247192783,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247166563,"realTimeFactor":0.07847389936507937,"finite":true,"samples":75600},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":3.175,"runSeconds":0.253069378,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253043408,"realTimeFactor":0.07970689070866142,"finite":true,"samples":76200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":3.0,"runSeconds":0.220655535,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220630165,"realTimeFactor":0.073551845,"finite":true,"samples":72000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":3.525,"runSeconds":0.267441947,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.267414887,"realTimeFactor":0.07587005588652483,"finite":true,"samples":84600},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":3.2,"runSeconds":0.262587843,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.262559942,"realTimeFactor":0.08205870093749999,"finite":true,"samples":76800},{"index":161,"text":"At that high level the air is pure.","audioSeconds":3.025,"runSeconds":0.228508057,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228481306,"realTimeFactor":0.075539853553719,"finite":true,"samples":72600},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.9,"runSeconds":0.222622991,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222597721,"realTimeFactor":0.07676654862068966,"finite":true,"samples":69600},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":3.25,"runSeconds":0.23730648,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23727934,"realTimeFactor":0.07301737846153845,"finite":true,"samples":78000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":3.15,"runSeconds":0.245279149,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.245253139,"realTimeFactor":0.07786639650793652,"finite":true,"samples":75600},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":3.4,"runSeconds":0.247543142,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247516382,"realTimeFactor":0.07280680647058824,"finite":true,"samples":81600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":3.35,"runSeconds":0.250924685,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.250898705,"realTimeFactor":0.07490289104477611,"finite":true,"samples":80400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":3.175,"runSeconds":0.253383282,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.253355962,"realTimeFactor":0.07980575811023623,"finite":true,"samples":76200},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":3.025,"runSeconds":0.226918722,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226891512,"realTimeFactor":0.07501445355371901,"finite":true,"samples":72600},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":3.2,"runSeconds":0.227273433,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227246053,"realTimeFactor":0.0710229478125,"finite":true,"samples":76800},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.925,"runSeconds":0.234171661,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234145811,"realTimeFactor":0.08005868752136752,"finite":true,"samples":70200},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":3.175,"runSeconds":0.247874201,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247843911,"realTimeFactor":0.07807061448818897,"finite":true,"samples":76200},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":3.125,"runSeconds":0.242389794,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242364114,"realTimeFactor":0.07756473408,"finite":true,"samples":75000},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":3.425,"runSeconds":0.254275696,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.254248526,"realTimeFactor":0.07424107912408759,"finite":true,"samples":82200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":3.025,"runSeconds":0.227041147,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227006117,"realTimeFactor":0.07505492462809918,"finite":true,"samples":72600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.975,"runSeconds":0.231279165,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231252935,"realTimeFactor":0.07774089579831933,"finite":true,"samples":71400},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":3.0,"runSeconds":0.220898975,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220872595,"realTimeFactor":0.07363299166666666,"finite":true,"samples":72000},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":3.1,"runSeconds":0.238508814,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238482864,"realTimeFactor":0.0769383270967742,"finite":true,"samples":74400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":3.25,"runSeconds":0.251219728,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251191228,"realTimeFactor":0.07729837784615384,"finite":true,"samples":78000},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":3.175,"runSeconds":0.248672959,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248646449,"realTimeFactor":0.07832219181102362,"finite":true,"samples":76200},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":3.05,"runSeconds":0.228280747,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228255307,"realTimeFactor":0.07484614655737705,"finite":true,"samples":73200},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.925,"runSeconds":0.219853826,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219828896,"realTimeFactor":0.0751637011965812,"finite":true,"samples":70200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":3.275,"runSeconds":0.242236393,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.242209783,"realTimeFactor":0.07396531083969465,"finite":true,"samples":78600},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.55,"runSeconds":0.271402359,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.271375729,"realTimeFactor":0.07645136873239436,"finite":true,"samples":85200},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.975,"runSeconds":0.22840481,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22837888,"realTimeFactor":0.07677472605042017,"finite":true,"samples":71400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.95,"runSeconds":0.225943887,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225918877,"realTimeFactor":0.07659114813559321,"finite":true,"samples":70800},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.875,"runSeconds":0.217070418,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217046278,"realTimeFactor":0.07550275408695652,"finite":true,"samples":69000},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.95,"runSeconds":0.223747576,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223721146,"realTimeFactor":0.0758466359322034,"finite":true,"samples":70800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":3.425,"runSeconds":0.265766349,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265738749,"realTimeFactor":0.07759601430656934,"finite":true,"samples":82200},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":3.25,