{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.11 {voices=af_heart,bf_isabella,am_puck,bm_fable, graph=onnx_paradee_int8.onnx, phonemizer=misaki-java fba1236, no fallback, onnxDynamicNodes=1311, onnxNodes=2535, onnxOpset=17, onnxOperators=56, backend=pure-java} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"am_puck","voiceIndex":2,"corpus":"harvard-200","pass":2,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 6.8.0-138-generic amd64 8 cpus","sentences":200,"totalAudioSeconds":502.60000000000014,"totalRunSeconds":40.39554763599999,"realTimeMultiple":12.441965251439976,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.625,"runSeconds":0.303795425,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.303655904,"realTimeFactor":0.11573159047619049,"finite":true,"samples":63000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.675,"runSeconds":0.30039569,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.300260369,"realTimeFactor":0.11229745420560748,"finite":true,"samples":64200},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.4,"runSeconds":0.249399817,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.249382247,"realTimeFactor":0.10391659041666666,"finite":true,"samples":57600},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.675,"runSeconds":0.221307168,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221289288,"realTimeFactor":0.08273165158878505,"finite":true,"samples":64200},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.6,"runSeconds":0.202746816,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202713626,"realTimeFactor":0.07797954461538462,"finite":true,"samples":62400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.45,"runSeconds":0.200621821,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20060391,"realTimeFactor":0.0818864575510204,"finite":true,"samples":58800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.220822675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220804904,"realTimeFactor":0.08178617592592592,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.725,"runSeconds":0.231947595,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231929835,"realTimeFactor":0.08511838348623853,"finite":true,"samples":65400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.475,"runSeconds":0.196407831,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196390671,"realTimeFactor":0.0793566993939394,"finite":true,"samples":59400},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":2.85,"runSeconds":0.224775574,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224755704,"realTimeFactor":0.07886862245614035,"finite":true,"samples":68400},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.225,"runSeconds":0.178605535,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178588645,"realTimeFactor":0.08027215056179775,"finite":true,"samples":53400},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.5,"runSeconds":0.197067596,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197051166,"realTimeFactor":0.07882703840000001,"finite":true,"samples":60000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.025,"runSeconds":0.234556765,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234536884,"realTimeFactor":0.07753942644628099,"finite":true,"samples":72600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.4,"runSeconds":0.177022114,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177004723,"realTimeFactor":0.07375921416666667,"finite":true,"samples":57600},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.35,"runSeconds":0.197837433,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197812643,"realTimeFactor":0.08418614170212765,"finite":true,"samples":56400},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.20845436,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20843536,"realTimeFactor":0.07866202264150944,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.4,"runSeconds":0.17636682,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17635056,"realTimeFactor":0.073486175,"finite":true,"samples":57600},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.45,"runSeconds":0.195688119,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195670789,"realTimeFactor":0.07987270163265306,"finite":true,"samples":58800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.525,"runSeconds":0.200972076,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200950156,"realTimeFactor":0.07959290138613861,"finite":true,"samples":60600},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.6,"runSeconds":0.199092663,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199074083,"realTimeFactor":0.07657410115384615,"finite":true,"samples":62400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.45,"runSeconds":0.196016341,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195999211,"realTimeFactor":0.08000666979591836,"finite":true,"samples":58800},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.725,"runSeconds":0.220642107,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220622097,"realTimeFactor":0.08096958055045872,"finite":true,"samples":65400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":2.8,"runSeconds":0.210252174,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210228824,"realTimeFactor":0.07509006214285714,"finite":true,"samples":67200},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.725,"runSeconds":0.221146402,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221126992,"realTimeFactor":0.08115464293577981,"finite":true,"samples":65400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.575,"runSeconds":0.209791831,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209774691,"realTimeFactor":0.08147255572815534,"finite":true,"samples":61800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.25,"runSeconds":0.181359667,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181341557,"realTimeFactor":0.08060429644444445,"finite":true,"samples":54000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.525,"runSeconds":0.203596807,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203574686,"realTimeFactor":0.08063239881188118,"finite":true,"samples":60600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.625,"runSeconds":0.206901771,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206884041,"realTimeFactor":0.0788197222857143,"finite":true,"samples":63000},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":2.725,"runSeconds":0.223306239,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223288139,"realTimeFactor":0.08194724366972476,"finite":true,"samples":65400},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.175,"runSeconds":0.180310821,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180294011,"realTimeFactor":0.08290152689655174,"finite":true,"samples":52200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.225,"runSeconds":0.179015142,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178997882,"realTimeFactor":0.08045624359550561,"finite":true,"samples":53400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.5,"runSeconds":0.196742479,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196725449,"realTimeFactor":0.0786969916,"finite":true,"samples":60000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.6,"runSeconds":0.195477961,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195460591,"realTimeFactor":0.07518383115384615,"finite":true,"samples":62400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.3,"runSeconds":0.186713629,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186697048,"realTimeFactor":0.08117983869565218,"finite":true,"samples":55200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.125,"runSeconds":0.172230334,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172214844,"realTimeFactor":0.08104956894117647,"finite":true,"samples":51000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.775,"runSeconds":0.229316704,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229297314,"realTimeFactor":0.0826366500900901,"finite":true,"samples":66600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.425,"runSeconds":0.186320926,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186303716,"realTimeFactor":0.07683337154639176,"finite":true,"samples":58200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.675,"runSeconds":0.211478887,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211461027,"realTimeFactor":0.0790575278504673,"finite":true,"samples":64200},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.425,"runSeconds":0.186626919,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186609889,"realTimeFactor":0.07695955422680413,"finite":true,"samples":58200},{"index":39,"text":"What joy there is in living.","audioSeconds":1.925,"runSeconds":0.162554916,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162540106,"realTimeFactor":0.0844441122077922,"finite":true,"samples":46200},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.625,"runSeconds":0.206658012,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206640282,"realTimeFactor":0.07872686171428571,"finite":true,"samples":63000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.217861473,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217842873,"realTimeFactor":0.08068943444444444,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.475,"runSeconds":0.193242217,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193224117,"realTimeFactor":0.07807766343434343,"finite":true,"samples":59400},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.55,"runSeconds":0.20348069,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20346309,"realTimeFactor":0.07979634901960785,"finite":true,"samples":61200},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.475,"runSeconds":0.191974538,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191957268,"realTimeFactor":0.0775654698989899,"finite":true,"samples":59400},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.3,"runSeconds":0.189286059,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189269609,"realTimeFactor":0.08229828652173914,"finite":true,"samples":55200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.7,"runSeconds":0.217717693,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217699023,"realTimeFactor":0.08063618259259259,"finite":true,"samples":64800},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.3,"runSeconds":0.187711248,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187693898,"realTimeFactor":0.08161358608695653,"finite":true,"samples":55200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.45,"runSeconds":0.195559815,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195540945,"realTimeFactor":0.07982033265306122,"finite":true,"samples":58800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.45,"runSeconds":0.188951198,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188931998,"realTimeFactor":0.07712293795918367,"finite":true,"samples":58800},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.3,"runSeconds":0.187070544,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187051074,"realTimeFactor":0.0813350191304348,"finite":true,"samples":55200},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.525,"runSeconds":0.198763478,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198745627,"realTimeFactor":0.07871820910891089,"finite":true,"samples":60600},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.25,"runSeconds":0.180149695,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180133305,"realTimeFactor":0.08006653111111112,"finite":true,"samples":54000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.525,"runSeconds":0.201191217,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201172637,"realTimeFactor":0.0796796899009901,"finite":true,"samples":60600},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.65,"runSeconds":0.211306189,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211287979,"realTimeFactor":0.07973818452830189,"finite":true,"samples":63600},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.45,"runSeconds":0.19474372,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19472605,"realTimeFactor":0.07948723265306122,"finite":true,"samples":58800},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.55,"runSeconds":0.203647634,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203630594,"realTimeFactor":0.07986181725490196,"finite":true,"samples":61200},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.3,"runSeconds":0.186692494,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186676164,"realTimeFactor":0.0811706495652174,"finite":true,"samples":55200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.5,"runSeconds":0.194996903,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194979323,"realTimeFactor":0.0779987612,"finite":true,"samples":60000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.725,"runSeconds":0.220069134,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220050674,"realTimeFactor":0.0807593152293578,"finite":true,"samples":65400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.55,"runSeconds":0.20439321,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20437496,"realTimeFactor":0.08015420000000001,"finite":true,"samples":61200},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.675,"runSeconds":0.21392503,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213907589,"realTimeFactor":0.0799719738317757,"finite":true,"samples":64200},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.65,"runSeconds":0.208543891,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208525921,"realTimeFactor":0.07869580792452831,"finite":true,"samples":63600},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.55,"runSeconds":0.20684767,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20683076,"realTimeFactor":0.08111673333333334,"finite":true,"samples":61200},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.375,"runSeconds":0.197389882,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197374122,"realTimeFactor":0.08311152926315789,"finite":true,"samples":57000},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.75,"runSeconds":0.223064056,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223046376,"realTimeFactor":0.08111420218181818,"finite":true,"samples":66000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.675,"runSeconds":0.21809597,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21807754,"realTimeFactor":0.08153120373831776,"finite":true,"samples":64200},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.8,"runSeconds":0.204203373,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204182052,"realTimeFactor":0.07292977607142857,"finite":true,"samples":67200},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.425,"runSeconds":0.186636586,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186619546,"realTimeFactor":0.0769635406185567,"finite":true,"samples":58200},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":2.875,"runSeconds":0.221323335,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221304804,"realTimeFactor":0.0769820295652174,"finite":true,"samples":69000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.65,"runSeconds":0.211664215,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211646325,"realTimeFactor":0.07987328867924529,"finite":true,"samples":63600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.3,"runSeconds":0.189375786,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189359885,"realTimeFactor":0.08233729826086957,"finite":true,"samples":55200},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.625,"runSeconds":0.206429879,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206411989,"realTimeFactor":0.0786399539047619,"finite":true,"samples":63000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.425,"runSeconds":0.186769457,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186752887,"realTimeFactor":0.07701833278350516,"finite":true,"samples":58200},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.375,"runSeconds":0.19967174,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1996555,"realTimeFactor":0.08407231157894736,"finite":true,"samples":57000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.2,"runSeconds":0.170725282,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170709662,"realTimeFactor":0.0776024009090909,"finite":true,"samples":52800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.575,"runSeconds":0.209617203,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209598853,"realTimeFactor":0.0814047390291262,"finite":true,"samples":61800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":2.85,"runSeconds":0.225994002,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225975782,"realTimeFactor":0.07929614105263158,"finite":true,"samples":68400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.75,"runSeconds":0.223857596,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223839736,"realTimeFactor":0.08140276218181818,"finite":true,"samples":66000},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.625,"runSeconds":0.205565784,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205548304,"realTimeFactor":0.07831077485714286,"finite":true,"samples":63000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.625,"runSeconds":0.204697579,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204679448,"realTimeFactor":0.07798003009523809,"finite":true,"samples":63000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.525,"runSeconds":0.198599524,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198578164,"realTimeFactor":0.07865327683168317,"finite":true,"samples":60600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.3,"runSeconds":0.186998061,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186977581,"realTimeFactor":0.0813035047826087,"finite":true,"samples":55200},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.575,"runSeconds":0.205432205,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205411084,"realTimeFactor":0.07977949708737864,"finite":true,"samples":61800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.25,"runSeconds":0.179451147,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179430577,"realTimeFactor":0.07975606533333333,"finite":true,"samples":54000},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.55,"runSeconds":0.202290902,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202269912,"realTimeFactor":0.07932976549019609,"finite":true,"samples":61200},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.125,"runSeconds":0.169684078,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169664848,"realTimeFactor":0.07985133082352941,"finite":true,"samples":51000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.4,"runSeconds":0.175019796,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.174998186,"realTimeFactor":0.072924915,"finite":true,"samples":57600},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.35,"runSeconds":0.193223328,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193203748,"realTimeFactor":0.08222269276595745,"finite":true,"samples":56400},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.55,"runSeconds":0.214248161,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214223651,"realTimeFactor":0.08401888666666667,"finite":true,"samples":61200},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.325,"runSeconds":0.193473869,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193449979,"realTimeFactor":0.08321456731182794,"finite":true,"samples":55800},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.4,"runSeconds":0.179599679,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179574258,"realTimeFactor":0.07483319958333334,"finite":true,"samples":57600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":2.575,"runSeconds":0.2073323,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20730614,"realTimeFactor":0.08051739805825242,"finite":true,"samples":61800},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":2.725,"runSeconds":0.223819891,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223795171,"realTimeFactor":0.08213573981651376,"finite":true,"samples":65400},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":2.45,"runSeconds":0.195207583,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195184433,"realTimeFactor":0.0796765644897959,"finite":true,"samples":58800},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":2.55,"runSeconds":0.203223101,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20319988,"realTimeFactor":0.0796953337254902,"finite":true,"samples":61200},{"index":96,"text":"The term ended in late June that year.","audioSeconds":2.55,"runSeconds":0.20449008,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20446696,"realTimeFactor":0.08019218823529412,"finite":true,"samples":61200},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":2.55,"runSeconds":0.208001437,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207978217,"realTimeFactor":0.08156919098039217,"finite":true,"samples":61200},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.075,"runSeconds":0.170955769,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170934169,"realTimeFactor":0.08238832240963855,"finite":true,"samples":49800},{"index":99,"text":"The bill was paid every third week.","audioSeconds":2.375,"runSeconds":0.204665832,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204641232,"realTimeFactor":0.08617508715789474,"finite":true,"samples":57000},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":2.475,"runSeconds":0.194242487,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194218487,"realTimeFactor":0.07848181292929292,"finite":true,"samples":59400},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":2.325,"runSeconds":0.191661889,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191639219,"realTimeFactor":0.08243522107526881,"finite":true,"samples":55800},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.225,"runSeconds":0.176933003,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176909443,"realTimeFactor":0.07952045078651686,"finite":true,"samples":53400},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":2.575,"runSeconds":0.209061326,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209038096,"realTimeFactor":0.0811888644660194,"finite":true,"samples":61800},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.5,"runSeconds":0.197082419,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197059389,"realTimeFactor":0.0788329676,"finite":true,"samples":60000},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":2.475,"runSeconds":0.19461039,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19458603,"realTimeFactor":0.0786304606060606,"finite":true,"samples":59400},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":2.65,"runSeconds":0.209612829,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209588159,"realTimeFactor":0.07909918075471699,"finite":true,"samples":63600},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":2.4,"runSeconds":0.180288548,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180266008,"realTimeFactor":0.07512022833333333,"finite":true,"samples":57600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.375,"runSeconds":0.200185822,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200162692,"realTimeFactor":0.08428876715789474,"finite":true,"samples":57000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.25,"runSeconds":0.18201265,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18198971,"realTimeFactor":0.08089451111111111,"finite":true,"samples":54000},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":2.85,"runSeconds":0.230838505,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230814225,"realTimeFactor":0.08099596666666667,"finite":true,"samples":68400},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":2.6,"runSeconds":0.199115405,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199091745,"realTimeFactor":0.07658284807692307,"finite":true,"samples":62400},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.325,"runSeconds":0.193283114,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193259324,"realTimeFactor":0.08313252215053762,"finite":true,"samples":55800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":2.45,"runSeconds":0.196814058,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196790118,"realTimeFactor":0.08033226857142856,"finite":true,"samples":58800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":2.475,"runSeconds":0.194266731,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194242511,"realTimeFactor":0.07849160848484849,"finite":true,"samples":59400},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":2.35,"runSeconds":0.195631351,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195607421,"realTimeFactor":0.08324738340425532,"finite":true,"samples":56400},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":2.55,"runSeconds":0.205260931,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20523677,"realTimeFactor":0.08049448274509804,"finite":true,"samples":61200},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.025,"runSeconds":0.233849469,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233823079,"realTimeFactor":0.07730560958677686,"finite":true,"samples":72600},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.275,"runSeconds":0.185257666,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.185232436,"realTimeFactor":0.0814319410989011,"finite":true,"samples":54600},{"index":119,"text":"We find joy in the simplest