e":true,"samples":61800},{"index":128,"text":"Feel the heat of the weak dying flame.","audioSeconds":2.425,"runSeconds":0.188585073,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188561222,"realTimeFactor":0.07776704041237113,"finite":true,"samples":58200},{"index":129,"text":"The tiny girl took off her hat.","audioSeconds":2.275,"runSeconds":0.184783655,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184760815,"realTimeFactor":0.08122358461538462,"finite":true,"samples":54600},{"index":130,"text":"A cramp is no small danger on a swim.","audioSeconds":2.825,"runSeconds":0.216447596,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216422276,"realTimeFactor":0.07661861805309733,"finite":true,"samples":67800},{"index":131,"text":"He said the same phrase thirty times.","audioSeconds":2.525,"runSeconds":0.199223541,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199191741,"realTimeFactor":0.07890041227722773,"finite":true,"samples":60600},{"index":132,"text":"Pluck the bright rose without leaves.","audioSeconds":2.35,"runSeconds":0.193896673,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193864283,"realTimeFactor":0.08250922255319149,"finite":true,"samples":56400},{"index":133,"text":"Two plus seven is less than ten.","audioSeconds":2.525,"runSeconds":0.197523989,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197501219,"realTimeFactor":0.07822732237623763,"finite":true,"samples":60600},{"index":134,"text":"The glow deepened in the eyes of the sweet girl.","audioSeconds":2.725,"runSeconds":0.222791173,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222767213,"realTimeFactor":0.08175822862385321,"finite":true,"samples":65400},{"index":135,"text":"Bring your problems to the wise chief.","audioSeconds":2.45,"runSeconds":0.195584105,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195560665,"realTimeFactor":0.07983024693877551,"finite":true,"samples":58800},{"index":136,"text":"Write a fond note to the friend you cherish.","audioSeconds":2.5,"runSeconds":0.201108616,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201085326,"realTimeFactor":0.0804434464,"finite":true,"samples":60000},{"index":137,"text":"Clothes and lodging are free to new men.","audioSeconds":2.6,"runSeconds":0.196967636,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196943536,"realTimeFactor":0.07575678307692307,"finite":true,"samples":62400},{"index":138,"text":"We frown when events take a bad turn.","audioSeconds":2.6,"runSeconds":0.199959898,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199929477,"realTimeFactor":0.07690765307692307,"finite":true,"samples":62400},{"index":139,"text":"Port is a strong wine with a smoky taste.","audioSeconds":2.775,"runSeconds":0.226734203,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226710173,"realTimeFactor":0.0817060190990991,"finite":true,"samples":66600},{"index":140,"text":"The young kid jumped the rusty gate.","audioSeconds":2.375,"runSeconds":0.197346879,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197325049,"realTimeFactor":0.0830934227368421,"finite":true,"samples":57000},{"index":141,"text":"Guess the results from the first scores.","audioSeconds":2.5,"runSeconds":0.197096318,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197073078,"realTimeFactor":0.0788385272,"finite":true,"samples":60000},{"index":142,"text":"A salt pickle tastes fine with ham.","audioSeconds":2.475,"runSeconds":0.194839502,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194814811,"realTimeFactor":0.0787230311111111,"finite":true,"samples":59400},{"index":143,"text":"The just claim got the right verdict.","audioSeconds":2.35,"runSeconds":0.19598084,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19595682,"realTimeFactor":0.08339610212765956,"finite":true,"samples":56400},{"index":144,"text":"These thistles bend in a high wind.","audioSeconds":2.425,"runSeconds":0.185181731,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.185158991,"realTimeFactor":0.07636360041237114,"finite":true,"samples":58200},{"index":145,"text":"Pure bred poodles have curls.","audioSeconds":2.2,"runSeconds":0.167404421,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167380081,"realTimeFactor":0.07609291863636362,"finite":true,"samples":52800},{"index":146,"text":"The tree top waved in a graceful way.","audioSeconds":2.6,"runSeconds":0.197701952,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197678172,"realTimeFactor":0.0760392123076923,"finite":true,"samples":62400},{"index":147,"text":"The spot on the blotter was made by green ink.","audioSeconds":2.925,"runSeconds":0.22862175,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22859445,"realTimeFactor":0.07816128205128206,"finite":true,"samples":70200},{"index":148,"text":"Mud was spattered on the front of his white shirt.","audioSeconds":2.875,"runSeconds":0.226399183,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226373773,"realTimeFactor":0.07874754191304348,"finite":true,"samples":69000},{"index":149,"text":"The cigar burned a hole in the desk top.","audioSeconds":2.625,"runSeconds":0.211681776,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211657575,"realTimeFactor":0.08064067657142857,"finite":true,"samples":63000},{"index":150,"text":"The empty flask stood on the tin tray.","audioSeconds":2.6,"runSeconds":0.201837274,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201806663,"realTimeFactor":0.07762972076923078,"finite":true,"samples":62400},{"index":151,"text":"A speedy man can beat this track mark.","audioSeconds":2.65,"runSeconds":0.21216524,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21214028,"realTimeFactor":0.08006235471698114,"finite":true,"samples":63600},{"index":152,"text":"He broke a new shoelace that day.","audioSeconds":2.25,"runSeconds":0.183073017,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183050467,"realTimeFactor":0.08136578533333333,"finite":true,"samples":54000},{"index":153,"text":"The coffee stand is too high for the couch.","audioSeconds":2.75,"runSeconds":0.22308042,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22305509,"realTimeFactor":0.08112015272727273,"finite":true,"samples":66000},{"index":154,"text":"The urge to write short stories is rare.","audioSeconds":2.6,"runSeconds":0.196538996,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196514285,"realTimeFactor":0.07559192153846153,"finite":true,"samples":62400},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.075,"runSeconds":0.164442741,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164419841,"realTimeFactor":0.07924951373493976,"finite":true,"samples":49800},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":2.575,"runSeconds":0.213806112,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213779742,"realTimeFactor":0.08303149980582523,"finite":true,"samples":61800},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":2.55,"runSeconds":0.205816085,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205792425,"realTimeFactor":0.08071219019607843,"finite":true,"samples":61200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.375,"runSeconds":0.199179386,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199156526,"realTimeFactor":0.08386500463157895,"finite":true,"samples":57000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":2.875,"runSeconds":0.222518067,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222493087,"realTimeFactor":0.07739758852173914,"finite":true,"samples":69000},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":2.7,"runSeconds":0.217230689,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217206509,"realTimeFactor":0.08045581074074074,"finite":true,"samples":64800},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.4,"runSeconds":0.177357957,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177335287,"realTimeFactor":0.07389914875,"finite":true,"samples":57600},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.35,"runSeconds":0.197029492,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197005182,"realTimeFactor":0.0838423370212766,"finite":true,"samples":56400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.525,"runSeconds":0.197422514,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197399024,"realTimeFactor":0.07818713425742574,"finite":true,"samples":60600},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.425,"runSeconds":0.190603754,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190579574,"realTimeFactor":0.07859948618556702,"finite":true,"samples":58200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.65,"runSeconds":0.209643485,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209617964,"realTimeFactor":0.07911074905660377,"finite":true,"samples":63600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.625,"runSeconds":0.204350037,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204324966,"realTimeFactor":0.07784763314285714,"finite":true,"samples":63000},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.65,"runSeconds":0.21017749,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21015436,"realTimeFactor":0.07931226037735849,"finite":true,"samples":63600},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.325,"runSeconds":0.189965001,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189940921,"realTimeFactor":0.08170537677419354,"finite":true,"samples":55800},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.675,"runSeconds":0.216449785,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216424815,"realTimeFactor":0.08091580747663552,"finite":true,"samples":64200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.25,"runSeconds":0.181105846,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181083356,"realTimeFactor":0.0804914871111111,"finite":true,"samples":54000},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.5,"runSeconds":0.196975404,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196951554,"realTimeFactor":0.07879016159999999,"finite":true,"samples":60000},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.55,"runSeconds":0.215592861,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215567371,"realTimeFactor":0.08454622,"finite":true,"samples":61200},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.775,"runSeconds":0.238561819,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238530378,"realTimeFactor":0.08596822306306307,"finite":true,"samples":66600},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.55,"runSeconds":0.210222591,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210199201,"realTimeFactor":0.08244023176470588,"finite":true,"samples":61200},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.375,"runSeconds":0.202495875,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202472005,"realTimeFactor":0.08526142105263157,"finite":true,"samples":57000},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.45,"runSeconds":0.19892818,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19890333,"realTimeFactor":0.08119517551020408,"finite":true,"samples":58800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.525,"runSeconds":0.199291893,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199266902,"realTimeFactor":0.07892748237623763,"finite":true,"samples":60600},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.725,"runSeconds":0.22224933,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22222311,"realTimeFactor":0.0815593871559633,"finite":true,"samples":65400},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.375,"runSeconds":0.200603941,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200581581,"realTimeFactor":0.0844648172631579,"finite":true,"samples":57000},{"index":180,"text":"Acid burns holes in wool cloth.","audioSecond