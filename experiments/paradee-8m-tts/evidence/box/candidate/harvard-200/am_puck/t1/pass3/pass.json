82978724,"finite":true,"samples":56400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.525,"runSeconds":0.207824482,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207801713,"realTimeFactor":0.08230672554455445,"finite":true,"samples":60600},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.425,"runSeconds":0.193878925,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193855816,"realTimeFactor":0.07995007216494847,"finite":true,"samples":58200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.65,"runSeconds":0.213417107,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213392029,"realTimeFactor":0.08053475735849057,"finite":true,"samples":63600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.625,"runSeconds":0.205559927,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205537028,"realTimeFactor":0.07830854361904763,"finite":true,"samples":63000},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.65,"runSeconds":0.21039784,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210373891,"realTimeFactor":0.07939541132075473,"finite":true,"samples":63600},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.325,"runSeconds":0.19082511,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190804012,"realTimeFactor":0.08207531612903225,"finite":true,"samples":55800},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.675,"runSeconds":0.214394249,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214370571,"realTimeFactor":0.08014738280373833,"finite":true,"samples":64200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.25,"runSeconds":0.190701283,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190677414,"realTimeFactor":0.08475612577777777,"finite":true,"samples":54000},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.5,"runSeconds":0.196157967,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196133239,"realTimeFactor":0.0784631868,"finite":true,"samples":60000},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.55,"runSeconds":0.203337617,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203309589,"realTimeFactor":0.07974024196078432,"finite":true,"samples":61200},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.775,"runSeconds":0.22919429,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229171372,"realTimeFactor":0.08259253693693694,"finite":true,"samples":66600},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.55,"runSeconds":0.203334218,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203310659,"realTimeFactor":0.07973890901960785,"finite":true,"samples":61200},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.375,"runSeconds":0.202336613,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202312595,"realTimeFactor":0.08519436336842105,"finite":true,"samples":57000},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.45,"runSeconds":0.199159327,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199136679,"realTimeFactor":0.08128952122448979,"finite":true,"samples":58800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.525,"runSeconds":0.198905133,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198882124,"realTimeFactor":0.07877431009900991,"finite":true,"samples":60600},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.725,"runSeconds":0.222575801,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222550722,"realTimeFactor":0.08167919302752293,"finite":true,"samples":65400},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.375,"runSeconds":0.201896108,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201873929,"realTimeFactor":0.08500888757894737,"finite":true,"samples":57000},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.35,"runSeconds":0.195530426,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195507497,"realTimeFactor":0.08320443659574468,"finite":true,"samples":56400},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.3,"runSeconds":0.186668685,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186644756,"realTimeFactor":0.08116029782608697,"finite":true,"samples":55200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":2.575,"runSeconds":0.206837494,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206813905,"realTimeFactor":0.08032524038834951,"finite":true,"samples":61800},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":2.95,"runSeconds":0.236556921,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236528992,"realTimeFactor":0.08018878677966101,"finite":true,"samples":70800},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.475,"runSeconds":0.195577477,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195553468,"realTimeFactor":0.07902120282828283,"finite":true,"samples":59400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.35,"runSeconds":0.196004984,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195983004,"realTimeFactor":0.08340637617021276,"finite":true,"samples":56400},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.275,"runSeconds":0.185682002,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.185658634,"realTimeFactor":0.08161846241758243,"finite":true,"samples":54600},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.325,"runSeconds":0.191340855,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191318177,"realTimeFactor":0.08229714193548386,"finite":true,"samples":55800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":2.975,"runSeconds":0.236391733,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236364695,"realTimeFactor":0.07945940605042016,"finite":true,"samples":71400},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.4,"runSeconds":0.176188678,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17616579,"realTimeFactor":0.07341194916666667,"finite":true,"samples":57600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.525,"runSeconds":0.201650512,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201627284,"realTimeFactor":0.0798615889108911,"finite":true,"samples":60600},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.775,"runSeconds":0.230032294,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230005705,"realTimeFactor":0.08289452036036037,"finite":true,"samples":66600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.075,"runSeconds":0.171717491,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.171694232,"realTimeFactor":0.08275541734939758,"finite":true,"samples":49800},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.625,"runSeconds":0.20661297,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206586742,"realTimeFactor":0.07870970285714286,"finite":true,"samples":63000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.675,"runSeconds":0.217220958,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21719695,"realTimeFactor":0.08120409644859813,"finite":true,"samples":64200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.3,"runSeconds":0.186818946,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186795878,"realTimeFactor":0.08122562869565218,"finite":true,"samples":55200},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.75,"runSeconds":0.229533806,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229508178,"realTimeFactor":0.08346683854545454,"finite":true,"samples":66000},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":2.625,"runSeconds":0.21184813,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211823262,"realTimeFactor":0.08070404952380952,"finite":true,"samples":63000},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.1,"runSeconds":0.167242961,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167220903,"realTimeFactor":0.07963950523809524,"finite":true,"samples":50400},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":2.575,"runSeconds":0.210641013,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210615835,"realTimeFactor":0.08180233514563105,"finite":true,"samples":61800}]}