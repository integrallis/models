eFactor":0.08318769892473118,"finite":true,"samples":55800},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.225,"runSeconds":0.180915167,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180892489,"realTimeFactor":0.08131018741573033,"finite":true,"samples":53400},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":2.575,"runSeconds":0.212421843,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212397335,"realTimeFactor":0.08249391961165048,"finite":true,"samples":61800},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.5,"runSeconds":0.19726802,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197244962,"realTimeFactor":0.07890720799999999,"finite":true,"samples":60000},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":2.475,"runSeconds":0.19401001,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193987032,"realTimeFactor":0.07838788282828282,"finite":true,"samples":59400},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":2.65,"runSeconds":0.207849237,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207825987,"realTimeFactor":0.07843367433962264,"finite":true,"samples":63600},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":2.4,"runSeconds":0.177885755,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177864196,"realTimeFactor":0.07411906458333334,"finite":true,"samples":57600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.375,"runSeconds":0.205906789,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20588385,"realTimeFactor":0.08669759536842106,"finite":true,"samples":57000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.25,"runSeconds":0.187152384,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187130825,"realTimeFactor":0.08317883733333334,"finite":true,"samples":54000},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":2.85,"runSeconds":0.226263624,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226239416,"realTimeFactor":0.0793907452631579,"finite":true,"samples":68400},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":2.6,"runSeconds":0.196627825,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196605186,"realTimeFactor":0.07562608653846153,"finite":true,"samples":62400},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.325,"runSeconds":0.191899722,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191879163,"realTimeFactor":0.08253751483870966,"finite":true,"samples":55800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":2.45,"runSeconds":0.195535548,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195512929,"realTimeFactor":0.07981042775510204,"finite":true,"samples":58800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":2.475,"runSeconds":0.197016599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196993461,"realTimeFactor":0.07960266626262626,"finite":true,"samples":59400},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":2.35,"runSeconds":0.198272385,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198249217,"realTimeFactor":0.08437122765957446,"finite":true,"samples":56400},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":2.55,"runSeconds":0.206029882,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206006453,"realTimeFactor":0.08079603215686275,"finite":true,"samples":61200},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.025,"runSeconds":0.235939359,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23591321,"realTimeFactor":0.07799648231404958,"finite":true,"samples":72600},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.275,"runSeconds":0.186287482,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186263764,"realTimeFactor":0.08188460747252747,"finite":true,"samples":54600},{"index":119,"text":"We find joy in the simp