{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.11 {phonemizer=misaki-java fba1236, no fallback, graph=onnx_paradee_int8.onnx, voices=af_heart,bf_isabella,am_puck,bm_fable, backend=pure-java, onnxOperators=56, onnxOpset=17, onnxNodes=2535, onnxDynamicNodes=1311} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"am_puck","voiceIndex":2,"corpus":"harvard-200","pass":3,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 6.8.0-138-generic amd64 8 cpus","sentences":200,"totalAudioSeconds":502.60000000000014,"totalRunSeconds":40.549830834999995,"realTimeMultiple":12.394626306706767,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.625,"runSeconds":0.298446834,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.298306984,"realTimeFactor":0.113694032,"finite":true,"samples":63000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.675,"runSeconds":0.301502841,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.301357232,"realTimeFactor":0.11271134242990656,"finite":true,"samples":64200},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.4,"runSeconds":0.239065996,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239050827,"realTimeFactor":0.09961083166666668,"finite":true,"samples":57600},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.675,"runSeconds":0.215706215,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215692426,"realTimeFactor":0.08063783738317758,"finite":true,"samples":64200},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.6,"runSeconds":0.208841354,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208810517,"realTimeFactor":0.0803235976923077,"finite":true,"samples":62400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.45,"runSeconds":0.197765718,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197747959,"realTimeFactor":0.0807207012244898,"finite":true,"samples":58800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.226720616,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226702617,"realTimeFactor":0.08397059851851851,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.725,"runSeconds":0.222259725,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222240226,"realTimeFactor":0.08156320183486238,"finite":true,"samples":65400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.475,"runSeconds":0.196267639,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196250611,"realTimeFactor":0.07930005616161616,"finite":true,"samples":59400},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":2.85,"runSeconds":0.224554738,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224535939,"realTimeFactor":0.07879113614035088,"finite":true,"samples":68400},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.225,"runSeconds":0.17775015,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177734941,"realTimeFactor":0.07988770786516854,"finite":true,"samples":53400},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.5,"runSeconds":0.197318267,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197294118,"realTimeFactor":0.0789273068,"finite":true,"samples":60000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.025,"runSeconds":0.234678274,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234658956,"realTimeFactor":0.0775795947107438,"finite":true,"samples":72600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.4,"runSeconds":0.183771086,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183753807,"realTimeFactor":0.07657128583333334,"finite":true,"samples":57600},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.35,"runSeconds":0.200036505,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200020336,"realTimeFactor":0.0851219170212766,"finite":true,"samples":56400},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.21088963,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210870741,"realTimeFactor":0.0795809924528302,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.4,"runSeconds":0.178440589,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17842358,"realTimeFactor":0.07435024541666667,"finite":true,"samples":57600},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.45,"runSeconds":0.19719513,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197177552,"realTimeFactor":0.0804878081632653,"finite":true,"samples":58800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.525,"runSeconds":0.202838679,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20282143,"realTimeFactor":0.0803321500990099,"finite":true,"samples":60600},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.6,"runSeconds":0.199907851,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199890292,"realTimeFactor":0.076887635,"finite":true,"samples":62400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.45,"runSeconds":0.209976443,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209954545,"realTimeFactor":0.08570467061224489,"finite":true,"samples":58800},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.725,"runSeconds":0.222511528,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22249233,"realTimeFactor":0.08165560660550458,"finite":true,"samples":65400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":2.8,"runSeconds":0.211651795,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211633096,"realTimeFactor":0.07558992678571429,"finite":true,"samples":67200},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.725,"runSeconds":0.221036815,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221017876,"realTimeFactor":0.08111442752293578,"finite":true,"samples":65400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.575,"runSeconds":0.209529052,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209510843,"realTimeFactor":0.08137050563106796,"finite":true,"samples":61800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.25,"runSeconds":0.180768996,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180753607,"realTimeFactor":0.08034177599999999,"finite":true,"samples":54000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.525,"runSeconds":0.200288803,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200271794,"realTimeFactor":0.07932229821782177,"finite":true,"samples":60600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.625,"runSeconds":0.205114606,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205097607,"realTimeFactor":0.07813889752380952,"finite":true,"samples":63000},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":2.725,"runSeconds":0.2231447,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223122572,"realTimeFactor":0.08188796330275229,"finite":true,"samples":65400},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.175,"runSeconds":0.179212748,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179196879,"realTimeFactor":0.08239666574712645,"finite":true,"samples":52200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.225,"runSeconds":0.179396565,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.179378856,"realTimeFactor":0.08062766966292134,"finite":true,"samples":53400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.5,"runSeconds":0.198941052,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198923884,"realTimeFactor":0.0795764208,"finite":true,"samples":60000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.6,"runSeconds":0.196006183,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195988484,"realTimeFactor":0.07538699346153846,"finite":true,"samples":62400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.3,"runSeconds":0.187527438,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187511709,"realTimeFactor":0.08153366869565218,"finite":true,"samples":55200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.125,"runSeconds":0.172830993,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172814235,"realTimeFactor":0.08133223199999999,"finite":true,"samples":51000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.775,"runSeconds":0.229799612,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229781073,"realTimeFactor":0.08281067099099099,"finite":true,"samples":66600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.425,"runSeconds":0.188453431,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188434912,"realTimeFactor":0.0777127550515464,"finite":true,"samples":58200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.675,"runSeconds":0.212552671,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212535363,"realTimeFactor":0.07945894242990655,"finite":true,"samples":64200},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.425,"runSeconds":0.186944674,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186927965,"realTimeFactor":0.07709058721649485,"finite":true,"samples":58200},{"index":39,"text":"What joy there is in living.","audioSeconds":1.925,"runSeconds":0.162298972,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162284593,"realTimeFactor":0.08431115428571428,"finite":true,"samples":46200},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.625,"runSeconds":0.205999892,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205981833,"realTimeFactor":0.07847614933333333,"finite":true,"samples":63000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.219338769,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21932041,"realTimeFactor":0.08123658111111111,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.475,"runSeconds":0.194350062,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194332953,"realTimeFactor":0.07852527757575757,"finite":true,"samples":59400},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.55,"runSeconds":0.206721791,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206704262,"realTimeFactor":0.08106736901960784,"finite":true,"samples":61200},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.475,"runSeconds":0.193112185,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193093106,"realTimeFactor":0.07802512525252525,"finite":true,"samples":59400},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.3,"runSeconds":0.202122887,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202104988,"realTimeFactor":0.08787951608695653,"finite":true,"samples":55200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.7,"runSeconds":0.217485939,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2174681,"realTimeFactor":0.08055034777777777,"finite":true,"samples":64800},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.3,"runSeconds":0.187846025,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187828316,"realTimeFactor":0.0816721847826087,"finite":true,"samples":55200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.45,"runSeconds":0.194114364,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194098155,"realTimeFactor":0.07923035265306122,"finite":true,"samples":58800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.45,"runSeconds":0.188376537,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188357879,"realTimeFactor":0.0768883824489796,"finite":true,"samples":58800},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.3,"runSeconds":0.185781845,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.185762707,"realTimeFactor":0.08077471521739131,"finite":true,"samples":55200},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.525,"runSeconds":0.211180828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211164089,"realTimeFactor":0.08363597148514851,"finite":true,"samples":60600},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.25,"runSeconds":0.181607357,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181590958,"realTimeFactor":0.08071438088888888,"finite":true,"samples":54000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.525,"runSeconds":0.201588719,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20157067,"realTimeFactor":0.07983711643564356,"finite":true,"samples":60600},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.65,"runSeconds":0.209477158,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209458729,"realTimeFactor":0.0790479841509434,"finite":true,"samples":63600},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.45,"runSeconds":0.198064309,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198045321,"realTimeFactor":0.0808425751020408,"finite":true,"samples":58800},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.55,"runSeconds":0.205313468,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205295749,"realTimeFactor":0.08051508549019608,"finite":true,"samples":61200},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.3,"runSeconds":0.188408065,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188388087,"realTimeFactor":0.08191655000000002,"finite":true,"samples":55200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.5,"runSeconds":0.196804132,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196785813,"realTimeFactor":0.0787216528,"finite":true,"samples":60000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.725,"runSeconds":0.22243842,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222418992,"realTimeFactor":0.08162877798165137,"finite":true,"samples":65400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.55,"runSeconds":0.206283165,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206263807,"realTimeFactor":0.08089535882352941,"finite":true,"samples":61200},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.675,"runSeconds":0.215532042,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215513883,"realTimeFactor":0.08057272598130842,"finite":true,"samples":64200},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.65,"runSeconds":0.211049298,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21103106,"realTimeFactor":0.07964124452830189,"finite":true,"samples":63600},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.55,"runSeconds":0.210373015,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210355206,"realTimeFactor":0.08249922156862746,"finite":true,"samples":61200},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.375,"runSeconds":0.198479536,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198461457,"realTimeFactor":0.08357033094736843,"finite":true,"samples":57000},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.75,"runSeconds":0.222965636,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222946907,"realTimeFactor":0.08107841309090909,"finite":true,"samples":66000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.675,"runSeconds":0.216427239,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21640994,"realTimeFactor":0.08090737906542056,"finite":true,"samples":64200},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.8,"runSeconds":0.203979877,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203960859,"realTimeFactor":0.07284995607142858,"finite":true,"samples":67200},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.425,"runSeconds":0.186250334,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186232865,"realTimeFactor":0.07680426144329897,"finite":true,"samples":58200},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":2.875,"runSeconds":0.221375085,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221356156,"realTimeFactor":0.07700002956521738,"finite":true,"samples":69000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.65,"runSeconds":0.210032996,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210014917,"realTimeFactor":0.07925773433962265,"finite":true,"samples":63600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.3,"runSeconds":0.190012409,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189995381,"realTimeFactor":0.08261409086956523,"finite":true,"samples":55200},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.625,"runSeconds":0.205832139,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205814261,"realTimeFactor":0.07841224342857142,"finite":true,"samples":63000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.425,"runSeconds":0.18683261,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186814882,"realTimeFactor":0.07704437525773197,"finite":true,"samples":58200},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.375,"runSeconds":0.19903794,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199022071,"realTimeFactor":0.08380544842105263,"finite":true,"samples":57000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.2,"runSeconds":0.169728631,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169712722,"realTimeFactor":0.07714937772727272,"finite":true,"samples":52800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.575,"runSeconds":0.210929681,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210910932,"realTimeFactor":0.08191443922330097,"finite":true,"samples":61800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":2.85,"runSeconds":0.225622136,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225603217,"realTimeFactor":0.07916566175438597,"finite":true,"samples":68400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.75,"runSeconds":0.223853656,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223826637,"realTimeFactor":0.08140132945454547,"finite":true,"samples":66000},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.625,"runSeconds":0.205766121,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205744972,"realTimeFactor":0.07838709371428572,"finite":true,"samples":63000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.625,"runSeconds":0.205110956,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205090077,"realTimeFactor":0.07813750704761906,"finite":true,"samples":63000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.525,"runSeconds":0.200677714,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200656695,"realTimeFactor":0.07947632237623763,"finite":true,"samples":60600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.3,"runSeconds":0.199630395,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199609626,"realTimeFactor":0.08679582391304348,"finite":true,"samples":55200},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.575,"runSeconds":0.206920301,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206898012,"realTimeFactor":0.08035739844660193,"finite":true,"samples":61800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.25,"runSeconds":0.180263325,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180240856,"realTimeFactor":0.08011703333333334,"finite":true,"samples":54000},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.55,"runSeconds":0.203175755,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203142658,"realTimeFactor":0.07967676666666668,"finite":true,"samples":61200},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.125,"runSeconds":0.170187068,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.170165509,"realTimeFactor":0.080088032,"finite":true,"samples":51000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.4,"runSeconds":0.17535809,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175336211,"realTimeFactor":0.07306587083333334,"finite":true,"samples":57600},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.35,"runSeconds":0.193967873,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193945945,"realTimeFactor":0.08253952042553192,"finite":true,"samples":56400},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.55,"runSeconds":0.204021104,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203997385,"realTimeFactor":0.08000827607843138,"finite":true,"samples":61200},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.325,"runSeconds":0.190598752,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190576192,"realTimeFactor":0.08197795784946237,"finite":true,"samples":55800},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.4,"runSeconds":0.178321674,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.178298316,"realTimeFactor":0.07430069750000001,"finite":true,"samples":57600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":2.575,"runSeconds":0.216084811,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216056003,"realTimeFactor":0.08391643145631067,"f