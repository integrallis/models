,"text":"The urge to write short stories is rare.","audioSeconds":2.6,"runSeconds":0.196516543,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196490293,"realTimeFactor":0.07558328576923076,"finite":true,"samples":62400},{"index":155,"text":"The pencils have all been used.","audioSeconds":2.075,"runSeconds":0.165124931,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.165103721,"realTimeFactor":0.07957828,"finite":true,"samples":49800},{"index":156,"text":"The pirates seized the crew of the lost ship.","audioSeconds":2.575,"runSeconds":0.208623718,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208599418,"realTimeFactor":0.08101891961165049,"finite":true,"samples":61800},{"index":157,"text":"We tried to replace the coin but failed.","audioSeconds":2.55,"runSeconds":0.203830587,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203805617,"realTimeFactor":0.07993356352941178,"finite":true,"samples":61200},{"index":158,"text":"She sewed the torn coat quite neatly.","audioSeconds":2.375,"runSeconds":0.209219828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209195638,"realTimeFactor":0.08809255915789474,"finite":true,"samples":57000},{"index":159,"text":"The sofa cushion is red and of light weight.","audioSeconds":2.875,"runSeconds":0.22418459,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22416043,"realTimeFactor":0.07797724869565217,"finite":true,"samples":69000},{"index":160,"text":"The jacket hung on the back of the wide chair.","audioSeconds":2.7,"runSeconds":0.230377355,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230352574,"realTimeFactor":0.08532494629629629,"finite":true,"samples":64800},{"index":161,"text":"At that high level the air is pure.","audioSeconds":2.4,"runSeconds":0.176391107,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176368767,"realTimeFactor":0.07349629458333333,"finite":true,"samples":57600},{"index":162,"text":"Drop the two when you add the figures.","audioSeconds":2.35,"runSeconds":0.195487159,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195464879,"realTimeFactor":0.08318602510638297,"finite":true,"samples":56400},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.525,"runSeconds":0.19688905,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19686619,"realTimeFactor":0.07797586138613861,"finite":true,"samples":60600},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.425,"runSeconds":0.190621499,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190598889,"realTimeFactor":0.07860680371134021,"finite":true,"samples":58200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.65,"runSeconds":0.208482125,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208458225,"realTimeFactor":0.07867249999999999,"finite":true,"samples":63600},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.625,"runSeconds":0.203642936,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203619196,"realTimeFactor":0.07757826133333333,"finite":true,"samples":63000},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.65,"runSeconds":0.208092797,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208068767,"realTimeFactor":0.0785255837735849,"finite":true,"samples":63600},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.325,"runSeconds":0.188245804,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188224174,"realTimeFactor":0.08096593720430106,"finite":true,"samples":55800},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.675,"runSeconds":0.212825207,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212793187,"realTimeFactor":0.07956082504672897,"finite":true,"samples":64200},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.25,"runSeconds":0.176123333,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176105453,"realTimeFactor":0.07827703688888889,"finite":true,"samples":54000},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.5,"runSeconds":0.194014268,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193983768,"realTimeFactor":0.0776057072,"finite":true,"samples":60000},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.55,"runSeconds":0.202461669,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202437739,"realTimeFactor":0.07939673294117648,"finite":true,"samples":61200},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.775,"runSeconds":0.227771845,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227743055,"realTimeFactor":0.08207994414414414,"finite":true,"samples":66600},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.55,"runSeconds":0.215239943,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215215043,"realTimeFactor":0.08440782078431373,"finite":true,"samples":61200},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.375,"runSeconds":0.198680072,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198657502,"realTimeFactor":0.08365476715789474,"finite":true,"samples":57000},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.45,"runSeconds":0.193728472,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193705992,"realTimeFactor":0.07907284571428572,"finite":true,"samples":58800},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.525,"runSeconds":0.196899322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196874762,"realTimeFactor":0.07797992950495049,"finite":true,"samples":60600},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.725,"runSeconds":0.219336428,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219312618,"realTimeFactor":0.08049043229357798,"finite":true,"samples":65400},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.375,"runSeconds":0.208489224,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208458414,"realTimeFactor":0.08778493642105263,"finite":true,"samples":57000},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.35,"runSeconds":0.192620785,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192598105,"realTimeFactor":0.0819662914893617,"finite":true,"samples":56400},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.3,"runSeconds":0.184578163,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184556113,"realTimeFactor":0.0802513752173913,"finite":true,"samples":55200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":2.575,"runSeconds":0.205666608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205642208,"realTimeFactor":0.07987052737864077,"finite":true,"samples":61800},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":2.95,"runSeconds":0.235014326,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234989106,"realTimeFactor":0.07966587322033898,"finite":true,"samples":70800},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.475,"runSeconds":0.193853557,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193822377,"realTimeFactor":0.0783246694949495,"finite":true,"samples":59400},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.35,"runSeconds":0.194473409,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194450729,"realTimeFactor":0.08275464212765958,"finite":true,"samples":56400},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.275,"runSeconds":0.184285358,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184262878,"realTimeFactor":0.08100455296703298,"finite":true,"samples":54600},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.325,"runSeconds":0.190915779,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190891779,"realTimeFactor":0.0821143135483871,"finite":true,"samples":55800},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":2.975,"runSeconds":0.23519608,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23516883,"realTimeFactor":0.07905750588235294,"finite":true,"samples":71400},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.4,"runSeconds":0.175855174,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175831864,"realTimeFactor":0.07327298916666668,"finite":true,"samples":57600},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.525,"runSeconds":0.199965445,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199933025,"realTimeFactor":0.07919423564356436,"finite":true,"samples":60600},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.775,"runSeconds":0.227405872,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227380763,"realTimeFactor":0.08194806198198198,"finite":true,"samples":66600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.075,"runSeconds":0.166741466,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166719196,"realTimeFactor":0.08035733301204818,"finite":true,"samples":49800},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.625,"runSeconds":0.204312095,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204288075,"realTimeFactor":0.07783317904761905,"finite":true,"samples":63000},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.675,"runSeconds":0.215680839,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215655989,"realTimeFactor":0.08062835102803739,"finite":true,"samples":64200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.3,"runSeconds":0.184989564,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184966604,"realTimeFactor":0.08043024521739131,"finite":true,"samples":55200},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.75,"runSeconds":0.226298096,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226273756,"realTimeFactor":0.08229021672727273,"finite":true,"samples":66000},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":2.625,"runSeconds":0.208028,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208004,"realTimeFactor":0.0792487619047619,"finite":true,"samples":63000},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.1,"runSeconds":0.164699689,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164683169,"realTimeFactor":0.07842842333333333,"finite":true,"samples":50400},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":2.575,"runSeconds":0.226843006,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226817916,"realTimeFactor":0.08809437126213591,"finite":true,"samples":61800}]}