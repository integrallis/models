{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.11 {backend=pure-java, onnxOperators=56, onnxOpset=17, onnxNodes=2535, onnxDynamicNodes=1311, phonemizer=misaki-java fba1236, no fallback, graph=onnx_paradee_int8.onnx, voices=af_heart,bf_isabella,am_puck,bm_fable} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"am_puck","voiceIndex":2,"corpus":"harvard-200","pass":1,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 6.8.0-138-generic amd64 8 cpus","sentences":200,"totalAudioSeconds":502.60000000000014,"totalRunSeconds":40.24503915199998,"realTimeMultiple":12.488495739853775,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.625,"runSeconds":0.331706029,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.331567229,"realTimeFactor":0.12636420152380953,"finite":true,"samples":63000},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.675,"runSeconds":0.280216199,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.280196649,"realTimeFactor":0.10475371925233645,"finite":true,"samples":64200},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.4,"runSeconds":0.20098424,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20096943,"realTimeFactor":0.08374343333333334,"finite":true,"samples":57600},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.675,"runSeconds":0.2234549,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22343872,"realTimeFactor":0.08353454205607477,"finite":true,"samples":64200},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.6,"runSeconds":0.200563871,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200535461,"realTimeFactor":0.07713995038461538,"finite":true,"samples":62400},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.45,"runSeconds":0.195576284,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195561834,"realTimeFactor":0.07982705469387755,"finite":true,"samples":58800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.216020078,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216003478,"realTimeFactor":0.0800074362962963,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.725,"runSeconds":0.216555027,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216539357,"realTimeFactor":0.07946973467889909,"finite":true,"samples":65400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.475,"runSeconds":0.192453319,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192429539,"realTimeFactor":0.07775891676767677,"finite":true,"samples":59400},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":2.85,"runSeconds":0.269852681,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.269837351,"realTimeFactor":0.09468515122807017,"finite":true,"samples":68400},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.225,"runSeconds":0.176633198,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176618458,"realTimeFactor":0.07938570696629213,"finite":true,"samples":53400},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.5,"runSeconds":0.1992223,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19920717,"realTimeFactor":0.07968892,"finite":true,"samples":60000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.025,"runSeconds":0.233649894,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233630464,"realTimeFactor":0.07723963438016529,"finite":true,"samples":72600},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.4,"runSeconds":0.1772418,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.17722306,"realTimeFactor":0.07385075,"finite":true,"samples":57600},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.35,"runSeconds":0.195567431,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195552091,"realTimeFactor":0.08322018340425533,"finite":true,"samples":56400},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.207679878,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207661608,"realTimeFactor":0.07836976528301888,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.4,"runSeconds":0.173123975,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173110555,"realTimeFactor":0.07213498958333334,"finite":true,"samples":57600},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.45,"runSeconds":0.198896363,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198878973,"realTimeFactor":0.08118218897959183,"finite":true,"samples":58800},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.525,"runSeconds":0.198455874,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198440764,"realTimeFactor":0.07859638574257426,"finite":true,"samples":60600},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.6,"runSeconds":0.199563314,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199542734,"realTimeFactor":0.07675512076923076,"finite":true,"samples":62400},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.45,"runSeconds":0.195949556,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195929416,"realTimeFactor":0.0799794106122449,"finite":true,"samples":58800},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.725,"runSeconds":0.221601529,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221584169,"realTimeFactor":0.08132166201834862,"finite":true,"samples":65400},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":2.8,"runSeconds":0.212549073,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212530323,"realTimeFactor":0.07591038321428573,"finite":true,"samples":67200},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.725,"runSeconds":0.220266069,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220244929,"realTimeFactor":0.08083158495412844,"finite":true,"samples":65400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.575,"runSeconds":0.210554874,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210536314,"realTimeFactor":0.08176888310679611,"finite":true,"samples":61800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.25,"runSeconds":0.177756749,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177742949,"realTimeFactor":0.07900299955555555,"finite":true,"samples":54000},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.525,"runSeconds":0.200809072,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200791512,"realTimeFactor":0.07952834534653466,"finite":true,"samples":60600},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.625,"runSeconds":0.20585717,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20583728,"realTimeFactor":0.07842177904761904,"finite":true,"samples":63000},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":2.725,"runSeconds":0.223347254,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223329114,"realTimeFactor":0.08196229504587156,"finite":true,"samples":65400},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.175,"runSeconds":0.180863889,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180847119,"realTimeFactor":0.08315581103448276,"finite":true,"samples":52200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.225,"runSeconds":0.176246114,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176231414,"realTimeFactor":0.07921173662921348,"finite":true,"samples":53400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.5,"runSeconds":0.196987098,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196967838,"realTimeFactor":0.0787948392,"finite":true,"samples":60000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.6,"runSeconds":0.199547726,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199528886,"realTimeFactor":0.07674912538461538,"finite":true,"samples":62400},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.3,"runSeconds":0.190565169,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190548569,"realTimeFactor":0.08285442130434784,"finite":true,"samples":55200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.125,"runSeconds":0.172566946,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.172542046,"realTimeFactor":0.0812079745882353,"finite":true,"samples":51000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.775,"runSeconds":0.231854776,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231830077,"realTimeFactor":0.08355127063063064,"finite":true,"samples":66600},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.425,"runSeconds":0.189010394,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188991794,"realTimeFactor":0.07794243051546393,"finite":true,"samples":58200},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.675,"runSeconds":0.212858836,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212839536,"realTimeFactor":0.07957339663551402,"finite":true,"samples":64200},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.425,"runSeconds":0.188828834,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188811154,"realTimeFactor":0.07786756041237114,"finite":true,"samples":58200},{"index":39,"text":"What joy there is in living.","audioSeconds":1.925,"runSeconds":0.162539474,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.162526614,"realTimeFactor":0.08443609038961038,"finite":true,"samples":46200},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.625,"runSeconds":0.210340998,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210320628,"realTimeFactor":0.080129904,"finite":true,"samples":63000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.225042126,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225020356,"realTimeFactor":0.08334893555555556,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.475,"runSeconds":0.196027415,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196009395,"realTimeFactor":0.07920299595959596,"finite":true,"samples":59400},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.55,"runSeconds":0.205613513,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205595363,"realTimeFactor":0.08063275019607843,"finite":true,"samples":61200},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.475,"runSeconds":0.194226986,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194206556,"realTimeFactor":0.07847554989898989,"finite":true,"samples":59400},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.3,"runSeconds":0.19067829,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19066125,"realTimeFactor":0.0829036043478261,"finite":true,"samples":55200},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.7,"runSeconds":0.218373772,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218355362,"realTimeFactor":0.08087917481481481,"finite":true,"samples":64800},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.3,"runSeconds":0.187473232,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187452942,"realTimeFactor":0.08151010086956521,"finite":true,"samples":55200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.45,"runSeconds":0.19530955,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19529165,"realTimeFactor":0.07971818367346938,"finite":true,"samples":58800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.45,"runSeconds":0.189257242,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189231222,"realTimeFactor":0.07724785387755101,"finite":true,"samples":58800},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.3,"runSeconds":0.189012254,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188992174,"realTimeFactor":0.08217924086956523,"finite":true,"samples":55200},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.525,"runSeconds":0.200217362,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200198872,"realTimeFactor":0.07929400475247525,"finite":true,"samples":60600},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.25,"runSeconds":0.181910338,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181895208,"realTimeFactor":0.08084903911111112,"finite":true,"samples":54000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.525,"runSeconds":0.203720992,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203702402,"realTimeFactor":0.080681580990099,"finite":true,"samples":60600},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.65,"runSeconds":0.21036866,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21034958,"realTimeFactor":0.07938440000000001,"finite":true,"samples":63600},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.45,"runSeconds":0.201209215,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201187765,"realTimeFactor":0.08212621020408163,"finite":true,"samples":58800},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.55,"runSeconds":0.210430594,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210411764,"realTimeFactor":0.08252180156862746,"finite":true,"samples":61200},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.3,"runSeconds":0.18735599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18733905,"realTimeFactor":0.08145912608695653,"finite":true,"samples":55200},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.5,"runSeconds":0.196982638,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196958028,"realTimeFactor":0.07879305519999999,"finite":true,"samples":60000},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.725,"runSeconds":0.221927561,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221908351,"realTimeFactor":0.08144130678899082,"finite":true,"samples":65400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.55,"runSeconds":0.205686168,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205667738,"realTimeFactor":0.08066124235294118,"finite":true,"samples":61200},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.675,"runSeconds":0.214778817,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214758767,"realTimeFactor":0.08029114654205609,"finite":true,"samples":64200},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.65,"runSeconds":0.211096809,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211077869,"realTimeFactor":0.07965917320754717,"finite":true,"samples":63600},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.55,"runSeconds":0.208498049,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208478499,"realTimeFactor":0.08176394078431373,"finite":true,"samples":61200},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.375,"runSeconds":0.198895922,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198878582,"realTimeFactor":0.08374565136842105,"finite":true,"samples":57000},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.75,"runSeconds":0.221972109,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221953679,"realTimeFactor":0.08071713054545454,"finite":true,"samples":66000},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.675,"runSeconds":0.214193112,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214174792,"realTimeFactor":0.08007219140186916,"finite":true,"samples":64200},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.8,"runSeconds":0.202393264,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202374454,"realTimeFactor":0.07228330857142858,"finite":true,"samples":67200},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.425,"runSeconds":0.185635318,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.185617758,"realTimeFactor":0.07655064659793814,"finite":true,"samples":58200},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":2.875,"runSeconds":0.231310079,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231291199,"realTimeFactor":0.08045567965217391,"finite":true,"samples":69000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.65,"runSeconds":0.210059517,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210041537,"realTimeFactor":0.07926774226415095,"finite":true,"samples":63600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.3,"runSeconds":0.188322102,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188306042,"realTimeFactor":0.0818791747826087,"finite":true,"samples":55200},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.625,"runSeconds":0.204559908,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204534108,"realTimeFactor":0.07792758400000001,"finite":true,"samples":63000},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.425,"runSeconds":0.185442392,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.185424612,"realTimeFactor":0.0764710894845361,"finite":true,"samples":58200},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.375,"runSeconds":0.198187019,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198170249,"realTimeFactor":0.08344716589473684,"finite":true,"samples":57000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.2,"runSeconds":0.167286329,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.167271479,"realTimeFactor":0.07603924045454545,"finite":true,"samples":52800},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.575,"runSeconds":0.207556593,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207539263,"realTimeFactor":0.08060450213592232,"finite":true,"samples":61800},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":2.85,"runSeconds":0.224871058,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224852048,"realTimeFactor":0.07890212561403509,"finite":true,"samples":68400},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.75,"runSeconds":0.224017378,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223998708,"realTimeFactor":0.08146086472727272,"finite":true,"samples":66000},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.625,"runSeconds":0.206108453,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206086253,"realTimeFactor":0.0785175059047619,"finite":true,"samples":63000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.625,"runSeconds":0.206481947,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206461647,"realTimeFactor":0.07865978933333333,"finite":true,"samples":63000},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.525,"runSeconds":0.198274847,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198253897,"realTimeFactor":0.07852469188118813,"finite":true,"samples":60600},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.3,"runSeconds":0.188602049,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188582819,"realTimeFactor":0.08200089086956522,"finite":true,"samples":55200},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.575,"runSeconds":0.204719297,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204695877,"realTimeFactor":0.07950263961165048,"finite":true,"samples":61800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.25,"runSeconds":0.176964141,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176948531,"realTimeFactor":0.07865072933333334,"finite":true,"samples":54000},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.55,"runSeconds":0.200787601,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200764081,"realTimeFactor":0.07874023568627452,"finite":true,"samples":61200},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.125,"runSeconds":0.166259766,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166244246,"realTimeFactor":0.07823988988235295,"finite":true,"samples":51000},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.4,"runSeconds":0.173809675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173778885,"realTimeFactor":0.07242069791666667,"finite":true,"samples":57600},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.35,"runSeconds":0.192101292,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192079082,"realTimeFactor":0.08174523063829787,"finite":true,"samples":56400},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.55,"runSeconds":0.20224012,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2022171,"realTimeFactor":0.07930985098039216,"finite":true,"samples":61200},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.325,"runSeconds":0.188723206,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188701176,"realTimeFactor":0.08117127139784946,"finite":true,"samples":55800},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.4,"runSeconds":0.176590987,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176568877,"realTimeFactor":0.07357957791666667,"finite":true,"samples":57600},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":2.575,"runSeconds":0.205629124,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205605334,"realTimeFactor":0.07985597048543688,"finite":true,"samples":61800},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":2.725,"runSeconds":0.221062363,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221039233,"realTimeFactor":0.08112380293577982,"finite":true,"samples":65400},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":2.45,"runSeconds":0.195499285,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195476795,"realTimeFactor":0.07979562653061224,"finite":true,"samples":58800},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":2.55,"runSeconds":0.202625158,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202601018,"realTimeFactor":0.0794608462745098,"finite":true,"samples":61200},{"index":96,"text":"The term ended in late June that year.","audioSeconds":2.55,"runSeconds":0.204414769,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204391619,"realTimeFactor":0.08016265450980392,"finite":true,"samples":61200},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":2.55,"runSeconds":0.206833529,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206811429,"realTimeFactor":0.08111118784313726,"finite":true,"samples":61200},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.075,"runSeconds":0.161204413,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.161188703,"realTimeFactor":0.07768887373493975,"finite":true,"samples":49800},{"index":99,"text":"The bill was paid every third week.","audioSeconds":2.375,"runSeconds":0.196227929,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196204159,"realTimeFactor":0.08262228589473684,"finite":true,"samples":57000},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":2.475,"runSeconds":0.192051572,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192028262,"realTimeFactor":0.07759659474747474,"finite":true,"samples":59400},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":2.325,"runSeconds":0.189534244,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189512204,"realTimeFactor":0.08152010494623654,"finite":true,"samples":55800},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.225,"runSeconds":0.173510416,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173493986,"realTimeFactor":0.07798220943820225,"finite":true,"samples":53400},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":2.575,"runSeconds":0.207869483,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207846633,"realTimeFactor":0.08072601281553397,"finite":true,"samples":61800},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.5,"runSeconds":0.196162653,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196139723,"realTimeFactor":0.07846506119999999,"finite":true,"samples":60000},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":2.475,"runSeconds":0.193082726,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193058866,"realTimeFactor":0.07801322262626263,"finite":true,"samples":59400},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":2.65,"runSeconds":0.207381687,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207358407,"realTimeFactor":0.0782572403773585,"finite":true,"samples":63600},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":2.4,"runSeconds":0.176936249,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176913889,"realTimeFactor":0.07372343708333333,"finite":true,"samples":57600},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.375,"runSeconds":0.196068458,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196046298,"realTimeFactor":0.08255514021052632,"finite":true,"samples":57000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.25,"runSeconds":0.175321749,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.175305759,"realTimeFactor":0.07792077733333333,"finite":true,"samples":54000},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":2.85,"runSeconds":0.223743498,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223719778,"realTimeFactor":0.0785064905263158,"finite":true,"samples":68400},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":2.6,"runSeconds":0.195280532,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195258012,"realTimeFactor":0.07510789692307693,"finite":true,"samples":62400},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.325,"runSeconds":0.190299481,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190278441,"realTimeFactor":0.08184923913978494,"finite":true,"samples":55800},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":2.45,"runSeconds":0.194083671,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194056521,"realTimeFactor":0.07921782489795919,"finite":true,"samples":58800},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":2.475,"runSeconds":0.193614982,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193592152,"realTimeFactor":0.07822827555555555,"finite":true,"samples":59400},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":2.35,"runSeconds":0.195945842,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195924072,"realTimeFactor":0.08338120936170212,"finite":true,"samples":56400},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":2.55,"runSeconds":0.204369765,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204346905,"realTimeFactor":0.08014500588235295,"finite":true,"samples":61200},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.025,"runSeconds":0.234867445,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.234841985,"realTimeFactor":0.07764213057851241,"finite":true,"samples":72600},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.275,"runSeconds":0.186106165,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186083865,"realTimeFactor":0.0818049076923077,"finite":true,"samples":54600},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":2.425,"runSeconds":0.190722615,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190698535,"realTimeFactor":0.07864850103092784,"finite":true,"samples":58200},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.125,"runSeconds":0.169528417,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.169512487,"realTimeFactor":0.07977807858823528,"finite":true,"samples":51000},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":2.6,"runSeconds":0.19905228,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19903008,"realTimeFactor":0.07655856923076923,"finite":true,"samples":62400},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":2.575,"runSeconds":0.20758961,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2075662,"realTimeFactor":0.08061732427184466,"finite":true,"samples":61800},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":2.675,"runSeconds":0.21562094,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2155901,"realTimeFactor":0.08060595887850468,"finite":true,"samples":64200},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":2.45,"runSeconds":0.19562332,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19560044,"realTimeFactor":0.07984625306122448,"finite":true,"samples":58800},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":2.6,"runSeconds":0.194419662,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194392512,"realTimeFactor":0.07477679307692307,"finite":true,"samples":62400},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":2.625,"runSeconds":0.206118484,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206095424,"realTimeFactor":0.07852132723809524,"finite":true,"samples":63000},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":2.575,"runSeconds":0.206940424,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206916754,"realTimeFactor":0.0803652132038835,"finite":true,"samples":61800},{"index":128,"text":"Feel the heat of the weak dying flame.","audioSeconds":2.425,"runSeconds":0.186428054,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186406334,"realTimeFactor":0.07687754804123713,"finite":true,"samples":58200},{"index":129,"text":"The tiny girl took off her hat.","audioSeconds":2.275,"runSeconds":0.183844644,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183823054,"realTimeFactor":0.08081083252747254,"finite":true,"samples":54600},{"index":130,"text":"A cramp is no small danger on a swim.","audioSeconds":2.825,"runSeconds":0.215020865,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214996805,"realTimeFactor":0.07611358053097345,"finite":true,"samples":67800},{"index":131,"text":"He said the same phrase thirty times.","audioSeconds":2.525,"runSeconds":0.206416728,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206393818,"realTimeFactor":0.08174919920792079,"finite":true,"samples":60600},{"index":132,"text":"Pluck the bright rose without leaves.","audioSeconds":2.35,"runSeconds":0.193246576,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193223456,"realTimeFactor":0.0822325855319149,"finite":true,"samples":56400},{"index":133,"text":"Two plus seven is less than ten.","audioSeconds":2.525,"runSeconds":0.196607997,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196561117,"realTimeFactor":0.07786455326732673,"finite":true,"samples":60600},{"index":134,"text":"The glow deepened in the eyes of the sweet girl.","audioSeconds":2.725,"runSeconds":0.221952469,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221928179,"realTimeFactor":0.08145044733944955,"finite":true,"samples":65400},{"index":135,"text":"Bring your problems to the wise chief.","audioSeconds":2.45,"runSeconds":0.194154539,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194130759,"realTimeFactor":0.07924675061224488,"finite":true,"samples":58800},{"index":136,"text":"Write a fond note to the friend you cherish.","audioSeconds":2.5,"runSeconds":0.199200141,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199176001,"realTimeFactor":0.0796800564,"finite":true,"samples":60000},{"index":137,"text":"Clothes and lodging are free to new men.","audioSeconds":2.6,"runSeconds":0.195665541,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195641211,"realTimeFactor":0.0752559773076923,"finite":true,"samples":62400},{"index":138,"text":"We frown when events take a bad turn.","audioSeconds":2.6,"runSeconds":0.199256862,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199232732,"realTimeFactor":0.07663725461538462,"finite":true,"samples":62400},{"index":139,"text":"Port is a strong wine with a smoky taste.","audioSeconds":2.775,"runSeconds":0.229230093,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229205223,"realTimeFactor":0.08260543891891892,"finite":true,"samples":66600},{"index":140,"text":"The young kid jumped the rusty gate.","audioSeconds":2.375,"runSeconds":0.197369724,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197346944,"realTimeFactor":0.08310304168421052,"finite":true,"samples":57000},{"index":141,"text":"Guess the results from the first scores.","audioSeconds":2.5,"runSeconds":0.197474945,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.197451765,"realTimeFactor":0.078989978,"finite":true,"samples":60000},{"index":142,"text":"A salt pickle tastes fine with ham.","audioSeconds":2.475,"runSeconds":0.195543586,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195519226,"realTimeFactor":0.07900750949494949,"finite":true,"samples":59400},{"index":143,"text":"The just claim got the right verdict.","audioSeconds":2.35,"runSeconds":0.196731765,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196708385,"realTimeFactor":0.08371564468085106,"finite":true,"samples":56400},{"index":144,"text":"These thistles bend in a high wind.","audioSeconds":2.425,"runSeconds":0.187472775,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187448745,"realTimeFactor":0.07730836082474228,"finite":true,"samples":58200},{"index":145,"text":"Pure bred poodles have curls.","audioSeconds":2.2,"runSeconds"