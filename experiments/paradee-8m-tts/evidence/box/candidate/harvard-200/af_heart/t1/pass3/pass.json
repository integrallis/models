89476566037737,"finite":true,"samples":63600},{"index":137,"text":"Clothes and lodging are free to new men.","audioSeconds":2.7,"runSeconds":0.2128204,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21279058,"realTimeFactor":0.07882237037037036,"finite":true,"samples":64800},{"index":138,"text":"We frown when events take a bad turn.","audioSeconds":2.675,"runSeconds":0.212493407,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212475107,"realTimeFactor":0.0794367876635514,"finite":true,"samples":64200},{"index":139,"text":"Port is a strong wine with a smoky taste.","audioSeconds":2.95,"runSeconds":0.232120108,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232101078,"realTimeFactor":0.07868478237288135,"finite":true,"samples":70800},{"index":140,"text":"The young kid jumped the rusty gate.","audioSeconds":2.55,"runSeconds":0.19979979,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19978204,"realTimeFactor":0.07835285882352942,"finite":true,"samples":61200},{"index":141,"text":"Guess the results from the first scores.","audioSeconds":2.6,"runSeconds":0.193536803,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193519252,"realTimeFactor":0.07443723192307693,"finite":true,"samples":62400},{"index":142,"text":"A salt pickle tastes fine with ham.","audioSeconds":2.625,"runSeconds":0.205896556,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205877865,"realTimeFactor":0.07843678323809525,"finite":true,"samples":63000},{"index":143,"text":"The just claim got the right verdict.","audioSeconds":2.35,"runSeconds":0.198558599,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198530908,"realTimeFactor":0.08449302085106383,"finite":true,"samples":56400},{"index":144,"text":"These thistles bend in a high wind.","audioSeconds":2.575,"runSeconds":0.205617223,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205599203,"realTimeFactor":0.07985134873786406,"finite":true,"samples":61800},{"index":145,"text":"Pure bred poodles have curls.","audioSeconds":2.25,"runSeconds":0.176486217,"g2pSeconds":0.0,"timeToFirstAudi