ioSeconds":2.5,"runSeconds":0.19339174,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1933746,"realTimeFactor":0.077356696,"finite":true,"samples":60000},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.25,"runSeconds":0.183813701,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183797381,"realTimeFactor":0.08169497822222221,"finite":true,"samples":54000},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":2.575,"runSeconds":0.205380069,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205362029,"realTimeFactor":0.07975925009708737,"finite":true,"samples":61800},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":2.725,"runSeconds":0.214796476,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214778326,"realTimeFactor":0.07882439486238531,"finite":true,"samples":65400},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":2.725,"runSeconds":0.213930799,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213912369,"realTimeFactor":0.0785067152293578,"finite":true,"samples":65400},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":2.6,"runSeconds":0.213591506,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213561746,"realTimeFactor":0.08215057923076922,"finite":true,"samples":62400},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":2.75,"runSeconds":0.216726944,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216701024,"realTimeFactor":0.07880979781818181,"finite":true,"samples":66000},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":2.675,"runSeconds":0.211041332,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211023112,"realTimeFactor":0.07889395588785048,"finite":true,"samples":64200},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":2.55,"runSeconds":0.201739887,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201720317,"realTimeFactor":0.0791136811764706,"finite":true,"samples":61200},{