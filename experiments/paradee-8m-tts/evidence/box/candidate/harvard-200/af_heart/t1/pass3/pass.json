ex":163,"text":"A filing case is now hard to buy.","audioSeconds":2.625,"runSeconds":0.217789638,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217768997,"realTimeFactor":0.08296748114285715,"finite":true,"samples":63000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.55,"runSeconds":0.201971122,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201952862,"realTimeFactor":0.07920436156862745,"finite":true,"samples":61200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.875,"runSeconds":0.217645726,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217624966,"realTimeFactor":0.07570286121739131,"finite":true,"samples":69000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.85,"runSeconds":0.2104823,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2104621,"realTimeFactor":0.07385343859649122,"finite":true,"samples":68400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.75,"runSeconds":0.218112611,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218093751,"realTimeFactor":0.07931367672727273,"finite":true,"samples":66000},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.5,"runSeconds":0.204533356,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204505086,"realTimeFactor":0.0818133424,"finite":true,"samples":60000},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.725,"runSeconds":0.21698415,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21695383,"realTimeFactor":0.0796272110091743,"finite":true,"samples":65400},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.425,"runSeconds":0.181526323,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181507003,"realTimeFactor":0.07485621567010309,"finite":true,"samples":58200},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.6,"runSeconds":0.192783167,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192765067,"realTimeFactor":0.07414737192307692,"finite":true,"samples":62400},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.7,"runSeconds":0.264821482,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.264803002,"realTimeFactor":0.09808203037037036,"finite":true,"samples":64800},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.925,"runSeconds":0.226002224,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225984014,"realTimeFactor":0.0772657176068376,"finite":true,"samples":70200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.525,"runSeconds":0.196640313,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196622503,"realTimeFactor":0.07787735168316832,"finite":true,"samples":60600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.525,"runSeconds":0.195704485,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195685635,"realTimeFactor":0.07750672673267328,"finite":true,"samples":60600},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.475,"runSeconds":0.207202361,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207184991,"realTimeFactor":0.08371812565656565,"finite":true,"samples":59400},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.6,"runSeconds":0.195998028,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195969348,"realTimeFactor":0.07538385692307692,"finite":true,"samples":62400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.8,"runSeconds":0.202354446,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202333976,"realTimeFactor":0.072269445,"finite":true,"samples":67200},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.575,"runSeconds":0.204151653,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204133583,"realTimeFactor":0.07928219533980582,"finite":true,"samples":61800},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.5,"runSeconds":0.190231536,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190213566,"realTimeFactor":0.07609261440000001,"finite":true,"samples":60000},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.425,"runSeconds":0.239744212,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.239726372,"realTimeFactor":0.0988635925773196,"finite":true,"samples":58200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":2.6,"runSeconds":0.19173732,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19172005,"realTimeFactor":0.07374512307692307,"finite":true,"samples":62400},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.2,"runSeconds":0.228501559,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228479699,"realTimeFactor":0.0714067371875,"finite":true,"samples":76800},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.55,"runSeconds":0.199089398,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199060158,"realTimeFactor":0.0780742737254902,"finite":true,"samples":61200},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.425,"runSeconds":0.181243052,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181217272,"realTimeFactor":0.07473940288659794,"finite":true,"samples":58200},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.425,"runSeconds":0.187597011,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.187569661,"realTimeFactor":0.07735959216494846,"finite":true,"samples":58200},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.475,"runSeconds":0.189535539,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189516539,"realTimeFactor":0.07658001575757575,"finite":true,"samples":59400},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":2.95,"runSeconds":0.229277216,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.229257886,"realTimeFactor":0.07772109016949152,"finite":true,"samples":70800},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.7,"runSeconds":0.207781768,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207761527,"realTimeFactor":0.07695621037037037,"finite":true,"samples":64800},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.7,"runSeconds":0.220649387,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220630237,"realTimeFactor":0.08172199518518518,"finite":true,"samples":64800},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.9,"runSeconds":0.221720897,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221700697,"realTimeFactor":0.07645548172413794,"finite":true,"samples":69600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.175,"runSeconds":0.176862013,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176845883,"realTimeFactor":0.08131586804597703,"finite":true,"samples":52200},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.65,"runSeconds":0.202401318,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202381578,"realTimeFactor":0.07637785584905661,"finite":true,"samples":63600},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.55,"runSeconds":0.222241762,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222211651,"realTimeFactor":0.08715363215686275,"finite":true,"samples":61200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.525,"runSeconds":0.196949139,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196928629,"realTimeFactor":0.077999659009901,"finite":true,"samples":60600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.775,"runSeconds":0.226604952,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226582132,"realTimeFactor":0.08165944216216216,"finite":true,"samples":66600},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":2.7,"runSeconds":0.213563452,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213544912,"realTimeFactor":0.0790975748148148,"finite":true,"samples":64800},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.35,"runSeconds":0.192923611,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192905941,"realTimeFactor":0.08209515361702127,"finite":true,"samples":56400},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":2.775,"runSeconds":0.223512413,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223492463,"realTimeFactor":0.0805450136936937,"finite":true,"samples":66600}]}