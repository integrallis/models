,"finite":true,"samples":59400},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.375,"runSeconds":0.199818938,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199802358,"realTimeFactor":0.08413428968421052,"finite":true,"samples":57000},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":2.675,"runSeconds":0.215195091,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215177021,"realTimeFactor":0.08044676299065422,"finite":true,"samples":64200},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.55,"runSeconds":0.201912271,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201896061,"realTimeFactor":0.07918128274509804,"finite":true,"samples":61200},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":2.7,"runSeconds":0.244114652,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.244086322,"realTimeFactor":0.09041283407407406,"finite":true,"samples":64800},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":2.9,"runSeconds":0.21967817,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.21964825,"realTimeFactor":0.07575109310344828,"finite":true,"samples":69600},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":2.6,"runSeconds":0.196381558,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196363187,"realTimeFactor":0.07553136846153846,"finite":true,"samples":62400},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.375,"runSeconds":0.196185565,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196168355,"realTimeFactor":0.08260444842105263,"finite":true,"samples":57000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.4,"runSeconds":0.219647931,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219631781,"realTimeFactor":0.09151997125,"finite":true,"samples":57600},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.05,"runSeconds":0.240052667,"g2pSeconds":0.0,"timeToFirstAudioS