61200},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.625,"runSeconds":0.203081228,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203056107,"realTimeFactor":0.07736427733333333,"finite":true,"samples":63000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.55,"runSeconds":0.204744179,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204725729,"realTimeFactor":0.08029183490196079,"finite":true,"samples":61200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.875,"runSeconds":0.228796911,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.228767371,"realTimeFactor":0.07958153426086956,"finite":true,"samples":69000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.85,"runSeconds":0.215559232,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215537652,"realTimeFactor":0.07563481824561404,"finite":true,"samples":68400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.75,"runSeconds":0.221509613,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221490262,"realTimeFactor":0.08054895018181818,"finite":true,"samples":66000},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.5,"runSeconds":0.196399284,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.196373504,"realTimeFactor":0.0785597136,"finite":true,"samples":60000},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.725,"runSeconds":0.217907669,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217888329,"realTimeFactor":0.07996611706422017,"finite":true,"samples":65400},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.425,"runSeconds":0.18394788,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.18392888,"realTimeFactor":0.07585479587628867,"finite":true,"samples":58200},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.6,"runSeconds":0.19426094,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19424304,"realTimeFactor":0.07471574615384614,"finite":true,"samples":62400},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.7,"runSeconds":0.218534045,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218506115,"realTimeFactor":0.08093853518518518,"finite":true,"samples":64800},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.925,"runSeconds":0.231684614,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.231664004,"realTimeFactor":0.07920841504273506,"finite":true,"samples":70200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.525,"runSeconds":0.200089941,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200071711,"realTimeFactor":0.079243540990099,"finite":true,"samples":60600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.525,"runSeconds":0.203283363,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203265762,"realTimeFactor":0.08050826257425743,"finite":true,"samples":60600},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.475,"runSeconds":0.194478023,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194458543,"realTimeFactor":0.07857697898989899,"finite":true,"samples":59400},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.6,"runSeconds":0.194321072,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194295811,"realTimeFactor":0.07473887384615385,"finite":true,"samples":62400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.8,"runSeconds":0.209132203,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209113653,"realTimeFactor":0.0746900725,"finite":true,"samples":67200},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.575,"runSeconds":0.210517633,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210490512,"realTimeFactor":0.08175442058252427,"finite":true,"samples":61800},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.5,"runSeconds":0.191053891,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.191035311,"realTimeFactor":0.0764215564,"finite":true,"samples":60000},{"index":181,"text":"Fairy tales should be fun to write.","audioSeconds":2.425,"runSeconds":0.181239055,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181221355,"realTimeFactor":0.07473775463917527,"finite":true,"samples":58200},{"index":182,"text":"Eight miles of woodland burned to waste.","audioSeconds":2.6,"runSeconds":0.192743983,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192725253,"realTimeFactor":0.07413230115384616,"finite":true,"samples":62400},{"index":183,"text":"The third act was dull and tired the players.","audioSeconds":3.2,"runSeconds":0.232839965,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232818055,"realTimeFactor":0.0727624890625,"finite":true,"samples":76800},{"index":184,"text":"A young child should not suffer fright.","audioSeconds":2.55,"runSeconds":0.201371413,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201345473,"realTimeFactor":0.07896918156862745,"finite":true,"samples":61200},{"index":185,"text":"Add the column and put the sum here.","audioSeconds":2.425,"runSeconds":0.187006015,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.186987755,"realTimeFactor":0.07711588247422681,"finite":true,"samples":58200},{"index":186,"text":"We admire and love a good cook.","audioSeconds":2.425,"runSeconds":0.185001012,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184978522,"realTimeFactor":0.07628907711340206,"finite":true,"samples":58200},{"index":187,"text":"There the flood mark is ten inches.","audioSeconds":2.475,"runSeconds":0.248991545,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.248966805,"realTimeFactor":0.10060264444444444,"finite":true,"samples":59400},{"index":188,"text":"He carved a head from the round block of marble.","audioSeconds":2.95,"runSeconds":0.240699791,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24066133,"realTimeFactor":0.08159314949152542,"finite":true,"samples":70800},{"index":189,"text":"She has a smart way of wearing clothes.","audioSeconds":2.7,"runSeconds":0.215253786,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215226846,"realTimeFactor":0.07972362444444445,"finite":true,"samples":64800},{"index":190,"text":"The fruit of a fig tree is apple-shaped.","audioSeconds":2.7,"runSeconds":0.214440191,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214420421,"realTimeFactor":0.07942229296296296,"finite":true,"samples":64800},{"index":191,"text":"Corn cobs can be used to kindle a fire.","audioSeconds":2.9,"runSeconds":0.223287322,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223266851,"realTimeFactor":0.07699562827586208,"finite":true,"samples":69600},{"index":192,"text":"Where were they when the noise started.","audioSeconds":2.175,"runSeconds":0.192675325,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192654275,"realTimeFactor":0.08858635632183909,"finite":true,"samples":52200},{"index":193,"text":"The paper box is full of thumb tacks.","audioSeconds":2.65,"runSeconds":0.2050393,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205018,"realTimeFactor":0.07737332075471699,"finite":true,"samples":63600},{"index":194,"text":"Sell your gift to a buyer at a good gain.","audioSeconds":2.55,"runSeconds":0.20961425,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20959479,"realTimeFactor":0.08220166666666667,"finite":true,"samples":61200},{"index":195,"text":"The tongs lay beside the ice pail.","audioSeconds":2.525,"runSeconds":0.194481407,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194463217,"realTimeFactor":0.0770223394059406,"finite":true,"samples":60600},{"index":196,"text":"The petals fall with the next puff of wind.","audioSeconds":2.775,"runSeconds":0.227956135,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.227928015,"realTimeFactor":0.08214635495495495,"finite":true,"samples":66600},{"index":197,"text":"Bring your best compass to the third class.","audioSeconds":2.7,"runSeconds":0.233908137,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233880787,"realTimeFactor":0.08663264333333333,"finite":true,"samples":64800},{"index":198,"text":"They could laugh although they were sad.","audioSeconds":2.35,"runSeconds":0.189296394,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189277144,"realTimeFactor":0.08055165702127659,"finite":true,"samples":56400},{"index":199,"text":"Farmers came in to thresh the oat crop.","audioSeconds":2.775,"runSeconds":0.222429659,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.222403099,"realTimeFactor":0.08015483207207208,"finite":true,"samples":66600}]}