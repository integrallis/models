amples":61200},{"index":163,"text":"A filing case is now hard to buy.","audioSeconds":2.625,"runSeconds":0.198153897,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198135087,"realTimeFactor":0.07548719885714286,"finite":true,"samples":63000},{"index":164,"text":"An abrupt start does not win the prize.","audioSeconds":2.55,"runSeconds":0.226941254,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226924244,"realTimeFactor":0.08899657019607844,"finite":true,"samples":61200},{"index":165,"text":"Wood is best for making toys and blocks.","audioSeconds":2.875,"runSeconds":0.240498059,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.240465889,"realTimeFactor":0.08365149878260869,"finite":true,"samples":69000},{"index":166,"text":"The office paint was a dull, sad tan.","audioSeconds":2.85,"runSeconds":0.213501419,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213482219,"realTimeFactor":0.07491277859649123,"finite":true,"samples":68400},{"index":167,"text":"He knew the skill of the great young actress.","audioSeconds":2.75,"runSeconds":0.220421262,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220402172,"realTimeFactor":0.08015318618181819,"finite":true,"samples":66000},{"index":168,"text":"A rag will soak up spilled water.","audioSeconds":2.5,"runSeconds":0.199187299,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199169399,"realTimeFactor":0.0796749196,"finite":true,"samples":60000},{"index":169,"text":"A shower of dirt fell from the hot pipes.","audioSeconds":2.725,"runSeconds":0.220310042,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220289592,"realTimeFactor":0.08084772183486238,"finite":true,"samples":65400},{"index":170,"text":"Steam hissed from the broken valve.","audioSeconds":2.425,"runSeconds":0.183680228,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.183658408,"realTimeFactor":0.07574442391752578,"finite":true,"samples":58200},{"index":171,"text":"The child almost hurt the small dog.","audioSeconds":2.6,"runSeconds":0.195182398,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195163748,"realTimeFactor":0.07507015307692308,"finite":true,"samples":62400},{"index":172,"text":"There was a sound of dry leaves outside.","audioSeconds":2.7,"runSeconds":0.23032087,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.23028975,"realTimeFactor":0.08530402592592592,"finite":true,"samples":64800},{"index":173,"text":"The sky that morning was clear and bright blue.","audioSeconds":2.925,"runSeconds":0.232919815,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.232898815,"realTimeFactor":0.07963070598290599,"finite":true,"samples":70200},{"index":174,"text":"Torn scraps littered the stone floor.","audioSeconds":2.525,"runSeconds":0.199627183,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199608153,"realTimeFactor":0.07906027049504952,"finite":true,"samples":60600},{"index":175,"text":"Sunday is the best part of the week.","audioSeconds":2.525,"runSeconds":0.216290974,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216272334,"realTimeFactor":0.08565979168316831,"finite":true,"samples":60600},{"index":176,"text":"The doctor cured him with these pills.","audioSeconds":2.475,"runSeconds":0.194614746,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194596506,"realTimeFactor":0.07863222060606061,"finite":true,"samples":59400},{"index":177,"text":"The new girl was fired today at noon.","audioSeconds":2.6,"runSeconds":0.198299781,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198281491,"realTimeFactor":0.07626914653846154,"finite":true,"samples":62400},{"index":178,"text":"They felt gay when the ship arrived in port.","audioSeconds":2.8,"runSeconds":0.218613675,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.218583095,"realTimeFactor":0.07807631250000001,"finite":true,"samples":67200},{"index":179,"text":"Add the store's account to the last cent.","audioSeconds":2.575,"runSeconds":0.217719526,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217700987,"realTimeFactor":0.0845512722330097,"finite":true,"samples":61800},{"index":180,"text":"Acid burns holes in wool cloth.","audioSeconds":2.5,"runSeconds"