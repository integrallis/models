{"arm":"candidate","runtime":"released com.integrallis:models-audio:0.5.11 {onnxOpset=17, onnxOperators=56, backend=pure-java, voices=af_heart,bf_isabella,am_puck,bm_fable, graph=onnx_paradee_int8.onnx, phonemizer=misaki-java fba1236, no fallback, onnxDynamicNodes=1311, onnxNodes=2535} via Paradee-8M v1.2","onnxruntimeVersion":null,"intraOpThreads":1,"interOpThreads":1,"model":"onnx/paradee_int8.onnx","phonemeSource":"java misaki port (bundled dictionaries, CMUdict tier, fallback model); public streaming synthesize","voice":"af_heart","voiceIndex":0,"corpus":"harvard-200","pass":1,"noiseSeed":"model default","java":"25.0.3","machine":"Linux 6.8.0-138-generic amd64 8 cpus","sentences":200,"totalAudioSeconds":524.9500000000002,"totalRunSeconds":42.902486032999995,"realTimeMultiple":12.235887673180896,"allFinite":true,"rows":[{"index":0,"text":"The birch canoe slid on the smooth planks.","audioSeconds":2.7,"runSeconds":0.281431928,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.281252449,"realTimeFactor":0.1042340474074074,"finite":true,"samples":64800},{"index":1,"text":"Glue the sheet to the dark blue background.","audioSeconds":2.7,"runSeconds":0.300616033,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.300601653,"realTimeFactor":0.11133927148148147,"finite":true,"samples":64800},{"index":2,"text":"It's easy to tell the depth of a well.","audioSeconds":2.5,"runSeconds":0.263700931,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.263681952,"realTimeFactor":0.10548037240000001,"finite":true,"samples":60000},{"index":3,"text":"These days a chicken leg is a rare dish.","audioSeconds":2.9,"runSeconds":0.230311221,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230296731,"realTimeFactor":0.07941766241379311,"finite":true,"samples":69600},{"index":4,"text":"Rice is often served in round bowls.","audioSeconds":2.8,"runSeconds":0.215353414,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215310454,"realTimeFactor":0.07691193357142857,"finite":true,"samples":67200},{"index":5,"text":"The juice of lemons makes fine punch.","audioSeconds":2.575,"runSeconds":0.266145862,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.266008012,"realTimeFactor":0.1033576163106796,"finite":true,"samples":61800},{"index":6,"text":"The box was thrown beside the parked truck.","audioSeconds":2.7,"runSeconds":0.282557828,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.282536708,"realTimeFactor":0.10465104740740741,"finite":true,"samples":64800},{"index":7,"text":"The hogs were fed chopped corn and garbage.","audioSeconds":2.85,"runSeconds":0.219977665,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219960625,"realTimeFactor":0.07718514561403508,"finite":true,"samples":68400},{"index":8,"text":"Four hours of steady work faced us.","audioSeconds":2.55,"runSeconds":0.265746875,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265729005,"realTimeFactor":0.10421446078431373,"finite":true,"samples":61200},{"index":9,"text":"A large size in stockings is hard to sell.","audioSeconds":3.05,"runSeconds":0.264650022,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.264623012,"realTimeFactor":0.08677049901639344,"finite":true,"samples":73200},{"index":10,"text":"The boy was there when the sun rose.","audioSeconds":2.4,"runSeconds":0.176313225,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176298255,"realTimeFactor":0.07346384375,"finite":true,"samples":57600},{"index":11,"text":"A rod is used to catch pink salmon.","audioSeconds":2.625,"runSeconds":0.207853273,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207837163,"realTimeFactor":0.07918219923809525,"finite":true,"samples":63000},{"index":12,"text":"The source of the huge river is the clear spring.","audioSeconds":3.1,"runSeconds":0.243586649,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.243568919,"realTimeFactor":0.07857633838709677,"finite":true,"samples":74400},{"index":13,"text":"Kick the ball straight and follow through.","audioSeconds":2.575,"runSeconds":0.236472494,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236343634,"realTimeFactor":0.09183397825242719,"finite":true,"samples":61800},{"index":14,"text":"Help the woman get back to her feet.","audioSeconds":2.425,"runSeconds":0.193646725,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193630205,"realTimeFactor":0.07985431958762887,"finite":true,"samples":58200},{"index":15,"text":"A pot of tea helps to pass the evening.","audioSeconds":2.65,"runSeconds":0.210879379,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.210863249,"realTimeFactor":0.0795771241509434,"finite":true,"samples":63600},{"index":16,"text":"Smoky fires lack flame and heat.","audioSeconds":2.575,"runSeconds":0.206632381,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206618011,"realTimeFactor":0.08024558485436893,"finite":true,"samples":61800},{"index":17,"text":"The soft cushion broke the man's fall.","audioSeconds":2.55,"runSeconds":0.207888189,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.207866259,"realTimeFactor":0.08152478,"finite":true,"samples":61200},{"index":18,"text":"The salt breeze came across from the sea.","audioSeconds":2.625,"runSeconds":0.211681173,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211657343,"realTimeFactor":0.08064044685714286,"finite":true,"samples":63000},{"index":19,"text":"The girl at the booth sold fifty bonds.","audioSeconds":2.65,"runSeconds":0.209169749,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209153999,"realTimeFactor":0.07893198075471698,"finite":true,"samples":63600},{"index":20,"text":"The small pup gnawed a hole in the sock.","audioSeconds":2.525,"runSeconds":0.20105302,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2010376,"realTimeFactor":0.07962495841584159,"finite":true,"samples":60600},{"index":21,"text":"The fish twisted and turned on the bent hook.","audioSeconds":2.925,"runSeconds":0.226322364,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226304935,"realTimeFactor":0.07737516717948718,"finite":true,"samples":70200},{"index":22,"text":"Press the pants and sew a button on the vest.","audioSeconds":3.025,"runSeconds":0.273376438,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.273357798,"realTimeFactor":0.0903723761983471,"finite":true,"samples":72600},{"index":23,"text":"The swan dive was far short of perfect.","audioSeconds":2.85,"runSeconds":0.216052327,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216035917,"realTimeFactor":0.07580783403508772,"finite":true,"samples":68400},{"index":24,"text":"The beauty of the view stunned the young boy.","audioSeconds":2.7,"runSeconds":0.212891945,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212875845,"realTimeFactor":0.07884886851851851,"finite":true,"samples":64800},{"index":25,"text":"Two blue fish swam in the tank.","audioSeconds":2.3,"runSeconds":0.182718592,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.182703652,"realTimeFactor":0.07944286608695654,"finite":true,"samples":55200},{"index":26,"text":"Her purse was full of useless trash.","audioSeconds":2.625,"runSeconds":0.261247324,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.261229814,"realTimeFactor":0.0995227900952381,"finite":true,"samples":63000},{"index":27,"text":"The colt reared and threw the tall rider.","audioSeconds":2.825,"runSeconds":0.217255249,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217229219,"realTimeFactor":0.07690451292035398,"finite":true,"samples":67800},{"index":28,"text":"It snowed, rained, and hailed the same morning.","audioSeconds":3.05,"runSeconds":0.237001799,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236984219,"realTimeFactor":0.07770550786885247,"finite":true,"samples":73200},{"index":29,"text":"Read verse out loud for pleasure.","audioSeconds":2.425,"runSeconds":0.181005701,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180991561,"realTimeFactor":0.074641526185567,"finite":true,"samples":58200},{"index":30,"text":"Hoist the load to your left shoulder.","audioSeconds":2.35,"runSeconds":0.192494051,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192479591,"realTimeFactor":0.08191236212765957,"finite":true,"samples":56400},{"index":31,"text":"Take the winding path to reach the lake.","audioSeconds":2.625,"runSeconds":0.224029747,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.224012397,"realTimeFactor":0.08534466552380952,"finite":true,"samples":63000},{"index":32,"text":"Note closely the size of the gas tank.","audioSeconds":2.75,"runSeconds":0.219203379,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219186619,"realTimeFactor":0.07971031963636364,"finite":true,"samples":66000},{"index":33,"text":"Wipe the grease off his dirty face.","audioSeconds":2.425,"runSeconds":0.181778353,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.181764313,"realTimeFactor":0.07496014556701032,"finite":true,"samples":58200},{"index":34,"text":"Mend the coat before you go out.","audioSeconds":2.25,"runSeconds":0.176699346,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176685236,"realTimeFactor":0.07853304266666666,"finite":true,"samples":54000},{"index":35,"text":"The wrist was badly strained and hung limp.","audioSeconds":2.85,"runSeconds":0.217830214,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217813084,"realTimeFactor":0.07643165403508771,"finite":true,"samples":68400},{"index":36,"text":"The stray cat gave birth to kittens.","audioSeconds":2.625,"runSeconds":0.258226526,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.258209056,"realTimeFactor":0.09837200990476191,"finite":true,"samples":63000},{"index":37,"text":"The young girl gave no clear response.","audioSeconds":2.7,"runSeconds":0.217568319,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217545189,"realTimeFactor":0.08058085888888888,"finite":true,"samples":64800},{"index":38,"text":"The meal was cooked before the bell rang.","audioSeconds":2.525,"runSeconds":0.226412978,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226397858,"realTimeFactor":0.08966850613861387,"finite":true,"samples":60600},{"index":39,"text":"What joy there is in living.","audioSeconds":2.075,"runSeconds":0.164156981,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.164144421,"realTimeFactor":0.07911179807228916,"finite":true,"samples":49800},{"index":40,"text":"A king ruled the state in the early days.","audioSeconds":2.75,"runSeconds":0.219698244,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219680524,"realTimeFactor":0.07989027054545454,"finite":true,"samples":66000},{"index":41,"text":"The ship was torn apart on the sharp reef.","audioSeconds":2.7,"runSeconds":0.265228277,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265213077,"realTimeFactor":0.09823269518518518,"finite":true,"samples":64800},{"index":42,"text":"Sickness kept him home the third week.","audioSeconds":2.5,"runSeconds":0.193625844,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193610814,"realTimeFactor":0.0774503376,"finite":true,"samples":60000},{"index":43,"text":"The wide road shimmered in the hot sun.","audioSeconds":2.625,"runSeconds":0.204419487,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204401637,"realTimeFactor":0.07787409028571429,"finite":true,"samples":63000},{"index":44,"text":"The lazy cow lay in the cool grass.","audioSeconds":2.55,"runSeconds":0.201323765,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201305315,"realTimeFactor":0.07895049607843137,"finite":true,"samples":61200},{"index":45,"text":"Lift the square stone over the fence.","audioSeconds":2.375,"runSeconds":0.199241863,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199227863,"realTimeFactor":0.0838913107368421,"finite":true,"samples":57000},{"index":46,"text":"The rope will bind the seven books at once.","audioSeconds":2.725,"runSeconds":0.247107469,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.247083149,"realTimeFactor":0.09068164,"finite":true,"samples":65400},{"index":47,"text":"Hop over the fence and plunge in.","audioSeconds":2.425,"runSeconds":0.184047412,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.184032112,"realTimeFactor":0.07589584,"finite":true,"samples":58200},{"index":48,"text":"The friendly gang left the drug store.","audioSeconds":2.575,"runSeconds":0.20516597,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20515032,"realTimeFactor":0.07967610485436893,"finite":true,"samples":61800},{"index":49,"text":"Mesh wire keeps chicks inside.","audioSeconds":2.525,"runSeconds":0.192246571,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.192225581,"realTimeFactor":0.07613725584158416,"finite":true,"samples":60600},{"index":50,"text":"The frosty air passed through the coat.","audioSeconds":2.375,"runSeconds":0.233847575,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.233828475,"realTimeFactor":0.09846213684210527,"finite":true,"samples":57000},{"index":51,"text":"The crooked maze failed to fool the mouse.","audioSeconds":2.625,"runSeconds":0.19959843,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19958326,"realTimeFactor":0.07603749714285714,"finite":true,"samples":63000},{"index":52,"text":"Adding fast leads to wrong sums.","audioSeconds":2.5,"runSeconds":0.190191092,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.190172492,"realTimeFactor":0.07607643680000001,"finite":true,"samples":60000},{"index":53,"text":"The show was a flop from the very start.","audioSeconds":2.725,"runSeconds":0.215237051,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215221021,"realTimeFactor":0.07898607376146789,"finite":true,"samples":65400},{"index":54,"text":"A saw is a tool used for making boards.","audioSeconds":2.85,"runSeconds":0.230251455,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230235465,"realTimeFactor":0.08078998421052631,"finite":true,"samples":68400},{"index":55,"text":"The wagon moved on well oiled wheels.","audioSeconds":2.6,"runSeconds":0.211064767,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.211039267,"realTimeFactor":0.08117875653846153,"finite":true,"samples":62400},{"index":56,"text":"March the soldiers past the next hill.","audioSeconds":2.65,"runSeconds":0.206891127,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.206875117,"realTimeFactor":0.07807212339622642,"finite":true,"samples":63600},{"index":57,"text":"A cup of sugar makes sweet fudge.","audioSeconds":2.35,"runSeconds":0.193272118,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193257788,"realTimeFactor":0.0822434544680851,"finite":true,"samples":56400},{"index":58,"text":"Place a rosebush near the porch steps.","audioSeconds":2.6,"runSeconds":0.193505368,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193489238,"realTimeFactor":0.07442514153846154,"finite":true,"samples":62400},{"index":59,"text":"Both lost their lives in the raging storm.","audioSeconds":2.85,"runSeconds":0.288232995,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.288216355,"realTimeFactor":0.10113438421052631,"finite":true,"samples":68400},{"index":60,"text":"We talked of the side show in the circus.","audioSeconds":2.575,"runSeconds":0.205659704,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205641795,"realTimeFactor":0.07986784621359223,"finite":true,"samples":61800},{"index":61,"text":"Use a pencil to write the first draft.","audioSeconds":2.775,"runSeconds":0.22434335,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.22432703,"realTimeFactor":0.08084445045045045,"finite":true,"samples":66600},{"index":62,"text":"He ran half way to the hardware store.","audioSeconds":2.725,"runSeconds":0.217907016,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.217890086,"realTimeFactor":0.07996587743119266,"finite":true,"samples":65400},{"index":63,"text":"The clock struck to mark the third period.","audioSeconds":2.625,"runSeconds":0.226377056,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226357926,"realTimeFactor":0.08623887847619047,"finite":true,"samples":63000},{"index":64,"text":"A small creek cut across the field.","audioSeconds":2.45,"runSeconds":0.193963306,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193940026,"realTimeFactor":0.0791686963265306,"finite":true,"samples":58800},{"index":65,"text":"Cars and busses stalled in snow drifts.","audioSeconds":2.85,"runSeconds":0.215404017,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215386927,"realTimeFactor":0.07558035684210526,"finite":true,"samples":68400},{"index":66,"text":"The set of china hit the floor with a crash.","audioSeconds":2.75,"runSeconds":0.221142583,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221126243,"realTimeFactor":0.08041548472727272,"finite":true,"samples":66000},{"index":67,"text":"This is a grand season for hikes on the road.","audioSeconds":2.875,"runSeconds":0.256191961,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.256171471,"realTimeFactor":0.08911024730434783,"finite":true,"samples":69000},{"index":68,"text":"The dune rose from the edge of the water.","audioSeconds":2.625,"runSeconds":0.20176939,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.20175223,"realTimeFactor":0.07686452952380952,"finite":true,"samples":63000},{"index":69,"text":"Those words were the cue for the actor to leave.","audioSeconds":3.0,"runSeconds":0.219420863,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219404193,"realTimeFactor":0.07314028766666666,"finite":true,"samples":72000},{"index":70,"text":"A yacht slid around the point into the bay.","audioSeconds":2.775,"runSeconds":0.225022019,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225005919,"realTimeFactor":0.08108901585585586,"finite":true,"samples":66600},{"index":71,"text":"The two met while playing on the sand.","audioSeconds":2.375,"runSeconds":0.282493586,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.282477856,"realTimeFactor":0.1189446677894737,"finite":true,"samples":57000},{"index":72,"text":"The ink stain dried on the finished page.","audioSeconds":2.725,"runSeconds":0.225729719,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.225706089,"realTimeFactor":0.08283659412844037,"finite":true,"samples":65400},{"index":73,"text":"The walled town was seized without a fight.","audioSeconds":2.575,"runSeconds":0.208263463,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208247233,"realTimeFactor":0.08087901475728156,"finite":true,"samples":61800},{"index":74,"text":"The lease ran out in sixteen weeks.","audioSeconds":2.5,"runSeconds":0.193048788,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193032238,"realTimeFactor":0.0772195152,"finite":true,"samples":60000},{"index":75,"text":"A tame squirrel makes a nice pet.","audioSeconds":2.375,"runSeconds":0.19661166,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19659677,"realTimeFactor":0.08278385684210526,"finite":true,"samples":57000},{"index":76,"text":"The horn of the car woke the sleeping cop.","audioSeconds":2.6,"runSeconds":0.251427235,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.251410195,"realTimeFactor":0.0967027826923077,"finite":true,"samples":62400},{"index":77,"text":"The heart beat strongly and with firm strokes.","audioSeconds":3.05,"runSeconds":0.24245695,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.24243686,"realTimeFactor":0.07949408196721312,"finite":true,"samples":73200},{"index":78,"text":"The pearl was worn in a thin silver ring.","audioSeconds":2.85,"runSeconds":0.220146171,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.220125602,"realTimeFactor":0.07724427052631579,"finite":true,"samples":68400},{"index":79,"text":"The fruit peel was cut in thick slices.","audioSeconds":2.75,"runSeconds":0.219900392,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219882702,"realTimeFactor":0.07996377890909091,"finite":true,"samples":66000},{"index":80,"text":"The Navy attacked the big task force.","audioSeconds":2.65,"runSeconds":0.25655791,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.25654044,"realTimeFactor":0.09681430566037737,"finite":true,"samples":63600},{"index":81,"text":"See the cat glaring at the scared mouse.","audioSeconds":2.625,"runSeconds":0.205985405,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205959625,"realTimeFactor":0.07847063047619048,"finite":true,"samples":63000},{"index":82,"text":"There are more than two factors here.","audioSeconds":2.325,"runSeconds":0.189808895,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.189790475,"realTimeFactor":0.08163823440860214,"finite":true,"samples":55800},{"index":83,"text":"The hat brim was wide and too droopy.","audioSeconds":2.7,"runSeconds":0.208352793,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208334253,"realTimeFactor":0.07716770111111111,"finite":true,"samples":64800},{"index":84,"text":"The lawyer tried to lose his case.","audioSeconds":2.425,"runSeconds":0.180187247,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.180169117,"realTimeFactor":0.0743040193814433,"finite":true,"samples":58200},{"index":85,"text":"The grass curled around the fence post.","audioSeconds":2.575,"runSeconds":0.266362444,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.266342324,"realTimeFactor":0.1034417258252427,"finite":true,"samples":61800},{"index":86,"text":"Cut the pie into large parts.","audioSeconds":2.2,"runSeconds":0.166179289,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.166163979,"realTimeFactor":0.07553604045454546,"finite":true,"samples":52800},{"index":87,"text":"Men strive but seldom get rich.","audioSeconds":2.575,"runSeconds":0.204211997,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204194067,"realTimeFactor":0.07930562990291262,"finite":true,"samples":61800},{"index":88,"text":"Always close the barn door tight.","audioSeconds":2.4,"runSeconds":0.173827395,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173801455,"realTimeFactor":0.07242808125,"finite":true,"samples":57600},{"index":89,"text":"He lay prone and hardly moved a limb.","audioSeconds":2.725,"runSeconds":0.214352916,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.214335386,"realTimeFactor":0.07866162055045871,"finite":true,"samples":65400},{"index":90,"text":"The slush lay deep along the street.","audioSeconds":2.425,"runSeconds":0.193308783,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193281193,"realTimeFactor":0.07971496206185569,"finite":true,"samples":58200},{"index":91,"text":"A wisp of cloud hung in the blue air.","audioSeconds":2.45,"runSeconds":0.19050441,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.1904865,"realTimeFactor":0.07775690204081633,"finite":true,"samples":58800},{"index":92,"text":"A pound of sugar costs more than eggs.","audioSeconds":2.675,"runSeconds":0.213828183,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213809473,"realTimeFactor":0.0799357693457944,"finite":true,"samples":64200},{"index":93,"text":"The fin was sharp and cut the clear water.","audioSeconds":2.925,"runSeconds":0.230333805,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.230307945,"realTimeFactor":0.0787466,"finite":true,"samples":70200},{"index":94,"text":"The play seems dull and quite stupid.","audioSeconds":2.55,"runSeconds":0.209607751,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209589501,"realTimeFactor":0.0821991180392157,"finite":true,"samples":61200},{"index":95,"text":"Bail the boat to stop it from sinking.","audioSeconds":2.625,"runSeconds":0.203395524,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.203376144,"realTimeFactor":0.07748400914285714,"finite":true,"samples":63000},{"index":96,"text":"The term ended in late June that year.","audioSeconds":2.65,"runSeconds":0.208254476,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208235756,"realTimeFactor":0.07858659471698114,"finite":true,"samples":63600},{"index":97,"text":"A tusk is used to make costly gifts.","audioSeconds":2.775,"runSeconds":0.226688639,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.226663579,"realTimeFactor":0.08168959963963963,"finite":true,"samples":66600},{"index":98,"text":"Ten pins were set in order.","audioSeconds":2.25,"runSeconds":0.195658926,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195625977,"realTimeFactor":0.08695952266666668,"finite":true,"samples":54000},{"index":99,"text":"The bill was paid every third week.","audioSeconds":2.45,"runSeconds":0.188140462,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188121262,"realTimeFactor":0.07679202530612245,"finite":true,"samples":58800},{"index":100,"text":"Oak is strong and also gives shade.","audioSeconds":2.7,"runSeconds":0.208159548,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.208140088,"realTimeFactor":0.07709612888888888,"finite":true,"samples":64800},{"index":101,"text":"Cats and dogs each hate the other.","audioSeconds":2.475,"runSeconds":0.190494159,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.19046959,"realTimeFactor":0.07696733696969696,"finite":true,"samples":59400},{"index":102,"text":"The pipe began to rust while new.","audioSeconds":2.375,"runSeconds":0.199275113,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.199258393,"realTimeFactor":0.08390531073684211,"finite":true,"samples":57000},{"index":103,"text":"Open the crate but don't break the glass.","audioSeconds":2.675,"runSeconds":0.212712764,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212694924,"realTimeFactor":0.07951879028037384,"finite":true,"samples":64200},{"index":104,"text":"Add the sum to the product of these three.","audioSeconds":2.55,"runSeconds":0.202462037,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.202443207,"realTimeFactor":0.07939687725490197,"finite":true,"samples":61200},{"index":105,"text":"Thieves who rob friends deserve jail.","audioSeconds":2.7,"runSeconds":0.209136662,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.209116902,"realTimeFactor":0.07745802296296296,"finite":true,"samples":64800},{"index":106,"text":"The ripe taste of cheese improves with age.","audioSeconds":2.9,"runSeconds":0.265589776,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265559246,"realTimeFactor":0.09158268137931035,"finite":true,"samples":69600},{"index":107,"text":"Act on these orders with great speed.","audioSeconds":2.6,"runSeconds":0.194245368,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194227899,"realTimeFactor":0.07470975692307692,"finite":true,"samples":62400},{"index":108,"text":"The hog crawled under the high fence.","audioSeconds":2.375,"runSeconds":0.195304367,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.195288397,"realTimeFactor":0.08223341768421052,"finite":true,"samples":57000},{"index":109,"text":"Move the vat over the hot fire.","audioSeconds":2.4,"runSeconds":0.173608122,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.173591092,"realTimeFactor":0.07233671750000001,"finite":true,"samples":57600},{"index":110,"text":"The bark of the pine tree was shiny and dark.","audioSeconds":3.05,"runSeconds":0.2416259,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2416053,"realTimeFactor":0.07922160655737706,"finite":true,"samples":73200},{"index":111,"text":"Leaves turn brown and yellow in the fall.","audioSeconds":2.775,"runSeconds":0.223463873,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.223444973,"realTimeFactor":0.08052752180180181,"finite":true,"samples":66600},{"index":112,"text":"The pennant waved when the wind blew.","audioSeconds":2.425,"runSeconds":0.188801145,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.188779605,"realTimeFactor":0.07785614226804125,"finite":true,"samples":58200},{"index":113,"text":"Split the log with a quick, sharp blow.","audioSeconds":2.725,"runSeconds":0.236577126,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.236558356,"realTimeFactor":0.08681729394495412,"finite":true,"samples":65400},{"index":114,"text":"Burn peat after the logs give out.","audioSeconds":2.575,"runSeconds":0.238261251,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238230091,"realTimeFactor":0.09252864116504854,"finite":true,"samples":61800},{"index":115,"text":"He ordered peach pie with ice cream.","audioSeconds":2.5,"runSeconds":0.20202984,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.2020104,"realTimeFactor":0.080811936,"finite":true,"samples":60000},{"index":116,"text":"Weave the carpet on the right hand side.","audioSeconds":2.55,"runSeconds":0.204934656,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.204915306,"realTimeFactor":0.08036653176470589,"finite":true,"samples":61200},{"index":117,"text":"Hemp is a weed found in parts of the tropics.","audioSeconds":3.1,"runSeconds":0.238755755,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.238734905,"realTimeFactor":0.07701798548387095,"finite":true,"samples":74400},{"index":118,"text":"A lame back kept his score low.","audioSeconds":2.425,"runSeconds":0.185804105,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.185785955,"realTimeFactor":0.0766202494845361,"finite":true,"samples":58200},{"index":119,"text":"We find joy in the simplest things.","audioSeconds":2.5,"runSeconds":0.193653529,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193635589,"realTimeFactor":0.0774614116,"finite":true,"samples":60000},{"index":120,"text":"Type out three lists of orders.","audioSeconds":2.25,"runSeconds":0.176042139,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.176026359,"realTimeFactor":0.07824095066666666,"finite":true,"samples":54000},{"index":121,"text":"The harder he tried the less he got done.","audioSeconds":2.575,"runSeconds":0.205570371,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.205552861,"realTimeFactor":0.07983315378640776,"finite":true,"samples":61800},{"index":122,"text":"The boss ran the show with a watchful eye.","audioSeconds":2.725,"runSeconds":0.282385242,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.282364263,"realTimeFactor":0.10362761174311926,"finite":true,"samples":65400},{"index":123,"text":"The cup cracked and spilled its contents.","audioSeconds":2.725,"runSeconds":0.219050382,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.219020982,"realTimeFactor":0.08038546128440366,"finite":true,"samples":65400},{"index":124,"text":"Paste can cleanse the most dirty brass.","audioSeconds":2.6,"runSeconds":0.194872673,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.194853483,"realTimeFactor":0.07495102807692307,"finite":true,"samples":62400},{"index":125,"text":"The slang word for raw whiskey is booze.","audioSeconds":2.75,"runSeconds":0.216487182,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.216464512,"realTimeFactor":0.07872261163636364,"finite":true,"samples":66000},{"index":126,"text":"It caught its hind paw in a rusty trap.","audioSeconds":2.675,"runSeconds":0.212047841,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.212030471,"realTimeFactor":0.07927022093457944,"finite":true,"samples":64200},{"index":127,"text":"The wharf could be seen at the farther shore.","audioSeconds":2.55,"runSeconds":0.213535139,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.213516649,"realTimeFactor":0.08373927019607844,"finite":true,"samples":61200},{"index":128,"text":"Feel the heat of the weak dying flame.","audioSeconds":2.55,"runSeconds":0.201577773,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.201560553,"realTimeFactor":0.07905010705882352,"finite":true,"samples":61200},{"index":129,"text":"The tiny girl took off her hat.","audioSeconds":2.25,"runSeconds":0.177228944,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.177213964,"realTimeFactor":0.07876841955555555,"finite":true,"samples":54000},{"index":130,"text":"A cramp is no small danger on a swim.","audioSeconds":2.9,"runSeconds":0.221269688,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221250468,"realTimeFactor":0.0762998924137931,"finite":true,"samples":69600},{"index":131,"text":"He said the same phrase thirty times.","audioSeconds":2.525,"runSeconds":0.265215971,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.265198341,"realTimeFactor":0.10503602811881188,"finite":true,"samples":60600},{"index":132,"text":"Pluck the bright rose without leaves.","audioSeconds":2.5,"runSeconds":0.198448734,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.198420664,"realTimeFactor":0.07937949359999999,"finite":true,"samples":60000},{"index":133,"text":"Two plus seven is less than ten.","audioSeconds":2.625,"runSeconds":0.201009468,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.200989938,"realTimeFactor":0.07657503542857143,"finite":true,"samples":63000},{"index":134,"text":"The glow deepened in the eyes of the sweet girl.","audioSeconds":2.825,"runSeconds":0.215791943,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.215770493,"realTimeFactor":0.07638652849557521,"finite":true,"samples":67800},{"index":135,"text":"Bring your problems to the wise chief.","audioSeconds":2.475,"runSeconds":0.193262319,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.193245089,"realTimeFactor":0.07808578545454545,"finite":true,"samples":59400},{"index":136,"text":"Write a fond note to the friend you cherish.","audioSeconds":2.65,"runSeconds":0.221373644,"g2pSeconds":0.0,"timeToFirstAudioSeconds":0.221353614,"realTimeFact