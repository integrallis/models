[0.030, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000, "o", "\r\n"]
[0.000, "o", "\u001b[1;36m  HARRIET  vs  TYPESAFE JEV\u001b[0m\r\n"]
[0.000, "o", "  Master services agreement, 404 tokens, 10 questions, identical prompts.\r\n"]
[0.000, "o", "  Every timing is measured inside the process that answers.\r\n"]
[0.000, "o", "\u001b[2m  We do not know what hardware Jev runs on. Ours is named below.\u001b[0m\r\n"]
[0.000, "o", "  ────────────────────────────────────────────────────────────────────\r\n\r\n"]
[0.000, "o", "\u001b[1;33m  ── TypeSafe Jev (hosted API, hardware unknown) ──\u001b[0m\r\n"]
[0.108, "o", "\r\n  TypeSafe Jev — one document, many questions\r\n  model jev-latest, 10 questions, document resent each call\r\n\r\n"]
[0.355, "o", "  Q1  What is the monthly fee?                       YES  p=0.990   0.354 s\r\n"]
[0.274, "o", "  Q2  What is the uptime guarantee?                  YES  p=0.990   0.274 s\r\n"]
[0.225, "o", "  Q3  Can Acme use Customer Data to train models?    YES  p=0.860   0.224 s\r\n"]
[0.241, "o", "  Q4  What is the liability cap?                     YES  p=0.980   0.241 s\r\n"]
[0.255, "o", "  Q5  Does the liability cap apply to data breaches? YES  p=0.840   0.255 s\r\n"]
[0.246, "o", "  Q6  When can Northwind terminate for convenience?  YES  p=0.980   0.246 s\r\n"]
[0.273, "o", "  Q7  What is the early termination fee?             YES  p=0.990   0.272 s\r\n"]
[0.357, "o", "  Q8  Which state's law governs?                     YES  p=0.990   0.357 s\r\n"]
[0.239, "o", "  Q9  What is the CEO of Acme Corp's name?           NO   p=0.020   0.239 s\r\n"]
[0.247, "o", "  Q10 What is the penalty for a data centre fire?    NO   p=0.060   0.247 s\r\n\r\n  input tokens billed          7292   (document resent 10x)\r\n  mean per question              0.271 s\r\n  total for 10 questions         2.712 s\r\n\r\n"]
[0.000, "o", "  timings written to /tmp/sbs-jev.json\r\n\r\n"]
[0.015, "o", "\u001b[1;32m  ── Harriet (frozen Qwen3.5-4B, letter logits, CPU) ──\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m     RunPod cpu3c, 32 vCPU AMD EPYC 9655P (Zen 5), 16 worker threads\u001b[0m"]
[0.000, "o", "\r\n"]
[2.433, "o", "  Harriet — one document, prefilled once, many questions\r\n"]
[0.006, "o", "  frozen Qwen3.5-4B, letter-logit readout, 10 questions, document never leaves the box\r\n"]
