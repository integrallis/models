        {"name":"move_photos","description":"Move photos into an album.","parameters":{"type":"object","properties":{"album":{"type":"string"},"filter":{"type":"string","description":"Which photos, e.g. 'last weekend', 'screenshots'."}},"required":["album","filter"]}},
        {"name":"delete_photos","description":"Delete photos.","parameters":{"type":"object","properties":{"filter":{"type":"string"}},"required":["filter"]}}
      ],
      "query": "create an album called Summer 2026 and move the photos from last weekend into it",
      "expectedCalls": [
        {"name":"create_album","arguments":{"name":"Summer 2026"}},
        {"name":"move_photos","arguments":{"album":"Summer 2026","filter":"last weekend"}}
      ]
