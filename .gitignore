# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/
bin/
out/

# OS
**/.DS_Store
Thumbs.db

# Security - Never commit secrets
*.env
.env
.env.*
!.env.example
credentials.json
api-keys.txt

# SpotBugs
spotbugs-output.txt

# JMH
*.jmh

# Python
**/__pycache__/
**/.pytest_cache/
**/.venv/
*.py[cod]

# Node
**/node_modules/
docs/.cache/
docs/content/modules/ROOT/attachments/javadoc/

# Model weights — never commit to git
*.gguf
*.safetensors

# Model cache directory
**/.jvllm/

# Agent worktrees and session scratch. These are embedded git repositories; git add -A
# swept one into a release commit once.
.claude/

# Host timing written beside a decision-evidence report. Deliberately not committed: it is
# wall clock, it changes on every run, and the whole point of moving it out of the evidence file
# was to stop a re-run dirtying the tree. The evidence file beside it is byte-reproducible.
experiments/**/evidence/*.timing.json

# Generated by scripts/fleet/make-boot.sh. Each one embeds a presigned S3 URL, which is a
# bearer token for the worker object -- regenerate from a shard number and a commit instead.
scripts/fleet/ud-boot-*.sh

# Paradee comparator downloads and oracle dumps (pinned by digest in pins.py, regenerated on demand)
experiments/paradee-8m-tts/comparator/.artifacts/
# Qualification pass directories keep their pass.json / judge.json / junit.xml; the per-sentence
# WAV and text files are regenerable from them and run to gigabytes.
experiments/paradee-8m-tts/evidence/**/[0-9][0-9][0-9].wav
experiments/paradee-8m-tts/evidence/**/[0-9][0-9][0-9].txt
experiments/paradee-8m-tts/evidence/**/gradle.log
# The fallback trainer's output directory keeps its cards, logs and reports; checkpoints and the
# raw export stay out (the bundled copies live in models-audio resources).
!experiments/paradee-8m-tts/g2p/out/
!experiments/paradee-8m-tts/g2p/out/**
experiments/paradee-8m-tts/g2p/out/**/*.pt
experiments/paradee-8m-tts/g2p/out/**/*.onnx
experiments/paradee-8m-tts/g2p/out/cmudict-us.json
